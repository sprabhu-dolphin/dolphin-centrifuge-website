---
// StatsBar — 4-up stat row matching WhyDolphin stat styling (big number + label)
const stats = [
  { value: '40+',    label: 'Years',                hasNumber: true  },
  { value: '500+',   label: 'Systems Delivered',    hasNumber: true  },
  { value: '150+',   label: 'Centrifuges in Stock', hasNumber: true  },
  { value: null,     label: 'In-House Engineering', hasNumber: false },
];
---

<section class="bg-navy py-10 md:py-12">
  <div class="container-dolphin">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 md:gap-8">
      {stats.map((stat) => (
        <div class="text-center border-r border-white/10 last:border-r-0 px-4">
          {stat.hasNumber ? (
            <span class="block font-heading text-4xl md:text-5xl font-extrabold text-gold leading-none mb-2">
              {stat.value}
            </span>
          ) : (
            <span class="flex items-center justify-center mb-2">
              <span class="w-10 h-10 rounded-full bg-gold/20 flex items-center justify-center">
                <svg class="w-5 h-5 text-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
              </span>
            </span>
          )}
          <span class="block text-sm font-semibold text-gray-300 leading-snug uppercase tracking-wide">
            {stat.label}
          </span>
        </div>
      ))}
    </div>
  </div>
</section>
