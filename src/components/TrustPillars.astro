---
// TrustPillars - 3-column icon-card row, the 3 core trust pillars
const pillars = [
  {
    headline: 'Every Unit Test-Run',
    body: 'We run every remanufactured centrifuge at rated speed before it ships.',
    icon: 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z',
  },
  {
    headline: 'Full Rebuild, Every Wear Part',
    body: "Every seal, gasket, friction pad, bearing, and fastener replaced regardless of condition, with exposed fasteners upgraded to stainless steel. Genuine OEM parts are made by Alfa Laval; Dolphin's compatible parts are made by other manufacturers to the same fit and function.",
    icon: 'M11.42 15.17l-5.384-3.079A.75.75 0 005.25 12.9v6.2a.75.75 0 00.786.738l5.23-1.12M11.42 15.17l5.384-3.079A.75.75 0 0117.59 11.5v-.75c0-.69-.56-1.25-1.25-1.25H7.66c-.69 0-1.25.56-1.25 1.25v.75a.75.75 0 00.786.738l4.224.912z',
  },
  {
    headline: '6-Month Warranty + Support',
    body: 'A 6-month mechanical warranty, plus ongoing support to the original purchaser.',
    icon: 'M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z',
  },
];
---

<section class="py-14 md:py-20 bg-white">
  <div class="container-dolphin">
    <div class="text-center mb-10 md:mb-14">
      <p class="text-xs font-bold tracking-[0.2em] uppercase text-gold mb-3">Our Standard</p>
      <h2 class="font-heading text-3xl md:text-4xl font-extrabold text-navy">Why Dolphin Builds Differently</h2>
    </div>

    <div class="grid sm:grid-cols-3 gap-6 lg:gap-8">
      {pillars.map((pillar) => (
        <div class="bg-warm-white rounded-xl border border-gray-100 p-7 text-center hover:shadow-lg hover:-translate-y-1 transition-all duration-200">
          <div class="w-14 h-14 rounded-full bg-navy flex items-center justify-center mx-auto mb-5">
            <svg class="w-7 h-7 text-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d={pillar.icon} />
            </svg>
          </div>
          <h3 class="font-heading text-base font-bold text-navy mb-3">{pillar.headline}</h3>
          <p class="text-text-muted text-sm leading-relaxed">{pillar.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>
