---
const pillars = [
  {
    label: 'Every Unit Test-Run',
    icon: 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z',
  },
  {
    label: 'Beyond-OEM Rebuild - Stainless Fasteners',
    icon: 'M11.42 15.17l-5.384-3.079A.75.75 0 005.25 12.9v6.2a.75.75 0 00.786.738l5.23-1.12M11.42 15.17l5.384-3.079A.75.75 0 0117.59 11.5v-.75c0-.69-.56-1.25-1.25-1.25H7.66c-.69 0-1.25.56-1.25 1.25v.75a.75.75 0 00.786.738l4.224.912z',
  },
  {
    label: '6-Month Mechanical Warranty',
    icon: 'M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z',
  },
];
---

<section class="bg-white border-b border-gray-200" aria-label="Dolphin centrifuge rebuild standards">
  <div class="container-dolphin py-3">
    <div class="flex flex-wrap md:flex-nowrap items-center justify-center gap-x-6 gap-y-2">
      {pillars.map((pillar) => (
        <div class="inline-flex items-center gap-2 text-navy">
          <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-navy text-gold">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d={pillar.icon} />
            </svg>
          </span>
          <span class="text-xs sm:text-sm font-bold leading-tight">{pillar.label}</span>
        </div>
      ))}
    </div>
  </div>
</section>
