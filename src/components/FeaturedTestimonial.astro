---
// FeaturedTestimonial - prominent homepage pull-quote from a start-up biodiesel customer.
// Navy card with a large gold quotation mark accent, matching site styling.
---

<section class="py-16 md:py-20 bg-warm-white">
  <div class="container-dolphin">
    <div class="relative max-w-4xl mx-auto bg-navy text-white rounded-2xl shadow-xl px-7 py-10 md:px-14 md:py-14 overflow-hidden">

      {/* Large gold quote mark accent */}
      <div class="absolute top-2 left-5 md:top-4 md:left-8 text-[7rem] md:text-[9rem] leading-none text-gold/25 font-serif select-none pointer-events-none" aria-hidden="true">&ldquo;</div>

      <div class="relative">
        <p class="inline-flex items-center gap-2 text-gold font-bold text-xs uppercase tracking-[0.2em] mb-5">
          <span class="w-6 h-0.5 bg-gold rounded"></span>
          In Their Words
        </p>

        <blockquote class="font-heading text-xl md:text-2xl lg:text-[1.7rem] font-semibold leading-snug text-white">
          &ldquo;...we are not Exxon Mobil or Chevron. We are a start-up in every sense of the word and at this point need an equipment supplier who realizes our concern over every dollar. You've been there, you get it.&rdquo;
        </blockquote>

        <div class="mt-7 flex items-center gap-4">
          <div class="flex-shrink-0 w-11 h-11 rounded-full bg-gold/20 flex items-center justify-center text-gold font-bold">
            T
          </div>
          <div>
            <div class="font-bold text-white">T.G., President &amp; CEO</div>
            <div class="text-sm text-gray-300">Northeast biodiesel start-up</div>
          </div>
        </div>

        <div class="mt-7">
          <a
            href="/dolphin-centrifuge-customer-testimonials/"
            class="inline-flex items-center gap-1.5 text-sm font-bold text-gold hover:text-white transition-colors"
          >
            Read more customer testimonials
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
