---
import { technicalCatalog } from '../data/centrifugeTechnicalRegistry.mjs';

type NumericValue = { value: number } | { minimum: number; maximum: number };
type CapacityRecord = {
  fluid: { category: string };
  sourceValue: NumericValue;
  derivedConversions: NumericValue[];
};
type ModelRecord = {
  recordType: string;
  displayName: string;
  canonicalPage: string;
  specifications: { cleaningMethod?: { value: string } };
  capacities: CapacityRecord[];
};
type FlowRow = {
  model: ModelRecord;
  gpmValue: number;
  gpmText: string;
  litersText: string;
  cleaning: string;
  otherFluids: string;
};

const fluidLabels: Record<string, string> = {
  'fuel-oil': 'gas oil',
  'heavy-fuel-oil': 'HFO',
  'lube-oil': 'lube oil',
};

const models = technicalCatalog.models as unknown as ModelRecord[];
const rows = models
  .filter((model) => model.recordType === 'oem-base-machine' && model.capacities.length > 0)
  .map((model) => {
    const diesel = model.capacities.find((capacity) => capacity.fluid.category === 'diesel');
    if (!diesel) return null;
    const gpm = diesel.derivedConversions[0];
    if (!gpm) return null;
    const gpmValue = 'value' in gpm ? gpm.value : gpm.minimum;
    const otherFluids = [...new Set(model.capacities
      .filter((capacity) => capacity.fluid.category !== 'diesel' && capacity.fluid.category !== 'reference')
      .map((capacity) => capacity.fluid.category))]
      .map((category) => fluidLabels[category] || category)
      .join(', ');
    return {
      model,
      gpmValue,
      gpmText: 'value' in gpm ? gpm.value.toFixed(2) : `${gpm.minimum.toFixed(2)}–${gpm.maximum.toFixed(2)}`,
      litersText: 'value' in diesel.sourceValue
        ? diesel.sourceValue.value.toLocaleString()
        : `${diesel.sourceValue.minimum.toLocaleString()}–${diesel.sourceValue.maximum.toLocaleString()}`,
      cleaning: model.specifications.cleaningMethod?.value || 'See model record',
      otherFluids,
    };
  })
  .filter((row): row is FlowRow => row !== null)
  .sort((a, b) => a.gpmValue - b.gpmValue);
---

<section id="find-your-model-by-flow-rate" class="my-10 not-prose">
  <h2 class="text-2xl md:text-3xl font-bold text-navy mb-4">Find an Exact Model by Diesel Capacity</h2>
  <p class="text-text-light mb-3 max-w-4xl">
    These are exact Alfa Laval base-machine application values, not blended Dolphin class ratings. The original L/h value is authoritative; US GPM is calculated as L/h ÷ 227.124707.
  </p>
  <p class="text-text-light mb-5 max-w-4xl">
    Capacity changes with fluid, viscosity, temperature, density difference, and solids loading. DMB and DMPX commercial classes can contain more than one base-machine variant, so select that exact machine before using a capacity. <a href="/technical-data/" class="font-semibold text-navy hover:text-gold">See all {technicalCatalog.statistics.capacityRecords} condition-qualified records and model mappings.</a>
  </p>
  <div class="overflow-x-auto border border-gray-100 rounded-xl shadow-sm">
    <table class="w-full text-sm text-left border-collapse">
      <thead>
        <tr class="bg-navy text-white">
          <th class="px-4 py-3 font-semibold">Diesel application capacity</th>
          <th class="px-4 py-3 font-semibold">Exact Alfa Laval model</th>
          <th class="px-4 py-3 font-semibold">Canonical source value</th>
          <th class="px-4 py-3 font-semibold">Cleaning method</th>
          <th class="px-4 py-3 font-semibold">Other source-backed fluids</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100 bg-white">
        {rows.map((row) => (
          <tr class="hover:bg-gray-50">
            <td class="px-4 py-3 font-mono text-navy whitespace-nowrap">{row.gpmText} US GPM</td>
            <td class="px-4 py-3 font-semibold">
              <a href={row.model.canonicalPage} class="text-navy hover:text-gold transition-colors">{row.model.displayName}</a>
            </td>
            <td class="px-4 py-3 font-mono text-text-light whitespace-nowrap">{row.litersText} L/h</td>
            <td class="px-4 py-3 text-text-light whitespace-nowrap">{row.cleaning}</td>
            <td class="px-4 py-3 text-text-light">{row.otherFluids || 'No additional fluid record in v1'}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="mt-3 text-xs text-text-muted">Diesel conditions: 13 cSt at 40°C. WHPX records are labeled marine diesel in the source table. Always confirm final sizing for the actual feed.</p>
</section>
