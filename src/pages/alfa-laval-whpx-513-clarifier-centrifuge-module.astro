const jsonLd = [productJsonLd, faqJsonLd, articleJsonLd];

const toc = [
  { id: 'overview', label: 'Centrifuge Module Overview' },
  { id: 'specifications', label: 'Technical Specifications' },
  { id: 'module-components', label: 'Module Components' },
  { id: 'applications', label: 'Applications' },
  { id: 'faq', label: 'Frequently Asked Questions' },
];

const relatedApplications = [
  { label: 'Wastewater Centrifuge', href: '/wastewater-centrifuge/' },
  { label: 'Machine Coolant Centrifuge', href: '/machine-coolant-centrifuge/' },
  { label: 'Lube Oil Centrifuge', href: '/lube-oil-centrifuge/' },
  { label: 'Diesel Fuel Centrifuge', href: '/diesel-centrifuge/' },
];

const relatedProducts = [
  { label: 'WHPX 513 Fuel Centrifuge', href: '/alfa-laval-whpx-513/', description: 'Base-machine application capacities with exact fluid conditions' },
  { label: 'DMPX-070 Self-Cleaning System', href: '/centrifuges/dmpx-070/', description: 'Commercial class; select the exact base machine before stating capacity' },
  { label: 'DMPX-042 Self-Cleaning System', href: '/centrifuges/dmpx-042/', description: 'Mid-size commercial class with multiple documented base machines' },
];
---

<ApplicationLayout
  title="WHPX 513 Centrifuge Module | Dolphin Centrifuge"
  heroTitle="WHPX 513 Centrifuge Module"
  description="Dolphin clarifier module built around an Alfa Laval WHPX 513, with PLC controls, stainless pump, and pre-filter. Application-specific sizing and testing."
  category="products"
  categoryLabel="Products"
  categoryHref="/alfa-laval-centrifuges/"
  heroImage="/images/alfa-laval-whpx-513-clarifier-centrifuge-module/Alfa-Laval-WHPX-513-Centrifuge-for-Waste-Water-Clarification.webp"
  heroImageAlt="Alfa Laval WHPX 513 centrifuge module for wastewater clarification"
  canonicalUrl="https://dolphincentrifuge.com/alfa-laval-whpx-513-clarifier-centrifuge-module/"
  jsonLd={jsonLd}
  toc={toc}
  relatedApplications={relatedApplications}
  relatedProducts={relatedProducts}
  hideBottomCTA={true}
>

  <div class="bg-navy/5 border-l-4 border-gold/40 rounded-r-lg p-4 mb-6 not-prose">
    <p class="text-sm text-text-light leading-relaxed italic">Dolphin Centrifuge supplies parts, repairs, and custom clarifier modules built around remanufactured Alfa Laval WHPX 513 separators. Each module includes PLC touch-screen controls, a stainless steel feed pump, and a pre-filter. Clarifier flow and particle separation are sized for the customer's actual fluid and performance target.</p>
  </div>

  <h2 id="overview">Centrifuge Module Overview</h2>

  <div class="flex flex-col md:flex-row gap-6 items-start mb-6">
    <div class="flex-1">
      <p>
        The Alfa Laval WHPX 513 is a self-cleaning <a href="/disc-stack-centrifuge/">disc stack centrifuge</a> designed for separation of mixed fluids and sludge. In this Dolphin configuration, it operates as a two-phase clarifier for removing suspended solids from process liquids.
      </p>
      <p>
        The WHPX 513 uses a 15 HP motor. Clarifier flow and achievable particle separation depend on the feed liquid, solids loading and size distribution, temperature, target clarity, and module configuration. Dolphin uses process data and, when appropriate, <a href="/industrial-centrifuge-sample-testing/">sample testing</a> to size wastewater and other clarification duties.
      </p>
    </div>
    <img
      src="/images/alfa-laval-whpx-513-clarifier-centrifuge-module/Alfa-Laval-WHPX-513-Centrifuge-for-Waste-Water-Clarification.webp"
      alt="Alfa Laval WHPX 513 centrifuge for wastewater clarification"
      width="300"
      height="300"
      loading="lazy"
      class="rounded-lg img-cap-300 shrink-0"
    />
  </div>

  <p>
    Dolphin Centrifuge is the independent specialist in <a href="/alfa-laval-centrifuges/">Alfa Laval</a> centrifuges. Apart from Alfa Laval itself, Dolphin is the reliable source for quality Alfa Laval machines: remanufactured centrifuges, turnkey systems, parts, and service, built on 40+ years of Alfa Laval experience and led by Sanjay Prabhu, MSME. The skid, controls, and ancillaries are Dolphin engineering; the centrifuge at the heart of the module is a genuine Alfa Laval WHPX 513, also supplied as the Dolphin <a href="/centrifuges/dmpx-070/">DMPX-070</a> module. Dolphin is an independent remanufacturer and is not affiliated with Alfa Laval.
  </p>

  <p>
    This centrifuge module ships as a complete, turnkey system with all ancillary equipment pre-installed, pre-wired, and tested. Simply connect your process piping and power, and the system is ready for operation. For <a href="/industrial-disc-centrifuge-repair/">ongoing centrifuge repair and maintenance</a>, Dolphin Centrifuge provides full field service support.
  </p>

  <div class="bg-gold/10 border-l-4 border-gold rounded-r-xl p-5 my-8 not-prose">
    <p class="text-base font-semibold text-navy mb-1">Custom-built centrifuge modules available</p>
    <p class="text-sm text-text-light mb-3">Dolphin Centrifuge builds each WHPX 513 centrifuge module to your application requirements. Modules include PLC controls, a feed pump, and a pre-filter, and are factory tested before shipment. <a href="/industrial-centrifuge-sample-testing/" class="text-navy font-semibold hover:text-gold">Sample testing</a> is available to verify performance for your fluid.</p>
    <a href="/contact-for-alfa-laval-centrifuges/" class="inline-block bg-gold hover:bg-gold/80 text-navy font-bold px-6 py-2 rounded-lg transition-colors text-sm">Request a Quote &rarr;</a>
  </div>

  <h2 id="specifications">Technical Specifications</h2>

  <table>
    <tbody>
      <tr><td><strong>Model Type</strong></td><td>Alfa Laval WHPX 513 TGD 24-60</td></tr>
      <tr><td><strong>Clarifier Capacity</strong></td><td>Application-specific; determined from feed data and testing</td></tr>
      <tr><td><strong>Base Separator Diesel Reference</strong></td><td>16,400 L/h (72.21 US GPM) at 13 cSt and 40 &deg;C; not a wastewater capacity</td></tr>
      <tr><td><strong>Base Separator Rated Reference</strong></td><td>24,500 L/h (107.87 US GPM); source fluid not specified and not a wastewater capacity</td></tr>
      <tr><td><strong>Sludge Space</strong></td><td>3.87 Gallons</td></tr>
      <tr><td><strong>Motor HP</strong></td><td>15 HP</td></tr>
      <tr><td><strong>Voltages</strong></td><td>230 / 460 V, 3 phase</td></tr>
    </tbody>
  </table>

  <h2 id="module-components">Module Components</h2>

  <p>This centrifuge module includes everything needed for immediate deployment:</p>

  <div class="grid md:grid-cols-2 gap-4 mb-6 not-prose">
    <div class="bg-white rounded-xl p-5 border border-gray-200">
      <h3 class="text-base font-bold text-navy mb-2">PLC Control Panel</h3>
      <p class="text-sm text-text-light">Fully programmed PLC-based control system with touchscreen interface for automated operation, discharge timing, and system monitoring.</p>
    </div>
    <div class="bg-white rounded-xl p-5 border border-gray-200">
      <h3 class="text-base font-bold text-navy mb-2">Stainless Steel Feed Pump</h3>
      <p class="text-sm text-text-light">Corrosion-resistant stainless steel pump sized for the selected application flow and compatible with the module process design.</p>
    </div>
    <div class="bg-white rounded-xl p-5 border border-gray-200">
      <h3 class="text-base font-bold text-navy mb-2">Pre-Filter System</h3>
      <p class="text-sm text-text-light">Inline pre-strainer protects the centrifuge from large debris and extends bowl cleaning intervals for maximum uptime.</p>
    </div>
    <div class="bg-white rounded-xl p-5 border border-gray-200">
      <h3 class="text-base font-bold text-navy mb-2">Integrated Skid</h3>
      <p class="text-sm text-text-light">All components mounted on a structural steel skid with pre-installed piping and wiring for plug-and-play commissioning.</p>
    </div>
  </div>

  <h2 id="applications">Applications</h2>

  <p>The WHPX 513 centrifuge module is suited for a variety of industrial clarification duties:</p>

  <ul>
    <li><a href="/wastewater-centrifuge/">Wastewater TSS clarification</a></li>
    <li><a href="/diesel-centrifuge/">Diesel fuel clarification</a> (with piping modification)</li>
    <li><a href="/lube-oil-centrifuge/">Lube oil clarification</a> (with piping modification)</li>
    <li>Mining residual water clarification</li>
    <li><a href="/wvo-centrifuge-separator/">WVO separation from water and solids</a> (with piping modification)</li>
    <li><a href="/machine-coolant-centrifuge/">Machine coolant recovery and polishing</a></li>
  </ul>

  <h3>Related Resources</h3>
  <ul>
    <li><a href="/alfa-laval-whpx-513/">Alfa Laval WHPX 513 Centrifuge (Purifier Configuration)</a></li>
    <li><a href="/technical-data/alfa-laval-whpx-513.json">WHPX 513 Machine-Readable Technical Record</a></li>
    <li><a href="/technical-data/">Technical Data Methodology</a></li>
    <li><a href="/disc-stack-centrifuge/">All Disc Stack Centrifuges</a></li>
    <li><a href="/disc-stack-centrifuge-faq/">101 Disc Stack Centrifuge FAQs</a></li>
    <li><a href="/alfa-laval-centrifuge-parts/">Centrifuge Parts &amp; Spares</a></li>
    <li><a href="/industrial-disc-centrifuge-repair/">Disc Centrifuge Repair &amp; Rebuild</a></li>
  </ul>

  <h2 id="faq">Frequently Asked Questions</h2>

  <details class="border-l-4 border-gold/40 pl-4 mb-3 group">
    <summary class="cursor-pointer font-semibold text-navy py-2 list-none flex justify-between items-center">
      What is the WHPX 513 Centrifuge Module used for?
      <span class="text-gold ml-2 group-open:rotate-180 transition-transform">&#9660;</span>
    </summary>
    <p class="text-text-light mt-2 pb-2">The WHPX 513 Centrifuge Module is a custom two-phase clarifier system for removing suspended solids from process liquids. It can be configured for wastewater clarification, machine coolant recovery, and industrial fluid polishing. Flow rate and achievable particle separation are application-specific and should be established from feed data and, when needed, sample testing.</p>
  </details>
  <details class="border-l-4 border-gold/40 pl-4 mb-3 group">
    <summary class="cursor-pointer font-semibold text-navy py-2 list-none flex justify-between items-center">
      What is included in the WHPX 513 module package?
      <span class="text-gold ml-2 group-open:rotate-180 transition-transform">&#9660;</span>
    </summary>
    <p class="text-text-light mt-2 pb-2">The module includes the Alfa Laval WHPX 513 self-cleaning disc stack centrifuge, PLC touchscreen control panel, stainless steel feed pump, pre-filter assembly, skid frame, and interconnecting pipework. It is pre-wired and factory tested. Dolphin Centrifuge custom-builds each module to the customer's application requirements.</p>
  </details>
  <details class="border-l-4 border-gold/40 pl-4 mb-3 group">
    <summary class="cursor-pointer font-semibold text-navy py-2 list-none flex justify-between items-center">
      How does the centrifuge module handle sludge discharge?
      <span class="text-gold ml-2 group-open:rotate-180 transition-transform">&#9660;</span>
    </summary>
    <p class="text-text-light mt-2 pb-2">The WHPX 513's self-cleaning bowl automatically discharges accumulated solids at programmable intervals using hydraulically operated discharge valves. Discharge takes only a few seconds and does not interrupt fluid flow. The sludge is collected in an integrated sludge tank within the module. No manual bowl opening or cleaning is required between service intervals.</p>
  </details>
  <details class="border-l-4 border-gold/40 pl-4 mb-3 group">
    <summary class="cursor-pointer font-semibold text-navy py-2 list-none flex justify-between items-center">
      What flow rate and separation performance does the WHPX 513 achieve?
      <span class="text-gold ml-2 group-open:rotate-180 transition-transform">&#9660;</span>
    </summary>
    <p class="text-text-light mt-2 pb-2">There is no universal WHPX 513 clarifier flow rate or particle-cut guarantee. Both depend on the feed liquid, solids, temperature, target clarity, and system configuration. For reference only, the WHPX 513 base separator has a published marine-diesel application capacity of 16,400 L/h (72.21 US GPM) at 13 cSt and 40 &deg;C, plus a rated reference value of 24,500 L/h (107.87 US GPM) whose source fluid is not specified. Neither number is a wastewater or clarifier capacity.</p>
  </details>
  <details class="border-l-4 border-gold/40 pl-4 mb-3 group">
    <summary class="cursor-pointer font-semibold text-navy py-2 list-none flex justify-between items-center">
      Can Dolphin Centrifuge supply parts or service the WHPX 513 module?
      <span class="text-gold ml-2 group-open:rotate-180 transition-transform">&#9660;</span>
    </summary>
    <p class="text-text-light mt-2 pb-2">Yes. Dolphin Centrifuge provides parts, complete overhauls, and field service for the WHPX 513 and its ancillary module components including the feed pump, PLC panel, and pre-filter. Contact us to schedule preventive maintenance or obtain a parts quotation.</p>
  </details>


</ApplicationLayout>
