---
import ApplicationLayout from '../layouts/ApplicationLayout.astro';

const faqItems = [
  {
    question: "What is the WHPX 513 Centrifuge Module used for?",
    answer: "The WHPX 513 Centrifuge Module is a custom two-phase clarifier system for removing suspended solids from process liquids. It can be configured for wastewater clarification, machine coolant recovery, and industrial fluid polishing. Flow rate and achievable particle separation are application-specific and should be established from feed data and, when needed, sample testing."
  },
  {
    question: "What is included in the WHPX 513 module package?",
    answer: "The module includes the Alfa Laval WHPX 513 self-cleaning disc stack centrifuge, PLC touchscreen control panel, stainless steel feed pump, pre-filter assembly, skid frame, and interconnecting pipework. It is pre-wired and factory tested. Dolphin Centrifuge custom-builds each module to the customer's application requirements."
  },
  {
    question: "How does the centrifuge module handle sludge discharge?",
    answer: "The WHPX 513's self-cleaning bowl automatically discharges accumulated solids at programmable intervals using hydraulically operated discharge valves. Discharge takes only a few seconds and does not interrupt fluid flow. The sludge is collected in an integrated sludge tank within the module. No manual bowl opening or cleaning is required between service intervals."
  },
  {
    question: "What flow rate and separation performance does the WHPX 513 achieve?",
    answer: "There is no universal WHPX 513 clarifier flow rate or particle-cut guarantee. Both depend on the feed liquid, solids, temperature, target clarity, and system configuration. For reference only, the WHPX 513 base separator has a published marine-diesel application capacity of 16,400 L/h (72.21 US GPM) at 13 cSt and 40 C, plus a rated reference value of 24,500 L/h (107.87 US GPM) whose source fluid is not specified. Neither number is a wastewater or clarifier capacity."
  },
  {
    question: "Can Dolphin Centrifuge supply parts or service the WHPX 513 module?",
    answer: "Yes. Dolphin Centrifuge provides parts, complete overhauls, and field service for the WHPX 513 and its ancillary module components including the feed pump, PLC panel, and pre-filter. Contact us to schedule preventive maintenance or obtain a parts quotation."
  }
];

const productJsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "Dolphin WHPX 513 Clarifier Centrifuge Module",
  "description": "Dolphin-built clarifier module featuring a remanufactured Alfa Laval WHPX 513 separator, PLC controls, stainless steel pump, and pre-filter. Flow and separation performance are application-specific.",
  "brand": { "@type": "Brand", "name": "Dolphin Centrifuge" },
  "manufacturer": { "@type": "Organization", "name": "Dolphin Centrifuge" },
  "model": "WHPX 513 Clarifier Module",
  "alternateName": ["Dolphin WHPX 513 Centrifuge Module"],
  "isRelatedTo": [
    {
      "@type": "Product",
      "name": "Alfa Laval WHPX 513 Centrifuge",
      "description": "Remanufactured WHPX 513 base separator used in the Dolphin module.",
      "url": "https://dolphincentrifuge.com/alfa-laval-whpx-513/"
    },
    {
      "@type": "Product",
      "name": "Dolphin DMPX-070 Centrifuge Module",
      "description": "Dolphin commercial system class available with a WHPX 513 base machine.",
      "url": "https://dolphincentrifuge.com/centrifuges/dmpx-070/"
    }
  ],
  "category": "Disc Stack Centrifuges",
  "image": "https://dolphincentrifuge.com/images/alfa-laval-whpx-513-clarifier-centrifuge-module/Alfa-Laval-WHPX-513-Centrifuge-for-Waste-Water-Clarification.webp",
  "url": "https://dolphincentrifuge.com/alfa-laval-whpx-513-clarifier-centrifuge-module/",
  "subjectOf": {
    "@type": "DigitalDocument",
    "name": "WHPX 513 base-machine technical record",
    "url": "https://dolphincentrifuge.com/technical-data/alfa-laval-whpx-513.json"
  },
  "additionalProperty": [
    { "@type": "PropertyValue", "name": "Base separator", "value": "Alfa Laval WHPX 513 TGD 24-60" },
    { "@type": "PropertyValue", "name": "Clarifier flow rate", "value": "Application-specific; determine from feed data and testing" },
    { "@type": "PropertyValue", "name": "Particle separation", "value": "Application-specific; no universal micron guarantee" },
    { "@type": "PropertyValue", "name": "Motor power", "value": "15 HP" }
  ],
  "offers": {
    "@type": "Offer",
    "availability": "https://schema.org/InStock",
    "priceCurrency": "USD",
    "seller": { "@type": "Organization", "name": "Dolphin Centrifuge", "url": "https://dolphincentrifuge.com" }
  }
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer.replace(/<[^>]*>/g, '')
    }
  }))
};

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "Alfa Laval WHPX 513 Centrifuge Module with PLC Control Panel",
  "description": "Technical overview of a Dolphin clarifier module built around the Alfa Laval WHPX 513 for wastewater, machine coolant, and industrial fluid polishing duties.",
  "author": {
    "@type": "Person",
    "@id": "https://dolphincentrifuge.com/authors/sanjay-prabhu/#person",
    "name": "Sanjay Prabhu",
    "honorificSuffix": "M.S.M.E.",
    "jobTitle": "Centrifuge Applications Engineer",
    "worksFor": {
      "@type": "Organization",
      "name": "Dolphin Centrifuge"
    }
  },
  "publisher": {
    "@type": "Organization",
    "name": "Dolphin Centrifuge",
    "url": "https://dolphincentrifuge.com"
  },
