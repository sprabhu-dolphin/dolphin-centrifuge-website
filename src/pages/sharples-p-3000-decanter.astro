  "jobTitle": "Centrifuge Applications Engineer",
  "knowsAbout": [
    "Industrial centrifuges",
    "Disc stack centrifuges",
    "Decanter centrifuges",
    "Alfa Laval centrifuge systems",
    "Centrifuge repair and remanufacturing",
    "Waste oil separation",
    "Coolant recycling",
    "Industrial fluid separation"
  ],
  "worksFor": {
    "@type": "Organization",
    "name": "Dolphin Centrifuge",
    "url": "https://dolphincentrifuge.com"
  },
  "description": "Leads centrifuge applications engineering at Dolphin Centrifuge, backed by the company's 40+ years of experience in industrial centrifuge systems",
  "url": "https://dolphincentrifuge.com/about-dolphin-centrifuge/",
  "alumniOf": {
    "@type": "CollegeOrUniversity",
    "name": "University of Arkansas",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Fayetteville",
      "addressRegion": "AR",
      "addressCountry": "US"
    }
  },
  "hasCredential": {
    "@type": "EducationalOccupationalCredential",
    "name": "Master of Science in Mechanical Engineering",
