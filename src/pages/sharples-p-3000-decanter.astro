    "availability": "https://schema.org/InStock",
    "priceCurrency": "USD",
    "itemCondition": "https://schema.org/RefurbishedCondition",
    "seller": { "@type": "Organization", "name": "Dolphin Centrifuge", "url": "https://dolphincentrifuge.com" }
