    { "@type": "PropertyValue", "name": "Rated Capacity", "value": "25 GPM on Municipal Sludge Thickening" },
    { "@type": "PropertyValue", "name": "Bowl Speed", "value": "4000 RPM (3,150 Gs RCF)" },
    { "@type": "PropertyValue", "name": "Drive Motor Power", "value": "15 HP" },
    { "@type": "PropertyValue", "name": "Auger Differential Speed", "value": "1 ~ 40 RPM" },
    { "@type": "PropertyValue", "name": "Gearbox Ratio", "value": "1: 125" },
    { "@type": "PropertyValue", "name": "Conveyor Protection", "value": "Carbide Tile or Tungsten Carbide Hard-Surfacing" }
  ]
};

const jsonLd = [articleJsonLd, productJsonLd];

const toc = [
  { id: 'applications', label: 'Applications' },
  { id: 'specifications', label: 'Specifications' },
  { id: 'units-for-sale', label: 'Sharples P 3000 Photo Gallery' },
  { id: 'used-and-remanufactured', label: 'Used and Remanufactured P-3000' },
];

const relatedProducts = [
  { label: 'Decanter Centrifuge', href: '/decanter-centrifuge/', description: 'Remanufactured Alfa Laval and Sharples decanters' },
  { label: 'Alfa Laval NX-314 Decanter', href: '/alfa-laval-nx-314-decanter-centrifuge/', description: 'Next size up for heavier solids' },
];

const relatedApplications = [
  { label: 'Decanter Centrifuge', href: '/decanter-centrifuge/' },
  { label: 'Wastewater Centrifuge', href: '/wastewater-centrifuge/' },
  { label: 'Waste Oil Centrifuge', href: '/waste-oil-centrifuge/' },
  { label: 'Liquid Humus Centrifuge', href: '/liquid-humus-centrifuge/' },
  { label: 'Hemp Extraction Centrifuge', href: '/stainless-steel-centrifuge/' },
