  "manufacturer": { "@type": "Organization", "name": "Alfa Laval (Sharples)" },
  "model": "P-3000",
  "alternateName": [
    "Sharples P-3000",
    "Sharples P3000 decanter centrifuge",
    "Alfa Laval Sharples P-3000"
