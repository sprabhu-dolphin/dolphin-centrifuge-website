        width="348"
        height="466"
        loading="lazy"
        class="rounded-lg img-cap-300"
      />
      <figcaption class="text-sm text-center text-text-light mt-1">Alfa Laval MOPX205 Diesel Purifier</figcaption>
    </figure>
