import ApplicationLayout from '../layouts/ApplicationLayout.astro';

const faqItems = [
  {
    question: "Which Dolphin module can use the Alfa Laval WHPX 405?",
    answer: "The Alfa Laval WHPX 405 is one exact base-machine option for the Dolphin DMPX-014 centrifuge system; another option is the MOPX 205. The module adds the frame, PLC controls, feed pump, heaters, and piping. The OEM diesel values are 3,700 L/h (16.29 US GPM derived) for WHPX 405 and 3,300 L/h (14.53 US GPM derived) for MOPX 205, both at 40 C and 13 cSt."
  },
  {
    question: "What is the difference between the WHPX 405 and MOPX 205?",
    answer: "The Alfa Laval WHPX 405 and MOPX 205 are different base machines in the same commercial size class. WHPX 405 uses a partial-discharge bowl and has an OEM marine-diesel value of 3,700 L/h (16.29 US GPM derived). MOPX 205 uses a total-discharge bowl and has an OEM diesel value of 3,300 L/h (14.53 US GPM derived). Both diesel records are at 40 C and 13 cSt."
  },
  {
    question: "What applications is the WHPX 405 / DMPX-014 best suited for?",
    answer: "The WHPX 405 / DMPX-014 is suited for small to medium throughput applications including diesel fuel polishing, pyrolysis-oil dewatering, waste-oil recovery, lube-oil purification, and hydraulic-oil cleaning. Non-diesel duties require application sizing from the actual fluid properties and separation target rather than reuse of the diesel value."
  },
  {
    question: "What G-force does the Alfa Laval WHPX 405 generate?",
    answer: "The Alfa Laval WHPX 405 operates at approximately 7,200 Gs of centrifugal force at rated bowl speed of 7,600 RPM. This high G-force enables separation of particles down to 0.5 microns and effective water removal from oil and fuel products."
  },
  {
    question: "Can Dolphin Centrifuge repair or supply parts for the WHPX 405?",
    answer: "Yes. Dolphin Centrifuge supplies genuine and compatible replacement parts, complete bowl rebuilds, and remanufactured WHPX 405 and MOPX 205 centrifuges. Each rebuilt unit is tested to factory specifications before shipment. Genuine OEM parts are made by Alfa Laval; Dolphin's compatible parts are made by other manufacturers to the same fit and function, so you can choose on price and lead time. Dolphin Centrifuge is an independent remanufacturer and is not affiliated with Alfa Laval. Contact us for parts availability and pricing."
  }
];

