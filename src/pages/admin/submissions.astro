---
// Admin Dashboard — Dolphin Centrifuge Submissions
// NO-INDEX: This page is hidden from search engines
// Password protected via sessionStorage + Worker Bearer token
const contactWorkerBaseUrl = (import.meta.env.PUBLIC_CONTACT_WORKER_URL || (
  import.meta.env.DEV
    ? 'http://127.0.0.1:8787'
    : 'https://dolphin-contact-form.dolphin-centrifuge.workers.dev'
)).replace(/\/$/, '');
const isDevDashboard = import.meta.env.DEV;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Submissions Dashboard — Dolphin Centrifuge</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <style is:global>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'Inter', Arial, sans-serif;
      background: #eef3f8;
      color: #1a2a4a;
      min-height: 100vh;
    }

    /* ── Login Screen ───────────────────────────────────────── */
    #login-screen {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      background: #1a2a4a;
    }
    .login-card {
      background: #fff;
      border-radius: 16px;
      padding: 40px 48px;
      width: 100%;
      max-width: 400px;
      box-shadow: 0 20px 60px rgba(0,0,0,0.3);
      text-align: center;
    }
    .login-card h1 {
      font-size: 1.4rem;
      color: #1a2a4a;
      margin-bottom: 6px;
    }
    .login-card p {
      font-size: 0.85rem;
      color: #666;
      margin-bottom: 28px;
    }
    .login-card input {
      width: 100%;
      border: 2px solid #ddd;
      border-radius: 10px;
      padding: 12px 16px;
      font-size: 1rem;
      outline: none;
      transition: border-color 0.2s;
      margin-bottom: 14px;
    }
    .login-card input:focus { border-color: #1a2a4a; }
    .login-card button {
      width: 100%;
      background: #1a2a4a;
      color: #fff;
      border: none;
      border-radius: 10px;
      padding: 13px;
      font-size: 1rem;
      font-weight: 600;
      cursor: pointer;
      transition: background 0.2s;
    }
    .login-card button:hover { background: #e8c204; color: #1a2a4a; }
    #login-error {
      color: #c0392b;
      font-size: 0.85rem;
      margin-top: 10px;
      min-height: 20px;
    }

    /* ── Dashboard (StatCounter-style shell) ─────────────────── */
    #dashboard { display: none; }
    #dashboard.is-active { display: flex; min-height: 100vh; }

    /* Sidebar */
    .sc-sidebar {
      flex: none;
      width: 212px;
      background: #16335c;
      color: #aebfd6;
      display: flex;
      flex-direction: column;
      position: sticky;
      top: 0;
      align-self: flex-start;
      height: 100vh;
    }
    .sc-brand {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 18px 16px;
      border-bottom: 1px solid rgba(255,255,255,0.08);
    }
    .sc-brand-mark {
      width: 30px;
      height: 30px;
      border-radius: 50%;
      background: #4a90d9;
      color: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.95rem;
      font-weight: 700;
      flex: none;
    }
    .sc-brand-name {
      color: #f2f6fc;
      font-size: 1.05rem;
      font-weight: 700;
      letter-spacing: 0.01em;
    }
    .sc-nav {
      display: flex;
      flex-direction: column;
      padding: 10px 0;
      flex: 1;
    }
    .sc-nav-item {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 12px 16px;
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: #aebfd6;
      background: transparent;
      border: 0;
      border-left: 3px solid transparent;
      text-align: left;
      cursor: pointer;
      transition: background 0.15s, color 0.15s;
      width: 100%;
      font-family: inherit;
    }
    .sc-nav-item .sc-nav-ico {
      flex: none;
      width: 16px;
      height: 16px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      opacity: 0.85;
    }
    .sc-nav-item:hover { background: #1f4575; color: #fff; }
    .sc-nav-item.active {
      background: #1f4575;
      color: #fff;
      border-left-color: #4a90d9;
    }
    .sc-nav-item.active .sc-nav-ico { opacity: 1; }
    .sc-sidebar-foot {
      border-top: 1px solid rgba(255,255,255,0.08);
      padding: 12px 16px;
    }
    .sc-logout-link {
      display: flex;
      align-items: center;
      gap: 8px;
      background: transparent;
      border: 0;
      color: #aebfd6;
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      cursor: pointer;
      padding: 0;
      font-family: inherit;
    }
    .sc-logout-link:hover { color: #fff; }

    /* Content area */
    .sc-content {
      flex: 1;
      min-width: 0;
      display: flex;
      flex-direction: column;
    }
    .sc-topbar {
      height: 56px;
      background: #fff;
      border-bottom: 1px solid #dde6f0;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      padding: 0 24px;
      position: sticky;
      top: 0;
      z-index: 20;
    }
    .sc-topbar-title { color: #16335c; font-size: 18px; font-weight: 700; }
    .sc-topbar-right { display: flex; align-items: center; gap: 14px; }
    .sc-topbar-right .sc-admin-tag { font-size: 0.82rem; color: #6a7a8c; }
    #logout-btn {
      background: transparent;
      border: 1px solid #c7d4e2;
      color: #2f6db5;
      border-radius: 6px;
      padding: 6px 16px;
      font-size: 0.85rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s;
    }
    #logout-btn:hover { background: #2f6db5; color: #fff; border-color: #2f6db5; }

    .sc-body { padding: 20px 24px 40px; }

    .sc-section-title {
      color: #2f6db5;
      font-size: 24px;
      font-weight: 600;
      margin: 4px 0 14px;
    }
    .sc-toolbar {
      display: flex;
      align-items: center;
      gap: 14px;
      flex-wrap: wrap;
      margin-bottom: 14px;
    }
    .sc-toolbar input[type="search"] {
      border: 1px solid #c7d4e2;
      border-radius: 6px;
      padding: 8px 14px;
      font-size: 0.9rem;
      outline: none;
      width: 320px;
      transition: border-color 0.2s;
      font-family: inherit;
    }
    .sc-toolbar input[type="search"]:focus { border-color: #2f6db5; }
    #count-badge { font-size: 0.82rem; color: #6a7a8c; }
    .sc-select, .sc-date {
      border: 1px solid #c7d4e2; border-radius: 6px; padding: 7px 10px;
      font-size: 0.85rem; font-family: inherit; color: #16335c; background: #fff; outline: none;
    }
    .sc-select:focus, .sc-date:focus { border-color: #2f6db5; }
    /* Pagination footer (StatCounter-style) */
    .sc-pager {
      display: flex; align-items: center; justify-content: flex-end; gap: 10px;
      flex-wrap: wrap; margin: 12px 2px 4px; font-size: 0.82rem; color: #6a7a8c;
    }
    .sc-pager:empty { display: none; }
    .sc-pager .sc-pg-info { margin-right: auto; }
    .sc-pager button {
      border: 1px solid #c7d4e2; border-radius: 6px; background: #fff; color: #16335c;
      padding: 5px 12px; font-size: 0.82rem; font-weight: 600; cursor: pointer; font-family: inherit;
    }
    .sc-pager button:hover:not(:disabled) { background: #eef4fc; border-color: #9db8dd; }
    .sc-pager button:disabled { opacity: 0.45; cursor: default; }
    .sc-pager .sc-pg-pages { color: #16335c; font-weight: 600; }
    /* Summary KPI tiles */
    .sc-tiles {
      display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
      gap: 12px; margin-bottom: 16px;
    }
    .sc-tiles:empty { display: none; }
    .sc-tile {
      background: #fff; border: 1px solid #e3e9f0; border-radius: 10px;
      padding: 14px 16px; box-shadow: 0 1px 2px rgba(16,51,92,0.04);
    }
    .sc-tile-val { font-size: 1.6rem; font-weight: 800; color: #16335c; line-height: 1.1; }
    .sc-tile-lbl { font-size: 0.72rem; font-weight: 600; color: #6a7a8c; text-transform: uppercase; letter-spacing: 0.03em; margin-top: 4px; }
    .sc-tile-sub { font-size: 0.72rem; color: #93a2b4; margin-top: 2px; }
    .sc-tile.accent .sc-tile-val { color: #1f7a3d; }
    /* Pages report (Top / Entry / Exit) */
    .sc-pages-tabs { display: flex; gap: 6px; margin-bottom: 12px; flex-wrap: wrap; }
    .sc-pages-tab {
      border: 1px solid #c7d4e2; background: #fff; color: #16335c; border-radius: 6px;
      padding: 6px 14px; font-size: 0.85rem; font-weight: 600; cursor: pointer; font-family: inherit;
    }
    .sc-pages-tab:hover { background: #eef4fc; }
    .sc-pages-tab.active { background: #1f4575; color: #fff; border-color: #1f4575; }
    .sc-pages-table { width: 100%; border-collapse: collapse; font-size: 0.85rem; }
    .sc-pages-table th, .sc-pages-table td {
      text-align: left; padding: 8px 12px; border-bottom: 1px solid #e3e9f0; color: #2a3a4c;
    }
    .sc-pages-table th { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.03em; color: #6a7a8c; }
    .sc-pages-table td.num, .sc-pages-table th.num { text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; }
    .sc-pages-table tr:hover td { background: #f7fafd; }
    .sc-pages-table .pg-path { color: #16335c; word-break: break-all; }

    /* Section panels (one visible at a time) */
    .sc-panel { display: none; }
    .sc-panel.active { display: block; }

    /* ── Table ──────────────────────────────────────────────── */
    .table-wrap {
      margin: 0 0 40px;
      max-height: calc(100vh - 200px);
      overflow: auto;
      background: #fff;
      border: 1px solid #cfd8e3;
      border-radius: 10px;
      box-shadow: 0 8px 24px rgba(26,42,74,0.08);
    }
    .visitor-directory {
      margin: 0 0 16px;
      background: transparent;
    }
    .visitor-directory h2 {
      color: #1a2a4a;
      font-size: 0.9rem;
      margin: 0 0 10px;
    }
    .visitor-directory-grid {
      display: grid;
      gap: 10px;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    }
    .visitor-directory-item {
      border: 1px solid #dce3ec;
      border-radius: 8px;
      padding: 10px;
    }
    .visitor-directory-title {
      color: #1a2a4a;
      font-size: 0.82rem;
      font-weight: 800;
      margin-bottom: 6px;
    }
    .submissions-table {
      width: max-content;
      min-width: 100%;
      border-collapse: separate;
      border-spacing: 0;
      table-layout: fixed;
      font-size: 0.84rem;
    }
    .submissions-table thead {
      background: #1a2a4a;
      color: #fff;
      text-align: left;
    }
    .submissions-table thead th {
      position: sticky;
      top: 0;
      z-index: 2;
      padding: 10px 12px;
      font-size: 0.72rem;
      font-weight: 700;
      line-height: 1.15;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      white-space: nowrap;
      background: #1a2a4a;
      border-right: 1px solid rgba(255,255,255,0.18);
      border-bottom: 1px solid #0f1b31;
    }
    .submissions-table thead th:last-child { border-right: 0; }
    .submissions-table thead th:nth-child(1),
    .submissions-table thead th:nth-child(2),
    .submissions-table thead th:nth-child(3),
    .submissions-table tbody td:nth-child(1),
    .submissions-table tbody td:nth-child(2),
    .submissions-table tbody td:nth-child(3) {
      position: sticky;
      z-index: 3;
    }
    .submissions-table thead th:nth-child(1),
    .submissions-table tbody td:nth-child(1) {
      left: 0;
      text-align: left;
    }
    .submissions-table thead th:nth-child(2),
    .submissions-table tbody td:nth-child(2) {
      left: 54px;
      white-space: nowrap;
    }
    .submissions-table thead th:nth-child(3),
    .submissions-table tbody td:nth-child(3) {
      left: 162px;
      white-space: nowrap;
    }
    .submissions-table thead th:nth-child(1),
    .submissions-table thead th:nth-child(2),
    .submissions-table thead th:nth-child(3) {
      z-index: 5;
      background: #1a2a4a;
    }
    .submissions-table tbody tr {
      transition: background 0.15s;
    }
    .submissions-table tbody tr:nth-child(even) { background: #f8fafc; }
    .submissions-table tbody tr:hover { background: #eef4fb; }
    .submissions-table tbody tr.reconnect-row { background: #fff8e1; }
    .submissions-table tbody tr.reconnect-row:hover { background: #fff3bb; }
    .submissions-table td {
      padding: 10px 12px;
      vertical-align: top;
      color: #333;
      background-clip: padding-box;
      border-right: 1px solid #dce3ec;
      border-bottom: 1px solid #dce3ec;
      line-height: 1.35;
      overflow-wrap: anywhere;
    }
    .submissions-table td:last-child { border-right: 0; }
    .submissions-table tbody td:nth-child(1),
    .submissions-table tbody td:nth-child(2),
    .submissions-table tbody td:nth-child(3) {
      background: #fff;
    }
    .submissions-table tbody tr:nth-child(even) td:nth-child(1),
    .submissions-table tbody tr:nth-child(even) td:nth-child(2),
    .submissions-table tbody tr:nth-child(even) td:nth-child(3) {
      background: #f8fafc;
    }
    .submissions-table tbody tr:hover td:nth-child(1),
    .submissions-table tbody tr:hover td:nth-child(2),
    .submissions-table tbody tr:hover td:nth-child(3) {
      background: #eef4fb;
    }
    .submissions-table tbody tr.reconnect-row td:nth-child(1),
    .submissions-table tbody tr.reconnect-row td:nth-child(2),
    .submissions-table tbody tr.reconnect-row td:nth-child(3) {
      background: #fff8e1;
    }
    .submissions-table tbody tr.reconnect-row:hover td:nth-child(1),
    .submissions-table tbody tr.reconnect-row:hover td:nth-child(2),
    .submissions-table tbody tr.reconnect-row:hover td:nth-child(3) {
      background: #fff3bb;
    }
    .submissions-table tbody td:nth-child(1) {
      color: #687386;
      font-weight: 700;
    }
    .submissions-table tbody td:nth-child(2) {
      color: #475569;
      font-size: 0.78rem;
    }
    .cell-num,
    .cell-date,
    .cell-phone,
    .cell-capacity,
    .cell-solids,
    .cell-action,
    .cell-status {
      white-space: nowrap;
    }
    .cell-num {
      color: #687386;
      font-weight: 700;
      text-align: left;
    }
    .cell-date {
      color: #475569;
      font-size: 0.78rem;
    }
    .cell-primary {
      color: #1a2a4a;
      font-weight: 700;
    }
    .cell-secondary {
      color: #64748b;
      font-size: 0.74rem;
      margin-top: 2px;
    }
    .cell-email a {
      color: #1a2a4a;
      font-weight: 600;
      text-decoration: none;
    }
    .cell-email a:hover { text-decoration: underline; }
    .empty-cell {
      color: #94a3b8;
      font-style: italic;
    }
    .badge-reconnect {
      display: inline-block;
      background: #e8c204;
      color: #1a2a4a;
      font-size: 0.7rem;
      font-weight: 700;
      padding: 2px 8px;
      border-radius: 20px;
      white-space: nowrap;
    }
    .type-badge {
      display: inline-block;
      background: #e8eef8;
      border: 1px solid #cbd8ea;
      color: #1a2a4a;
      font-size: 0.7rem;
      font-weight: 700;
      padding: 4px 8px;
      border-radius: 6px;
      white-space: nowrap;
    }
    .attrib-cell {
      min-width: 380px;
      font-size: 0.76rem;
    }
    .visitor-cell {
      min-width: 340px;
      font-size: 0.76rem;
    }
    .attrib-panel {
      display: grid;
      gap: 6px;
    }
    .attrib-source {
      display: inline-flex;
      align-items: center;
      width: fit-content;
      background: #eaf6ee;
      border: 1px solid #b7dfc2;
      border-radius: 6px;
      color: #1a2a4a;
      font-weight: 700;
      padding: 4px 8px;
    }
    .attrib-muted {
      color: #687386;
    }
    .attrib-line {
      display: grid;
      grid-template-columns: 86px minmax(0, 1fr);
      gap: 8px;
      align-items: start;
    }
    .attrib-label {
      color: #687386;
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }
    .attrib-value {
      color: #24344d;
      min-width: 0;
    }
    .attrib-path {
      color: #333;
      font-family: Consolas, 'JetBrains Mono', monospace;
      font-size: 0.72rem;
      word-break: break-word;
    }
    .attrib-details {
      border-top: 1px solid #dce3ec;
      margin-top: 2px;
      padding-top: 6px;
    }
    .attrib-details summary {
      cursor: pointer;
      color: #1a2a4a;
      font-weight: 700;
    }
    .attrib-details ol {
      margin: 6px 0 0 18px;
    }
    .attrib-details li {
      margin-bottom: 5px;
    }
    .context-ua-text {
      color: #24344d;
      font-family: Consolas, 'JetBrains Mono', monospace;
      font-size: 0.7rem;
      line-height: 1.35;
      margin-top: 6px;
      overflow-wrap: anywhere;
    }
    .visitor-label-box {
      border-top: 1px solid #dce3ec;
      display: grid;
      gap: 6px;
      margin-top: 2px;
      padding-top: 6px;
    }
    .visitor-label-box input[type="text"],
    .visitor-label-box input[type="email"],
    .visitor-label-box input[type="tel"],
    .visitor-label-box textarea {
      border: 1px solid #cfd8e3;
      border-radius: 6px;
      color: #24344d;
      font: inherit;
      padding: 5px 7px;
      width: 100%;
    }
    .visitor-label-box textarea {
      min-height: 54px;
      resize: vertical;
    }
    .visitor-identity-grid {
      display: grid;
      gap: 5px;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .visitor-identity-grid input {
      min-width: 0;
    }
    .visitor-alert-row {
      align-items: center;
      color: #475569;
      display: flex;
      gap: 6px;
    }
    .visitor-save-btn {
      background: #1a2a4a;
      border: 0;
      border-radius: 6px;
      color: #fff;
      cursor: pointer;
      font-size: 0.72rem;
      font-weight: 700;
      padding: 6px 9px;
      width: fit-content;
    }
    .visitor-save-btn:disabled {
      cursor: wait;
      opacity: 0.6;
    }
    .visitor-save-status {
      color: #64748b;
      font-size: 0.7rem;
    }
    .delete-btn {
      background: transparent;
      border: 1px solid #e74c3c;
      color: #e74c3c;
      border-radius: 6px;
      padding: 4px 10px;
      font-size: 0.78rem;
      cursor: pointer;
      transition: all 0.15s;
      white-space: nowrap;
    }
    .delete-btn:hover { background: #e74c3c; color: #fff; }

    .loading {
      text-align: center;
      padding: 60px;
      color: #888;
      font-size: 1rem;
    }
    .empty {
      text-align: center;
      padding: 60px;
      color: #999;
      font-size: 0.95rem;
    }

    /* ── Visitor activity log (StatCounter per-visit rows) ───── */
    .va-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 12px; margin: 0 0 10px; }
    .va-count { font-size: 0.8rem; font-weight: 600; color: #6a7a8c; }
    .va-legend { font-size: 0.72rem; color: #94a3b8; margin-left: auto; }
    .va-dot-id { display: inline-block; width: 10px; height: 10px; border-radius: 3px; background: #eef4fc; border: 1px solid #cbd8ea; vertical-align: -1px; }

    .va-log {
      display: flex;
      flex-direction: column;
      border: 1px solid #e3e9f0;
      border-radius: 8px;
      overflow: hidden;
      background: #fff;
    }
    .va-row { border-top: 1px solid #e3e9f0; }
    .va-row:first-child { border-top: 0; }
    .va-row.identified { background: #eef4fc; }
    /* "Connected dots" — visitors where multiple signals fuse stand out in gold */
    .va-row.va-connected { background: #fff7e6; box-shadow: inset 4px 0 0 #e0a93a; }
    .va-row.va-fullcircle { background: #fff2cc; box-shadow: inset 4px 0 0 #c9920a; }
    .va-badge-connected, .va-badge-circle {
      display: inline-block; margin-left: 6px; padding: 1px 7px; border-radius: 10px;
      font-size: 0.68rem; font-weight: 700; vertical-align: 1px; white-space: nowrap;
      border: 0; font-family: inherit; cursor: pointer;
    }
    .va-badge-connected { background: #fde8c0; color: #8a5a00; }
    .va-badge-circle { background: #f6cf6b; color: #5c4302; }
    .va-badge-connected:hover, .va-badge-circle:hover { filter: brightness(0.96); }
    .va-quicktag {
      margin-left: 8px; padding: 1px 8px; border: 1px solid #cbd8ea; border-radius: 10px;
      background: #f4f8fd; color: #16335c; font-size: 0.7rem; font-weight: 600;
      cursor: pointer; vertical-align: 1px; white-space: nowrap;
    }
    .va-quicktag:hover { background: #e3eefb; border-color: #9db8dd; }
    .va-pill {
      display: inline-block; margin-left: 6px; padding: 1px 7px; border-radius: 10px;
      font-size: 0.68rem; font-weight: 700; vertical-align: 1px; white-space: nowrap;
    }
    .va-pill-ads { background: #fde8c0; color: #8a5a00; }
    .va-pill-neu { background: #eef2f7; color: #506179; }
    .va-pill-org-g { background: #e3f4e8; color: #1f7a3d; }
    .va-pill-org-b { background: #e2eef7; color: #1d5d86; }

    /* Country flag image (StatCounter look) + raw-code fallback when the flag can't render */
    .va-flag { display: inline-block; width: 20px; height: 15px; vertical-align: -2px; border-radius: 2px; box-shadow: 0 0 0 1px rgba(0,0,0,0.10); }
    .va-cc { color: #6a7a8c; }
    /* "Connected dots" click-popup — appended to <body> so it isn't clipped by .va-log overflow */
    .va-dots-wrap { position: relative; display: inline-block; }
    .va-dots-wrap > .va-dots-pop { display: none; }
    .va-dots-pop {
      position: fixed; z-index: 60;
      min-width: 230px; max-width: 320px; padding: 10px 12px;
      background: #fff; border: 1px solid #e0c489; border-radius: 10px;
      box-shadow: 0 12px 34px rgba(0,0,0,0.2); text-align: left;
      font-weight: 400; white-space: normal;
    }
    .va-pop-head { font-size: 0.72rem; font-weight: 700; color: #8a5a00; margin-bottom: 6px; }
    .va-pop-row { display: flex; align-items: baseline; gap: 7px; font-size: 0.74rem; padding: 2px 0; }
    .va-pop-row.off { color: #9aa7b6; }
    .va-pop-row.on { color: #24344d; }
    .va-pop-mark { width: 12px; flex: none; text-align: center; font-weight: 700; }
    .va-pop-row.on .va-pop-mark { color: #1f7a3d; }
    .va-pop-lbl { font-weight: 600; flex: none; }
    .va-pop-det { color: #6a7a8c; overflow-wrap: anywhere; }

    .va-summary {
      display: flex;
      align-items: flex-start;
      gap: 14px;
      padding: 13px 16px;
      cursor: pointer;
      list-style: none;
    }
    .va-summary::-webkit-details-marker { display: none; }

    /* Blue circular expand button with a white triangle */
    .va-expand {
      flex: none;
      width: 28px;
      height: 28px;
      border-radius: 50%;
      background: #2e6fbf;
      color: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.62rem;
      line-height: 1;
      margin-top: 2px;
      transition: transform 0.15s;
    }
    .va-expand::before { content: '▶'; transform: translateX(1px); }
    .va-row[open] .va-expand { transform: rotate(90deg); }

    .va-main { flex: 1; min-width: 0; }

    /* Identity header line at the top of a row */
    .va-ident { margin-bottom: 6px; }
    .va-name { font-size: 0.95rem; font-weight: 700; color: #16335c; }
    .va-name .va-id { font-family: Consolas, monospace; font-size: 0.74rem; font-weight: 400; color: #94a3b8; }
    .va-company { color: #6a7a8c; font-weight: 600; font-size: 0.84rem; }
    .va-badge-filled {
      margin-left: 8px;
      font-size: 0.64rem;
      font-weight: 700;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      background: #eaf6ee;
      border: 1px solid #b7dfc2;
      color: #0f6e56;
      padding: 2px 7px;
      border-radius: 5px;
      vertical-align: 1px;
    }
    .va-badge-ret {
      margin-left: 6px;
      font-size: 0.64rem;
      font-weight: 700;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      background: #fdf2c9;
      border: 1px solid #e8c204;
      color: #7a5b00;
      padding: 2px 7px;
      border-radius: 5px;
      vertical-align: 1px;
    }

    /* Two-column label:value grid (StatCounter look) */
    .va-cols {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 4px 28px;
    }
    .va-pair {
      display: grid;
      grid-template-columns: 120px minmax(0, 1fr);
      gap: 8px;
      align-items: baseline;
      font-size: 0.78rem;
      line-height: 1.4;
    }
    .va-pair .va-lbl { color: #6a7a8c; }
    .va-pair .va-val { color: #24344d; overflow-wrap: anywhere; }
    .va-val a { text-decoration: none; }
    .va-val .va-isp { color: #c0392b; }
    .va-val .va-link { color: #2e6fbf; }
    .va-val .va-link:hover { text-decoration: underline; }

    .va-when { flex: none; font-size: 0.75rem; color: #6a7a8c; white-space: nowrap; text-align: right; }

    .va-detail {
      padding: 10px 16px 16px 58px;
      display: grid;
      gap: 6px;
      border-top: 1px dashed #e3e9f0;
      background: #fafcff;
    }
    .va-origin {
      border: 1px solid #d9e2ec;
      border-radius: 7px;
      background: #fff;
      padding: 8px 10px;
      font-size: 0.78rem;
      color: #24344d;
    }
    .va-origin strong { color: #16335c; }
    .va-origin-code {
      font-family: Consolas, monospace;
      font-size: 0.72rem;
      color: #6a7a8c;
      overflow-wrap: anywhere;
    }
    .va-timeline {
      border: 1px solid #d9e2ec;
      border-radius: 8px;
      background: #fff;
      overflow: hidden;
    }
    .va-timeline-head {
      padding: 9px 11px;
      font-size: 0.74rem;
      font-weight: 700;
      color: #16335c;
      background: #f4f8fd;
      border-bottom: 1px solid #d9e2ec;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }
    .va-event-list { display: grid; gap: 0; }
    .va-event {
      display: grid;
      grid-template-columns: 76px minmax(0, 1fr);
      gap: 10px;
      padding: 9px 11px;
      border-top: 1px solid #eef2f7;
      font-size: 0.78rem;
    }
    .va-event:first-child { border-top: 0; }
    .va-event-time { color: #6a7a8c; white-space: nowrap; }
    .va-event-main { min-width: 0; }
    .va-event-label { color: #24344d; font-weight: 600; overflow-wrap: anywhere; }
    .va-event-meta { color: #6a7a8c; margin-top: 2px; overflow-wrap: anywhere; }
    .va-event-type {
      display: inline-block;
      margin-right: 6px;
      padding: 1px 6px;
      border-radius: 5px;
      font-size: 0.66rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.03em;
      background: #eef2f7;
      color: #506179;
    }
    .va-event-type-phone_click { background: #fde8c0; color: #8a5a00; }
    .va-event-type-email_click { background: #e2eef7; color: #1d5d86; }
    .va-event-type-form_submit { background: #eaf6ee; color: #0f6e56; }
    .va-timeline-empty {
      padding: 10px 11px;
      color: #6a7a8c;
      font-size: 0.78rem;
    }
  </style>
</head>
<body>

  <!-- ── Login Screen ─────────────────────────────────────── -->
  <div id="login-screen">
    <div class="login-card">
      <h1>🔒 Admin Dashboard</h1>
      <p>Dolphin Centrifuge — Form Submissions</p>
      <input type="password" id="password-input" placeholder="Enter admin password" autocomplete="current-password" />
      <button id="login-btn">Sign In</button>
      <div id="login-error"></div>
      <p id="login-hint" style="margin-top:14px; font-size:0.82rem; color:#94a3b8;">Hint: ekAmrish@</p>
    </div>
  </div>

  <!-- ── Dashboard ────────────────────────────────────────── -->
  <div id="dashboard">

    <!-- Navy left sidebar -->
    <aside class="sc-sidebar">
      <div class="sc-brand">
        <span class="sc-brand-mark">D</span>
        <span class="sc-brand-name">Dolphin</span>
      </div>
      <nav class="sc-nav">
        <button type="button" class="sc-nav-item active" data-view="activity">
          <span class="sc-nav-ico">&#128202;</span>Visitor Activity
        </button>
        <button type="button" class="sc-nav-item" data-view="pages">
          <span class="sc-nav-ico">&#128196;</span>Pages
        </button>
        <button type="button" class="sc-nav-item" data-view="submissions">
          <span class="sc-nav-ico">&#128203;</span>Form Submissions
        </button>
        <button type="button" class="sc-nav-item" data-view="known">
          <span class="sc-nav-ico">&#9733;</span>Known Visitors
        </button>
      </nav>
      <div class="sc-sidebar-foot">
        <button type="button" class="sc-logout-link" id="sidebar-logout">
          <span class="sc-nav-ico">&#9099;</span>Log out
        </button>
      </div>
    </aside>

    <!-- Content area -->
    <div class="sc-content">
      <div class="sc-topbar">
        <div class="sc-topbar-title">Dolphincentrifuge.com</div>
        <div class="sc-topbar-right">
          <span class="sc-admin-tag">Admin</span>
          <button id="logout-btn">Log Out</button>
        </div>
      </div>

      <div class="sc-body">
        <div id="summary-tiles" class="sc-tiles"></div>
        <div class="sc-toolbar">
          <input type="search" id="search-input" placeholder="Search by name, company, email, fluid…" />
          <select id="date-preset" class="sc-select" title="Date range (UTC day boundaries)">
            <option value="all">All time</option>
            <option value="today">Today</option>
            <option value="7d">Last 7 days</option>
            <option value="30d" selected>Last 30 days</option>
            <option value="month">This month</option>
            <option value="custom">Custom…</option>
          </select>
          <input type="date" id="date-start" class="sc-date" style="display:none" title="Start date" />
          <input type="date" id="date-end" class="sc-date" style="display:none" title="End date" />
          <select id="rows-per-page" class="sc-select" title="Rows per page">
            <option value="25">25 / page</option>
            <option value="50" selected>50 / page</option>
            <option value="100">100 / page</option>
            <option value="200">200 / page</option>
          </select>
          <span id="count-badge">Loading…</span>
        </div>

        <!-- Visitor activity / Known visitors share this panel -->
        <section class="sc-panel active" id="panel-activity">
          <h1 class="sc-section-title" id="activity-title">Visitor activity</h1>
          <div id="visitor-directory" class="visitor-directory loading">Loading visitor activity…</div>
          <div id="visitor-pager" class="sc-pager"></div>
        </section>

        <!-- Pages report (Top / Entry / Exit) -->
        <section class="sc-panel" id="panel-pages">
          <h1 class="sc-section-title">Pages</h1>
          <div class="sc-pages-tabs">
            <button type="button" class="sc-pages-tab active" data-ptab="top">Top pages</button>
            <button type="button" class="sc-pages-tab" data-ptab="entry">Entry pages</button>
            <button type="button" class="sc-pages-tab" data-ptab="exit">Exit pages</button>
          </div>
          <div class="table-wrap">
            <div id="pages-container" class="loading">Loading pages…</div>
          </div>
        </section>

        <!-- Form submissions table -->
        <section class="sc-panel" id="panel-submissions">
          <h1 class="sc-section-title">Form submissions</h1>
          <div class="table-wrap">
            <div id="table-container" class="loading">Loading submissions…</div>
          </div>
          <div id="leads-pager" class="sc-pager"></div>
        </section>
      </div>
    </div>
  </div>

  <script define:vars={{ contactWorkerBaseUrl, isDevDashboard }}>
    // ── Config ────────────────────────────────────────────────
    const WORKER_URL = contactWorkerBaseUrl;
    const SESSION_KEY = 'dc_admin_token';

    // ── Elements ──────────────────────────────────────────────
    const loginScreen    = document.getElementById('login-screen');
    const dashboard      = document.getElementById('dashboard');
    const passwordInput  = document.getElementById('password-input');
    const loginBtn       = document.getElementById('login-btn');
    const loginError     = document.getElementById('login-error');
    const searchInput    = document.getElementById('search-input');
    const countBadge     = document.getElementById('count-badge');
    const tableContainer = document.getElementById('table-container');
    const visitorDirectory = document.getElementById('visitor-directory');
    const logoutBtn      = document.getElementById('logout-btn');
    const datePreset     = document.getElementById('date-preset');
    const dateStart      = document.getElementById('date-start');
    const dateEnd        = document.getElementById('date-end');
    const rowsPerPageSel = document.getElementById('rows-per-page');
    const leadsPager     = document.getElementById('leads-pager');
    const visitorPager   = document.getElementById('visitor-pager');
    const summaryTiles   = document.getElementById('summary-tiles');
    const pagesContainer = document.getElementById('pages-container');

    let allData = [];
    let allVisitors = [];
    const visitorEventsCache = new Map();
    const visitorEventsLoading = new Set();
    const initialSearch = new URLSearchParams(window.location.search).get('q') || '';

    // ── Date-range + pagination state ─────────────────────────
    let rowsPerPage = 50;
    let leadsPage = 1;
    let visitorsPage = 1;
    let curStart = null;   // YYYY-MM-DD inclusive, or null = no lower bound
    let curEnd = null;     // YYYY-MM-DD inclusive, or null = no upper bound
    let dataTruncated = false;
    let visitorsTruncated = false;

    function currentToken() { return sessionStorage.getItem(SESSION_KEY); }
    function isoDay(d) { return d.toISOString().slice(0, 10); }

    // Compute {start,end} (UTC, inclusive) for a preset. null = unbounded.
    function computeRange(preset) {
      const now = new Date();
      const end = isoDay(now);
      if (preset === 'all') return { start: null, end: null };
      if (preset === 'today') return { start: end, end };
      if (preset === '7d') { const s = new Date(now); s.setUTCDate(s.getUTCDate() - 6); return { start: isoDay(s), end }; }
      if (preset === '30d') { const s = new Date(now); s.setUTCDate(s.getUTCDate() - 29); return { start: isoDay(s), end }; }
      if (preset === 'month') { const s = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), 1)); return { start: isoDay(s), end }; }
      return { start: null, end: null };
    }

    function rangeQuery() {
      const p = new URLSearchParams();
      if (curStart) p.set('start', curStart);
      if (curEnd) p.set('end', curEnd);
      const qs = p.toString();
      return qs ? ('?' + qs) : '';
    }

    function clampPage(page, total) {
      const pages = Math.max(1, Math.ceil(total / rowsPerPage));
      return Math.min(Math.max(1, page), pages);
    }
    function pageSlice(arr, page) {
      const p = clampPage(page, arr.length);
      return arr.slice((p - 1) * rowsPerPage, p * rowsPerPage);
    }
    function renderPager(el, total, page, kind) {
      if (total <= rowsPerPage) { el.innerHTML = ''; return; }
      const pages = Math.max(1, Math.ceil(total / rowsPerPage));
      const from = total === 0 ? 0 : (page - 1) * rowsPerPage + 1;
      const to = Math.min(total, page * rowsPerPage);
      el.innerHTML =
        `<span class="sc-pg-info">Showing ${from}–${to} of ${total}</span>` +
        `<button type="button" data-pg-kind="${kind}" data-pg-dir="prev" ${page <= 1 ? 'disabled' : ''}>← Prev</button>` +
        `<span class="sc-pg-pages">Page ${page} of ${pages}</span>` +
        `<button type="button" data-pg-kind="${kind}" data-pg-dir="next" ${page >= pages ? 'disabled' : ''}>Next →</button>`;
    }

    // ── Auto-login if session exists ──────────────────────────
    // Local dev only: lets us verify localhost without a real admin secret.
    const localDemoToken = (
      isDevDashboard
      && ['localhost', '127.0.0.1', '::1'].includes(window.location.hostname)
      && new URLSearchParams(window.location.search).get('localDemo') === '1'
    ) ? 'local-demo-token' : '';
    if (localDemoToken) sessionStorage.setItem(SESSION_KEY, localDemoToken);

    // Initialize the default date range (Last 30 days) BEFORE any first load,
    // so the initial fetch is already bounded. (computeRange/syncCustomDateInputs
    // are hoisted function declarations, safe to call here.)
    (function initRange() {
      const r = computeRange(datePreset.value || '30d');
      curStart = r.start; curEnd = r.end;
      syncCustomDateInputs();
    })();

    const savedToken = localDemoToken || sessionStorage.getItem(SESSION_KEY);
    if (savedToken) {
      showDashboard();
      loadSubmissions(savedToken);
    }

    // ── Login ─────────────────────────────────────────────────
    loginBtn.addEventListener('click', attemptLogin);
    passwordInput.addEventListener('keydown', e => { if (e.key === 'Enter') attemptLogin(); });

    async function attemptLogin() {
      const token = passwordInput.value.trim();
      if (!token) { loginError.textContent = 'Please enter your password.'; return; }

      loginBtn.textContent = 'Checking…';
      loginBtn.disabled = true;
      loginError.textContent = '';

      try {
        const resp = await fetch(`${WORKER_URL}/admin/submissions${rangeQuery()}`, {
          headers: { 'Authorization': `Bearer ${token}` }
        });

        if (resp.status === 401) {
          loginError.textContent = 'Incorrect password.';
        } else if (resp.ok) {
          sessionStorage.setItem(SESSION_KEY, token);
          const json = await resp.json();
          allData = json.data || [];
          dataTruncated = !!json.truncated;
          showDashboard();
          applyInitialSearch();
          applySearch();
          loadVisitors(token);
          loadSummary(token);
          loadPages(token);
        } else {
          loginError.textContent = 'Server error. Please try again.';
        }
      } catch (err) {
        loginError.textContent = 'Connection error. Is the worker deployed?';
      }

      loginBtn.textContent = 'Sign In';
      loginBtn.disabled = false;
    }

    // ── Load submissions ───────────────────────────────────────
    async function loadSubmissions(token) {
      try {
        const resp = await fetch(`${WORKER_URL}/admin/submissions${rangeQuery()}`, {
          headers: { 'Authorization': `Bearer ${token}` }
        });
        if (resp.status === 401) { logout(); return; }
        const json = await resp.json();
        allData = json.data || [];
        dataTruncated = !!json.truncated;
        applyInitialSearch();
        applySearch();
        loadVisitors(token);
        loadSummary(token);
        loadPages(token);
      } catch (err) {
        tableContainer.innerHTML = '<div class="empty">Failed to load data. Check your connection.</div>';
        countBadge.textContent = 'Failed to load';
      }
    }

    async function loadVisitors(token) {
      try {
        const resp = await fetch(`${WORKER_URL}/admin/visitors${rangeQuery()}`, {
          headers: { 'Authorization': `Bearer ${token}` }
        });
        if (!resp.ok) throw new Error('Visitor load failed');
        const json = await resp.json();
        allVisitors = json.data || [];
        visitorsTruncated = !!json.truncated;
        applySearch();
      } catch (err) {
        visitorDirectory.innerHTML = '<h2>Known Visitors</h2><div class="attrib-muted">Visitor profiles are not available yet.</div>';
      }
    }

    // ── Summary KPI tiles (server-aggregated over the date range) ──
    function tile(val, label, sub, accent) {
      return `<div class="sc-tile${accent ? ' accent' : ''}">` +
        `<div class="sc-tile-val">${esc(val)}</div>` +
        `<div class="sc-tile-lbl">${esc(label)}</div>` +
        (sub ? `<div class="sc-tile-sub">${esc(sub)}</div>` : '') +
        `</div>`;
    }
    function fmtNum(n) { return Number(n || 0).toLocaleString('en-US'); }
    function renderSummary(s) {
      if (!summaryTiles) return;
      const visitors = Number(s.visitors || 0);
      const leads = Number(s.leads || 0);
      const conv = visitors > 0 ? ((leads / visitors) * 100) : 0;
      const convStr = visitors > 0 ? `${conv.toFixed(conv < 10 ? 1 : 0)}%` : '—';
      summaryTiles.innerHTML =
        tile(fmtNum(s.pageviews), 'Pageviews') +
        tile(fmtNum(visitors), 'Visitors') +
        tile(fmtNum(s.sessions), 'Sessions') +
        tile(fmtNum(leads), 'Form leads', '', true) +
        tile(convStr, 'Lead rate', 'leads ÷ visitors');
    }
    async function loadSummary(token) {
      if (!token) return;
      try {
        const resp = await fetch(`${WORKER_URL}/admin/summary${rangeQuery()}`, {
          headers: { 'Authorization': `Bearer ${token}` }
        });
        if (!resp.ok) { if (summaryTiles) summaryTiles.innerHTML = ''; return; }
        const json = await resp.json();
        if (!json || json.success !== true) { if (summaryTiles) summaryTiles.innerHTML = ''; return; }
        renderSummary(json);
      } catch (err) {
        if (summaryTiles) summaryTiles.innerHTML = '';
      }
    }

    // ── Pages report (Top / Entry / Exit) ──────────────────────
    let pagesData = { top: [], entry: [], exit: [] };
    let pagesTab = 'top';

    function renderPages() {
      if (!pagesContainer) return;
      const rows = (pagesData && pagesData[pagesTab]) || [];
      if (!rows.length) {
        pagesContainer.innerHTML = '<div class="empty">No page activity in this range.</div>';
        return;
      }
      let head, body;
      if (pagesTab === 'top') {
        head = '<th>Page</th><th class="num">Sessions</th><th class="num">Pageviews</th>';
        body = rows.map(r => `<tr><td class="pg-path">${esc(r.page)}</td><td class="num">${fmtNum(r.sessions)}</td><td class="num">${fmtNum(r.pageviews)}</td></tr>`).join('');
      } else if (pagesTab === 'entry') {
        head = '<th>Entry page</th><th class="num">Sessions</th><th class="num">Bounce %</th>';
        body = rows.map(r => {
          const sessions = Number(r.sessions || 0);
          const bounced = Number(r.bounced || 0);
          const pct = sessions > 0 ? Math.round((bounced / sessions) * 100) : 0;
          return `<tr><td class="pg-path">${esc(r.page)}</td><td class="num">${fmtNum(sessions)}</td><td class="num">${pct}%</td></tr>`;
        }).join('');
      } else { // exit
        head = '<th>Exit page</th><th class="num">Sessions</th>';
        body = rows.map(r => `<tr><td class="pg-path">${esc(r.page)}</td><td class="num">${fmtNum(r.sessions)}</td></tr>`).join('');
      }
      const cap = rows.length >= 50 ? '<div class="attrib-muted" style="padding:8px 2px;font-size:0.75rem;">Showing top 50 pages by sessions.</div>' : '';
      pagesContainer.innerHTML = `<table class="sc-pages-table"><thead><tr>${head}</tr></thead><tbody>${body}</tbody></table>${cap}`;
    }

    async function loadPages(token) {
      if (!token) return;
      try {
        const resp = await fetch(`${WORKER_URL}/admin/pages${rangeQuery()}`, {
          headers: { 'Authorization': `Bearer ${token}` }
        });
        if (!resp.ok) { pagesData = { top: [], entry: [], exit: [] }; renderPages(); return; }
        const json = await resp.json();
        pagesData = { top: json.top || [], entry: json.entry || [], exit: json.exit || [] };
        renderPages();
      } catch (err) {
        pagesData = { top: [], entry: [], exit: [] };
        renderPages();
      }
    }

    // Re-fetch both lists for the current date range (used when the range changes).
    function reloadForRange() {
      const token = currentToken();
      if (!token) return;
      leadsPage = 1;
      visitorsPage = 1;
      // Clear stale data so the directory/pages never render the OLD range's
      // data against the NEW range's leads while the fetches are in flight.
      allVisitors = [];
      pagesData = { top: [], entry: [], exit: [] };
      loadSubmissions(token);
    }

    // ── Render table ───────────────────────────────────────────
    function isReturningRecord(record) {
      return Boolean(
        record.is_reconnect
        || Number(record.attribution_is_returning || 0)
        || Number(record.visitor_profile_visit_count || record.attribution_visit_count || 0) > 1
      );
    }

    function renderTable(data) {
      if (data.length === 0) {
        tableContainer.innerHTML = '<div class="empty">No submissions in this range.</div>';
        return;
      }

      const colgroup = `
        <colgroup>
          <col style="width:54px">
          <col style="width:108px">
          <col style="width:116px">
          <col style="width:170px">
          <col style="width:210px">
          <col style="width:230px">
          <col style="width:128px">
          <col style="width:138px">
          <col style="width:150px">
          <col style="width:110px">
          <col style="width:92px">
          <col style="width:155px">
          <col style="width:130px">
          <col style="width:250px">
          <col style="width:430px">
          <col style="width:360px">
          <col style="width:132px">
          <col style="width:96px">
        </colgroup>`;

      const thead = `
        <thead>
          <tr>
            <th>#</th>
            <th>Date</th>
            <th>Type</th>
            <th>Name</th>
            <th>Company</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Country</th>
            <th>Fluid Type</th>
            <th>Capacity</th>
            <th>Solids %</th>
            <th>Condition</th>
            <th>Contact Pref.</th>
            <th>Details</th>
            <th>Google Attribution</th>
            <th>Visitor Context</th>
            <th>Status</th>
            <th>Delete</th>
          </tr>
        </thead>`;

      const tbody = data.map(r => {
        const date = r.created_at ? r.created_at.substring(0, 10) : '—';
        const reconnectBadge = isReturningRecord(r)
          ? `<span class="badge-reconnect">⚡ RETURNING</span>`
          : '';
        const details = r.additional_details
          ? r.additional_details.substring(0, 80) + (r.additional_details.length > 80 ? '…' : '')
          : '—';
        const rowClass = isReturningRecord(r) ? 'reconnect-row' : '';
        // Country flag + foreigner cue: form country is a 2-letter ISO code.
        const cc = String(r.country || '').trim().toUpperCase();
        const ccFlagImg = flagImg(cc);
        const isForeign = /^[A-Z]{2}$/.test(cc) && cc !== 'US';

        return `
          <tr class="${rowClass}" data-id="${r.id}">
            <td>${r.id}</td>
            <td style="white-space:nowrap">${date}</td>
            <td><span class="type-badge">${esc(formTypeLabel(r.form_type))}</span></td>
            <td style="white-space:nowrap">${esc(r.first_name)} ${esc(r.last_name)}</td>
            <td>${esc(r.company)}</td>
            <td><a href="mailto:${esc(r.email)}" style="color:#1a2a4a;">${esc(r.email)}</a></td>
            <td style="white-space:nowrap">${esc(r.phone)}</td>
            <td style="white-space:nowrap;${isForeign ? 'background:#FFE0B2;font-weight:600;' : ''}">${ccFlagImg || esc(r.country || '')}${r.us_state ? ' / ' + esc(r.us_state) : ''}</td>
            <td>${esc(r.fluid_type)}</td>
            <td>${esc(r.capacity)}</td>
            <td>${esc(r.solids_percentage)}</td>
            <td style="white-space:nowrap">${esc(r.centrifuge_condition)}</td>
            <td style="white-space:nowrap">${esc(r.contact_method)}</td>
            <td title="${esc(r.additional_details)}">${esc(details)}</td>
            <td class="attrib-cell">${renderAttribution(r)}</td>
            <td class="visitor-cell">${renderVisitorContext(r)}</td>
            <td>${reconnectBadge}</td>
            <td><button class="delete-btn" data-delete-id="${r.id}">Delete</button></td>
          </tr>`;
      }).join('');

      tableContainer.innerHTML = `<table class="submissions-table">${colgroup}${thead}<tbody>${tbody}</tbody></table>`;
    }

    // ── Search filter ──────────────────────────────────────────
    function visitorProfileSearchText(visitor) {
      return `${visitor.visitor_id || ''} ${visitor.label || ''} ${visitor.contact_name || ''} ${visitor.contact_company || ''} ${visitor.contact_email || ''} ${visitor.contact_phone || ''} ${visitor.identity_source || ''} ${visitor.identity_confidence || ''} ${visitor.notes || ''} ${visitor.visitor_ip || ''} ${visitor.visitor_user_agent || ''} ${visitor.visitor_country || ''} ${visitor.visitor_region || ''} ${visitor.visitor_city || ''} ${visitor.visitor_as_organization || ''} ${visitor.source || ''} ${visitor.medium || ''} ${visitor.campaign || ''} ${visitor.term || ''} ${visitor.first_landing_page || ''} ${visitor.last_page || ''}`;
    }

    function visitorDisplayName(visitor) {
      return visitor.label || visitor.contact_name || visitor.contact_company || visitor.contact_email || '';
    }

    function visitorInitials(name) {
      const parts = String(name || '').trim().split(/\s+/).filter(Boolean);
      if (!parts.length) return '';
      return (parts[0][0] + (parts[1] ? parts[1][0] : '')).toUpperCase();
    }

    function formatWhen(iso) {
      if (!iso) return '';
      const d = new Date(iso);
      if (isNaN(d.getTime())) return esc(String(iso));
      return d.toLocaleString(undefined, { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' });
    }

    function submittedVisitorIdSet() {
      const set = new Set();
      for (const r of allData) {
        if (r.attribution_visitor_id) set.add(r.attribution_visitor_id);
      }
      return set;
    }

    function visitorSourcePill(visitor) {
      const src = String(visitor.source || '').toLowerCase();
      const med = String(visitor.medium || '').toLowerCase();
      const urls = [visitor.first_landing_page, visitor.last_page, visitor.referrer].filter(Boolean).join(' ').toLowerCase();
      const hasPaid = Boolean(visitor.gclid || visitor.gbraid || visitor.wbraid)
        || ['cpc', 'ppc', 'paid'].includes(med)
        || src.includes('googleads')
        || src.includes('gclid')
        || urls.includes('googleads')
        || urls.includes('gclid');

      if (hasPaid) {
        return '<span class="va-pill va-pill-ads">Paid &middot; Google</span>';
      }
      if (med === 'organic' && src.includes('google')) {
        return '<span class="va-pill va-pill-org-g">Organic &middot; Google</span>';
      }
      if (src.includes('bing') || src.includes('msn') || src.includes('yahoo')) {
        return '<span class="va-pill va-pill-org-b">Organic &middot; Bing</span>';
      }
      if (!src || src === 'direct' || src === '(direct)' || src === 'none') {
        return '<span class="va-pill va-pill-neu">Direct</span>';
      }
      const detail = [visitor.source, visitor.medium].filter(Boolean).join('/');
      return `<span class="va-pill va-pill-neu">Other${detail ? ' &middot; ' + esc(detail) : ''}</span>`;
    }

    function qparam(url, names) {
      try {
        const u = new URL(url, 'https://x');
        for (const n of names) {
          const v = u.searchParams.get(n);
          if (v) return decodeURIComponent(v.replace(/\+/g, ' ')).trim();
        }
      } catch (e) {}
      return '';
    }

    function decipherKeyword(visitor) {
      if (visitor.term && visitor.term !== '(not provided)') return visitor.term;
      const urls = [visitor.last_page, visitor.first_landing_page, visitor.referrer].filter(Boolean);
      for (const u of urls) {
        const k = qparam(u, ['vt_keyword', 'utm_term', 'keyword', 'q', 'p']);
        if (k) return k;
      }
      return '';
    }

    function isIdentifiedVisitor(visitor, submitted) {
      return Boolean(
        submitted.has(visitor.visitor_id)
        || visitor.contact_name
        || visitor.contact_email
        || visitor.label
      );
    }

    // Build one StatCounter-style "label: value" pair.
    function vaPair(label, valueHtml) {
      if (!valueHtml) return '';
      return `<div class="va-pair"><span class="va-lbl">${esc(label)}</span><span class="va-val">${valueHtml}</span></div>`;
    }

    function parseEventMeta(raw) {
      if (!raw) return {};
      try {
        const parsed = JSON.parse(raw);
        return parsed && typeof parsed === 'object' ? parsed : {};
      } catch (e) {
        return {};
      }
    }

    function visitorOriginHtml(visitor) {
      const source = [visitor.source, visitor.medium].filter(Boolean).join(' / ');
      const clickId = visitor.gclid || visitor.gbraid || visitor.wbraid || '';
      const clickLabel = visitor.gclid ? 'gclid' : (visitor.gbraid ? 'gbraid' : (visitor.wbraid ? 'wbraid' : ''));
      if (clickId) {
        return `<div class="va-origin"><strong>Origin:</strong> Google Ads <span class="va-origin-code">(${esc(clickLabel)} ${esc(clickId)})</span></div>`;
      }
      if (source) return `<div class="va-origin"><strong>Origin:</strong> ${esc(source)}</div>`;
      return '<div class="va-origin"><strong>Origin:</strong> Direct or unknown</div>';
    }

    function submissionEventsForVisitor(visitorId) {
      if (!visitorId) return [];
      return allData
        .filter(row => row.attribution_visitor_id === visitorId && row.created_at)
        .map(row => ({
          created_at: row.created_at,
          event_type: 'form_submit',
          page_path: row.attribution_current_page || '',
          page_title: formTypeLabel(row.form_type || row.attribution_form_name || 'contact'),
          attribution_json: JSON.stringify({
            target: formTypeLabel(row.form_type || row.attribution_form_name || 'contact'),
            link_text: [row.first_name, row.last_name, row.company].filter(Boolean).join(' ')
          })
        }));
    }

    function eventSortValue(event) {
      const time = new Date(event.created_at || '').getTime();
      return Number.isFinite(time) ? time : 0;
    }

    function renderTimelineEvent(event) {
      const type = String(event.event_type || 'pageview');
      const meta = parseEventMeta(event.attribution_json);
      const safeType = type.replace(/[^a-z0-9_-]/gi, '');
      const when = event.created_at ? formatWhen(event.created_at) : '';
      const path = shortPath(event.page_path || '');
      const title = event.page_title || '';
      const target = meta.target || '';
      let label = '';
      let detail = '';
      if (type === 'phone_click') {
        label = `Clicked to call ${target || 'phone number'}`;
        detail = [meta.link_text, path].filter(Boolean).join(' / ');
      } else if (type === 'email_click') {
        label = `Clicked email ${target || 'email address'}`;
        detail = [meta.link_text, path].filter(Boolean).join(' / ');
      } else if (type === 'form_submit') {
        label = `Submitted ${target || title || 'form'}`;
        detail = [meta.link_text, path].filter(Boolean).join(' / ');
      } else {
        label = `Viewed ${path || title || 'page'}`;
        detail = title && title !== path ? title : '';
      }
      return `
        <div class="va-event">
          <div class="va-event-time">${esc(when)}</div>
          <div class="va-event-main">
            <div class="va-event-label"><span class="va-event-type va-event-type-${esc(safeType)}">${esc(type.replace(/_/g, ' '))}</span>${esc(label)}</div>
            ${detail ? `<div class="va-event-meta">${esc(detail)}</div>` : ''}
          </div>
        </div>`;
    }

    function renderVisitorTimeline(visitorId, events, visitor) {
      const merged = (Array.isArray(events) ? events : [])
        .concat(submissionEventsForVisitor(visitorId))
        .filter(event => event && event.created_at)
        .sort((a, b) => eventSortValue(a) - eventSortValue(b));
      const body = merged.length
        ? `<div class="va-event-list">${merged.map(renderTimelineEvent).join('')}</div>`
        : '<div class="va-timeline-empty">No page, call, email, or form events found for this visitor yet.</div>';
      return `
        ${visitorOriginHtml(visitor || {})}
        <div class="va-timeline">
          <div class="va-timeline-head">Visitor event timeline</div>
          ${body}
        </div>`;
    }

    function renderVisitorTimelineShell(visitor) {
      const visitorId = visitor && visitor.visitor_id ? String(visitor.visitor_id) : '';
      if (!visitorId) return '';
      if (visitorEventsCache.has(visitorId)) {
        return `<div data-visitor-timeline="${esc(visitorId)}">${renderVisitorTimeline(visitorId, visitorEventsCache.get(visitorId), visitor)}</div>`;
      }
      return `
        <div data-visitor-timeline="${esc(visitorId)}">
          ${visitorOriginHtml(visitor)}
          <div class="va-timeline">
            <div class="va-timeline-head">Visitor event timeline</div>
            <div class="va-timeline-empty">Open row to load activity...</div>
          </div>
        </div>`;
    }

    async function loadVisitorTimeline(visitorId) {
      if (!visitorId) return;
      const containers = visitorDirectory.querySelectorAll(`[data-visitor-timeline="${cssEscape(visitorId)}"]`);
      if (!containers.length) return;
      const visitor = allVisitors.find(v => v.visitor_id === visitorId) || {};
      if (visitorEventsCache.has(visitorId)) {
        containers.forEach(el => { el.innerHTML = renderVisitorTimeline(visitorId, visitorEventsCache.get(visitorId), visitor); });
        return;
      }
      if (visitorEventsLoading.has(visitorId)) return;
      const token = currentToken();
      if (!token) return;
      visitorEventsLoading.add(visitorId);
      containers.forEach(el => {
        el.innerHTML = `
          ${visitorOriginHtml(visitor)}
          <div class="va-timeline">
            <div class="va-timeline-head">Visitor event timeline</div>
            <div class="va-timeline-empty">Loading activity...</div>
          </div>`;
      });
      try {
        const resp = await fetch(`${WORKER_URL}/admin/visitors/${encodeURIComponent(visitorId)}/events`, {
          headers: { 'Authorization': `Bearer ${token}` }
        });
        if (resp.status === 401) { logout(); return; }
        if (!resp.ok) throw new Error('Visitor event load failed');
        const json = await resp.json();
        const events = json && json.success === true ? (json.data || []) : [];
        visitorEventsCache.set(visitorId, events);
        containers.forEach(el => { el.innerHTML = renderVisitorTimeline(visitorId, events, visitor); });
      } catch (err) {
        containers.forEach(el => {
          el.innerHTML = `
            ${visitorOriginHtml(visitor)}
            <div class="va-timeline">
              <div class="va-timeline-head">Visitor event timeline</div>
              <div class="va-timeline-empty">Failed to load activity for this visitor.</div>
            </div>`;
        });
      } finally {
        visitorEventsLoading.delete(visitorId);
      }
    }

    // Body-level dots popup state. renderVisitorDirectory closes it before
    // replacing row markup so a popup cannot outlive its source badge.
    let dotsPopupEl = null;
    let dotsPopupAnchor = null;

    function renderVisitorDirectory(visitors) {
      closeDotsPopup();
      const submitted = submittedVisitorIdSet();
      const filteredByView = knownOnly
        ? visitors.filter(v => isIdentifiedVisitor(v, submitted))
        : visitors;
      const total = filteredByView.length;
      visitorsPage = clampPage(visitorsPage, total);
      const shown = pageSlice(filteredByView, visitorsPage);
      const identifiedCount = visitors.filter(v => isIdentifiedVisitor(v, submitted)).length;
      const cap = visitorsTruncated ? ' · showing newest 10k' : '';
      const countLabel = knownOnly
        ? `${total} known visitor${total !== 1 ? 's' : ''}${cap}`
        : `${total} visitor${total !== 1 ? 's' : ''} · ${identifiedCount} identified${cap}`;
      const heading = `
        <div class="va-head">
          <span class="va-count">${countLabel}</span>
          <span class="va-legend"><span class="va-dot-id"></span> identified / filled form · newest first</span>
        </div>`;

      if (shown.length === 0) {
        const emptyMsg = knownOnly
          ? 'No identified visitors yet. Visitors who fill a form — or that you name/label — appear here.'
          : 'No visitors match this filter yet. Tracking went live recently — new visitors appear here as they browse the site.';
        visitorDirectory.innerHTML = `${heading}<div class="attrib-muted" style="padding:14px;">${emptyMsg}</div>`;
        renderPager(visitorPager, total, visitorsPage, 'visitors');
        return;
      }

      visitorDirectory.innerHTML = `${heading}<div class="va-log">${shown.map(visitor => {
        const visitorId = visitor.visitor_id || '';
        const isFiller = submitted.has(visitorId);
        const name = visitorDisplayName(visitor);
        const isIdentified = isIdentifiedVisitor(visitor, submitted);
        const visits = Number(visitor.visit_count || 0);
        const pageviews = Number(visitor.pageview_count || 0);
        const isReturning = visits > 1;

        // "Connected dots" — count how many distinct signal types fuse on this profile.
        const srcL = String(visitor.source || '').toLowerCase();
        const hasIdentity = Boolean(visitor.contact_name || visitor.contact_email || visitor.contact_phone || visitor.label);
        const hasConversion = isFiller;
        const hasPaid = Boolean(visitor.gclid);
        const hasSource = Boolean(visitor.term) || (srcL && srcL !== 'direct' && srcL !== '(direct)' && srcL !== 'none');
        const dots = [hasIdentity, hasConversion, hasPaid, isReturning, hasSource].filter(Boolean).length;
        const fullCircle = hasIdentity && hasConversion && (hasPaid || hasSource);
        const connectClass = fullCircle ? 'va-fullcircle' : (dots >= 3 ? 'va-connected' : (isIdentified ? 'identified' : ''));
        // Per-signal breakdown for the click-popup (which dots are linked + why).
        const sourceDetail = visitor.term
          ? esc(visitor.term)
          : esc([visitor.source, visitor.medium].filter(Boolean).join(' / '));
        const signalRows = [
          { on: hasIdentity, label: 'Identity', detail: esc(visitor.contact_name || visitor.contact_email || visitor.contact_phone || visitor.label || '') },
          { on: hasConversion, label: 'Filled a form', detail: 'Submitted a lead form' },
          { on: hasPaid, label: 'Paid click', detail: 'Google Ads click (gclid)' },
          { on: isReturning, label: 'Returning', detail: '&times;' + visits + ' visits' },
          { on: hasSource, label: 'Traffic source', detail: sourceDetail },
        ];
        const signalsHtml =
          `<div class="va-pop-head">${dots} of 5 signals linked${fullCircle ? ' &middot; 🎯 full circle' : ''}</div>`
          + signalRows.map(s =>
              `<div class="va-pop-row ${s.on ? 'on' : 'off'}"><span class="va-pop-mark">${s.on ? '✓' : '·'}</span><span class="va-pop-lbl">${s.label}</span>${s.on && s.detail ? `<span class="va-pop-det">${s.detail}</span>` : ''}</div>`
            ).join('');
        const connectBadge = (fullCircle || dots >= 3)
          ? `<span class="va-dots-wrap">`
            + `<button type="button" class="${fullCircle ? 'va-badge-circle' : 'va-badge-connected'}" data-dots-toggle title="Click for signal details">${fullCircle ? '🎯 Full circle' : '🔗 ' + dots + ' dots'}</button>`
            + `<span class="va-dots-pop" hidden>${signalsHtml}</span>`
            + `</span>`
          : '';
        const quickTagBtn = visitorId
          ? `<button type="button" class="va-quicktag" data-quick-tag-id="${esc(visitorId)}" title="Quick name / tag this visitor">🏷 ${name ? 'Re-tag' : 'Name'}</button>`
          : '';
        const sourcePill = visitorSourcePill(visitor);

        // Identity header line — compact geo (flag + deduped "City, Region", no country text)
        const geo = locationDisplay(visitor);
        const anonIsp = visitor.visitor_as_organization || '';
        const anonymousNameHtml = (geo.has || anonIsp)
          ? `${geo.flagHtml ? geo.flagHtml + ' ' : ''}${esc(geo.loc)}${anonIsp ? ' <span class="va-company">&middot; ' + esc(anonIsp) + '</span>' : ''}`
          : `Anonymous <span class="va-id">#${esc(String(visitor.visitor_id || '').slice(0, 12))}</span>`;
        const nameHtml = name
          ? `${esc(name)}${(visitor.contact_company && visitor.contact_company !== name) ? ' <span class="va-company">· ' + esc(visitor.contact_company) + '</span>' : ''}`
          : anonymousNameHtml;
        const filledBadge = isFiller ? '<span class="va-badge-filled">Filled Form</span>' : '';
        const retBadge = isReturning ? `<span class="va-badge-ret">Returning ×${visits}</span>` : '';
        const keyword = decipherKeyword(visitor);

        // Column A
        const system = browserSummary(visitor.visitor_user_agent || '');
        // Column B — reuse the compact geo computed for the header line
        const locationHtml = (geo.flagHtml ? geo.flagHtml + ' ' : '') + (geo.loc ? esc(geo.loc) : '');
        const ispParts = [];
        if (visitor.visitor_as_organization) ispParts.push(`<span class="va-isp">${esc(visitor.visitor_as_organization)}</span>`);
        if (visitor.visitor_ip) ispParts.push(`(${esc(visitor.visitor_ip)})`);
        const ispHtml = ispParts.join(' ');
        const sourceText = [visitor.source, visitor.medium].filter(Boolean).join(' / ') || (visitor.referrer ? displayUrl(visitor.referrer) : '');
        const lastPageRaw = visitor.last_page || visitor.first_landing_page || '';
        let lastPageLabel = '';
        // Scheme-guard: last_page / first_landing_page come from the public, unauthenticated
        // /track/pageview beacon (Worker cleanText only trims+truncates — no scheme validation),
        // so a javascript:/data: URL could be stored. Only link it when it parses to http(s);
        // otherwise render the label as plain text so the admin origin can't be a click-XSS sink.
        let lastPageSafe = false;
        if (lastPageRaw) {
          try {
            const u = new URL(lastPageRaw, 'https://x');
            lastPageSafe = u.protocol === 'http:' || u.protocol === 'https:';
            lastPageLabel = u.pathname || displayUrl(lastPageRaw);
          } catch (e) {
            lastPageLabel = displayUrl(lastPageRaw);
          }
        }
        const lastPageHtml = lastPageRaw
          ? (lastPageSafe
              ? `<a class="va-link" href="${esc(lastPageRaw)}" target="_blank" rel="noopener" title="${esc(lastPageRaw)}">${esc(lastPageLabel)} &#8599;</a>`
              : `<span class="va-link-plain" title="${esc(lastPageRaw)}">${esc(lastPageLabel)}</span>`)
          : '';

        // Detail panel (attrib lines + identity controls)
        const network = [visitor.visitor_asn ? 'AS' + visitor.visitor_asn : '', visitor.visitor_as_organization || ''].filter(Boolean).join(' ');

        return `
          <details class="va-row ${connectClass}" data-visitor-id="${esc(visitorId)}">
            <summary class="va-summary">
              <span class="va-expand" aria-hidden="true"></span>
              <div class="va-main">
                <div class="va-ident">
                  <span class="va-name">${nameHtml}</span>${filledBadge}${retBadge}${sourcePill}${connectBadge}${quickTagBtn}
                </div>
                <div class="va-cols">
                  ${vaPair('Page Views:', String(pageviews))}
                  ${vaPair('Location:', locationHtml)}
                  ${vaPair('Last seen:', visitor.last_seen_at ? esc(formatWhen(visitor.last_seen_at)) : '')}
                  ${vaPair('ISP / IP:', ispHtml)}
                  ${vaPair('Visits:', String(visits))}
                  ${vaPair('Source:', sourceText ? esc(sourceText) : '')}
                  ${vaPair('Searched:', keyword ? esc(keyword) : '')}
                  ${vaPair('System:', system ? esc(system) : '')}
                  ${vaPair('Visit Page:', lastPageHtml)}
                </div>
              </div>
              <div class="va-when">${formatWhen(visitor.last_seen_at)}</div>
            </summary>
            <div class="va-detail">
              ${attribLine('Visitor ID', visitorId ? esc(visitorId) : '', 'attrib-path')}
              ${attribLine('Network', network ? esc(network) : '')}
              ${attribLine('First seen', visitor.first_seen_at ? formatWhen(visitor.first_seen_at) : '')}
              ${attribLine('Keyword', visitor.term ? esc(visitor.term) : '')}
              ${attribLine('Last page', visitor.last_page ? esc(visitor.last_page) : '', 'attrib-path')}
              ${visitorId ? renderVisitorTimelineShell(visitor) : ''}
              ${visitorId ? renderVisitorIdentityControls(visitor, visitorId) : ''}
            </div>
          </details>`;
      }).join('')}</div>`;
      renderPager(visitorPager, total, visitorsPage, 'visitors');
    }

    function applyInitialSearch() {
      if (initialSearch && !searchInput.value) searchInput.value = initialSearch;
    }

    function applySearch() {
      const q = searchInput.value.toLowerCase();
      // Leads — date range is already applied server-side; this is the in-range text filter.
      const leadsFiltered = allData.filter(r =>
        `${r.first_name} ${r.last_name} ${r.company} ${r.email} ${r.phone} ${r.fluid_type} ${r.country} ${r.additional_details} ${r.form_type} ${googleAttributionSearchText(r)} ${visitorContextSearchText(r)}`
          .toLowerCase().includes(q)
      );
      leadsPage = clampPage(leadsPage, leadsFiltered.length);
      renderTable(pageSlice(leadsFiltered, leadsPage));
      renderPager(leadsPager, leadsFiltered.length, leadsPage, 'leads');
      const returning = leadsFiltered.filter(isReturningRecord).length;
      countBadge.textContent =
        `${leadsFiltered.length} ${leadsFiltered.length === 1 ? 'entry' : 'entries'} · ${returning} returning${dataTruncated ? ' · showing newest 10k' : ''}`;

      // Visitors — renderVisitorDirectory applies the known-only view + pagination.
      const visitorsFiltered = allVisitors.filter(visitor =>
        visitorProfileSearchText(visitor).toLowerCase().includes(q)
      );
      renderVisitorDirectory(visitorsFiltered);
    }

    searchInput.addEventListener('input', () => { leadsPage = 1; visitorsPage = 1; applySearch(); });

    // ── Date range + rows-per-page + pagination wiring ────────
    function syncCustomDateInputs() {
      const isCustom = datePreset.value === 'custom';
      dateStart.style.display = isCustom ? '' : 'none';
      dateEnd.style.display = isCustom ? '' : 'none';
    }
    datePreset.addEventListener('change', () => {
      if (datePreset.value === 'custom') {
        // Entering custom: start fresh (don't silently reuse stale dates);
        // the range applies once the user picks the dates (applyCustomDates).
        dateStart.value = '';
        dateEnd.value = '';
        syncCustomDateInputs();
        return;
      }
      syncCustomDateInputs();
      const r = computeRange(datePreset.value);
      curStart = r.start; curEnd = r.end;
      reloadForRange();
    });
    function applyCustomDates() {
      if (datePreset.value !== 'custom') return;
      let s = dateStart.value || null;
      let e = dateEnd.value || null;
      // Guard an inverted range — swap so start <= end instead of silently returning nothing.
      if (s && e && s > e) { const t = s; s = e; e = t; dateStart.value = s; dateEnd.value = e; }
      curStart = s;
      curEnd = e;
      reloadForRange();
    }
    dateStart.addEventListener('change', applyCustomDates);
    dateEnd.addEventListener('change', applyCustomDates);

    rowsPerPageSel.addEventListener('change', () => {
      rowsPerPage = Number(rowsPerPageSel.value) || 50;
      leadsPage = 1; visitorsPage = 1;
      applySearch();
    });

    function onPagerClick(e) {
      const btn = e.target.closest('button[data-pg-dir]');
      if (!btn) return;
      const dir = btn.dataset.pgDir === 'next' ? 1 : -1;
      if (btn.dataset.pgKind === 'leads') leadsPage += dir; else visitorsPage += dir;
      applySearch();
    }
    leadsPager.addEventListener('click', onPagerClick);
    visitorPager.addEventListener('click', onPagerClick);

    // ── Delete: event delegation on table container ─────────
    let pendingDeleteId = null;

    function getDeleteModalEls() {
      return {
        deleteModal: document.getElementById('delete-modal'),
        modalConfirm: document.getElementById('modal-confirm'),
        modalCancel: document.getElementById('modal-cancel'),
      };
    }

    tableContainer.addEventListener('click', function(e) {
      const saveVisitorBtn = e.target.closest('[data-save-visitor-id]');
      if (saveVisitorBtn) {
        saveVisitorSettings(saveVisitorBtn);
        return;
      }

      const btn = e.target.closest('[data-delete-id]');
      if (!btn) return;
      pendingDeleteId = Number(btn.dataset.deleteId);
      const { deleteModal } = getDeleteModalEls();
      if (deleteModal) deleteModal.style.display = 'flex';
    });

    visitorDirectory.addEventListener('click', function(e) {
      const quickTagBtn = e.target.closest('[data-quick-tag-id]');
      if (quickTagBtn) {
        e.preventDefault();   // don't toggle the <details> row
        e.stopPropagation();
        quickTagVisitor(quickTagBtn.dataset.quickTagId);
        return;
      }
      const dotsToggle = e.target.closest('[data-dots-toggle]');
      if (dotsToggle) {
        e.preventDefault();   // don't toggle the <details> row
        e.stopPropagation();
        const src = dotsToggle.parentElement.querySelector('.va-dots-pop');
        const reopen = dotsPopupAnchor === dotsToggle;
        closeDotsPopup();
        if (!reopen) openDotsPopup(dotsToggle, src ? src.innerHTML : '');
        return;
      }
      const saveVisitorBtn = e.target.closest('[data-save-visitor-id]');
      if (saveVisitorBtn) saveVisitorSettings(saveVisitorBtn);
    });

    // "Connected dots" popup — a single body-level node (so .va-log's overflow
    // can't clip it), positioned under the badge and closed on any outside click.
    visitorDirectory.addEventListener('toggle', function(e) {
      const row = e.target && e.target.closest ? e.target.closest('details[data-visitor-id]') : null;
      if (!row || !row.open) return;
      loadVisitorTimeline(row.dataset.visitorId);
    }, true);

    visitorDirectory.addEventListener('click', function(e) {
      const summary = e.target.closest('summary');
      if (!summary) return;
      const row = summary.closest('details[data-visitor-id]');
      if (!row) return;
      window.setTimeout(() => {
        if (row.open) loadVisitorTimeline(row.dataset.visitorId);
      }, 0);
    });

    function closeDotsPopup() {
      if (dotsPopupEl) { dotsPopupEl.remove(); dotsPopupEl = null; }
      dotsPopupAnchor = null;
    }
    function openDotsPopup(anchor, html) {
      const el = document.createElement('div');
      el.className = 'va-dots-pop';
      el.innerHTML = html;
      document.body.appendChild(el);
      const r = anchor.getBoundingClientRect();
      const maxLeft = window.innerWidth - el.offsetWidth - 10;
      el.style.top = (r.bottom + 6) + 'px';
      el.style.left = Math.max(10, Math.min(r.left, maxLeft)) + 'px';
      dotsPopupEl = el;
      dotsPopupAnchor = anchor;
    }
    document.addEventListener('click', function(e) {
      if (e.target.closest('[data-dots-toggle]') || e.target.closest('.va-dots-pop')) return;
      closeDotsPopup();
    });
    window.addEventListener('scroll', closeDotsPopup, true);
    window.addEventListener('resize', closeDotsPopup);

    async function saveVisitorSettings(button) {
      const visitorId = button.dataset.saveVisitorId;
      if (!visitorId) return;
      const token = sessionStorage.getItem(SESSION_KEY);
      const labelInput = dashboard.querySelector(`[data-visitor-label="${cssEscape(visitorId)}"]`);
      const contactNameInput = dashboard.querySelector(`[data-visitor-contact-name="${cssEscape(visitorId)}"]`);
      const contactCompanyInput = dashboard.querySelector(`[data-visitor-contact-company="${cssEscape(visitorId)}"]`);
      const contactEmailInput = dashboard.querySelector(`[data-visitor-contact-email="${cssEscape(visitorId)}"]`);
      const contactPhoneInput = dashboard.querySelector(`[data-visitor-contact-phone="${cssEscape(visitorId)}"]`);
      const notesInput = dashboard.querySelector(`[data-visitor-notes="${cssEscape(visitorId)}"]`);
      const alertInput = dashboard.querySelector(`[data-visitor-alert="${cssEscape(visitorId)}"]`);
      const emailInput = dashboard.querySelector(`[data-visitor-email="${cssEscape(visitorId)}"]`);
      const statusEl = dashboard.querySelector(`[data-visitor-status="${cssEscape(visitorId)}"]`);
      const payload = {
        label: labelInput ? labelInput.value.trim() : '',
        contact_name: contactNameInput ? contactNameInput.value.trim() : '',
        contact_company: contactCompanyInput ? contactCompanyInput.value.trim() : '',
        contact_email: contactEmailInput ? contactEmailInput.value.trim() : '',
        contact_phone: contactPhoneInput ? contactPhoneInput.value.trim() : '',
        identity_source: 'manual',
        identity_confidence: 'manual-confirmed',
        notes: notesInput ? notesInput.value.trim() : '',
        alert_enabled: alertInput ? alertInput.checked : false,
        alert_email: emailInput ? emailInput.value.trim() : 'sales@dolphincentrifuge.com',
      };

      button.disabled = true;
      if (statusEl) statusEl.textContent = 'Saving...';

      try {
        const resp = await fetch(`${WORKER_URL}/admin/visitors/${encodeURIComponent(visitorId)}`, {
          method: 'POST',
          headers: {
            'Authorization': `Bearer ${token}`,
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(payload),
        });
        if (!resp.ok) throw new Error('Save failed');

        allData = allData.map(row => {
          if (row.attribution_visitor_id !== visitorId) return row;
          return {
            ...row,
            visitor_label: payload.label,
            visitor_contact_name: payload.contact_name,
            visitor_contact_company: payload.contact_company,
            visitor_contact_email: payload.contact_email,
            visitor_contact_phone: payload.contact_phone,
            visitor_identity_source: payload.identity_source,
            visitor_identity_confidence: payload.identity_confidence,
            visitor_notes: payload.notes,
            visitor_alert_enabled: payload.alert_enabled ? 1 : 0,
            visitor_alert_email: payload.alert_email,
          };
        });
        allVisitors = allVisitors.map(visitor => {
          if (visitor.visitor_id !== visitorId) return visitor;
          return {
            ...visitor,
            label: payload.label,
            contact_name: payload.contact_name,
            contact_company: payload.contact_company,
            contact_email: payload.contact_email,
            contact_phone: payload.contact_phone,
            identity_source: payload.identity_source,
            identity_confidence: payload.identity_confidence,
            notes: payload.notes,
            alert_enabled: payload.alert_enabled ? 1 : 0,
            alert_email: payload.alert_email,
          };
        });
        applySearch();
      } catch (err) {
        if (statusEl) statusEl.textContent = 'Save failed';
        button.disabled = false;
      }
    }

    // Quick name/tag straight from a visitor row (StatCounter-style), reusing the
    // same /admin/visitors save endpoint. Merges with existing fields so a fast
    // tag never wipes previously-saved contact details.
    async function quickTagVisitor(visitorId) {
      if (!visitorId) return;
      const existing = allVisitors.find(v => v.visitor_id === visitorId) || {};
      const current = existing.label || existing.contact_name || '';
      const entered = window.prompt('Quick name / tag for this visitor (phone match, form, your read, IP — your call):', current);
      if (entered === null) return; // cancelled
      const tag = entered.trim();
      const token = sessionStorage.getItem(SESSION_KEY);
      const payload = {
        label: tag,
        contact_name: existing.contact_name || '',
        contact_company: existing.contact_company || '',
        contact_email: existing.contact_email || '',
        contact_phone: existing.contact_phone || '',
        identity_source: 'manual',
        identity_confidence: 'manual-quick',
        notes: existing.notes || '',
        alert_enabled: existing.alert_enabled ? true : false,
        alert_email: existing.alert_email || 'sales@dolphincentrifuge.com',
      };
      try {
        const resp = await fetch(`${WORKER_URL}/admin/visitors/${encodeURIComponent(visitorId)}`, {
          method: 'POST',
          headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        if (!resp.ok) throw new Error('Save failed');
        allVisitors = allVisitors.map(v => v.visitor_id === visitorId
          ? { ...v, label: tag, identity_source: 'manual', identity_confidence: 'manual-quick' } : v);
        allData = allData.map(row => row.attribution_visitor_id === visitorId
          ? { ...row, visitor_label: tag, visitor_identity_source: 'manual' } : row);
        applySearch();
      } catch (err) {
        alert('Could not save the tag. Please try again.');
      }
    }

    document.addEventListener('DOMContentLoaded', function() {
      const { deleteModal, modalConfirm, modalCancel } = getDeleteModalEls();
      if (!deleteModal || !modalConfirm || !modalCancel) return;

      modalCancel.addEventListener('click', function() {
      deleteModal.style.display = 'none';
      pendingDeleteId = null;
    });

    modalConfirm.addEventListener('click', async function() {
      if (!pendingDeleteId) return;
      const id    = pendingDeleteId;
      const token = sessionStorage.getItem(SESSION_KEY);
      deleteModal.style.display = 'none';
      pendingDeleteId = null;

      modalConfirm.textContent = 'Deleting…';
      modalConfirm.disabled = true;

      try {
        const resp = await fetch(`${WORKER_URL}/admin/submissions/${id}`, {
          method: 'DELETE',
          headers: { 'Authorization': `Bearer ${token}` }
        });
        if (resp.ok) {
          allData = allData.filter(r => r.id !== id);
          applySearch();   // re-filter + re-paginate + refresh badge/pager
        } else {
          alert('Delete failed — server returned an error.');
        }
      } catch (err) {
        alert('Connection error. Please try again.');
      } finally {
        modalConfirm.textContent = 'Yes, Delete';
        modalConfirm.disabled = false;
      }
    });

    // Close modal on backdrop click
    deleteModal.addEventListener('click', function(e) {
      if (e.target === deleteModal) {
        deleteModal.style.display = 'none';
        pendingDeleteId = null;
      }
    });

    // ── Helpers ────────────────────────────────────────────────
