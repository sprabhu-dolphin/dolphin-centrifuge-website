    // ── Sidebar navigation (StatCounter-style view switching) ──
    // "Known Visitors" reuses the activity panel but pre-filters to
    // identified visitors (form-fillers or named/labeled profiles).
    let knownOnly = false;
    const navItems = Array.from(document.querySelectorAll('.sc-nav-item'));
    const panelActivity = document.getElementById('panel-activity');
    const panelSubmissions = document.getElementById('panel-submissions');
    const panelPages = document.getElementById('panel-pages');
    const activityTitle = document.getElementById('activity-title');

    function setView(view) {
      navItems.forEach(btn => btn.classList.toggle('active', btn.dataset.view === view));
      const showActivity = (view === 'activity' || view === 'known');
      panelActivity.classList.toggle('active', showActivity);
      panelSubmissions.classList.toggle('active', view === 'submissions');
      if (panelPages) panelPages.classList.toggle('active', view === 'pages');
      knownOnly = (view === 'known');
      if (activityTitle) {
        activityTitle.textContent = knownOnly ? 'Known visitors' : 'Visitor activity';
      }
      visitorsPage = 1;
      if (showActivity) applySearch();
    }

    navItems.forEach(btn => {
      btn.addEventListener('click', () => setView(btn.dataset.view));
    });

    // Pages report tab switching (Top / Entry / Exit) — re-renders from cached data.
    document.querySelectorAll('.sc-pages-tab').forEach(btn => {
      btn.addEventListener('click', () => {
        pagesTab = btn.dataset.ptab;
        document.querySelectorAll('.sc-pages-tab').forEach(b => b.classList.toggle('active', b === btn));
        renderPages();
      });
    });

    function formTypeLabel(value) {
      const type = String(value || 'contact');
      if (type === 'parts_request_form') return 'Parts RFQ';
      if (type === 'disc_parts_glossary_form') return 'Parts RFQ';
      if (type === 'centrifuge_contact_form') return 'Contact';
      if (type === 'contact') return 'Contact';
      return type.replace(/_/g, ' ');
    }

    function shortPath(value) {
      if (!value) return '';
      try {
        const url = new URL(String(value), window.location.origin);
        return `${url.pathname}${url.search}`;
      } catch (e) {
        return String(value);
      }
    }

    function displayUrl(value) {
      if (!value) return '';
      try {
        const url = new URL(String(value), window.location.origin);
        if (url.origin === window.location.origin) return `${url.pathname}${url.search}`;
        return `${url.hostname}${url.pathname}${url.search}`;
      } catch (e) {
        return String(value);
      }
    }

    function parsePages(record) {
      const raw = record && record.attribution_pages_json;
      if (!raw) return [];
      try {
        const pages = JSON.parse(raw);
        if (!Array.isArray(pages)) return [];
        return pages.filter(page => page && (page.path || page.title)).slice(-8);
      } catch (e) {
        return [];
      }
    }

    function isGoogleAttribution(record) {
      const source = String(record.attribution_source || '').toLowerCase();
      return source === 'google'
        || source.includes('google.')
        || Boolean(record.attribution_gclid || record.attribution_gbraid || record.attribution_wbraid);
    }

    function googleAttributionSearchText(record) {
      if (!isGoogleAttribution(record)) return '';
      return `${record.attribution_source} ${record.attribution_medium} ${record.attribution_campaign} ${record.attribution_term} ${record.attribution_landing_page} ${record.attribution_current_page} ${record.attribution_gclid} ${record.attribution_gbraid} ${record.attribution_wbraid} ${record.attribution_ga_client_id} ${record.attribution_statcounter_visitor_id}`;
    }

    function visitorContextSearchText(record) {
      const pages = parsePages(record).map(page => `${page.path || ''} ${page.title || ''} ${page.referrer || ''}`).join(' ');
      return `${record.attribution_visitor_id || ''} ${record.visitor_label || ''} ${record.visitor_contact_name || ''} ${record.visitor_contact_company || ''} ${record.visitor_contact_email || ''} ${record.visitor_contact_phone || ''} ${record.visitor_identity_source || ''} ${record.visitor_identity_confidence || ''} ${record.visitor_notes || ''} ${record.visitor_ip || ''} ${record.visitor_user_agent || ''} ${record.visitor_accept_language || ''} ${record.visitor_country || ''} ${record.visitor_region || ''} ${record.visitor_city || ''} ${record.visitor_timezone || ''} ${record.visitor_asn || ''} ${record.visitor_as_organization || ''} ${record.visitor_cf_ray || ''} ${record.attribution_referrer || ''} ${record.attribution_landing_page || ''} ${record.attribution_current_page || ''} ${pages}`;
    }

    function attribLine(label, value, className) {
      if (!value) return '';
      const valueClass = className ? `attrib-value ${className}` : 'attrib-value';
      return `
        <div class="attrib-line">
          <span class="attrib-label">${esc(label)}</span>
          <span class="${valueClass}">${value}</span>
        </div>`;
    }

    function cssEscape(value) {
      if (window.CSS && typeof window.CSS.escape === 'function') return window.CSS.escape(String(value));
      return String(value).replace(/["\\]/g, '\\$&');
    }

    // Real flag image. Windows can't render flag emoji, so use flagcdn.com
    // PNGs by ISO-3166-1 alpha-2 code. Returns '' on a bad code.
    function flagImg(cc) {
      const code = String(cc || '').trim().toLowerCase();
      if (!/^[a-z]{2}$/.test(code)) return '';
      const u = code.toUpperCase();
      return `<img class="va-flag" src="https://flagcdn.com/20x15/${code}.png" srcset="https://flagcdn.com/40x30/${code}.png 2x" width="20" height="15" loading="lazy" alt="${esc(u)}" title="${esc(u)}">`;
    }

    // Compact location for the visitor log: dedupes a repeated city/region
    // (e.g. "Ho Chi Minh City, Ho Chi Minh City"), drops the country text (the
    // flag conveys it), and exposes the flag with the ISO code as a tooltip.
    // Returns { flagHtml, loc, has } — loc is "City, Region" with no country.
    function locationDisplay(visitor) {
      const code = String(visitor.visitor_country || '').trim().toUpperCase();
      const city = String(visitor.visitor_city || '').trim();
      const region = String(visitor.visitor_region || '').trim();
      const parts = [];
      if (city) parts.push(city);
      if (region && region.toLowerCase() !== city.toLowerCase()) parts.push(region);
      const img = flagImg(code);
      const flagHtml = img || (code ? `<span class="va-cc">${esc(code)}</span>` : '');
      const loc = parts.join(', ');
      return { flagHtml, loc, has: Boolean(loc || flagHtml) };
    }

    function browserSummary(userAgent) {
      const ua = String(userAgent || '');
      let browser = 'Browser details';
      if (ua.includes('Edg/')) browser = 'Edge';
      else if (ua.includes('Chrome/')) browser = 'Chrome';
      else if (ua.includes('Firefox/')) browser = 'Firefox';
      else if (ua.includes('Safari/') && !ua.includes('Chrome/')) browser = 'Safari';

      let device = '';
      if (ua.includes('Windows')) device = 'Windows';
      else if (ua.includes('Macintosh')) device = 'macOS';
      else if (ua.includes('iPhone')) device = 'iPhone';
      else if (ua.includes('iPad')) device = 'iPad';
      else if (ua.includes('Android')) device = 'Android';
      else if (ua.includes('Linux')) device = 'Linux';

      return device ? `${browser} on ${device}` : browser;
    }

    function renderVisitorIdentityControls(record, visitorId) {
      const labelValue = record.visitor_label || record.label || '';
      const contactNameValue = record.visitor_contact_name || record.contact_name || '';
      const contactCompanyValue = record.visitor_contact_company || record.contact_company || '';
      const contactEmailValue = record.visitor_contact_email || record.contact_email || '';
      const contactPhoneValue = record.visitor_contact_phone || record.contact_phone || '';
      const notesValue = record.visitor_notes || record.notes || '';
      const alertEnabled = Number(record.visitor_alert_enabled || record.alert_enabled || 0);
      const alertEmail = record.visitor_alert_email || record.alert_email || 'sales@dolphincentrifuge.com';

      return `
        <div class="visitor-label-box" data-visitor-box="${esc(visitorId)}">
          ${attribLine('Label', labelValue ? esc(labelValue) : '<span class="attrib-muted">Unlabeled</span>')}
          <input type="text" data-visitor-label="${esc(visitorId)}" value="${esc(labelValue)}" placeholder="Name this visitor" />
          <div class="visitor-identity-grid">
            <input type="text" data-visitor-contact-name="${esc(visitorId)}" value="${esc(contactNameValue)}" placeholder="Contact name" />
            <input type="text" data-visitor-contact-company="${esc(visitorId)}" value="${esc(contactCompanyValue)}" placeholder="Company" />
            <input type="email" data-visitor-contact-email="${esc(visitorId)}" value="${esc(contactEmailValue)}" placeholder="Email" />
            <input type="tel" data-visitor-contact-phone="${esc(visitorId)}" value="${esc(contactPhoneValue)}" placeholder="Phone or caller ID" />
          </div>
          <textarea data-visitor-notes="${esc(visitorId)}" placeholder="Notes, e.g. John called at 2:10 PM from Massachusetts">${esc(notesValue)}</textarea>
          <label class="visitor-alert-row">
            <input type="checkbox" data-visitor-alert="${esc(visitorId)}" ${alertEnabled ? 'checked' : ''} />
            <span>Email me when this visitor returns</span>
          </label>
          <input type="email" data-visitor-email="${esc(visitorId)}" value="${esc(alertEmail)}" placeholder="sales@dolphincentrifuge.com" />
          <button class="visitor-save-btn" data-save-visitor-id="${esc(visitorId)}">Save Visitor</button>
          <span class="visitor-save-status" data-visitor-status="${esc(visitorId)}"></span>
        </div>
      `;
    }

    function renderVisitorContext(record) {
      // Dedupe a repeated city/region (e.g. "Ho Chi Minh City, Ho Chi Minh City");
      // keep the country here since this plain-text drill-down has no flag.
      const locCity = String(record.visitor_city || '').trim();
      const locRegion = String(record.visitor_region || '').trim();
      const location = [
        locCity,
        (locRegion && locRegion.toLowerCase() !== locCity.toLowerCase()) ? locRegion : '',
        String(record.visitor_country || '').trim(),
      ].filter(Boolean).join(', ');
      const network = [
        record.visitor_asn ? `AS${record.visitor_asn}` : '',
        record.visitor_as_organization || '',
      ].filter(Boolean).join(' ');
      const pages = parsePages(record);
      const pageCount = Number(record.attribution_page_count || pages.length || 0);
      const referrer = displayUrl(record.attribution_referrer || '');
      const landing = displayUrl(record.attribution_landing_page || '');
      const userAgent = record.visitor_user_agent || '';
      const cookieVisitorId = record.attribution_visitor_id || '';
      const visitCount = Number(record.visitor_profile_visit_count || record.attribution_visit_count || 0);
      const isReturning = Number(record.attribution_is_returning || 0) || visitCount > 1;
      const lastSeen = record.visitor_profile_last_seen_at || record.attribution_visitor_last_seen_at || '';
      const labelValue = record.visitor_label || '';
      const contactNameValue = record.visitor_contact_name || '';
      const contactCompanyValue = record.visitor_contact_company || '';
      const contactEmailValue = record.visitor_contact_email || '';
      const contactPhoneValue = record.visitor_contact_phone || '';
      const identitySourceValue = record.visitor_identity_source || '';
      const identityConfidenceValue = record.visitor_identity_confidence || '';
      const notesValue = record.visitor_notes || '';
      const alertEnabled = Number(record.visitor_alert_enabled || 0);
      const alertEmail = record.visitor_alert_email || 'sales@dolphincentrifuge.com';
      const hasContext = record.visitor_ip
        || userAgent
        || location
        || network
        || cookieVisitorId
        || contactNameValue
        || contactCompanyValue
        || contactEmailValue
        || contactPhoneValue
        || notesValue
        || record.visitor_accept_language
        || record.visitor_cf_ray
        || referrer
        || landing
        || pages.length;

      if (!hasContext) {
        return '<span class="attrib-muted">Not captured yet</span>';
      }

      const browserDetails = userAgent
        ? `<details class="attrib-details"><summary>${esc(browserSummary(userAgent))}</summary><div class="context-ua-text">${esc(userAgent)}</div></details>`
        : '';
      const trailLabel = pageCount > pages.length
        ? `${pages.length} shown of ${pageCount} pages`
        : `${pages.length} page${pages.length === 1 ? '' : 's'}`;
      const trail = pages.length
        ? `<details class="attrib-details"><summary>Visit trail: ${esc(trailLabel)}</summary><ol>${pages.map(page => `<li><span class="attrib-path">${esc(displayUrl(page.path || ''))}</span>${page.title ? `<br><span class="attrib-muted">${esc(page.title)}</span>` : ''}</li>`).join('')}</ol></details>`
        : '';
      const labelControls = cookieVisitorId ? renderVisitorIdentityControls(record, cookieVisitorId) : '';

      return `
        <div class="attrib-panel">
          <div class="attrib-source">Visitor context</div>
          ${attribLine('Cookie ID', cookieVisitorId ? esc(cookieVisitorId) : '', 'attrib-path')}
          ${attribLine('Contact', contactNameValue ? esc(contactNameValue) : '')}
          ${attribLine('Company', contactCompanyValue ? esc(contactCompanyValue) : '')}
          ${attribLine('Phone', contactPhoneValue ? esc(contactPhoneValue) : '')}
          ${attribLine('Email', contactEmailValue ? esc(contactEmailValue) : '')}
          ${attribLine('Identity', identitySourceValue || identityConfidenceValue ? esc([identitySourceValue, identityConfidenceValue].filter(Boolean).join(' / ')) : '')}
          ${attribLine('Notes', notesValue ? esc(notesValue) : '')}
          ${attribLine('Visit #', visitCount ? esc(String(visitCount)) : '')}
          ${attribLine('Last seen', lastSeen ? esc(lastSeen) : '')}
          ${attribLine('Returning', isReturning ? 'Yes' : '')}
          ${attribLine('IP', record.visitor_ip ? esc(record.visitor_ip) : '')}
          ${attribLine('Location', location ? esc(location) : '')}
          ${attribLine('Referrer', referrer ? esc(referrer) : '', 'attrib-path')}
          ${attribLine('Landing', landing ? esc(landing) : '', 'attrib-path')}
          ${attribLine('Language', record.visitor_accept_language ? esc(record.visitor_accept_language) : '')}
          ${attribLine('Network', network ? esc(network) : '')}
          ${attribLine('CF-Ray', record.visitor_cf_ray ? esc(record.visitor_cf_ray) : '')}
          ${browserDetails}
          ${trail}
          ${labelControls}
        </div>
      `;
    }

    function renderAttribution(record) {
      const source = record.attribution_source || '';
      const medium = record.attribution_medium || '';
      const isGoogle = isGoogleAttribution(record);
      const landing = shortPath(record.attribution_landing_page || '');
      const current = shortPath(record.attribution_current_page || '');
      const campaign = record.attribution_campaign || '';
      const term = record.attribution_term || '';
      const pages = parsePages(record);
      const pageCount = Number(record.attribution_page_count || pages.length || 0);
      const clickIds = [
        record.attribution_gclid ? 'gclid' : '',
        record.attribution_gbraid ? 'gbraid' : '',
        record.attribution_wbraid ? 'wbraid' : '',
      ].filter(Boolean);

      if (!source && !landing && !current && pages.length === 0) {
        return '<span class="attrib-muted">Not captured yet</span>';
      }

      if (!isGoogle) {
        return `
          <div class="attrib-panel">
            <div class="attrib-source">Non-Google traffic</div>
            <div class="attrib-line">
              <span class="attrib-label">Report</span>
              <span class="attrib-value attrib-muted">Not included in Google report</span>
            </div>
          </div>
        `;
      }

      const sourceLabel = `Google${medium ? ' / ' + medium : ''}`;
      const trailLabel = pageCount > pages.length
        ? `${pages.length} shown of ${pageCount} pages`
        : `${pages.length} page${pages.length === 1 ? '' : 's'}`;
      const trail = pages.length
        ? `<details class="attrib-details"><summary>${esc(trailLabel)}</summary><ol>${pages.map(page => `<li><span class="attrib-path">${esc(shortPath(page.path || ''))}</span>${page.title ? `<br><span class="attrib-muted">${esc(page.title)}</span>` : ''}</li>`).join('')}</ol></details>`
        : '';

      return `
        <div class="attrib-panel">
          <div class="attrib-source">${esc(sourceLabel)}</div>
          ${attribLine('Campaign', campaign ? esc(campaign) : '')}
          ${attribLine('Keyword', term ? esc(term) : '')}
          ${attribLine('Landing', landing ? esc(landing) : '', 'attrib-path')}
          ${attribLine('Form page', current ? esc(current) : '', 'attrib-path')}
          ${attribLine('Ad IDs', clickIds.length ? esc(clickIds.join(', ')) : '')}
          ${attribLine('GA client', record.attribution_ga_client_id ? esc(record.attribution_ga_client_id) : '')}
          ${attribLine('StatCounter', record.attribution_statcounter_visitor_id ? esc(record.attribution_statcounter_visitor_id) : '')}
          ${trail}
        </div>
      `;
    }

    function esc(str) {
      if (!str) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }
  </script>

  <!-- ── Delete Confirmation Modal ──────────────────────────── -->
  <div id="delete-modal" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.55); z-index:200; align-items:center; justify-content:center;">
    <div style="background:#fff; border-radius:14px; padding:36px 40px; max-width:420px; width:90%; box-shadow:0 20px 60px rgba(0,0,0,0.35); text-align:center;">
      <div style="width:52px; height:52px; background:#fee2e2; border-radius:50%; display:flex; align-items:center; justify-content:center; margin:0 auto 16px;">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#e74c3c" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4h6v2"/>
        </svg>
      </div>
      <h3 style="font-family:Inter,Arial,sans-serif; font-size:1.1rem; font-weight:700; color:#1a2a4a; margin:0 0 8px;">Remove Submission?</h3>
      <p style="font-family:Inter,Arial,sans-serif; font-size:0.88rem; color:#666; margin:0 0 24px; line-height:1.5;">This record will be permanently removed from your dashboard. This cannot be undone.</p>
      <div style="display:flex; gap:12px; justify-content:center;">
        <button id="modal-cancel" style="flex:1; padding:10px; border:2px solid #ddd; background:#fff; border-radius:8px; font-size:0.9rem; font-weight:600; cursor:pointer; color:#555; transition:all 0.15s;">Cancel</button>
        <button id="modal-confirm" style="flex:1; padding:10px; border:none; background:#e74c3c; border-radius:8px; font-size:0.9rem; font-weight:600; cursor:pointer; color:#fff; transition:background 0.15s;">Yes, Delete</button>
      </div>
    </div>
  </div>

</body>
</html>
