---
// Admin Dashboard — Dolphin Centrifuge Submissions
// NO-INDEX: This page is hidden from search engines
// Password protected via sessionStorage + Worker Bearer token
const contactWorkerBaseUrl = (import.meta.env.PUBLIC_CONTACT_WORKER_URL || (
  import.meta.env.DEV
    ? 'http://127.0.0.1:8787'
    : 'https://dolphin-contact-form.dolphin-centrifuge.workers.dev'
)).replace(/\/$/, '');
const isDevDashboard = import.meta.env.DEV;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Submissions Dashboard — Dolphin Centrifuge</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <style is:global>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'Inter', Arial, sans-serif;
      background: #eef3f8;
      color: #1a2a4a;
      min-height: 100vh;
    }

    /* ── Login Screen ───────────────────────────────────────── */
    #login-screen {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      background: #1a2a4a;
    }
    .login-card {
      background: #fff;
      border-radius: 16px;
      padding: 40px 48px;
      width: 100%;
      max-width: 400px;
      box-shadow: 0 20px 60px rgba(0,0,0,0.3);
      text-align: center;
    }
    .login-card h1 {
      font-size: 1.4rem;
      color: #1a2a4a;
      margin-bottom: 6px;
    }
    .login-card p {
      font-size: 0.85rem;
      color: #666;
      margin-bottom: 28px;
    }
    .login-card input {
      width: 100%;
      border: 2px solid #ddd;
      border-radius: 10px;
      padding: 12px 16px;
      font-size: 1rem;
      outline: none;
      transition: border-color 0.2s;
      margin-bottom: 14px;
    }
    .login-card input:focus { border-color: #1a2a4a; }
    .login-card button {
      width: 100%;
      background: #1a2a4a;
      color: #fff;
      border: none;
      border-radius: 10px;
      padding: 13px;
      font-size: 1rem;
      font-weight: 600;
      cursor: pointer;
      transition: background 0.2s;
    }
    .login-card button:hover { background: #e8c204; color: #1a2a4a; }
    #login-error {
      color: #c0392b;
      font-size: 0.85rem;
      margin-top: 10px;
      min-height: 20px;
    }

    /* ── Dashboard (StatCounter-style shell) ─────────────────── */
    #dashboard { display: none; }
    #dashboard.is-active { display: flex; min-height: 100vh; }

    /* Sidebar */
    .sc-sidebar {
      flex: none;
      width: 212px;
      background: #16335c;
      color: #aebfd6;
      display: flex;
      flex-direction: column;
      position: sticky;
      top: 0;
      align-self: flex-start;
      height: 100vh;
    }
    .sc-brand {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 18px 16px;
      border-bottom: 1px solid rgba(255,255,255,0.08);
    }
    .sc-brand-mark {
      width: 30px;
      height: 30px;
      border-radius: 50%;
      background: #4a90d9;
      color: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.95rem;
      font-weight: 700;
      flex: none;
    }
    .sc-brand-name {
      color: #f2f6fc;
      font-size: 1.05rem;
      font-weight: 700;
      letter-spacing: 0.01em;
    }
    .sc-nav {
      display: flex;
      flex-direction: column;
      padding: 10px 0;
      flex: 1;
    }
    .sc-nav-item {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 12px 16px;
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: #aebfd6;
      background: transparent;
      border: 0;
      border-left: 3px solid transparent;
      text-align: left;
      cursor: pointer;
      transition: background 0.15s, color 0.15s;
      width: 100%;
      font-family: inherit;
    }
    .sc-nav-item .sc-nav-ico {
      flex: none;
      width: 16px;
      height: 16px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      opacity: 0.85;
    }
    .sc-nav-item:hover { background: #1f4575; color: #fff; }
    .sc-nav-item.active {
      background: #1f4575;
      color: #fff;
      border-left-color: #4a90d9;
    }
    .sc-nav-item.active .sc-nav-ico { opacity: 1; }
    .sc-sidebar-foot {
      border-top: 1px solid rgba(255,255,255,0.08);
      padding: 12px 16px;
    }
    .sc-logout-link {
      display: flex;
      align-items: center;
      gap: 8px;
      background: transparent;
      border: 0;
      color: #aebfd6;
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      cursor: pointer;
      padding: 0;
      font-family: inherit;
    }
    .sc-logout-link:hover { color: #fff; }

    /* Content area */
    .sc-content {
      flex: 1;
      min-width: 0;
      display: flex;
      flex-direction: column;
    }
    .sc-topbar {
      height: 56px;
      background: #fff;
      border-bottom: 1px solid #dde6f0;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      padding: 0 24px;
      position: sticky;
      top: 0;
      z-index: 20;
    }
    .sc-topbar-title { color: #16335c; font-size: 18px; font-weight: 700; }
    .sc-topbar-right { display: flex; align-items: center; gap: 14px; }
    .sc-topbar-right .sc-admin-tag { font-size: 0.82rem; color: #6a7a8c; }
    #logout-btn {
      background: transparent;
      border: 1px solid #c7d4e2;
      color: #2f6db5;
      border-radius: 6px;
      padding: 6px 16px;
      font-size: 0.85rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s;
    }
    #logout-btn:hover { background: #2f6db5; color: #fff; border-color: #2f6db5; }

    .sc-body { padding: 20px 24px 40px; }

    .sc-section-title {
      color: #2f6db5;
      font-size: 24px;
      font-weight: 600;
      margin: 4px 0 14px;
    }
    .sc-toolbar {
      display: flex;
      align-items: center;
      gap: 14px;
      flex-wrap: wrap;
      margin-bottom: 14px;
    }
    .sc-toolbar input[type="search"] {
      border: 1px solid #c7d4e2;
      border-radius: 6px;
      padding: 8px 14px;
      font-size: 0.9rem;
      outline: none;
      width: 320px;
      transition: border-color 0.2s;
      font-family: inherit;
    }
    .sc-toolbar input[type="search"]:focus { border-color: #2f6db5; }
    #count-badge { font-size: 0.82rem; color: #6a7a8c; }
    .sc-select, .sc-date {
      border: 1px solid #c7d4e2; border-radius: 6px; padding: 7px 10px;
      font-size: 0.85rem; font-family: inherit; color: #16335c; background: #fff; outline: none;
    }
    .sc-select:focus, .sc-date:focus { border-color: #2f6db5; }
    /* Pagination footer (StatCounter-style) */
    .sc-pager {
      display: flex; align-items: center; justify-content: flex-end; gap: 10px;
      flex-wrap: wrap; margin: 12px 2px 4px; font-size: 0.82rem; color: #6a7a8c;
    }
    .sc-pager:empty { display: none; }
    .sc-pager .sc-pg-info { margin-right: auto; }
    .sc-pager button {
      border: 1px solid #c7d4e2; border-radius: 6px; background: #fff; color: #16335c;
      padding: 5px 12px; font-size: 0.82rem; font-weight: 600; cursor: pointer; font-family: inherit;
    }
    .sc-pager button:hover:not(:disabled) { background: #eef4fc; border-color: #9db8dd; }
    .sc-pager button:disabled { opacity: 0.45; cursor: default; }
    .sc-pager .sc-pg-pages { color: #16335c; font-weight: 600; }
    /* Summary KPI tiles */
    .sc-tiles {
      display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
      gap: 12px; margin-bottom: 16px;
    }
    .sc-tiles:empty { display: none; }
    .sc-tile {
      background: #fff; border: 1px solid #e3e9f0; border-radius: 10px;
      padding: 14px 16px; box-shadow: 0 1px 2px rgba(16,51,92,0.04);
    }
    .sc-tile-val { font-size: 1.6rem; font-weight: 800; color: #16335c; line-height: 1.1; }
    .sc-tile-lbl { font-size: 0.72rem; font-weight: 600; color: #6a7a8c; text-transform: uppercase; letter-spacing: 0.03em; margin-top: 4px; }
    .sc-tile-sub { font-size: 0.72rem; color: #93a2b4; margin-top: 2px; }
    .sc-tile.accent .sc-tile-val { color: #1f7a3d; }
    /* Pages report (Top / Entry / Exit) */
    .sc-pages-tabs { display: flex; gap: 6px; margin-bottom: 12px; flex-wrap: wrap; }
    .sc-pages-tab {
      border: 1px solid #c7d4e2; background: #fff; color: #16335c; border-radius: 6px;
      padding: 6px 14px; font-size: 0.85rem; font-weight: 600; cursor: pointer; font-family: inherit;
    }
    .sc-pages-tab:hover { background: #eef4fc; }
    .sc-pages-tab.active { background: #1f4575; color: #fff; border-color: #1f4575; }
    .sc-pages-table { width: 100%; border-collapse: collapse; font-size: 0.85rem; }
    .sc-pages-table th, .sc-pages-table td {
      text-align: left; padding: 8px 12px; border-bottom: 1px solid #e3e9f0; color: #2a3a4c;
    }
    .sc-pages-table th { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.03em; color: #6a7a8c; }
    .sc-pages-table td.num, .sc-pages-table th.num { text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; }
    .sc-pages-table tr:hover td { background: #f7fafd; }
    .sc-pages-table .pg-path { color: #16335c; word-break: break-all; }

    /* Section panels (one visible at a time) */
    .sc-panel { display: none; }
    .sc-panel.active { display: block; }

    /* ── Table ──────────────────────────────────────────────── */
    .table-wrap {
      margin: 0 0 40px;
      max-height: calc(100vh - 200px);
      overflow: auto;
      background: #fff;
      border: 1px solid #cfd8e3;
      border-radius: 10px;
      box-shadow: 0 8px 24px rgba(26,42,74,0.08);
    }
    .visitor-directory {
      margin: 0 0 16px;
      background: transparent;
    }
    .visitor-directory h2 {
      color: #1a2a4a;
      font-size: 0.9rem;
      margin: 0 0 10px;
    }
    .visitor-directory-grid {
      display: grid;
      gap: 10px;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    }
    .visitor-directory-item {
      border: 1px solid #dce3ec;
      border-radius: 8px;
      padding: 10px;
    }
    .visitor-directory-title {
      color: #1a2a4a;
      font-size: 0.82rem;
      font-weight: 800;
      margin-bottom: 6px;
    }
    .submissions-table {
      width: max-content;
      min-width: 100%;
      border-collapse: separate;
      border-spacing: 0;
      table-layout: fixed;
      font-size: 0.84rem;
    }
    .submissions-table thead {
      background: #1a2a4a;
      color: #fff;
      text-align: left;
    }
    .submissions-table thead th {
      position: sticky;
      top: 0;
      z-index: 2;
      padding: 10px 12px;
      font-size: 0.72rem;
      font-weight: 700;
      line-height: 1.15;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      white-space: nowrap;
      background: #1a2a4a;
      border-right: 1px solid rgba(255,255,255,0.18);
      border-bottom: 1px solid #0f1b31;
    }
    .submissions-table thead th:last-child { border-right: 0; }
    .submissions-table thead th:nth-child(1),
    .submissions-table thead th:nth-child(2),
    .submissions-table thead th:nth-child(3),
    .submissions-table tbody td:nth-child(1),
    .submissions-table tbody td:nth-child(2),
    .submissions-table tbody td:nth-child(3) {
      position: sticky;
      z-index: 3;
    }
    .submissions-table thead th:nth-child(1),
    .submissions-table tbody td:nth-child(1) {
      left: 0;
      text-align: left;
    }
    .submissions-table thead th:nth-child(2),
    .submissions-table tbody td:nth-child(2) {
      left: 54px;
      white-space: nowrap;
    }
    .submissions-table thead th:nth-child(3),
    .submissions-table tbody td:nth-child(3) {
      left: 162px;
      white-space: nowrap;
    }
    .submissions-table thead th:nth-child(1),
    .submissions-table thead th:nth-child(2),
    .submissions-table thead th:nth-child(3) {
      z-index: 5;
      background: #1a2a4a;
    }
    .submissions-table tbody tr {
      transition: background 0.15s;
    }
    .submissions-table tbody tr:nth-child(even) { background: #f8fafc; }
    .submissions-table tbody tr:hover { background: #eef4fb; }
    .submissions-table tbody tr.reconnect-row { background: #fff8e1; }
    .submissions-table tbody tr.reconnect-row:hover { background: #fff3bb; }
    .submissions-table td {
      padding: 10px 12px;
      vertical-align: top;
      color: #333;
      background-clip: padding-box;
      border-right: 1px solid #dce3ec;
      border-bottom: 1px solid #dce3ec;
      line-height: 1.35;
      overflow-wrap: anywhere;
    }
    .submissions-table td:last-child { border-right: 0; }
    .submissions-table tbody td:nth-child(1),
    .submissions-table tbody td:nth-child(2),
    .submissions-table tbody td:nth-child(3) {
      background: #fff;
    }
    .submissions-table tbody tr:nth-child(even) td:nth-child(1),
    .submissions-table tbody tr:nth-child(even) td:nth-child(2),
    .submissions-table tbody tr:nth-child(even) td:nth-child(3) {
      background: #f8fafc;
    }
    .submissions-table tbody tr:hover td:nth-child(1),
    .submissions-table tbody tr:hover td:nth-child(2),
    .submissions-table tbody tr:hover td:nth-child(3) {
      background: #eef4fb;
    }
    .submissions-table tbody tr.reconnect-row td:nth-child(1),
    .submissions-table tbody tr.reconnect-row td:nth-child(2),
    .submissions-table tbody tr.reconnect-row td:nth-child(3) {
      background: #fff8e1;
    }
    .submissions-table tbody tr.reconnect-row:hover td:nth-child(1),
    .submissions-table tbody tr.reconnect-row:hover td:nth-child(2),
    .submissions-table tbody tr.reconnect-row:hover td:nth-child(3) {
      background: #fff3bb;
    }
    .submissions-table tbody td:nth-child(1) {
      color: #687386;
      font-weight: 700;
    }
    .submissions-table tbody td:nth-child(2) {
      color: #475569;
      font-size: 0.78rem;
    }
    .cell-num,
    .cell-date,
    .cell-phone,
    .cell-capacity,
    .cell-solids,
    .cell-action,
    .cell-status {
      white-space: nowrap;
    }
    .cell-num {
      color: #687386;
      font-weight: 700;
      text-align: left;
    }
    .cell-date {
      color: #475569;
      font-size: 0.78rem;
    }
    .cell-primary {
      color: #1a2a4a;
      font-weight: 700;
    }
    .cell-secondary {
      color: #64748b;
      font-size: 0.74rem;
      margin-top: 2px;
    }
    .cell-email a {
      color: #1a2a4a;
      font-weight: 600;
      text-decoration: none;
    }
    .cell-email a:hover { text-decoration: underline; }
    .empty-cell {
      color: #94a3b8;
      font-style: italic;
    }
    .badge-reconnect {
      display: inline-block;
      background: #e8c204;
      color: #1a2a4a;
      font-size: 0.7rem;
      font-weight: 700;
      padding: 2px 8px;
      border-radius: 20px;
      white-space: nowrap;
    }
    .type-badge {
      display: inline-block;
      background: #e8eef8;
      border: 1px solid #cbd8ea;
      color: #1a2a4a;
      font-size: 0.7rem;
      font-weight: 700;
      padding: 4px 8px;
      border-radius: 6px;
      white-space: nowrap;
    }
    .attrib-cell {
      min-width: 380px;
      font-size: 0.76rem;
    }
    .visitor-cell {
      min-width: 340px;
      font-size: 0.76rem;
    }
    .attrib-panel {
      display: grid;
      gap: 6px;
    }
    .attrib-source {
      display: inline-flex;
      align-items: center;
      width: fit-content;
      background: #eaf6ee;
      border: 1px solid #b7dfc2;
      border-radius: 6px;
      color: #1a2a4a;
      font-weight: 700;
      padding: 4px 8px;
    }
    .attrib-muted {
      color: #687386;
    }
    .attrib-line {
      display: grid;
      grid-template-columns: 86px minmax(0, 1fr);
      gap: 8px;
      align-items: start;
    }
    .attrib-label {
      color: #687386;
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }
    .attrib-value {
      color: #24344d;
      min-width: 0;
    }
    .attrib-path {
      color: #333;
      font-family: Consolas, 'JetBrains Mono', monospace;
      font-size: 0.72rem;
      word-break: break-word;
    }
    .attrib-details {
      border-top: 1px solid #dce3ec;
      margin-top: 2px;
      padding-top: 6px;
    }
    .attrib-details summary {
      cursor: pointer;
      color: #1a2a4a;
      font-weight: 700;
    }
    .attrib-details ol {
      margin: 6px 0 0 18px;
    }
    .attrib-details li {
      margin-bottom: 5px;
    }
    .context-ua-text {
      color: #24344d;
      font-family: Consolas, 'JetBrains Mono', monospace;
      font-size: 0.7rem;
      line-height: 1.35;
      margin-top: 6px;
      overflow-wrap: anywhere;
    }
    .visitor-label-box {
      border-top: 1px solid #dce3ec;
      display: grid;
      gap: 6px;
      margin-top: 2px;
      padding-top: 6px;
    }
    .visitor-label-box input[type="text"],
    .visitor-label-box input[type="email"],
    .visitor-label-box input[type="tel"],
    .visitor-label-box textarea {
      border: 1px solid #cfd8e3;
      border-radius: 6px;
      color: #24344d;
      font: inherit;
      padding: 5px 7px;
      width: 100%;
    }
    .visitor-label-box textarea {
      min-height: 54px;
      resize: vertical;
    }
    .visitor-identity-grid {
      display: grid;
      gap: 5px;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .visitor-identity-grid input {
      min-width: 0;
    }
    .visitor-alert-row {
      align-items: center;
      color: #475569;
      display: flex;
      gap: 6px;
    }
    .visitor-save-btn {
      background: #1a2a4a;
      border: 0;
      border-radius: 6px;
      color: #fff;
      cursor: pointer;
      font-size: 0.72rem;
      font-weight: 700;
      padding: 6px 9px;
      width: fit-content;
    }
    .visitor-save-btn:disabled {
      cursor: wait;
      opacity: 0.6;
    }
    .visitor-save-status {
      color: #64748b;
      font-size: 0.7rem;
    }
    .delete-btn {
      background: transparent;
      border: 1px solid #e74c3c;
      color: #e74c3c;
      border-radius: 6px;
      padding: 4px 10px;
      font-size: 0.78rem;
      cursor: pointer;
      transition: all 0.15s;
      white-space: nowrap;
    }
    .delete-btn:hover { background: #e74c3c; color: #fff; }

    .loading {
      text-align: center;
      padding: 60px;
      color: #888;
      font-size: 1rem;
    }
    .empty {
      text-align: center;
      padding: 60px;
      color: #999;
      font-size: 0.95rem;
    }

    /* ── Visitor activity log (StatCounter per-visit rows) ───── */
    .va-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 12px; margin: 0 0 10px; }
    .va-count { font-size: 0.8rem; font-weight: 600; color: #6a7a8c; }
    .va-legend { font-size: 0.72rem; color: #94a3b8; margin-left: auto; }
    .va-dot-id { display: inline-block; width: 10px; height: 10px; border-radius: 3px; background: #eef4fc; border: 1px solid #cbd8ea; vertical-align: -1px; }

    .va-log {
      display: flex;
      flex-direction: column;
      border: 1px solid #e3e9f0;
      border-radius: 8px;
      overflow: hidden;
      background: #fff;
    }
    .va-row { border-top: 1px solid #e3e9f0; }
    .va-row:first-child { border-top: 0; }
    .va-row.identified { background: #eef4fc; }
    /* "Connected dots" — visitors where multiple signals fuse stand out in gold */
    .va-row.va-connected { background: #fff7e6; box-shadow: inset 4px 0 0 #e0a93a; }
    .va-row.va-fullcircle { background: #fff2cc; box-shadow: inset 4px 0 0 #c9920a; }
    .va-badge-connected, .va-badge-circle {
      display: inline-block; margin-left: 6px; padding: 1px 7px; border-radius: 10px;
      font-size: 0.68rem; font-weight: 700; vertical-align: 1px; white-space: nowrap;
      border: 0; font-family: inherit; cursor: pointer;
    }
    .va-badge-connected { background: #fde8c0; color: #8a5a00; }
    .va-badge-circle { background: #f6cf6b; color: #5c4302; }
    .va-badge-connected:hover, .va-badge-circle:hover { filter: brightness(0.96); }
    .va-quicktag {
      margin-left: 8px; padding: 1px 8px; border: 1px solid #cbd8ea; border-radius: 10px;
      background: #f4f8fd; color: #16335c; font-size: 0.7rem; font-weight: 600;
      cursor: pointer; vertical-align: 1px; white-space: nowrap;
    }
    .va-quicktag:hover { background: #e3eefb; border-color: #9db8dd; }
    .va-pill {
      display: inline-block; margin-left: 6px; padding: 1px 7px; border-radius: 10px;
      font-size: 0.68rem; font-weight: 700; vertical-align: 1px; white-space: nowrap;
    }
    .va-pill-ads { background: #fde8c0; color: #8a5a00; }
    .va-pill-neu { background: #eef2f7; color: #506179; }
    .va-pill-org-g { background: #e3f4e8; color: #1f7a3d; }
    .va-pill-org-b { background: #e2eef7; color: #1d5d86; }

    /* ── AI-referral GEO chip ────────────────────────────────── */
    .va-pill-ai { background: #f3e8ff; color: #6b21a8; }

    /* ── StatCounter compact row anatomy (2-line, fixed-height) ─ */
    .va-log-sc {
      display: flex;
      flex-direction: column;
      border: 1px solid #e3e9f0;
      border-radius: 8px;
      overflow: visible;
      background: #fff;
    }
    .va-row-sc {
      border-top: 1px solid #eef2f7;
      padding: 7px 10px 7px 12px;
      display: flex;
      align-items: flex-start;
      gap: 0;
      transition: background 0.1s;
      position: relative;
    }
    .va-row-sc:first-child { border-top: 0; }
    .va-row-sc:hover { background: #f7fafd; }
    .va-row-sc.identified { background: #eef4fc; }
    .va-row-sc.identified:hover { background: #e5eef9; }
    .va-row-sc.va-connected { background: #fff7e6; box-shadow: inset 4px 0 0 #e0a93a; }
    .va-row-sc.va-connected:hover { background: #fff3d6; }
    .va-row-sc.va-fullcircle { background: #fff2cc; box-shadow: inset 4px 0 0 #c9920a; }
    .va-row-sc.va-fullcircle:hover { background: #ffedb5; }
    .va-row-sc-body { flex: 1; min-width: 0; }
    /* Line 1: meta row */
    .va-line1 {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 5px;
      font-size: 0.79rem;
      line-height: 1.3;
      margin-bottom: 2px;
    }
    .va-l1-time { color: #6a7a8c; white-space: nowrap; font-size: 0.73rem; margin-right: 4px; flex: none; }
    .va-l1-geo { display: flex; align-items: center; gap: 4px; white-space: nowrap; font-weight: 600; color: #16335c; }
    .va-l1-isp { color: #6a7a8c; font-size: 0.72rem; white-space: nowrap; }
    /* Line 2: page/referrer/keyword row */
    .va-line2 {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 8px;
      font-size: 0.74rem;
      line-height: 1.3;
      color: #6a7a8c;
    }
    .va-l2-page { color: #2e6fbf; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 260px; text-decoration: none; }
    .va-l2-page:hover { text-decoration: underline; }
    .va-l2-ref  { color: #6a7a8c; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 200px; text-decoration: none; }
    .va-l2-ref:hover { text-decoration: underline; }
    .va-l2-kw   { background: #fef9c3; color: #7a5b00; padding: 0 5px; border-radius: 3px; white-space: nowrap; }
    .va-l2-sep  { color: #c7d4e2; }
    /* Small chip base (inline on Line 1) */
    .va-chip {
      display: inline-flex; align-items: center; gap: 2px;
      padding: 0 6px; height: 18px; border-radius: 9px;
      font-size: 0.64rem; font-weight: 700; white-space: nowrap;
      vertical-align: middle; line-height: 1;
      border: 1px solid transparent;
    }
    .va-chip-id   { background: #e0eeff; color: #1a4fa0; border-color: #b3d0f5; }
    .va-chip-grade-a { background: #dcfce7; color: #15803d; border-color: #86efac; }
    .va-chip-grade-b { background: #fef9c3; color: #854d0e; border-color: #fde047; }
    .va-chip-grade-c { background: #f1f5f9; color: #475569; border-color: #cbd5e1; }
    .va-chip-grade-empty {
      background: transparent; color: #94a3b8; border: 1px dashed #cbd5e1;
      cursor: pointer;
    }
    .va-chip-grade-empty:hover { border-color: #94a3b8; color: #64748b; }
    .va-chip-ai   { background: #f3e8ff; color: #6b21a8; border-color: #d8b4fe; }
    .va-chip-action { background: #f8fafc; color: #334155; border-color: #e2e8f0; }
    .va-chip-action-phone { background: #fde8c0; color: #8a5a00; border-color: #fcd7a0; }
    .va-chip-action-email { background: #e2eef7; color: #1d5d86; border-color: #b0d4ee; }
    .va-chip-action-form  { background: #eaf6ee; color: #0f6e56; border-color: #a7dfbe; }
    /* Visit # badge */
    .va-visitbadge {
      display: inline-flex; align-items: center;
      background: #eef2f7; color: #475569;
      border: 1px solid #cbd5e1;
      border-radius: 9px; padding: 0 6px; height: 18px;
      font-size: 0.64rem; font-weight: 700; white-space: nowrap;
    }
    /* RETURNING badge */
    .va-retbadge {
      display: inline-flex; align-items: center;
      background: #fdf2c9; color: #7a5b00;
      border: 1px solid #e8c204;
      border-radius: 9px; padding: 0 7px; height: 18px;
      font-size: 0.64rem; font-weight: 700; letter-spacing: 0.03em;
      text-transform: uppercase; white-space: nowrap;
    }
    /* Magnify (expand) button — right edge */
    .va-magnify {
      flex: none; margin-left: 10px; margin-top: 2px;
      width: 26px; height: 26px; border-radius: 50%;
      background: #eef4fc; border: 1px solid #c7d4e2;
      color: #2e6fbf; cursor: pointer;
      display: flex; align-items: center; justify-content: center;
      font-size: 0.82rem; transition: background 0.15s;
    }
    .va-magnify:hover { background: #d9eaf8; border-color: #9db8dd; }
    .va-row-sc.va-detail-open .va-magnify { background: #2e6fbf; color: #fff; border-color: #2e6fbf; }
    /* Detail panel — slides in below the row */
    .va-detail-sc {
      display: none;
      padding: 12px 14px 16px 14px;
      border-top: 1px dashed #e3e9f0;
      background: #fafcff;
      gap: 6px;
    }
    .va-detail-sc.open {
      display: grid;
    }
    /* Row wrapper groups a compact row with its detail panel */
    .va-vrow { border-top: 1px solid #eef2f7; }
    .va-vrow:first-child { border-top: 0; }
    .va-vrow > .va-row-sc { border-top: 0; cursor: pointer; }
    /* Browser / OS inline-SVG marker — Windows-safe (no flag-emoji trap), no favicons, no icon font */
    .va-osmark { display: inline-flex; align-items: center; gap: 3px; white-space: nowrap; }
    .va-osmark .va-osmark-txt { color: #6a7a8c; font-size: 0.72rem; }
    .va-bico, .va-osico { width: 13px; height: 13px; display: inline-block; vertical-align: -2px; flex: none; }
    /* Expand chevron flips when the detail panel is open */
    .va-magnify svg { transition: transform 0.15s; display: block; }
    .va-row-sc.va-detail-open .va-magnify svg { transform: rotate(180deg); }
    .va-detail-sc .attrib-line { margin: 0; }

    /* Country flag image (StatCounter look) + raw-code fallback when the flag can't render */
    .va-flag { display: inline-block; width: 20px; height: 15px; vertical-align: -2px; border-radius: 2px; box-shadow: 0 0 0 1px rgba(0,0,0,0.10); }
    .va-cc { color: #6a7a8c; }
    /* "Connected dots" click-popup — appended to <body> so it isn't clipped by .va-log overflow */
    .va-dots-wrap { position: relative; display: inline-block; }
    .va-dots-wrap > .va-dots-pop { display: none; }
    .va-dots-pop {
      position: fixed; z-index: 60;
      min-width: 230px; max-width: 320px; padding: 10px 12px;
      background: #fff; border: 1px solid #e0c489; border-radius: 10px;
      box-shadow: 0 12px 34px rgba(0,0,0,0.2); text-align: left;
      font-weight: 400; white-space: normal;
    }
    .va-pop-head { font-size: 0.72rem; font-weight: 700; color: #8a5a00; margin-bottom: 6px; }
    .va-pop-row { display: flex; align-items: baseline; gap: 7px; font-size: 0.74rem; padding: 2px 0; }
    .va-pop-row.off { color: #9aa7b6; }
    .va-pop-row.on { color: #24344d; }
    .va-pop-mark { width: 12px; flex: none; text-align: center; font-weight: 700; }
    .va-pop-row.on .va-pop-mark { color: #1f7a3d; }
    .va-pop-lbl { font-weight: 600; flex: none; }
    .va-pop-det { color: #6a7a8c; overflow-wrap: anywhere; }

    .va-summary {
      display: flex;
      align-items: flex-start;
      gap: 14px;
      padding: 13px 16px;
      cursor: pointer;
      list-style: none;
    }
    .va-summary::-webkit-details-marker { display: none; }

    /* Blue circular expand button with a white triangle */
    .va-expand {
      flex: none;
      width: 28px;
      height: 28px;
      border-radius: 50%;
      background: #2e6fbf;
      color: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.62rem;
      line-height: 1;
      margin-top: 2px;
      transition: transform 0.15s;
    }
    .va-expand::before { content: '▶'; transform: translateX(1px); }
    .va-row[open] .va-expand { transform: rotate(90deg); }

    .va-main { flex: 1; min-width: 0; }

    /* Identity header line at the top of a row */
    .va-ident { margin-bottom: 6px; }
    .va-name { font-size: 0.95rem; font-weight: 700; color: #16335c; }
    .va-name .va-id { font-family: Consolas, monospace; font-size: 0.74rem; font-weight: 400; color: #94a3b8; }
    .va-company { color: #6a7a8c; font-weight: 600; font-size: 0.84rem; }
    .va-badge-filled {
      margin-left: 8px;
      font-size: 0.64rem;
      font-weight: 700;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      background: #eaf6ee;
      border: 1px solid #b7dfc2;
      color: #0f6e56;
      padding: 2px 7px;
      border-radius: 5px;
      vertical-align: 1px;
    }
    .va-badge-ret {
      margin-left: 6px;
      font-size: 0.64rem;
      font-weight: 700;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      background: #fdf2c9;
      border: 1px solid #e8c204;
      color: #7a5b00;
      padding: 2px 7px;
      border-radius: 5px;
      vertical-align: 1px;
    }

    /* Two-column label:value grid (StatCounter look) */
    .va-cols {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 4px 28px;
    }
    .va-pair {
      display: grid;
      grid-template-columns: 120px minmax(0, 1fr);
      gap: 8px;
      align-items: baseline;
      font-size: 0.78rem;
      line-height: 1.4;
    }
    .va-pair .va-lbl { color: #6a7a8c; }
    .va-pair .va-val { color: #24344d; overflow-wrap: anywhere; }
    .va-val a { text-decoration: none; }
    .va-val .va-isp { color: #c0392b; }
    .va-val .va-link { color: #2e6fbf; }
    .va-val .va-link:hover { text-decoration: underline; }

    .va-when { flex: none; font-size: 0.75rem; color: #6a7a8c; white-space: nowrap; text-align: right; }

    .va-detail {
      padding: 10px 16px 16px 58px;
      display: grid;
      gap: 6px;
      border-top: 1px dashed #e3e9f0;
      background: #fafcff;
    }
    .va-origin {
      border: 1px solid #d9e2ec;
      border-radius: 7px;
      background: #fff;
      padding: 8px 10px;
      font-size: 0.78rem;
      color: #24344d;
      font-family: inherit;
    }
    .va-origin strong { color: #16335c; }
    .va-gclid-badge {
      display: inline-block;
      margin-left: 6px;
      padding: 1px 6px;
      border: 1px solid #b7dfc2;
      border-radius: 5px;
      background: #eaf6ee;
      color: #0f6e56;
      font-size: 0.66rem;
      font-weight: 700;
      white-space: nowrap;
    }
    .va-url {
      display: inline-flex;
      align-items: baseline;
      flex-wrap: wrap;
      gap: 5px;
      min-width: 0;
      max-width: 100%;
    }
    .va-url-path {
      color: #2e6fbf;
      text-decoration: none;
      overflow-wrap: anywhere;
    }
    .va-url-path:hover { text-decoration: underline; }
    .va-url-params {
      display: inline;
      min-width: 0;
    }
    .va-url-toggle {
      padding: 0;
      border: 0;
      background: transparent;
      color: #6a7a8c;
      cursor: pointer;
      font-size: 0.68rem;
      font-family: inherit;
      white-space: nowrap;
    }
    .va-url-toggle[aria-expanded="true"] { color: #2e6fbf; }
    .va-url-raw {
      display: block;
      width: 100%;
      margin-top: 4px;
      padding: 5px 7px;
      border: 1px solid #e3e9f0;
      border-radius: 5px;
      background: #f8fafc;
      color: #475569;
      font-family: Consolas, "Courier New", monospace;
      font-size: 0.68rem;
      line-height: 1.35;
      overflow-wrap: anywhere;
      white-space: normal;
    }
    .va-url-raw[hidden] { display: none; }
    .va-detail-grid {
      display: grid;
      grid-template-columns: minmax(110px, 160px) minmax(0, 1fr);
      margin: 0;
      border: 1px solid #d9e2ec;
      border-radius: 8px;
      background: #fff;
      font-family: inherit;
      font-size: 0.78rem;
      line-height: 1.35;
      overflow: hidden;
    }
    .va-detail-grid dt,
    .va-detail-grid dd {
      margin: 0;
      padding: 6px 9px;
      border-top: 1px solid #eef2f7;
    }
    .va-detail-grid dt:nth-of-type(1),
    .va-detail-grid dd:nth-of-type(1) { border-top: 0; }
    .va-detail-grid dt {
      color: #6a7a8c;
      font-weight: 600;
      background: #f8fafc;
    }
    .va-detail-grid dd {
      color: #24344d;
      overflow-wrap: anywhere;
    }
    .va-timeline {
      border: 1px solid #d9e2ec;
      border-radius: 8px;
      background: #fff;
      overflow: hidden;
    }
    .va-timeline-head {
      padding: 9px 11px;
      font-size: 0.74rem;
      font-weight: 700;
      color: #16335c;
      background: #f4f8fd;
      border-bottom: 1px solid #d9e2ec;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }
    .va-event-list { display: grid; gap: 0; }
    .va-event {
      display: grid;
      grid-template-columns: 112px max-content minmax(0, 1fr);
      align-items: baseline;
      gap: 8px;
      padding: 7px 11px;
      border-top: 1px solid #eef2f7;
      font-size: 0.78rem;
      font-family: inherit;
    }
    .va-event:first-child { border-top: 0; }
    .va-event-time { color: #6a7a8c; white-space: nowrap; }
    .va-event-main { min-width: 0; color: #24344d; overflow-wrap: anywhere; }
    .va-event-form-contact { color: #6a7a8c; margin-left: 6px; }
    .va-event-type {
      display: inline-block;
      padding: 1px 6px;
      border-radius: 5px;
      font-size: 0.66rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.03em;
      background: #eef2f7;
      color: #506179;
      white-space: nowrap;
    }
    .va-event-type-phone_click { background: #fde8c0; color: #8a5a00; }
    .va-event-type-phone_voicemail { background: #ffe3cd; color: #8d3d0c; }
    .va-event-type-email_click { background: #e2eef7; color: #1d5d86; }
    .va-event-type-form_submit { background: #eaf6ee; color: #0f6e56; }
    .va-timeline-empty {
      padding: 10px 11px;
      color: #6a7a8c;
      font-size: 0.78rem;
    }
    .calls-table {
      width: 100%;
      border-collapse: collapse;
      table-layout: fixed;
      background: #fff;
      font-size: 0.8rem;
    }
    .calls-table th,
    .calls-table td {
      border-bottom: 1px solid #e5edf5;
      padding: 10px 12px;
      text-align: left;
      vertical-align: top;
      overflow-wrap: anywhere;
    }
    .calls-table th {
      background: #f4f8fd;
      color: #16335c;
      font-size: 0.72rem;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }
    .call-match {
      display: inline-block;
      padding: 2px 7px;
      border-radius: 6px;
      font-size: 0.68rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.03em;
      background: #eef2f7;
      color: #506179;
    }
    .call-match.matched { background: #eaf6ee; color: #0f6e56; }
    .call-match.unmatched { background: #fff5d6; color: #8a5a00; }
    .call-transcript {
      color: #334155;
      line-height: 1.45;
      max-width: 520px;
    }

    /* ── Inline grade select (Line 1) ─────────────────────────── */
    .va-grade-select {
      height: 18px; padding: 0 4px;
      border: 1px solid #cbd5e1; border-radius: 9px;
      font-size: 0.65rem; font-weight: 700;
      background: #f8fafc; color: #475569;
      cursor: pointer; outline: none;
      vertical-align: middle;
    }
    .va-grade-select.grade-a { background: #dcfce7; color: #15803d; border-color: #86efac; }
    .va-grade-select.grade-b { background: #fef9c3; color: #854d0e; border-color: #fde047; }
    .va-grade-select.grade-c { background: #f1f5f9; color: #475569; border-color: #cbd5e1; }
    .lead-grade-select { padding: 4px 8px; border: 1px solid #cbd5e1; border-radius: 6px; font-family: inherit; font-size: 0.78rem; background: #fff; color: #16335c; cursor: pointer; }
    .lead-grade-select.grade-a { background: #dcfce7; color: #15803d; border-color: #86efac; }
    .lead-grade-select.grade-b { background: #fef9c3; color: #854d0e; border-color: #fde047; }
    .lead-grade-select.grade-c { background: #f1f5f9; color: #475569; border-color: #cbd5e1; }
    .lead-grade-reason { margin-top: 4px; font-size: 0.68rem; color: #64748b; line-height: 1.25; max-width: 150px; }
    /* Grade control inside the Save Visitor panel */
    .visitor-grade-row { display: flex; align-items: center; gap: 8px; margin-top: 8px; flex-wrap: wrap; }
    .visitor-grade-label { font-size: 0.75rem; font-weight: 700; color: #475569; }
    .visitor-grade-input { padding: 4px 8px; border: 1px solid #cbd5e1; border-radius: 6px; font-family: inherit; font-size: 0.8rem; background: #fff; color: #16335c; cursor: pointer; }
    .visitor-grade-hint { font-size: 0.68rem; color: #94a3b8; }

    /* ── Filter bar (below toolbar) ───────────────────────────── */
    .sc-filter-bar {
      display: flex; align-items: center; gap: 8px;
      flex-wrap: wrap; margin-bottom: 10px;
    }
    .sc-filter-label {
      font-size: 0.72rem; font-weight: 700; color: #6a7a8c;
      text-transform: uppercase; letter-spacing: 0.04em; margin-right: 4px;
    }
    .sc-filter-btn {
      border: 1px solid #c7d4e2; border-radius: 20px;
      background: #fff; color: #16335c;
      padding: 4px 12px; font-size: 0.78rem; font-weight: 600;
      cursor: pointer; font-family: inherit;
      transition: all 0.15s;
    }
    .sc-filter-btn:hover { background: #eef4fc; border-color: #9db8dd; }
    .sc-filter-btn.active { background: #1f4575; color: #fff; border-color: #1f4575; }

    /* ── Weekly report button in topbar ──────────────────────── */
    #weekly-report-btn {
      background: transparent;
      border: 1px solid #c7d4e2;
      color: #2f6db5;
      border-radius: 6px;
      padding: 6px 12px;
      font-size: 0.78rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s;
      font-family: inherit;
    }
    #weekly-report-btn:hover { background: #2f6db5; color: #fff; border-color: #2f6db5; }
  </style>
</head>
<body>

  <!-- ── Login Screen ─────────────────────────────────────── -->
  <div id="login-screen">
    <div class="login-card">
      <h1>🔒 Admin Dashboard</h1>
      <p>Dolphin Centrifuge — Form Submissions</p>
      <input type="password" id="password-input" placeholder="Enter admin password" autocomplete="current-password" />
      <button id="login-btn">Sign In</button>
      <div id="login-error"></div>
    </div>
  </div>

  <!-- ── Dashboard ────────────────────────────────────────── -->
  <div id="dashboard">

    <!-- Navy left sidebar -->
    <aside class="sc-sidebar">
      <div class="sc-brand">
        <span class="sc-brand-mark">D</span>
        <span class="sc-brand-name">Dolphin</span>
      </div>
      <nav class="sc-nav">
        <button type="button" class="sc-nav-item active" data-view="activity">
          <span class="sc-nav-ico">&#128202;</span>Visitor Activity
        </button>
        <button type="button" class="sc-nav-item" data-view="pages">
          <span class="sc-nav-ico">&#128196;</span>Pages
        </button>
        <button type="button" class="sc-nav-item" data-view="calls">
          <span class="sc-nav-ico">&#9742;</span>Phone Leads
        </button>
        <button type="button" class="sc-nav-item" data-view="submissions">
          <span class="sc-nav-ico">&#128203;</span>Form Submissions
        </button>
        <button type="button" class="sc-nav-item" data-view="known">
          <span class="sc-nav-ico">&#9733;</span>Known Visitors
        </button>
      </nav>
      <div class="sc-sidebar-foot">
        <button type="button" class="sc-logout-link" id="sidebar-logout">
          <span class="sc-nav-ico">&#9099;</span>Log out
        </button>
      </div>
    </aside>

    <!-- Content area -->
    <div class="sc-content">
      <div class="sc-topbar">
        <div class="sc-topbar-title">Dolphincentrifuge.com</div>
        <div class="sc-topbar-right">
          <span class="sc-admin-tag">Admin</span>
          <button id="weekly-report-btn" title="Download 14-day growth-ops report with live D1, GA4, and Ads source health">📊 Weekly Report</button>
          <button id="logout-btn">Log Out</button>
        </div>
      </div>

      <div class="sc-body">
        <div id="summary-tiles" class="sc-tiles"></div>
        <div class="sc-toolbar">
          <input type="search" id="search-input" placeholder="Search by name, company, email, fluid…" />
          <select id="date-preset" class="sc-select" title="Date range (UTC day boundaries)">
            <option value="all">All time</option>
            <option value="today">Today</option>
            <option value="7d">Last 7 days</option>
            <option value="14d">Last 14 days</option>
            <option value="30d" selected>Last 30 days</option>
            <option value="month">This month</option>
            <option value="custom">Custom…</option>
          </select>
          <input type="date" id="date-start" class="sc-date" style="display:none" title="Start date" />
          <input type="date" id="date-end" class="sc-date" style="display:none" title="End date" />
          <select id="rows-per-page" class="sc-select" title="Rows per page">
            <option value="25">25 / page</option>
            <option value="50" selected>50 / page</option>
            <option value="100">100 / page</option>
            <option value="200">200 / page</option>
          </select>
          <span id="count-badge">Loading…</span>
        </div>

        <!-- Filter bar for the Visitor Activity view -->
        <div class="sc-filter-bar" id="visitor-filter-bar">
          <span class="sc-filter-label">Filter:</span>
          <button type="button" class="sc-filter-btn" id="filter-identified" data-filter="identified">👤 Identified only</button>
          <button type="button" class="sc-filter-btn" id="filter-graded" data-filter="graded">🏅 Graded only</button>
          <button type="button" class="sc-filter-btn" id="filter-paid" data-filter="paid">💰 Paid only</button>
          <button type="button" class="sc-filter-btn" id="filter-ai" data-filter="ai">🤖 AI-referral only</button>
        </div>

        <!-- Visitor activity / Known visitors share this panel -->
        <section class="sc-panel active" id="panel-activity">
          <h1 class="sc-section-title" id="activity-title">Visitor activity</h1>
          <div id="visitor-directory" class="visitor-directory loading">Loading visitor activity…</div>
          <div id="visitor-pager" class="sc-pager"></div>
        </section>

        <!-- Pages report (Top / Entry / Exit) -->
        <section class="sc-panel" id="panel-pages">
          <h1 class="sc-section-title">Pages</h1>
          <div class="sc-pages-tabs">
            <button type="button" class="sc-pages-tab active" data-ptab="top">Top pages</button>
            <button type="button" class="sc-pages-tab" data-ptab="entry">Entry pages</button>
            <button type="button" class="sc-pages-tab" data-ptab="exit">Exit pages</button>
          </div>
          <div class="table-wrap">
            <div id="pages-container" class="loading">Loading pages…</div>
          </div>
        </section>

        <!-- Phone leads from Talkroute voicemail emails -->
        <section class="sc-panel" id="panel-calls">
          <h1 class="sc-section-title">Phone leads</h1>
          <div class="table-wrap">
            <div id="calls-container" class="loading">Loading phone leads...</div>
          </div>
        </section>

        <!-- Form submissions table -->
        <section class="sc-panel" id="panel-submissions">
          <h1 class="sc-section-title">Form submissions</h1>
          <div class="table-wrap">
            <div id="table-container" class="loading">Loading submissions…</div>
          </div>
          <div id="leads-pager" class="sc-pager"></div>
        </section>
      </div>
    </div>
  </div>

  <script define:vars={{ contactWorkerBaseUrl, isDevDashboard }}>
    // ── Config ────────────────────────────────────────────────
    const WORKER_URL = contactWorkerBaseUrl;
    const SESSION_KEY = 'dc_admin_token';

    // ── Elements ──────────────────────────────────────────────
    const loginScreen    = document.getElementById('login-screen');
    const dashboard      = document.getElementById('dashboard');
    const passwordInput  = document.getElementById('password-input');
    const loginBtn       = document.getElementById('login-btn');
    const loginError     = document.getElementById('login-error');
    const searchInput    = document.getElementById('search-input');
    const countBadge     = document.getElementById('count-badge');
    const tableContainer = document.getElementById('table-container');
    const visitorDirectory = document.getElementById('visitor-directory');
    const logoutBtn      = document.getElementById('logout-btn');
    const datePreset     = document.getElementById('date-preset');
    const dateStart      = document.getElementById('date-start');
    const dateEnd        = document.getElementById('date-end');
    const rowsPerPageSel = document.getElementById('rows-per-page');
    const leadsPager     = document.getElementById('leads-pager');
    const visitorPager   = document.getElementById('visitor-pager');
    const summaryTiles   = document.getElementById('summary-tiles');
    const pagesContainer = document.getElementById('pages-container');
    const callsContainer = document.getElementById('calls-container');

    let allData = [];
    let allVisitors = [];
    let allCalls = [];
    const visitorEventsCache = new Map();
    const visitorEventsLoading = new Set();
    const initialSearch = new URLSearchParams(window.location.search).get('q') || '';

    // ── Date-range + pagination state ─────────────────────────
    let rowsPerPage = 50;
    let leadsPage = 1;
    let visitorsPage = 1;
    let activeView = 'activity';
    // Visitor Activity toggle-filters (Last-14-days lives in the date preset).
    const activeFilters = { identified: false, graded: false, paid: false, ai: false };
    let curStart = null;   // YYYY-MM-DD inclusive, or null = no lower bound
    let curEnd = null;     // YYYY-MM-DD inclusive, or null = no upper bound
    let dataTruncated = false;
    let visitorsTruncated = false;
    let callsTruncated = false;

    function currentToken() { return sessionStorage.getItem(SESSION_KEY); }
    function isoDay(d) { return d.toISOString().slice(0, 10); }

    // Compute {start,end} (UTC, inclusive) for a preset. null = unbounded.
    function computeRange(preset) {
      const now = new Date();
      const end = isoDay(now);
      if (preset === 'all') return { start: null, end: null };
      if (preset === 'today') return { start: end, end };
      if (preset === '7d') { const s = new Date(now); s.setUTCDate(s.getUTCDate() - 6); return { start: isoDay(s), end }; }
      if (preset === '14d') { const s = new Date(now); s.setUTCDate(s.getUTCDate() - 13); return { start: isoDay(s), end }; }
      if (preset === '30d') { const s = new Date(now); s.setUTCDate(s.getUTCDate() - 29); return { start: isoDay(s), end }; }
      if (preset === 'month') { const s = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), 1)); return { start: isoDay(s), end }; }
      return { start: null, end: null };
    }

    function rangeQuery() {
      const p = new URLSearchParams();
      if (curStart) p.set('start', curStart);
      if (curEnd) p.set('end', curEnd);
      const qs = p.toString();
      return qs ? ('?' + qs) : '';
    }

    function clampPage(page, total) {
      const pages = Math.max(1, Math.ceil(total / rowsPerPage));
      return Math.min(Math.max(1, page), pages);
    }
    function pageSlice(arr, page) {
      const p = clampPage(page, arr.length);
      return arr.slice((p - 1) * rowsPerPage, p * rowsPerPage);
    }
    function renderPager(el, total, page, kind) {
      if (total <= rowsPerPage) { el.innerHTML = ''; return; }
      const pages = Math.max(1, Math.ceil(total / rowsPerPage));
      const from = total === 0 ? 0 : (page - 1) * rowsPerPage + 1;
      const to = Math.min(total, page * rowsPerPage);
      el.innerHTML =
        `<span class="sc-pg-info">Showing ${from}–${to} of ${total}</span>` +
        `<button type="button" data-pg-kind="${kind}" data-pg-dir="prev" ${page <= 1 ? 'disabled' : ''}>← Prev</button>` +
        `<span class="sc-pg-pages">Page ${page} of ${pages}</span>` +
        `<button type="button" data-pg-kind="${kind}" data-pg-dir="next" ${page >= pages ? 'disabled' : ''}>Next →</button>`;
    }

    // ── Auto-login if session exists ──────────────────────────
    // Local dev only: lets us verify localhost without a real admin secret.
    const localDemoToken = (
      isDevDashboard
      && ['localhost', '127.0.0.1', '::1'].includes(window.location.hostname)
      && new URLSearchParams(window.location.search).get('localDemo') === '1'
    ) ? 'local-demo-token' : '';
    if (localDemoToken) sessionStorage.setItem(SESSION_KEY, localDemoToken);

    // Initialize the default date range (Last 30 days) BEFORE any first load,
    // so the initial fetch is already bounded. (computeRange/syncCustomDateInputs
    // are hoisted function declarations, safe to call here.)
    (function initRange() {
      const r = computeRange(datePreset.value || '30d');
      curStart = r.start; curEnd = r.end;
      syncCustomDateInputs();
    })();

    const savedToken = localDemoToken || sessionStorage.getItem(SESSION_KEY);
    if (savedToken) {
      showDashboard();
      loadSubmissions(savedToken);
    }

    // ── Login ─────────────────────────────────────────────────
    loginBtn.addEventListener('click', attemptLogin);
    passwordInput.addEventListener('keydown', e => { if (e.key === 'Enter') attemptLogin(); });

    async function attemptLogin() {
      const token = passwordInput.value.trim();
      if (!token) { loginError.textContent = 'Please enter your password.'; return; }

      loginBtn.textContent = 'Checking…';
      loginBtn.disabled = true;
      loginError.textContent = '';

      try {
        const resp = await fetch(`${WORKER_URL}/admin/submissions${rangeQuery()}`, {
          headers: { 'Authorization': `Bearer ${token}` }
        });

        if (resp.status === 401) {
          loginError.textContent = 'Incorrect password.';
        } else if (resp.ok) {
          sessionStorage.setItem(SESSION_KEY, token);
          const json = await resp.json();
          allData = json.data || [];
          dataTruncated = !!json.truncated;
          showDashboard();
          applyInitialSearch();
          applySearch();
          loadVisitors(token);
          loadSummary(token);
          loadPages(token);
          loadCalls(token);
        } else {
          loginError.textContent = 'Server error. Please try again.';
        }
      } catch (err) {
        loginError.textContent = 'Connection error. Is the worker deployed?';
      }

      loginBtn.textContent = 'Sign In';
      loginBtn.disabled = false;
    }

    // ── Load submissions ───────────────────────────────────────
    async function loadSubmissions(token) {
      try {
        const resp = await fetch(`${WORKER_URL}/admin/submissions${rangeQuery()}`, {
          headers: { 'Authorization': `Bearer ${token}` }
        });
        if (resp.status === 401) { logout(); return; }
        const json = await resp.json();
        allData = json.data || [];
        dataTruncated = !!json.truncated;
        applyInitialSearch();
        applySearch();
        loadVisitors(token);
        loadSummary(token);
        loadPages(token);
        loadCalls(token);
      } catch (err) {
        tableContainer.innerHTML = '<div class="empty">Failed to load data. Check your connection.</div>';
        countBadge.textContent = 'Failed to load';
      }
    }

    async function loadVisitors(token) {
      try {
        const resp = await fetch(`${WORKER_URL}/admin/visitors${rangeQuery()}`, {
          headers: { 'Authorization': `Bearer ${token}` }
        });
        if (!resp.ok) throw new Error('Visitor load failed');
        const json = await resp.json();
        allVisitors = json.data || [];
        visitorsTruncated = !!json.truncated;
        applySearch();
      } catch (err) {
        visitorDirectory.innerHTML = '<h2>Known Visitors</h2><div class="attrib-muted">Visitor profiles are not available yet.</div>';
      }
    }

    async function loadCalls(token) {
      if (!callsContainer) return;
      try {
        const resp = await fetch(`${WORKER_URL}/admin/calls${rangeQuery()}`, {
          headers: { 'Authorization': `Bearer ${token}` }
        });
        if (!resp.ok) throw new Error('Calls load failed');
        const json = await resp.json();
        allCalls = json.data || [];
        callsTruncated = !!json.truncated;
        applySearch();
      } catch (err) {
        allCalls = [];
        callsContainer.innerHTML = '<div class="empty">Phone leads are not available yet.</div>';
      }
    }

    // ── Summary KPI tiles (server-aggregated over the date range) ──
    function tile(val, label, sub, accent) {
      return `<div class="sc-tile${accent ? ' accent' : ''}">` +
        `<div class="sc-tile-val">${esc(val)}</div>` +
        `<div class="sc-tile-lbl">${esc(label)}</div>` +
        (sub ? `<div class="sc-tile-sub">${esc(sub)}</div>` : '') +
        `</div>`;
    }
    function fmtNum(n) { return Number(n || 0).toLocaleString('en-US'); }
    function renderSummary(s) {
      if (!summaryTiles) return;
      const visitors = Number(s.visitors || 0);
      const leads = Number(s.leads || 0);
      const conv = visitors > 0 ? ((leads / visitors) * 100) : 0;
      const convStr = visitors > 0 ? `${conv.toFixed(conv < 10 ? 1 : 0)}%` : '—';
      summaryTiles.innerHTML =
        tile(fmtNum(s.pageviews), 'Pageviews') +
        tile(fmtNum(visitors), 'Visitors') +
        tile(fmtNum(s.sessions), 'Sessions') +
        tile(fmtNum(leads), 'Form leads', '', true) +
        tile(fmtNum(s.calls), 'Phone leads') +
        tile(convStr, 'Lead rate', 'leads ÷ visitors');
    }
    async function loadSummary(token) {
      if (!token) return;
      try {
        const resp = await fetch(`${WORKER_URL}/admin/summary${rangeQuery()}`, {
          headers: { 'Authorization': `Bearer ${token}` }
        });
        if (!resp.ok) { if (summaryTiles) summaryTiles.innerHTML = ''; return; }
        const json = await resp.json();
        if (!json || json.success !== true) { if (summaryTiles) summaryTiles.innerHTML = ''; return; }
        renderSummary(json);
      } catch (err) {
        if (summaryTiles) summaryTiles.innerHTML = '';
      }
    }

    // ── Pages report (Top / Entry / Exit) ──────────────────────
    let pagesData = { top: [], entry: [], exit: [] };
    let pagesTab = 'top';

    function renderPages() {
      if (!pagesContainer) return;
      const rows = (pagesData && pagesData[pagesTab]) || [];
      if (!rows.length) {
        pagesContainer.innerHTML = '<div class="empty">No page activity in this range.</div>';
        return;
      }
      let head, body;
      if (pagesTab === 'top') {
        head = '<th>Page</th><th class="num">Sessions</th><th class="num">Pageviews</th>';
        body = rows.map(r => `<tr><td class="pg-path">${esc(r.page)}</td><td class="num">${fmtNum(r.sessions)}</td><td class="num">${fmtNum(r.pageviews)}</td></tr>`).join('');
      } else if (pagesTab === 'entry') {
        head = '<th>Entry page</th><th class="num">Sessions</th><th class="num">Bounce %</th>';
        body = rows.map(r => {
          const sessions = Number(r.sessions || 0);
          const bounced = Number(r.bounced || 0);
          const pct = sessions > 0 ? Math.round((bounced / sessions) * 100) : 0;
          return `<tr><td class="pg-path">${esc(r.page)}</td><td class="num">${fmtNum(sessions)}</td><td class="num">${pct}%</td></tr>`;
        }).join('');
      } else { // exit
        head = '<th>Exit page</th><th class="num">Sessions</th>';
        body = rows.map(r => `<tr><td class="pg-path">${esc(r.page)}</td><td class="num">${fmtNum(r.sessions)}</td></tr>`).join('');
      }
      const cap = rows.length >= 50 ? '<div class="attrib-muted" style="padding:8px 2px;font-size:0.75rem;">Showing top 50 pages by sessions.</div>' : '';
      pagesContainer.innerHTML = `<table class="sc-pages-table"><thead><tr>${head}</tr></thead><tbody>${body}</tbody></table>${cap}`;
    }

    async function loadPages(token) {
      if (!token) return;
      try {
        const resp = await fetch(`${WORKER_URL}/admin/pages${rangeQuery()}`, {
          headers: { 'Authorization': `Bearer ${token}` }
        });
        if (!resp.ok) { pagesData = { top: [], entry: [], exit: [] }; renderPages(); return; }
        const json = await resp.json();
        pagesData = { top: json.top || [], entry: json.entry || [], exit: json.exit || [] };
        renderPages();
      } catch (err) {
        pagesData = { top: [], entry: [], exit: [] };
        renderPages();
      }
    }

    // Re-fetch both lists for the current date range (used when the range changes).
    function reloadForRange() {
      const token = currentToken();
      if (!token) return;
      leadsPage = 1;
      visitorsPage = 1;
      // Clear stale data so the directory/pages never render the OLD range's
      // data against the NEW range's leads while the fetches are in flight.
      allVisitors = [];
      allCalls = [];
      pagesData = { top: [], entry: [], exit: [] };
      loadSubmissions(token);
    }

    // ── Render table ───────────────────────────────────────────
    function isReturningRecord(record) {
      return Boolean(
        record.is_reconnect
        || Number(record.attribution_is_returning || 0)
        || Number(record.visitor_profile_visit_count || record.attribution_visit_count || 0) > 1
      );
    }

    function leadGradeValue(record) {
      return (record.grade === 'A' || record.grade === 'B' || record.grade === 'C') ? record.grade : '';
    }

    function isLeadGraded(record) {
      return Boolean(leadGradeValue(record));
    }

    function renderLeadGrade(record) {
      const grade = leadGradeValue(record);
      const cls = grade ? ` grade-${grade.toLowerCase()}` : '';
      const reason = String(record.grade_reason || '').trim();
      const source = String(record.grade_source || '').trim();
      const title = [source ? `Source: ${source}` : '', reason].filter(Boolean).join(' | ');
      const reasonText = reason ? (reason.length > 70 ? reason.slice(0, 70) + '...' : reason) : '';
      return `<select class="lead-grade-select${cls}" data-grade-submission-id="${esc(record.id)}" title="${esc(title || 'Lead grade')}">`
        + `<option value=""${grade ? '' : ' selected'}>Ungraded</option>`
        + `<option value="A"${grade === 'A' ? ' selected' : ''}>A</option>`
        + `<option value="B"${grade === 'B' ? ' selected' : ''}>B</option>`
        + `<option value="C"${grade === 'C' ? ' selected' : ''}>C</option>`
        + `</select>`
        + (reasonText ? `<div class="lead-grade-reason" title="${esc(reason)}">${esc(reasonText)}</div>` : '');
    }

    function renderTable(data) {
      if (data.length === 0) {
        tableContainer.innerHTML = '<div class="empty">No submissions in this range.</div>';
        return;
      }

      const colgroup = `
        <colgroup>
          <col style="width:54px">
          <col style="width:108px">
          <col style="width:116px">
          <col style="width:150px">
          <col style="width:170px">
          <col style="width:210px">
          <col style="width:230px">
          <col style="width:128px">
          <col style="width:138px">
          <col style="width:150px">
          <col style="width:110px">
          <col style="width:92px">
          <col style="width:155px">
          <col style="width:130px">
          <col style="width:250px">
          <col style="width:430px">
          <col style="width:360px">
          <col style="width:132px">
          <col style="width:96px">
        </colgroup>`;

      const thead = `
        <thead>
          <tr>
            <th>#</th>
            <th>Date</th>
            <th>Type</th>
            <th>Grade</th>
            <th>Name</th>
            <th>Company</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Country</th>
            <th>Fluid Type</th>
            <th>Capacity</th>
            <th>Solids %</th>
            <th>Condition</th>
            <th>Contact Pref.</th>
            <th>Details</th>
            <th>Google Attribution</th>
            <th>Visitor Context</th>
            <th>Status</th>
            <th>Delete</th>
          </tr>
        </thead>`;

      const tbody = data.map(r => {
        const date = r.created_at ? r.created_at.substring(0, 10) : '—';
        const reconnectBadge = isReturningRecord(r)
          ? `<span class="badge-reconnect">⚡ RETURNING</span>`
          : '';
        const details = r.additional_details
          ? r.additional_details.substring(0, 80) + (r.additional_details.length > 80 ? '…' : '')
          : '—';
        const rowClass = isReturningRecord(r) ? 'reconnect-row' : '';
        // Country flag + foreigner cue: form country is a 2-letter ISO code.
        const cc = String(r.country || '').trim().toUpperCase();
        const ccFlagImg = flagImg(cc);
        const isForeign = /^[A-Z]{2}$/.test(cc) && cc !== 'US';

        return `
          <tr class="${rowClass}" data-id="${r.id}">
            <td>${r.id}</td>
            <td style="white-space:nowrap">${date}</td>
            <td><span class="type-badge">${esc(formTypeLabel(r.form_type))}</span></td>
            <td>${renderLeadGrade(r)}</td>
            <td style="white-space:nowrap">${esc(r.first_name)} ${esc(r.last_name)}</td>
            <td>${esc(r.company)}</td>
            <td><a href="mailto:${esc(r.email)}" style="color:#1a2a4a;">${esc(r.email)}</a></td>
            <td style="white-space:nowrap">${esc(r.phone)}</td>
            <td style="white-space:nowrap;${isForeign ? 'background:#FFE0B2;font-weight:600;' : ''}">${ccFlagImg || esc(r.country || '')}${r.us_state ? ' / ' + esc(r.us_state) : ''}</td>
            <td>${esc(r.fluid_type)}</td>
            <td>${esc(r.capacity)}</td>
            <td>${esc(r.solids_percentage)}</td>
            <td style="white-space:nowrap">${esc(r.centrifuge_condition)}</td>
            <td style="white-space:nowrap">${esc(r.contact_method)}</td>
            <td title="${esc(r.additional_details)}">${esc(details)}</td>
            <td class="attrib-cell">${renderAttribution(r)}</td>
            <td class="visitor-cell">${renderVisitorContext(r)}</td>
            <td>${reconnectBadge}</td>
            <td><button class="delete-btn" data-delete-id="${r.id}">Delete</button></td>
          </tr>`;
      }).join('');

      tableContainer.innerHTML = `<table class="submissions-table">${colgroup}${thead}<tbody>${tbody}</tbody></table>`;
    }

    function safeHttpUrl(value) {
      if (!value) return '';
      try {
        const url = new URL(String(value), window.location.origin);
        return (url.protocol === 'http:' || url.protocol === 'https:') ? String(value) : '';
      } catch (e) {
        return '';
      }
    }

    function formatDuration(seconds) {
      const n = Math.max(0, Math.round(Number(seconds || 0)));
      if (!n) return '';
      const m = Math.floor(n / 60);
      const s = n % 60;
      if (!m) return `${s}s`;
      return `${m}m ${String(s).padStart(2, '0')}s`;
    }

    function callMatchName(call) {
      return call.visitor_label
        || call.visitor_contact_name
        || call.visitor_contact_company
        || [call.submission_first_name, call.submission_last_name].filter(Boolean).join(' ')
        || call.submission_company
        || call.visitor_contact_email
        || call.submission_email
        || '';
    }

    function callSearchText(call) {
      return `${call.caller_raw || ''} ${call.caller_phone_e164 || ''} ${call.caller_phone_digits || ''} ${call.mailbox || ''} ${call.transcript_snippet || ''} ${call.email_subject || ''} ${call.match_status || ''} ${call.match_confidence || ''} ${call.matched_visitor_id || ''} ${call.submission_first_name || ''} ${call.submission_last_name || ''} ${call.submission_company || ''} ${call.submission_email || ''} ${call.submission_phone || ''} ${call.visitor_label || ''} ${call.visitor_contact_name || ''} ${call.visitor_contact_company || ''} ${call.visitor_contact_email || ''} ${call.visitor_contact_phone || ''}`;
    }

    function renderCalls(calls) {
      if (!callsContainer) return;
      if (!calls.length) {
        callsContainer.innerHTML = '<div class="empty">No phone leads in this range.</div>';
        return;
      }

      const body = calls.map(call => {
        const caller = call.caller_raw || call.caller_phone_e164 || 'Unknown caller';
        const rawTranscript = String(call.transcript_snippet || '');
        const transcript = Number(call.transcript_available || 0)
          ? rawTranscript.slice(0, 260)
          : 'No transcript available';
        const transcriptText = transcript + (rawTranscript.length > 260 ? '...' : '');
        const matched = Boolean(call.matched_visitor_id || call.matched_submission_id);
        const matchName = callMatchName(call);
        const matchText = matched
          ? (matchName ? `Matched: ${matchName}` : 'Matched by phone')
          : 'Unmatched';
        const gmailUrl = safeHttpUrl(call.source_display_url || '');
        return `
          <tr>
            <td>${esc(call.created_at ? formatWhen(call.created_at) : '')}</td>
            <td><strong>${esc(caller)}</strong><br><span class="attrib-muted">${esc(call.caller_phone_e164 || '')}</span></td>
            <td>${esc(call.mailbox || '')}</td>
            <td>${esc(formatDuration(call.duration_seconds))}</td>
            <td><div class="call-transcript">${esc(transcriptText)}</div></td>
            <td><span class="call-match ${matched ? 'matched' : 'unmatched'}">${esc(matchText)}</span>${call.matched_visitor_id ? `<br><span class="attrib-muted">${esc(String(call.matched_visitor_id).slice(0, 12))}</span>` : ''}</td>
            <td>${gmailUrl ? `<a class="va-link" href="${esc(gmailUrl)}" target="_blank" rel="noopener">Gmail &#8599;</a>` : '<span class="attrib-muted">Gmail</span>'}</td>
          </tr>`;
      }).join('');

      callsContainer.innerHTML = `
        <table class="calls-table">
          <colgroup>
            <col style="width:130px">
            <col style="width:190px">
            <col style="width:110px">
            <col style="width:80px">
            <col style="width:420px">
            <col style="width:220px">
            <col style="width:90px">
          </colgroup>
          <thead>
            <tr>
              <th>Date</th>
              <th>Caller</th>
              <th>Mailbox</th>
              <th>Length</th>
              <th>Transcript</th>
              <th>Match</th>
              <th>Source</th>
            </tr>
          </thead>
          <tbody>${body}</tbody>
        </table>`;
    }

    // ── Search filter ──────────────────────────────────────────
    function visitorProfileSearchText(visitor) {
      return `${visitor.visitor_id || ''} ${visitor.label || ''} ${visitor.contact_name || ''} ${visitor.contact_company || ''} ${visitor.contact_email || ''} ${visitor.contact_phone || ''} ${visitor.identity_source || ''} ${visitor.identity_confidence || ''} ${visitor.notes || ''} ${visitor.visitor_ip || ''} ${visitor.visitor_user_agent || ''} ${visitor.visitor_country || ''} ${visitor.visitor_region || ''} ${visitor.visitor_city || ''} ${visitor.visitor_as_organization || ''} ${visitor.source || ''} ${visitor.medium || ''} ${visitor.campaign || ''} ${visitor.term || ''} ${visitor.first_landing_page || ''} ${visitor.last_page || ''}`;
    }

    function visitorDisplayName(visitor) {
      return visitor.label || visitor.contact_name || visitor.contact_company || visitor.contact_email || '';
    }

    function visitorInitials(name) {
      const parts = String(name || '').trim().split(/\s+/).filter(Boolean);
      if (!parts.length) return '';
      return (parts[0][0] + (parts[1] ? parts[1][0] : '')).toUpperCase();
    }

    function formatWhen(iso) {
      if (!iso) return '';
      const d = new Date(iso);
      if (isNaN(d.getTime())) return esc(String(iso));
      return d.toLocaleString(undefined, { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' });
    }

    function submittedVisitorIdSet() {
      const set = new Set();
      for (const r of allData) {
        if (r.attribution_visitor_id) set.add(r.attribution_visitor_id);
      }
      return set;
    }

    function latestSubmissionForVisitor(visitorId) {
      if (!visitorId) return null;
      return allData.find(row =>
        row.attribution_visitor_id === visitorId
        && (row.email || row.created_at)
      ) || null;
    }

    function renderVisitorGrade(visitorId) {
      const record = latestSubmissionForVisitor(visitorId);
      if (!record) return '';
      const grade = leadGradeValue(record);
      const gradeClass = grade ? ` grade-${grade.toLowerCase()}` : '';
      return `<select class="va-grade-select${gradeClass}" data-grade-submission-id="${esc(record.id)}" title="Lead grade for ${esc(record.email || 'identified form submission')}">`
        + `<option value=""${grade ? '' : ' selected'}>-</option>`
        + `<option value="A"${grade === 'A' ? ' selected' : ''}>A</option>`
        + `<option value="B"${grade === 'B' ? ' selected' : ''}>B</option>`
        + `<option value="C"${grade === 'C' ? ' selected' : ''}>C</option>`
        + `</select>`;
    }

    function visitorHasPaidOrigin(visitor) {
      const src = String(visitor.source || '').toLowerCase();
      const med = String(visitor.medium || '').toLowerCase();
      const urls = [visitor.first_landing_page, visitor.last_page, visitor.referrer].filter(Boolean).join(' ').toLowerCase();
      return Boolean(visitor.gclid || visitor.gbraid || visitor.wbraid)
        || ['cpc', 'ppc', 'paid'].includes(med)
        || src.includes('googleads')
        || src.includes('gclid')
        || urls.includes('googleads')
        || urls.includes('gclid');
    }

    function visitorPaidDetail(visitor) {
      if (visitor.gclid) return 'Google Ads click (gclid)';
      if (visitor.gbraid) return 'Google Ads click (gbraid)';
      if (visitor.wbraid) return 'Google Ads click (wbraid)';
      return 'Paid traffic signal';
    }

    function visitorSourcePill(visitor) {
      const src = String(visitor.source || '').toLowerCase();
      const med = String(visitor.medium || '').toLowerCase();
      const hasPaid = visitorHasPaidOrigin(visitor);

      if (hasPaid) {
        return '<span class="va-pill va-pill-ads">Paid &middot; Google</span>';
      }
      const ai = aiReferralInfo(visitor);
      if (ai) {
        return `<span class="va-pill va-pill-ai">AI &middot; ${esc(ai.name)}</span>`;
      }
      if (med === 'organic' && src.includes('google')) {
        return '<span class="va-pill va-pill-org-g">Organic &middot; Google</span>';
      }
      if (src.includes('bing') || src.includes('msn') || src.includes('yahoo')) {
        return '<span class="va-pill va-pill-org-b">Organic &middot; Bing</span>';
      }
      if (!src || src === 'direct' || src === '(direct)' || src === 'none') {
        return '<span class="va-pill va-pill-neu">Direct</span>';
      }
      const detail = [visitor.source, visitor.medium].filter(Boolean).join('/');
      return `<span class="va-pill va-pill-neu">Other${detail ? ' &middot; ' + esc(detail) : ''}</span>`;
    }

    function qparam(url, names) {
      try {
        const u = new URL(url, 'https://x');
        for (const n of names) {
          const v = u.searchParams.get(n);
          if (v) return decodeURIComponent(v.replace(/\+/g, ' ')).trim();
        }
      } catch (e) {}
      return '';
    }

    function decipherKeyword(visitor) {
      if (visitor.term && visitor.term !== '(not provided)') return visitor.term;
      const urls = [visitor.last_page, visitor.first_landing_page, visitor.referrer].filter(Boolean);
      for (const u of urls) {
        const k = qparam(u, ['vt_keyword', 'utm_term', 'keyword', 'q', 'p']);
        if (k) return k;
      }
      return '';
    }

    function isIdentifiedVisitor(visitor, submitted) {
      return Boolean(
        submitted.has(visitor.visitor_id)
        || visitor.contact_name
        || visitor.contact_email
        || visitor.label
      );
    }

    // Build one StatCounter-style "label: value" pair.
    function vaPair(label, valueHtml) {
      if (!valueHtml) return '';
      return `<div class="va-pair"><span class="va-lbl">${esc(label)}</span><span class="va-val">${valueHtml}</span></div>`;
    }

    function parseEventMeta(raw) {
      if (!raw) return {};
      try {
        const parsed = JSON.parse(raw);
        return parsed && typeof parsed === 'object' ? parsed : {};
      } catch (e) {
        return {};
      }
    }

    function visitorOriginHtml(visitor) {
      const source = [visitor.source, visitor.medium].filter(Boolean).join(' / ');
      const urls = [visitor.first_landing_page, visitor.last_page, visitor.referrer].filter(Boolean);
      const gclidFromUrl = firstVisitorParam(visitor, ['gclid']);
      const gclid = visitor.gclid || gclidFromUrl || '';
      const gclidUrl = urls.find(raw => urlDisplayData(raw).params.get('gclid')) || '';
      const paramsUrl = urls.find(raw => urlDisplayData(raw).hasParams) || '';
      const disclosure = gclidUrl || (gclid ? `gclid=${gclid}` : paramsUrl);
      if (visitorHasPaidOrigin(visitor)) {
        return `<div class="va-origin"><strong>Origin:</strong> Google Ads${gclid ? '<span class="va-gclid-badge">GCLID captured</span>' : ''}${rawParamsToggle('', disclosure)}</div>`;
      }
      if (source) return `<div class="va-origin"><strong>Origin:</strong> ${esc(source)}</div>`;
      return '<div class="va-origin"><strong>Origin:</strong> Direct or unknown</div>';
    }

    function submissionEventsForVisitor(visitorId) {
      if (!visitorId) return [];
      return allData
        .filter(row => row.attribution_visitor_id === visitorId && row.created_at)
        .map(row => ({
          created_at: row.created_at,
          event_type: 'form_submit',
          page_path: row.attribution_current_page || '',
          page_title: formTypeLabel(row.form_type || row.attribution_form_name || 'contact'),
          attribution_json: JSON.stringify({
            target: formTypeLabel(row.form_type || row.attribution_form_name || 'contact'),
            link_text: [row.first_name, row.last_name, row.company].filter(Boolean).join(' ')
          })
        }));
    }

    function eventSortValue(event) {
      const time = new Date(event.created_at || '').getTime();
      return Number.isFinite(time) ? time : 0;
    }

    function eventTypeRank(event) {
      const type = String(event.event_type || 'pageview');
      if (type === 'pageview') return 0;
      if (type === 'phone_click') return 1;
      if (type === 'phone_voicemail') return 2;
      if (type === 'email_click') return 2;
      if (type === 'form_submit') return 3;
      return 4;
    }

    function compareTimelineEvents(a, b) {
      const timeDiff = eventSortValue(a) - eventSortValue(b);
      if (timeDiff) return timeDiff;
      return eventTypeRank(a) - eventTypeRank(b);
    }

    function renderTimelineEvent(event) {
      const type = String(event.event_type || 'pageview');
      const meta = parseEventMeta(event.attribution_json);
      const safeType = type.replace(/[^a-z0-9_-]/gi, '');
      const when = event.created_at ? formatWhen(event.created_at) : '';
      const rawPath = event.page_path || '';
      const title = event.page_title || '';
      const target = meta.target || '';
      const pathHtml = rawPath ? renderDisplayUrl(rawPath, 'va-event-path') : '';
      const fallback = target || title || (type === 'phone_voicemail' ? 'Phone lead' : 'No page recorded');
      const formContact = type === 'form_submit' && meta.link_text
        ? `<span class="va-event-form-contact">${esc(meta.link_text)}</span>`
        : '';
      return `
        <div class="va-event">
          <div class="va-event-time">${esc(when)}</div>
          <span class="va-event-type va-event-type-${esc(safeType)}">${esc(type.replace(/_/g, ' '))}</span>
          <div class="va-event-main">${pathHtml || esc(fallback)}${formContact}</div>
        </div>`;
    }

    function renderVisitorTimeline(visitorId, events, visitor) {
      const workerEvents = Array.isArray(events) ? events : [];
      const hasWorkerFormSubmit = workerEvents.some(event => event && event.event_type === 'form_submit');
      const merged = workerEvents
        .concat(hasWorkerFormSubmit ? [] : submissionEventsForVisitor(visitorId))
        .filter(event => event && event.created_at)
        .sort(compareTimelineEvents);
      const body = merged.length
        ? `<div class="va-event-list">${merged.map(renderTimelineEvent).join('')}</div>`
        : '<div class="va-timeline-empty">No page, call, email, or form events found for this visitor yet.</div>';
      return `
        ${visitorOriginHtml(visitor || {})}
        <div class="va-timeline">
          <div class="va-timeline-head">Visitor event timeline</div>
          ${body}
        </div>`;
    }

    function renderVisitorTimelineShell(visitor) {
      const visitorId = visitor && visitor.visitor_id ? String(visitor.visitor_id) : '';
      if (!visitorId) return '';
      if (visitorEventsCache.has(visitorId)) {
        return `<div data-visitor-timeline="${esc(visitorId)}">${renderVisitorTimeline(visitorId, visitorEventsCache.get(visitorId), visitor)}</div>`;
      }
      return `
        <div data-visitor-timeline="${esc(visitorId)}">
          ${visitorOriginHtml(visitor)}
          <div class="va-timeline">
            <div class="va-timeline-head">Visitor event timeline</div>
            <div class="va-timeline-empty">Open row to load activity...</div>
          </div>
        </div>`;
    }

    async function loadVisitorTimeline(visitorId) {
      if (!visitorId) return;
      const containers = visitorDirectory.querySelectorAll(`[data-visitor-timeline="${cssEscape(visitorId)}"]`);
      if (!containers.length) return;
      const visitor = allVisitors.find(v => v.visitor_id === visitorId) || {};
      if (visitorEventsCache.has(visitorId)) {
        containers.forEach(el => { el.innerHTML = renderVisitorTimeline(visitorId, visitorEventsCache.get(visitorId), visitor); });
        return;
      }
      if (visitorEventsLoading.has(visitorId)) return;
      const token = currentToken();
      if (!token) return;
      visitorEventsLoading.add(visitorId);
      containers.forEach(el => {
        el.innerHTML = `
          ${visitorOriginHtml(visitor)}
          <div class="va-timeline">
            <div class="va-timeline-head">Visitor event timeline</div>
            <div class="va-timeline-empty">Loading activity...</div>
          </div>`;
      });
      try {
        const resp = await fetch(`${WORKER_URL}/admin/visitors/${encodeURIComponent(visitorId)}/events`, {
          headers: { 'Authorization': `Bearer ${token}` }
        });
        if (resp.status === 401) { logout(); return; }
        if (!resp.ok) throw new Error('Visitor event load failed');
        const json = await resp.json();
        const events = json && json.success === true ? (json.data || []) : [];
        visitorEventsCache.set(visitorId, events);
        containers.forEach(el => { el.innerHTML = renderVisitorTimeline(visitorId, events, visitor); });
      } catch (err) {
        containers.forEach(el => {
          el.innerHTML = `
            ${visitorOriginHtml(visitor)}
            <div class="va-timeline">
              <div class="va-timeline-head">Visitor event timeline</div>
              <div class="va-timeline-empty">Failed to load activity for this visitor.</div>
            </div>`;
        });
      } finally {
        visitorEventsLoading.delete(visitorId);
      }
    }

    // Body-level dots popup state. renderVisitorDirectory closes it before
    // replacing row markup so a popup cannot outlive its source badge.
    let dotsPopupEl = null;
    let dotsPopupAnchor = null;

    // Scheme-guarded link for Line 2. last_page/referrer come from the public,
    // unauthenticated tracking beacons, so only render an <a> for http(s); any
    // other scheme falls back to inert text so the admin origin can't be a click sink.
    function safeUrlLink(raw, cls) {
      return renderDisplayUrl(raw, cls);
    }

    function vaDetailPair(label, valueHtml) {
      if (!valueHtml) return '';
      return `<dt>${esc(label)}</dt><dd>${valueHtml}</dd>`;
    }

    // Expanded detail panel for a visitor row — holds everything hidden from the
    // compact row: cookie/GA/StatCounter IDs, full IP/UA/URLs, network, visit
    // trail (timeline), plus the Save Visitor controls (incl. grade).
    function renderVisitorRowDetail(visitor, visitorId) {
      const network = [visitor.visitor_asn ? 'AS' + visitor.visitor_asn : '', visitor.visitor_as_organization || ''].filter(Boolean).join(' ');
      const locCity = String(visitor.visitor_city || '').trim();
      const locRegion = String(visitor.visitor_region || '').trim();
      const location = [
        locCity,
        (locRegion && locRegion.toLowerCase() !== locCity.toLowerCase()) ? locRegion : '',
        String(visitor.visitor_country || '').trim(),
      ].filter(Boolean).join(', ');
      const visits = Number(visitor.visit_count || 0);
      const pageviews = Number(visitor.pageview_count || 0);
      const ua = visitor.visitor_user_agent || '';
      const uaDetails = ua
        ? `<details class="attrib-details"><summary>${esc(browserSummary(ua))}</summary><div class="context-ua-text">${esc(ua)}</div></details>`
        : '';
      const keyword = (visitor.term && visitor.term !== '(not provided)')
        ? visitor.term
        : firstVisitorParam(visitor, ['vt_keyword']);
      const sourceValue = visitor.source || firstVisitorParam(visitor, ['utm_source']);
      const sourceText = [sourceValue, visitor.medium].filter(Boolean).join(' / ');
      const campaignId = firstVisitorParam(visitor, ['gad_campaignid', 'vt_campaign']);
      const gclid = visitor.gclid || firstVisitorParam(visitor, ['gclid']);
      return `
        <div class="attrib-panel">
          <div class="attrib-source">Visitor detail</div>
          <dl class="va-detail-grid">
            ${vaDetailPair('Cookie ID', visitorId ? esc(visitorId) : '')}
            ${vaDetailPair('IP', visitor.visitor_ip ? esc(visitor.visitor_ip) : '')}
            ${vaDetailPair('Network / AS', network ? esc(network) : '')}
            ${vaDetailPair('Location', location ? esc(location) : '')}
            ${vaDetailPair('Language', visitor.visitor_accept_language ? esc(visitor.visitor_accept_language) : '')}
            ${vaDetailPair('CF-Ray', visitor.visitor_cf_ray ? esc(visitor.visitor_cf_ray) : '')}
            ${vaDetailPair('First seen', visitor.first_seen_at ? esc(formatWhen(visitor.first_seen_at)) : '')}
            ${vaDetailPair('Last seen', visitor.last_seen_at ? esc(formatWhen(visitor.last_seen_at)) : '')}
            ${vaDetailPair('Visits', visits ? esc(String(visits)) : '')}
            ${vaDetailPair('Page views', pageviews ? esc(String(pageviews)) : '')}
            ${vaDetailPair('Keyword', keyword ? esc(keyword) : '')}
            ${vaDetailPair('Source', sourceText ? esc(sourceText) : '')}
            ${vaDetailPair('Campaign', visitor.campaign ? esc(visitor.campaign) : '')}
            ${vaDetailPair('Campaign ID', campaignId ? esc(campaignId) : '')}
            ${vaDetailPair('Google click ID', gclid ? '<span class="va-gclid-badge">GCLID captured</span>' : '')}
            ${vaDetailPair('Landing page', renderDisplayUrl(visitor.first_landing_page || ''))}
            ${vaDetailPair('Current page', renderDisplayUrl(visitor.last_page || ''))}
            ${vaDetailPair('Referrer', renderDisplayUrl(visitor.referrer || ''))}
            ${vaDetailPair('GA client ID', visitor.ga_client_id ? esc(visitor.ga_client_id) : '')}
            ${vaDetailPair('StatCounter ID', visitor.statcounter_visitor_id ? esc(visitor.statcounter_visitor_id) : '')}
            ${vaDetailPair('Browser', uaDetails)}
          </dl>
          ${visitorId ? renderVisitorTimelineShell(visitor) : ''}
          ${visitorId ? renderVisitorIdentityControls(visitor, visitorId) : ''}
        </div>`;
    }

    function renderVisitorDirectory(visitors) {
      closeDotsPopup();
      const submitted = submittedVisitorIdSet();
      const filteredByView = knownOnly
        ? visitors.filter(v => isIdentifiedVisitor(v, submitted))
        : visitors;
      const total = filteredByView.length;
      visitorsPage = clampPage(visitorsPage, total);
      const shown = pageSlice(filteredByView, visitorsPage);
      const identifiedCount = visitors.filter(v => isIdentifiedVisitor(v, submitted)).length;
      const cap = visitorsTruncated ? ' · showing newest 10k' : '';
      const countLabel = knownOnly
        ? `${total} known visitor${total !== 1 ? 's' : ''}${cap}`
        : `${total} visitor${total !== 1 ? 's' : ''} · ${identifiedCount} identified${cap}`;
      const heading = `
        <div class="va-head">
          <span class="va-count">${countLabel}</span>
          <span class="va-legend"><span class="va-dot-id"></span> identified / filled form · newest first</span>
        </div>`;

      if (shown.length === 0) {
        const emptyMsg = knownOnly
          ? 'No identified visitors yet. Visitors who fill a form — or that you name/label — appear here.'
          : 'No visitors match this filter yet. Tracking went live recently — new visitors appear here as they browse the site.';
        visitorDirectory.innerHTML = `${heading}<div class="attrib-muted" style="padding:14px;">${emptyMsg}</div>`;
        renderPager(visitorPager, total, visitorsPage, 'visitors');
        return;
      }

      visitorDirectory.innerHTML = `${heading}<div class="va-log-sc">${shown.map(visitor => {
        const visitorId = visitor.visitor_id || '';
        const isFiller = submitted.has(visitorId);
        const name = visitorDisplayName(visitor);
        const isIdentified = isIdentifiedVisitor(visitor, submitted);
        const visits = Number(visitor.visit_count || 0);
        const pageviews = Number(visitor.pageview_count || 0);
        const isReturning = visits > 1;

        // "Connected dots" — count how many distinct signal types fuse on this profile.
        const srcL = String(visitor.source || '').toLowerCase();
        const hasIdentity = Boolean(visitor.contact_name || visitor.contact_email || visitor.contact_phone || visitor.label);
        const hasConversion = isFiller;
        const hasPaid = visitorHasPaidOrigin(visitor);
        const hasSource = Boolean(visitor.term) || (srcL && srcL !== 'direct' && srcL !== '(direct)' && srcL !== 'none');
        const dots = [hasIdentity, hasConversion, hasPaid, isReturning, hasSource].filter(Boolean).length;
        const fullCircle = hasIdentity && hasConversion && (hasPaid || hasSource);
        const connectClass = fullCircle ? 'va-fullcircle' : (dots >= 3 ? 'va-connected' : (isIdentified ? 'identified' : ''));
        // Per-signal breakdown for the click-popup (which dots are linked + why).
        const sourceDetail = visitor.term
          ? esc(visitor.term)
          : esc([visitor.source, visitor.medium].filter(Boolean).join(' / '));
        const signalRows = [
          { on: hasIdentity, label: 'Identity', detail: esc(visitor.contact_name || visitor.contact_email || visitor.contact_phone || visitor.label || '') },
          { on: hasConversion, label: 'Filled a form', detail: 'Submitted a lead form' },
          { on: hasPaid, label: 'Paid click', detail: visitorPaidDetail(visitor) },
          { on: isReturning, label: 'Returning', detail: '&times;' + visits + ' visits' },
          { on: hasSource, label: 'Traffic source', detail: sourceDetail },
        ];
        const signalsHtml =
          `<div class="va-pop-head">${dots} of 5 signals linked${fullCircle ? ' &middot; 🎯 full circle' : ''}</div>`
          + signalRows.map(s =>
              `<div class="va-pop-row ${s.on ? 'on' : 'off'}"><span class="va-pop-mark">${s.on ? '✓' : '·'}</span><span class="va-pop-lbl">${s.label}</span>${s.on && s.detail ? `<span class="va-pop-det">${s.detail}</span>` : ''}</div>`
            ).join('');
        const connectBadge = (fullCircle || dots >= 3)
          ? `<span class="va-dots-wrap">`
            + `<button type="button" class="${fullCircle ? 'va-badge-circle' : 'va-badge-connected'}" data-dots-toggle title="Click for signal details">${fullCircle ? '🎯 Full circle' : '🔗 ' + dots + ' dots'}</button>`
            + `<span class="va-dots-pop" hidden>${signalsHtml}</span>`
            + `</span>`
          : '';
        const quickTagBtn = visitorId
          ? `<button type="button" class="va-quicktag" data-quick-tag-id="${esc(visitorId)}" title="Quick name / tag this visitor">🏷 ${name ? 'Re-tag' : 'Name'}</button>`
          : '';
        const sourcePill = visitorSourcePill(visitor);

        // Line 1 — geo (flag + deduped "City, Region"), ISP, browser/OS marker
        const geo = locationDisplay(visitor);
        const geoInner = geo.has
          ? `${geo.flagHtml ? geo.flagHtml + ' ' : ''}${esc(geo.loc || '')}`
          : `#${esc(String(visitorId).slice(0, 10))}`;
        const geoHtml = `<span class="va-l1-geo">${geoInner}</span>`;
        const isp = visitor.visitor_as_organization || '';
        const ispHtml = isp ? `<span class="va-l1-isp">${esc(isp)}</span>` : '';
        const osHtml = browserOsMarker(visitor.visitor_user_agent || '');
        const timeHtml = `<span class="va-l1-time">${esc(formatWhen(visitor.last_seen_at))}</span>`;

        // Identity chip (name / company), shown only when identified
        const identityLabel = name
          ? name + ((visitor.contact_company && visitor.contact_company !== name) ? ' · ' + visitor.contact_company : '')
          : '';
        const identityChip = identityLabel
          ? `<span class="va-chip va-chip-id" title="Identified visitor">${esc(identityLabel)}</span>`
          : '';

        // The visitor card grades the latest linked form submission through the
        // same submission endpoint and state used by the Form Submissions tab.
        const gradeSelect = renderVisitorGrade(visitorId);

        // Visit-# badge + RETURNING badge
        const visitN = visits || 1;
        const visitBadge = `<span class="va-visitbadge" title="${esc(pageviews + ' pageviews over ' + visitN + ' visit' + (visitN === 1 ? '' : 's'))}">${visitN}&times;</span>`;
        const retBadge = isReturning ? '<span class="va-retbadge">Returning</span>' : '';

        // Action chips — grounded in signals known at the profile level
        const actionChips =
          (isFiller ? '<span class="va-chip va-chip-action-form" title="Submitted a lead form">Form</span>' : '')
          + (hasPaid ? '<span class="va-chip va-chip-action" title="Arrived via a paid Google click">Ad click</span>' : '');

        // Line 2 — entry/last page, referrer, keyword (all scheme-guarded)
        const keyword = decipherKeyword(visitor);
        const lastPageHtml = safeUrlLink(visitor.last_page || visitor.first_landing_page || '', 'va-l2-page');
        const refHtml = visitor.referrer ? safeUrlLink(visitor.referrer, 'va-l2-ref') : '';
        const kwHtml = keyword ? `<span class="va-l2-kw" title="Search keyword">${esc(keyword)}</span>` : '';
        const line2Parts = [lastPageHtml, refHtml, kwHtml].filter(Boolean);
        const line2 = line2Parts.length
          ? line2Parts.join('<span class="va-l2-sep">·</span>')
          : '<span class="va-l2-ref">No landing page recorded</span>';

        return `
          <div class="va-vrow" data-visitor-id="${esc(visitorId)}">
            <div class="va-row-sc ${connectClass}" data-va-expand>
              <div class="va-row-sc-body">
                <div class="va-line1">${timeHtml}${geoHtml}${ispHtml}${osHtml}${visitBadge}${retBadge}${identityChip}${gradeSelect}${sourcePill}${connectBadge}${actionChips}${quickTagBtn}</div>
                <div class="va-line2">${line2}</div>
              </div>
              <button type="button" class="va-magnify" data-va-expand aria-label="Toggle details"><svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M4 6 L8 10 L12 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
            </div>
            <div class="va-detail-sc" data-visitor-detail="${esc(visitorId)}">${renderVisitorRowDetail(visitor, visitorId)}</div>
          </div>`;
      }).join('')}</div>`;
      renderPager(visitorPager, total, visitorsPage, 'visitors');
    }

    function applyInitialSearch() {
      if (initialSearch && !searchInput.value) searchInput.value = initialSearch;
    }

    function applySearch() {
      const q = searchInput.value.toLowerCase();
      // Leads — date range is already applied server-side; this is the in-range text filter.
      const leadsFiltered = allData.filter(r =>
        `${r.first_name} ${r.last_name} ${r.company} ${r.email} ${r.phone} ${r.fluid_type} ${r.country} ${r.additional_details} ${r.form_type} ${googleAttributionSearchText(r)} ${visitorContextSearchText(r)}`
          .toLowerCase().includes(q)
      );
      leadsPage = clampPage(leadsPage, leadsFiltered.length);
      renderTable(pageSlice(leadsFiltered, leadsPage));
      renderPager(leadsPager, leadsFiltered.length, leadsPage, 'leads');
      const returning = leadsFiltered.filter(isReturningRecord).length;

      // Visitors — text filter, then the activity toggle-filters, then
      // renderVisitorDirectory applies the known-only view + pagination.
      const submittedForFilter = submittedVisitorIdSet();
      const gradedLeadVisitors = new Set(
        allData.filter(isLeadGraded).map(r => r.attribution_visitor_id).filter(Boolean)
      );
      let visitorsFiltered = allVisitors.filter(visitor =>
        visitorProfileSearchText(visitor).toLowerCase().includes(q)
      );
      if (activeFilters.identified) visitorsFiltered = visitorsFiltered.filter(v => isIdentifiedVisitor(v, submittedForFilter));
      if (activeFilters.graded) visitorsFiltered = visitorsFiltered.filter(v => gradedLeadVisitors.has(v.visitor_id));
      if (activeFilters.paid) visitorsFiltered = visitorsFiltered.filter(v => visitorHasPaidOrigin(v));
      if (activeFilters.ai) visitorsFiltered = visitorsFiltered.filter(v => isAiReferral(v));
      renderVisitorDirectory(visitorsFiltered);

      // The toggle-filter bar only makes sense on the visitor views.
      const fBar = document.getElementById('visitor-filter-bar');
      if (fBar) fBar.style.display = (activeView === 'activity' || activeView === 'known') ? 'flex' : 'none';

      const callsFiltered = allCalls.filter(call =>
        callSearchText(call).toLowerCase().includes(q)
      );
      renderCalls(callsFiltered);

      if (activeView === 'calls') {
        countBadge.textContent =
          `${callsFiltered.length} phone lead${callsFiltered.length === 1 ? '' : 's'}${callsTruncated ? ' · showing newest 10k' : ''}`;
      } else if (activeView === 'pages') {
        const pageRows = (pagesData && pagesData[pagesTab]) || [];
        const pageLabel = pagesTab === 'top' ? 'page' : `${pagesTab} page`;
        countBadge.textContent =
          `${pageRows.length} ${pageLabel}${pageRows.length === 1 ? '' : 's'}`;
      } else if (activeView === 'activity' || activeView === 'known') {
        const submitted = submittedVisitorIdSet();
        const visitorTotal = knownOnly
          ? visitorsFiltered.filter(v => isIdentifiedVisitor(v, submitted)).length
          : visitorsFiltered.length;
        countBadge.textContent =
          `${visitorTotal} visitor${visitorTotal === 1 ? '' : 's'}${visitorsTruncated ? ' · showing newest 10k' : ''}`;
      } else {
        countBadge.textContent =
          `${leadsFiltered.length} ${leadsFiltered.length === 1 ? 'entry' : 'entries'} · ${returning} returning${dataTruncated ? ' · showing newest 10k' : ''}`;
      }
    }

    searchInput.addEventListener('input', () => { leadsPage = 1; visitorsPage = 1; applySearch(); });

    // ── Date range + rows-per-page + pagination wiring ────────
    function syncCustomDateInputs() {
      const isCustom = datePreset.value === 'custom';
      dateStart.style.display = isCustom ? '' : 'none';
      dateEnd.style.display = isCustom ? '' : 'none';
    }
    datePreset.addEventListener('change', () => {
      if (datePreset.value === 'custom') {
        // Entering custom: start fresh (don't silently reuse stale dates);
        // the range applies once the user picks the dates (applyCustomDates).
        dateStart.value = '';
        dateEnd.value = '';
        syncCustomDateInputs();
        return;
      }
      syncCustomDateInputs();
      const r = computeRange(datePreset.value);
      curStart = r.start; curEnd = r.end;
      reloadForRange();
    });
    function applyCustomDates() {
      if (datePreset.value !== 'custom') return;
      let s = dateStart.value || null;
      let e = dateEnd.value || null;
      // Guard an inverted range — swap so start <= end instead of silently returning nothing.
      if (s && e && s > e) { const t = s; s = e; e = t; dateStart.value = s; dateEnd.value = e; }
      curStart = s;
      curEnd = e;
      reloadForRange();
    }
    dateStart.addEventListener('change', applyCustomDates);
    dateEnd.addEventListener('change', applyCustomDates);

    rowsPerPageSel.addEventListener('change', () => {
      rowsPerPage = Number(rowsPerPageSel.value) || 50;
      leadsPage = 1; visitorsPage = 1;
      applySearch();
    });

    function onPagerClick(e) {
      const btn = e.target.closest('button[data-pg-dir]');
      if (!btn) return;
      const dir = btn.dataset.pgDir === 'next' ? 1 : -1;
      if (btn.dataset.pgKind === 'leads') leadsPage += dir; else visitorsPage += dir;
      applySearch();
    }
    leadsPager.addEventListener('click', onPagerClick);
    visitorPager.addEventListener('click', onPagerClick);

    // ── Delete: event delegation on table container ─────────
    let pendingDeleteId = null;

    function getDeleteModalEls() {
      return {
        deleteModal: document.getElementById('delete-modal'),
        modalConfirm: document.getElementById('modal-confirm'),
        modalCancel: document.getElementById('modal-cancel'),
      };
    }

    tableContainer.addEventListener('click', function(e) {
      const saveVisitorBtn = e.target.closest('[data-save-visitor-id]');
      if (saveVisitorBtn) {
        saveVisitorSettings(saveVisitorBtn);
        return;
      }

      const btn = e.target.closest('[data-delete-id]');
      if (!btn) return;
      pendingDeleteId = Number(btn.dataset.deleteId);
      const { deleteModal } = getDeleteModalEls();
      if (deleteModal) deleteModal.style.display = 'flex';
    });

    dashboard.addEventListener('click', function(e) {
      const toggle = e.target.closest('[data-url-params-toggle]');
      if (!toggle) return;
      e.preventDefault();
      e.stopPropagation();
      const raw = toggle.parentElement && toggle.parentElement.querySelector('.va-url-raw');
      if (!raw) return;
      const willOpen = raw.hidden;
      raw.hidden = !willOpen;
      toggle.setAttribute('aria-expanded', willOpen ? 'true' : 'false');
      toggle.textContent = willOpen ? '- params' : '+ params';
    });

    visitorDirectory.addEventListener('click', function(e) {
      // Interactive controls first — these must never toggle the row.
      const quickTagBtn = e.target.closest('[data-quick-tag-id]');
      if (quickTagBtn) {
        e.preventDefault();
        e.stopPropagation();
        quickTagVisitor(quickTagBtn.dataset.quickTagId);
        return;
      }
      const dotsToggle = e.target.closest('[data-dots-toggle]');
      if (dotsToggle) {
        e.preventDefault();
        e.stopPropagation();
        const src = dotsToggle.parentElement.querySelector('.va-dots-pop');
        const reopen = dotsPopupAnchor === dotsToggle;
        closeDotsPopup();
        if (!reopen) openDotsPopup(dotsToggle, src ? src.innerHTML : '');
        return;
      }
      const saveVisitorBtn = e.target.closest('[data-save-visitor-id]');
      if (saveVisitorBtn) { saveVisitorSettings(saveVisitorBtn); return; }
      // The grade dropdown, links, and anything inside the detail panel handle
      // themselves — never toggle the row for those.
      if (e.target.closest('[data-grade-submission-id]') || e.target.closest('[data-url-params-toggle]')
        || e.target.closest('a') || e.target.closest('details') || e.target.closest('.va-detail-sc')) return;
      // Otherwise a click anywhere on the compact row toggles its detail panel.
      const expander = e.target.closest('[data-va-expand]');
      if (!expander) return;
      const wrap = expander.closest('.va-vrow');
      if (wrap) toggleVisitorDetail(wrap);
    });

    // Lead grade selectors save straight to submissions.grade.
    dashboard.addEventListener('change', function(e) {
      const gradeSel = e.target.closest('[data-grade-submission-id]');
      if (!gradeSel) return;
      saveSubmissionGrade(gradeSel.dataset.gradeSubmissionId, gradeSel.value);
    });

    // Expand/collapse a compact row's detail panel; lazy-load its timeline on open.
    function toggleVisitorDetail(wrap) {
      const row = wrap.querySelector('.va-row-sc');
      const detail = wrap.querySelector('.va-detail-sc');
      if (!row || !detail) return;
      const isOpen = detail.classList.toggle('open');
      row.classList.toggle('va-detail-open', isOpen);
      if (isOpen) loadVisitorTimeline(wrap.dataset.visitorId);
    }

    // ── Visitor Activity filter toggles ───────────────────────
    (function wireVisitorFilters() {
      const bar = document.getElementById('visitor-filter-bar');
      if (!bar) return;
      bar.addEventListener('click', function(e) {
        const btn = e.target.closest('.sc-filter-btn[data-filter]');
        if (!btn) return;
        const key = btn.dataset.filter;
        if (!(key in activeFilters)) return;
        activeFilters[key] = !activeFilters[key];
        btn.classList.toggle('active', activeFilters[key]);
        visitorsPage = 1;
        applySearch();
      });
    })();

    // ── Weekly growth-ops report download ─────────────────────
    (function wireWeeklyReport() {
      const btn = document.getElementById('weekly-report-btn');
      if (btn) btn.addEventListener('click', downloadWeeklyReport);
    })();

    function closeDotsPopup() {
      if (dotsPopupEl) { dotsPopupEl.remove(); dotsPopupEl = null; }
      dotsPopupAnchor = null;
    }
    function openDotsPopup(anchor, html) {
      const el = document.createElement('div');
      el.className = 'va-dots-pop';
      el.innerHTML = html;
      document.body.appendChild(el);
      const r = anchor.getBoundingClientRect();
      const maxLeft = window.innerWidth - el.offsetWidth - 10;
      el.style.top = (r.bottom + 6) + 'px';
      el.style.left = Math.max(10, Math.min(r.left, maxLeft)) + 'px';
      dotsPopupEl = el;
      dotsPopupAnchor = anchor;
    }
    document.addEventListener('click', function(e) {
      if (e.target.closest('[data-dots-toggle]') || e.target.closest('.va-dots-pop')) return;
      closeDotsPopup();
    });
    window.addEventListener('scroll', closeDotsPopup, true);
    window.addEventListener('resize', closeDotsPopup);

    async function saveVisitorSettings(button) {
      const visitorId = button.dataset.saveVisitorId;
      if (!visitorId) return;
      const token = sessionStorage.getItem(SESSION_KEY);
      const labelInput = dashboard.querySelector(`[data-visitor-label="${cssEscape(visitorId)}"]`);
      const contactNameInput = dashboard.querySelector(`[data-visitor-contact-name="${cssEscape(visitorId)}"]`);
      const contactCompanyInput = dashboard.querySelector(`[data-visitor-contact-company="${cssEscape(visitorId)}"]`);
      const contactEmailInput = dashboard.querySelector(`[data-visitor-contact-email="${cssEscape(visitorId)}"]`);
      const contactPhoneInput = dashboard.querySelector(`[data-visitor-contact-phone="${cssEscape(visitorId)}"]`);
      const notesInput = dashboard.querySelector(`[data-visitor-notes="${cssEscape(visitorId)}"]`);
      const alertInput = dashboard.querySelector(`[data-visitor-alert="${cssEscape(visitorId)}"]`);
      const emailInput = dashboard.querySelector(`[data-visitor-email="${cssEscape(visitorId)}"]`);
      const statusEl = dashboard.querySelector(`[data-visitor-status="${cssEscape(visitorId)}"]`);
      const payload = {
        label: labelInput ? labelInput.value.trim() : '',
        contact_name: contactNameInput ? contactNameInput.value.trim() : '',
        contact_company: contactCompanyInput ? contactCompanyInput.value.trim() : '',
        contact_email: contactEmailInput ? contactEmailInput.value.trim() : '',
        contact_phone: contactPhoneInput ? contactPhoneInput.value.trim() : '',
        identity_source: 'manual',
        identity_confidence: 'manual-confirmed',
        notes: notesInput ? notesInput.value.trim() : '',
        alert_enabled: alertInput ? alertInput.checked : false,
        alert_email: emailInput ? emailInput.value.trim() : 'sales@dolphincentrifuge.com',
      };

      button.disabled = true;
      if (statusEl) statusEl.textContent = 'Saving...';

      try {
        const resp = await fetch(`${WORKER_URL}/admin/visitors/${encodeURIComponent(visitorId)}`, {
          method: 'POST',
          headers: {
            'Authorization': `Bearer ${token}`,
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(payload),
        });
        if (!resp.ok) throw new Error('Save failed');

        allData = allData.map(row => {
          if (row.attribution_visitor_id !== visitorId) return row;
          return {
            ...row,
            visitor_label: payload.label,
            visitor_contact_name: payload.contact_name,
            visitor_contact_company: payload.contact_company,
            visitor_contact_email: payload.contact_email,
            visitor_contact_phone: payload.contact_phone,
            visitor_identity_source: payload.identity_source,
            visitor_identity_confidence: payload.identity_confidence,
            visitor_notes: payload.notes,
            visitor_alert_enabled: payload.alert_enabled ? 1 : 0,
            visitor_alert_email: payload.alert_email,
          };
        });
        allVisitors = allVisitors.map(visitor => {
          if (visitor.visitor_id !== visitorId) return visitor;
          return {
            ...visitor,
            label: payload.label,
            contact_name: payload.contact_name,
            contact_company: payload.contact_company,
            contact_email: payload.contact_email,
            contact_phone: payload.contact_phone,
            identity_source: payload.identity_source,
            identity_confidence: payload.identity_confidence,
            notes: payload.notes,
            alert_enabled: payload.alert_enabled ? 1 : 0,
            alert_email: payload.alert_email,
          };
        });
        applySearch();
      } catch (err) {
        if (statusEl) statusEl.textContent = 'Save failed';
        button.disabled = false;
      }
    }

    // Quick name/tag straight from a visitor row (StatCounter-style), reusing the
    // same /admin/visitors save endpoint. Merges with existing fields so a fast
    // tag never wipes previously-saved contact details.
    async function quickTagVisitor(visitorId) {
      if (!visitorId) return;
      const existing = allVisitors.find(v => v.visitor_id === visitorId) || {};
      const current = existing.label || existing.contact_name || '';
      const entered = window.prompt('Quick name / tag for this visitor (phone match, form, your read, IP — your call):', current);
      if (entered === null) return; // cancelled
      const tag = entered.trim();
      const token = sessionStorage.getItem(SESSION_KEY);
      const payload = {
        label: tag,
        contact_name: existing.contact_name || '',
        contact_company: existing.contact_company || '',
        contact_email: existing.contact_email || '',
        contact_phone: existing.contact_phone || '',
        identity_source: 'manual',
        identity_confidence: 'manual-quick',
        notes: existing.notes || '',
        alert_enabled: existing.alert_enabled ? true : false,
        alert_email: existing.alert_email || 'sales@dolphincentrifuge.com',
      };
      try {
        const resp = await fetch(`${WORKER_URL}/admin/visitors/${encodeURIComponent(visitorId)}`, {
          method: 'POST',
          headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        if (!resp.ok) throw new Error('Save failed');
        allVisitors = allVisitors.map(v => v.visitor_id === visitorId
          ? { ...v, label: tag, identity_source: 'manual', identity_confidence: 'manual-quick' } : v);
        allData = allData.map(row => row.attribution_visitor_id === visitorId
          ? { ...row, visitor_label: tag, visitor_identity_source: 'manual' } : row);
        applySearch();
      } catch (err) {
        alert('Could not save the tag. Please try again.');
      }
    }

    async function saveSubmissionGrade(submissionId, value) {
      if (!submissionId) return;
      const grade = (value === 'A' || value === 'B' || value === 'C') ? value : '';
      const token = sessionStorage.getItem(SESSION_KEY);
      const now = new Date().toISOString();
      const reason = grade ? 'manual dashboard grade' : 'manual dashboard cleared grade';
      allData = allData.map(r => String(r.id) === String(submissionId)
        ? { ...r, grade: grade, grade_source: 'manual', grade_reason: reason, graded_at: now }
        : r);
      const selects = dashboard.querySelectorAll(`[data-grade-submission-id="${cssEscape(submissionId)}"]`);
      selects.forEach(sel => {
        if (sel.value !== grade) sel.value = grade;
        if (sel.classList.contains('lead-grade-select') || sel.classList.contains('va-grade-select')) {
          sel.classList.remove('grade-a', 'grade-b', 'grade-c');
          if (grade) sel.classList.add('grade-' + grade.toLowerCase());
        }
      });
      try {
        const resp = await fetch(`${WORKER_URL}/admin/submissions/${encodeURIComponent(submissionId)}`, {
          method: 'POST',
          headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
          body: JSON.stringify({ grade }),
        });
        if (resp.status === 401) { logout(); return; }
        if (!resp.ok) throw new Error('Grade save failed');
        const json = await resp.json().catch(() => ({}));
        allData = allData.map(r => String(r.id) === String(submissionId)
          ? {
              ...r,
              grade: json.grade || '',
              grade_source: json.grade_source || 'manual',
              grade_reason: json.grade_reason || reason,
              graded_at: json.graded_at || now,
            }
          : r);
        applySearch();
      } catch (err) {
        alert('Could not save the grade. Please try again.');
        loadSubmissions(token);
      }
    }

    // Download the 14-day growth-ops report (admin-gated JSON) as a file.
    async function downloadWeeklyReport() {
      const btn = document.getElementById('weekly-report-btn');
      const token = sessionStorage.getItem(SESSION_KEY);
      if (!token) { logout(); return; }
      const original = btn ? btn.textContent : '';
      if (btn) { btn.disabled = true; btn.textContent = 'Building…'; }
      try {
        const resp = await fetch(`${WORKER_URL}/admin/api/weekly-report?days=14`, {
          headers: { 'Authorization': `Bearer ${token}` },
        });
        if (resp.status === 401) { logout(); return; }
        if (!resp.ok) throw new Error('Report request failed');
        const json = await resp.json();
        const blob = new Blob([JSON.stringify(json, null, 2)], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        const stamp = String(json.generated_at || new Date().toISOString()).slice(0, 10);
        a.href = url;
        a.download = `dolphin-weekly-report-${stamp}.json`;
        document.body.appendChild(a);
        a.click();
        a.remove();
        URL.revokeObjectURL(url);
      } catch (err) {
        alert('Could not generate the weekly report. Please try again.');
      } finally {
        if (btn) { btn.disabled = false; btn.textContent = original; }
      }
    }

    document.addEventListener('DOMContentLoaded', function() {
      const { deleteModal, modalConfirm, modalCancel } = getDeleteModalEls();
      if (!deleteModal || !modalConfirm || !modalCancel) return;

      modalCancel.addEventListener('click', function() {
      deleteModal.style.display = 'none';
      pendingDeleteId = null;
    });

    modalConfirm.addEventListener('click', async function() {
      if (!pendingDeleteId) return;
      const id    = pendingDeleteId;
      const token = sessionStorage.getItem(SESSION_KEY);
      deleteModal.style.display = 'none';
      pendingDeleteId = null;

      modalConfirm.textContent = 'Deleting…';
      modalConfirm.disabled = true;

      try {
        const resp = await fetch(`${WORKER_URL}/admin/submissions/${id}`, {
          method: 'DELETE',
          headers: { 'Authorization': `Bearer ${token}` }
        });
        if (resp.ok) {
          allData = allData.filter(r => r.id !== id);
          applySearch();   // re-filter + re-paginate + refresh badge/pager
        } else {
          alert('Delete failed — server returned an error.');
        }
      } catch (err) {
        alert('Connection error. Please try again.');
      } finally {
        modalConfirm.textContent = 'Yes, Delete';
        modalConfirm.disabled = false;
      }
    });

    // Close modal on backdrop click
    deleteModal.addEventListener('click', function(e) {
      if (e.target === deleteModal) {
        deleteModal.style.display = 'none';
        pendingDeleteId = null;
      }
    });

    // ── Helpers ────────────────────────────────────────────────
    });

    function showDashboard() {
      loginScreen.style.display = 'none';
      dashboard.style.display = 'flex';
      dashboard.classList.add('is-active');
    }

    function logout() {
      sessionStorage.removeItem(SESSION_KEY);
      dashboard.classList.remove('is-active');
      loginScreen.style.display = 'flex';
      dashboard.style.display = 'none';
      passwordInput.value = '';
    }

    logoutBtn.addEventListener('click', logout);
    const sidebarLogout = document.getElementById('sidebar-logout');
    if (sidebarLogout) sidebarLogout.addEventListener('click', logout);

    // ── Sidebar navigation (StatCounter-style view switching) ──
    // "Known Visitors" reuses the activity panel but pre-filters to
    // identified visitors (form-fillers or named/labeled profiles).
    let knownOnly = false;
    const navItems = Array.from(document.querySelectorAll('.sc-nav-item'));
    const panelActivity = document.getElementById('panel-activity');
    const panelSubmissions = document.getElementById('panel-submissions');
    const panelPages = document.getElementById('panel-pages');
    const panelCalls = document.getElementById('panel-calls');
    const activityTitle = document.getElementById('activity-title');

    function setView(view) {
      activeView = view;
      navItems.forEach(btn => btn.classList.toggle('active', btn.dataset.view === view));
      const showActivity = (view === 'activity' || view === 'known');
      panelActivity.classList.toggle('active', showActivity);
      panelSubmissions.classList.toggle('active', view === 'submissions');
      if (panelPages) panelPages.classList.toggle('active', view === 'pages');
      if (panelCalls) panelCalls.classList.toggle('active', view === 'calls');
      knownOnly = (view === 'known');
      if (activityTitle) {
        activityTitle.textContent = knownOnly ? 'Known visitors' : 'Visitor activity';
      }
      visitorsPage = 1;
      applySearch();
    }

    navItems.forEach(btn => {
      btn.addEventListener('click', () => setView(btn.dataset.view));
    });

    // Pages report tab switching (Top / Entry / Exit) — re-renders from cached data.
    document.querySelectorAll('.sc-pages-tab').forEach(btn => {
      btn.addEventListener('click', () => {
        pagesTab = btn.dataset.ptab;
        document.querySelectorAll('.sc-pages-tab').forEach(b => b.classList.toggle('active', b === btn));
        renderPages();
      });
    });

    function formTypeLabel(value) {
      const type = String(value || 'contact');
      if (type === 'parts_request_form') return 'Parts RFQ';
      if (type === 'disc_parts_glossary_form') return 'Parts RFQ';
      if (type === 'centrifuge_contact_form') return 'Contact';
      if (type === 'contact') return 'Contact';
      return type.replace(/_/g, ' ');
    }

    function shortPath(value) {
      if (!value) return '';
      try {
        const url = new URL(String(value), window.location.origin);
        return url.pathname || '/';
      } catch (e) {
        return String(value).split(/[?#]/, 1)[0];
      }
    }

    function displayUrl(value) {
      if (!value) return '';
      try {
        const url = new URL(String(value), window.location.origin);
        return url.pathname || '/';
      } catch (e) {
        return String(value).split(/[?#]/, 1)[0];
      }
    }

    function urlDisplayData(value) {
      const raw = String(value || '');
      if (!raw) return { raw: '', path: '', safeHref: '', hasParams: false, params: new URLSearchParams() };
      try {
        const url = new URL(raw, window.location.origin);
        const safeHref = (url.protocol === 'http:' || url.protocol === 'https:') ? raw : '';
        return {
          raw,
          path: url.pathname || '/',
          safeHref,
          hasParams: Boolean(url.search),
          params: url.searchParams,
        };
      } catch (e) {
        return {
          raw,
          path: raw.split(/[?#]/, 1)[0],
          safeHref: '',
          hasParams: raw.includes('?'),
          params: new URLSearchParams(),
        };
      }
    }

    function rawParamsToggle(raw, fallbackRaw) {
      const data = urlDisplayData(raw);
      const disclosure = data.hasParams ? data.raw : String(fallbackRaw || '');
      if (!disclosure) return '';
      return `<span class="va-url-params"><button type="button" class="va-url-toggle" data-url-params-toggle aria-expanded="false">+ params</button><code class="va-url-raw" hidden>${esc(disclosure)}</code></span>`;
    }

    function renderDisplayUrl(raw, className) {
      const data = urlDisplayData(raw);
      if (!data.path) return '';
      const cls = className ? `va-url-path ${className}` : 'va-url-path';
      const pathHtml = data.safeHref
        ? `<a class="${cls}" href="${esc(data.safeHref)}" target="_blank" rel="noopener">${esc(data.path)}</a>`
        : `<span class="${cls}">${esc(data.path)}</span>`;
      return `<span class="va-url">${pathHtml}${rawParamsToggle(raw)}</span>`;
    }

    function firstVisitorParam(visitor, names) {
      const urls = [visitor.first_landing_page, visitor.last_page, visitor.referrer].filter(Boolean);
      for (const raw of urls) {
        const data = urlDisplayData(raw);
        for (const name of names) {
          const value = data.params.get(name);
          if (value) return value.trim();
        }
      }
      return '';
    }

    function parsePages(record) {
      const raw = record && record.attribution_pages_json;
      if (!raw) return [];
      try {
        const pages = JSON.parse(raw);
        if (!Array.isArray(pages)) return [];
        return pages.filter(page => page && (page.path || page.title)).slice(-8);
      } catch (e) {
        return [];
      }
    }

    function isGoogleAttribution(record) {
      const source = String(record.attribution_source || '').toLowerCase();
      return source === 'google'
        || source.includes('google.')
        || Boolean(record.attribution_gclid || record.attribution_gbraid || record.attribution_wbraid);
    }

    function googleAttributionSearchText(record) {
      if (!isGoogleAttribution(record)) return '';
      return `${record.attribution_source} ${record.attribution_medium} ${record.attribution_campaign} ${record.attribution_term} ${record.attribution_landing_page} ${record.attribution_current_page} ${record.attribution_gclid} ${record.attribution_gbraid} ${record.attribution_wbraid} ${record.attribution_ga_client_id} ${record.attribution_statcounter_visitor_id}`;
    }

    function visitorContextSearchText(record) {
      const pages = parsePages(record).map(page => `${page.path || ''} ${page.title || ''} ${page.referrer || ''}`).join(' ');
      return `${record.attribution_visitor_id || ''} ${record.visitor_label || ''} ${record.visitor_contact_name || ''} ${record.visitor_contact_company || ''} ${record.visitor_contact_email || ''} ${record.visitor_contact_phone || ''} ${record.visitor_identity_source || ''} ${record.visitor_identity_confidence || ''} ${record.visitor_notes || ''} ${record.visitor_ip || ''} ${record.visitor_user_agent || ''} ${record.visitor_accept_language || ''} ${record.visitor_country || ''} ${record.visitor_region || ''} ${record.visitor_city || ''} ${record.visitor_timezone || ''} ${record.visitor_asn || ''} ${record.visitor_as_organization || ''} ${record.visitor_cf_ray || ''} ${record.attribution_referrer || ''} ${record.attribution_landing_page || ''} ${record.attribution_current_page || ''} ${pages}`;
    }

    function attribLine(label, value, className) {
      if (!value) return '';
      const valueClass = className ? `attrib-value ${className}` : 'attrib-value';
      return `
        <div class="attrib-line">
          <span class="attrib-label">${esc(label)}</span>
          <span class="${valueClass}">${value}</span>
        </div>`;
    }

    function cssEscape(value) {
      if (window.CSS && typeof window.CSS.escape === 'function') return window.CSS.escape(String(value));
      return String(value).replace(/["\\]/g, '\\$&');
    }

    // Real flag image. Windows can't render flag emoji, so use flagcdn.com
    // PNGs by ISO-3166-1 alpha-2 code. Returns '' on a bad code.
    function flagImg(cc) {
      const code = String(cc || '').trim().toLowerCase();
      if (!/^[a-z]{2}$/.test(code)) return '';
      const u = code.toUpperCase();
      return `<img class="va-flag" src="https://flagcdn.com/20x15/${code}.png" srcset="https://flagcdn.com/40x30/${code}.png 2x" width="20" height="15" loading="lazy" alt="${esc(u)}" title="${esc(u)}">`;
    }

    // Compact location for the visitor log: dedupes a repeated city/region
    // (e.g. "Ho Chi Minh City, Ho Chi Minh City"), drops the country text (the
    // flag conveys it), and exposes the flag with the ISO code as a tooltip.
    // Returns { flagHtml, loc, has } — loc is "City, Region" with no country.
    function locationDisplay(visitor) {
      const code = String(visitor.visitor_country || '').trim().toUpperCase();
      const city = String(visitor.visitor_city || '').trim();
      const region = String(visitor.visitor_region || '').trim();
      const parts = [];
      if (city) parts.push(city);
      if (region && region.toLowerCase() !== city.toLowerCase()) parts.push(region);
      const img = flagImg(code);
      const flagHtml = img || (code ? `<span class="va-cc">${esc(code)}</span>` : '');
      const loc = parts.join(', ');
      return { flagHtml, loc, has: Boolean(loc || flagHtml) };
    }

    // Detect browser + OS from a user-agent. Order matters: SamsungBrowser and
    // Edge UAs also contain "Chrome"; Android UAs also contain "Linux".
    function browserOsInfo(userAgent) {
      const ua = String(userAgent || '');
      let bKey = '', bName = '';
      if (ua.includes('Edg/') || ua.includes('EdgA/') || ua.includes('EdgiOS/')) { bKey = 'edge'; bName = 'Edge'; }
      else if (ua.includes('SamsungBrowser')) { bKey = 'samsung'; bName = 'Samsung Internet'; }
      else if (ua.includes('Firefox/') || ua.includes('FxiOS/')) { bKey = 'firefox'; bName = 'Firefox'; }
      else if (ua.includes('CriOS/') || ua.includes('Chrome/')) { bKey = 'chrome'; bName = 'Chrome'; }
      else if (ua.includes('Safari/') && !ua.includes('Chrome/')) { bKey = 'safari'; bName = 'Safari'; }

      let oKey = '', oName = '';
      if (ua.includes('Windows')) { oKey = 'windows'; oName = 'Windows'; }
      else if (ua.includes('Android')) { oKey = 'android'; oName = 'Android'; }
      else if (ua.includes('iPhone')) { oKey = 'apple'; oName = 'iPhone'; }
      else if (ua.includes('iPad')) { oKey = 'apple'; oName = 'iPad'; }
      else if (ua.includes('Macintosh') || ua.includes('Mac OS')) { oKey = 'apple'; oName = 'macOS'; }
      else if (ua.includes('Linux')) { oKey = 'linux'; oName = 'Linux'; }
      return { bKey, bName, oKey, oName };
    }

    function browserSummary(userAgent) {
      const info = browserOsInfo(userAgent);
      const browser = info.bName || 'Browser details';
      return info.oName ? `${browser} on ${info.oName}` : browser;
    }

    // Local inline-SVG icons — render identically on Windows (no flag-emoji trap),
    // no remote favicons, no icon font.
    const BROWSER_ICONS = {
      chrome: '<svg class="va-bico" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="7" fill="#dfe1e5"/><g stroke="#fff" stroke-width="1.4"><path d="M8 8 L8 1"/><path d="M8 8 L14 11.5"/><path d="M8 8 L2 11.5"/></g><circle cx="8" cy="8" r="3" fill="#1a73e8"/><circle cx="8" cy="8" r="3" fill="none" stroke="#fff" stroke-width="0.8"/></svg>',
      firefox: '<svg class="va-bico" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="7" fill="#e66000"/><path d="M8.5 2.5c2.5 0.4 4 2.4 4 4.8 0 2.6-2.1 4.7-4.7 4.7 1.4-0.8 2.1-2 1.6-3.4-0.6 1.3-2.4 1-2.4-0.6 0-1.4 1.6-1.6 1-3.3 1.2 0.2 1.6 1 1.5 1.9 0.6-1.2 0-3.2-2-3.8Z" fill="#ffb64d"/></svg>',
      safari: '<svg class="va-bico" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="7" fill="#1e9bf0"/><circle cx="8" cy="8" r="5.4" fill="#fff"/><path d="M11 5 L8.6 8.2 L8 8 Z" fill="#ff3b30"/><path d="M5 11 L7.4 7.8 L8 8 Z" fill="#c3c9cf"/></svg>',
      edge: '<svg class="va-bico" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="7" fill="#2b73c4"/><path d="M4 10.5a4 4 0 0 1 7.5-2.2 5 3.2 0 0 0-8.2 1.2 5.6 5.6 0 0 0 0.7 1Z" fill="#48c7b0"/></svg>',
      samsung: '<svg class="va-bico" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="7" fill="#6b4bce"/><path d="M4.5 6a4 4 0 0 1 7 1.2 2.6 2.6 0 0 0-4.6-0.2 2.6 2.6 0 0 1-2.4-1Z M11.5 10a4 4 0 0 1-7-1.2 2.6 2.6 0 0 0 4.6 0.2 2.6 2.6 0 0 1 2.4 1Z" fill="#fff"/></svg>',
    };
    const OS_ICONS = {
      windows: '<svg class="va-osico" viewBox="0 0 16 16" aria-hidden="true"><path fill="#3b82c4" d="M2 3.6 L7.3 2.9 L7.3 7.5 L2 7.5 Z M7.9 2.8 L14 2 L14 7.5 L7.9 7.5 Z M2 8.1 L7.3 8.1 L7.3 12.7 L2 12 Z M7.9 8.1 L14 8.1 L14 14 L7.9 13.2 Z"/></svg>',
      apple: '<svg class="va-osico" viewBox="0 0 16 16" aria-hidden="true"><path fill="#888" d="M10.8 8.4c0-1.5 1.2-2.2 1.3-2.3-0.7-1-1.8-1.2-2.2-1.2-0.9-0.1-1.8 0.5-2.3 0.5-0.5 0-1.2-0.5-2-0.5-1 0-1.9 0.6-2.4 1.5-1 1.8-0.3 4.5 0.7 6 0.5 0.7 1 1.5 1.8 1.5 0.7 0 1-0.5 1.9-0.5 0.8 0 1.1 0.5 1.9 0.5 0.8 0 1.3-0.7 1.8-1.4 0.5-0.8 0.8-1.6 0.8-1.6 0 0-1.5-0.6-1.5-2.2Z M9.6 4c0.4-0.5 0.7-1.1 0.6-1.8-0.6 0-1.2 0.4-1.6 0.9-0.4 0.4-0.7 1-0.6 1.6 0.6 0.1 1.2-0.3 1.6-0.7Z"/></svg>',
      android: '<svg class="va-osico" viewBox="0 0 16 16" aria-hidden="true"><g fill="#3ddc84"><path d="M4.2 7 h7.6 v4 a1 1 0 0 1-1 1 H5.2 a1 1 0 0 1-1-1 Z"/><path d="M4.3 6.6 a3.7 3.7 0 0 1 7.4 0 Z"/><rect x="2.2" y="7" width="1.3" height="3.6" rx="0.65"/><rect x="12.5" y="7" width="1.3" height="3.6" rx="0.65"/><rect x="6" y="11.6" width="1.2" height="2.6" rx="0.6"/><rect x="8.8" y="11.6" width="1.2" height="2.6" rx="0.6"/></g><g fill="#fff"><circle cx="6.4" cy="5.4" r="0.45"/><circle cx="9.6" cy="5.4" r="0.45"/></g></svg>',
      linux: '<svg class="va-osico" viewBox="0 0 16 16" aria-hidden="true"><ellipse cx="8" cy="9.3" rx="3.6" ry="4.5" fill="#2b2b2b"/><ellipse cx="8" cy="10.2" rx="2.1" ry="3" fill="#f5f5f5"/><circle cx="8" cy="4.8" r="2.4" fill="#2b2b2b"/><circle cx="7.1" cy="4.6" r="0.45" fill="#fff"/><circle cx="8.9" cy="4.6" r="0.45" fill="#fff"/><path d="M7.3 5.4 h1.4 l-0.7 0.9 Z" fill="#f4b400"/><path d="M5.8 13.3 l1.5-0.9 0.1 1 Z M10.2 13.3 l-1.5-0.9-0.1 1 Z" fill="#f4b400"/></svg>',
    };

    // Compact browser/OS marker for Line 1. Falls back to short text when unknown.
    function browserOsMarker(userAgent) {
      const info = browserOsInfo(userAgent);
      const title = browserSummary(userAgent);
      const bIcon = BROWSER_ICONS[info.bKey] || '';
      const oIcon = OS_ICONS[info.oKey] || '';
      if (!bIcon && !oIcon) {
        if (!title || title === 'Browser details') return '';
        return `<span class="va-osmark" title="${esc(title)}"><span class="va-osmark-txt">${esc(title)}</span></span>`;
      }
      return `<span class="va-osmark" title="${esc(title)}">${bIcon}${oIcon}</span>`;
    }

    // AI-assistant referral detection (owner-specified domains).
    const AI_REFERRAL_MAP = [
      { d: 'chatgpt.com', name: 'ChatGPT' },
      { d: 'perplexity.ai', name: 'Perplexity' },
      { d: 'claude.ai', name: 'Claude' },
      { d: 'gemini.google.com', name: 'Gemini' },
      { d: 'copilot.microsoft.com', name: 'Copilot' },
      { d: 'you.com', name: 'You.com' },
      { d: 'phind.com', name: 'Phind' },
    ];
    function aiReferralInfo(visitor) {
      const candidates = [visitor.referrer, visitor.source].filter(Boolean);
      for (const raw of candidates) {
        let host = '';
        try {
          const s = String(raw).trim();
          const withScheme = /^https?:\/\//i.test(s) ? s : 'https://' + s.replace(/^\/+/, '');
          host = new URL(withScheme).hostname.replace(/^www\./, '').toLowerCase();
        } catch (e) { continue; }
        if (!host) continue;
        for (const entry of AI_REFERRAL_MAP) {
          if (host === entry.d || host.endsWith('.' + entry.d)) return entry;
        }
      }
      return null;
    }
    function isAiReferral(visitor) { return Boolean(aiReferralInfo(visitor)); }

    function renderVisitorIdentityControls(record, visitorId) {
      const labelValue = record.visitor_label || record.label || '';
      const contactNameValue = record.visitor_contact_name || record.contact_name || '';
      const contactCompanyValue = record.visitor_contact_company || record.contact_company || '';
      const contactEmailValue = record.visitor_contact_email || record.contact_email || '';
      const contactPhoneValue = record.visitor_contact_phone || record.contact_phone || '';
      const notesValue = record.visitor_notes || record.notes || '';
      const alertEnabled = Number(record.visitor_alert_enabled || record.alert_enabled || 0);
      const alertEmail = record.visitor_alert_email || record.alert_email || 'sales@dolphincentrifuge.com';
      return `
        <div class="visitor-label-box" data-visitor-box="${esc(visitorId)}">
          ${attribLine('Label', labelValue ? esc(labelValue) : '<span class="attrib-muted">Unlabeled</span>')}
          <input type="text" data-visitor-label="${esc(visitorId)}" value="${esc(labelValue)}" placeholder="Name this visitor" />
          <div class="visitor-identity-grid">
            <input type="text" data-visitor-contact-name="${esc(visitorId)}" value="${esc(contactNameValue)}" placeholder="Contact name" />
            <input type="text" data-visitor-contact-company="${esc(visitorId)}" value="${esc(contactCompanyValue)}" placeholder="Company" />
            <input type="email" data-visitor-contact-email="${esc(visitorId)}" value="${esc(contactEmailValue)}" placeholder="Email" />
            <input type="tel" data-visitor-contact-phone="${esc(visitorId)}" value="${esc(contactPhoneValue)}" placeholder="Phone or caller ID" />
          </div>
          <textarea data-visitor-notes="${esc(visitorId)}" placeholder="Notes, e.g. John called at 2:10 PM from Massachusetts">${esc(notesValue)}</textarea>
          <label class="visitor-alert-row">
            <input type="checkbox" data-visitor-alert="${esc(visitorId)}" ${alertEnabled ? 'checked' : ''} />
            <span>Email me when this visitor returns</span>
          </label>
          <input type="email" data-visitor-email="${esc(visitorId)}" value="${esc(alertEmail)}" placeholder="sales@dolphincentrifuge.com" />
          <button class="visitor-save-btn" data-save-visitor-id="${esc(visitorId)}">Save Visitor</button>
          <span class="visitor-save-status" data-visitor-status="${esc(visitorId)}"></span>
        </div>
      `;
    }

    function renderVisitorContext(record) {
      // Dedupe a repeated city/region (e.g. "Ho Chi Minh City, Ho Chi Minh City");
      // keep the country here since this plain-text drill-down has no flag.
      const locCity = String(record.visitor_city || '').trim();
      const locRegion = String(record.visitor_region || '').trim();
      const location = [
        locCity,
        (locRegion && locRegion.toLowerCase() !== locCity.toLowerCase()) ? locRegion : '',
        String(record.visitor_country || '').trim(),
      ].filter(Boolean).join(', ');
      const network = [
        record.visitor_asn ? `AS${record.visitor_asn}` : '',
        record.visitor_as_organization || '',
      ].filter(Boolean).join(' ');
      const pages = parsePages(record);
      const pageCount = Number(record.attribution_page_count || pages.length || 0);
      const referrer = renderDisplayUrl(record.attribution_referrer || '');
      const landing = renderDisplayUrl(record.attribution_landing_page || '');
      const userAgent = record.visitor_user_agent || '';
      const cookieVisitorId = record.attribution_visitor_id || '';
      const visitCount = Number(record.visitor_profile_visit_count || record.attribution_visit_count || 0);
      const isReturning = Number(record.attribution_is_returning || 0) || visitCount > 1;
      const lastSeen = record.visitor_profile_last_seen_at || record.attribution_visitor_last_seen_at || '';
      const labelValue = record.visitor_label || '';
      const contactNameValue = record.visitor_contact_name || '';
      const contactCompanyValue = record.visitor_contact_company || '';
      const contactEmailValue = record.visitor_contact_email || '';
      const contactPhoneValue = record.visitor_contact_phone || '';
      const identitySourceValue = record.visitor_identity_source || '';
      const identityConfidenceValue = record.visitor_identity_confidence || '';
      const notesValue = record.visitor_notes || '';
      const alertEnabled = Number(record.visitor_alert_enabled || 0);
      const alertEmail = record.visitor_alert_email || 'sales@dolphincentrifuge.com';
      const hasContext = record.visitor_ip
        || userAgent
        || location
        || network
        || cookieVisitorId
        || contactNameValue
        || contactCompanyValue
        || contactEmailValue
        || contactPhoneValue
        || notesValue
        || record.visitor_accept_language
        || record.visitor_cf_ray
        || referrer
        || landing
        || pages.length;

      if (!hasContext) {
        return '<span class="attrib-muted">Not captured yet</span>';
      }

      const browserDetails = userAgent
        ? `<details class="attrib-details"><summary>${esc(browserSummary(userAgent))}</summary><div class="context-ua-text">${esc(userAgent)}</div></details>`
        : '';
      const trailLabel = pageCount > pages.length
        ? `${pages.length} shown of ${pageCount} pages`
        : `${pages.length} page${pages.length === 1 ? '' : 's'}`;
      const trail = pages.length
        ? `<details class="attrib-details"><summary>Visit trail: ${esc(trailLabel)}</summary><ol>${pages.map(page => `<li>${renderDisplayUrl(page.path || '', 'attrib-path')}${page.title ? `<br><span class="attrib-muted">${esc(page.title)}</span>` : ''}</li>`).join('')}</ol></details>`
        : '';
      const labelControls = cookieVisitorId ? renderVisitorIdentityControls(record, cookieVisitorId) : '';

      return `
        <div class="attrib-panel">
          <div class="attrib-source">Visitor context</div>
          ${attribLine('Cookie ID', cookieVisitorId ? esc(cookieVisitorId) : '', 'attrib-path')}
          ${attribLine('Contact', contactNameValue ? esc(contactNameValue) : '')}
          ${attribLine('Company', contactCompanyValue ? esc(contactCompanyValue) : '')}
          ${attribLine('Phone', contactPhoneValue ? esc(contactPhoneValue) : '')}
          ${attribLine('Email', contactEmailValue ? esc(contactEmailValue) : '')}
          ${attribLine('Identity', identitySourceValue || identityConfidenceValue ? esc([identitySourceValue, identityConfidenceValue].filter(Boolean).join(' / ')) : '')}
          ${attribLine('Notes', notesValue ? esc(notesValue) : '')}
          ${attribLine('Visit #', visitCount ? esc(String(visitCount)) : '')}
          ${attribLine('Last seen', lastSeen ? esc(lastSeen) : '')}
          ${attribLine('Returning', isReturning ? 'Yes' : '')}
          ${attribLine('IP', record.visitor_ip ? esc(record.visitor_ip) : '')}
          ${attribLine('Location', location ? esc(location) : '')}
          ${attribLine('Referrer', referrer)}
          ${attribLine('Landing', landing)}
          ${attribLine('Language', record.visitor_accept_language ? esc(record.visitor_accept_language) : '')}
          ${attribLine('Network', network ? esc(network) : '')}
          ${attribLine('CF-Ray', record.visitor_cf_ray ? esc(record.visitor_cf_ray) : '')}
          ${browserDetails}
          ${trail}
          ${labelControls}
        </div>
      `;
    }

    function renderAttribution(record) {
      const source = record.attribution_source || '';
      const medium = record.attribution_medium || '';
      const isGoogle = isGoogleAttribution(record);
      const landing = renderDisplayUrl(record.attribution_landing_page || '');
      const current = renderDisplayUrl(record.attribution_current_page || '');
      const campaign = record.attribution_campaign || '';
      const term = record.attribution_term || '';
      const pages = parsePages(record);
      const pageCount = Number(record.attribution_page_count || pages.length || 0);
      const clickIds = [
        record.attribution_gclid ? 'gclid' : '',
        record.attribution_gbraid ? 'gbraid' : '',
        record.attribution_wbraid ? 'wbraid' : '',
      ].filter(Boolean);

      if (!source && !landing && !current && pages.length === 0) {
        return '<span class="attrib-muted">Not captured yet</span>';
      }

      if (!isGoogle) {
        return `
          <div class="attrib-panel">
            <div class="attrib-source">Non-Google traffic</div>
            <div class="attrib-line">
              <span class="attrib-label">Report</span>
              <span class="attrib-value attrib-muted">Not included in Google report</span>
            </div>
          </div>
        `;
      }

      const sourceLabel = `Google${medium ? ' / ' + medium : ''}`;
      const trailLabel = pageCount > pages.length
        ? `${pages.length} shown of ${pageCount} pages`
        : `${pages.length} page${pages.length === 1 ? '' : 's'}`;
      const trail = pages.length
        ? `<details class="attrib-details"><summary>${esc(trailLabel)}</summary><ol>${pages.map(page => `<li>${renderDisplayUrl(page.path || '', 'attrib-path')}${page.title ? `<br><span class="attrib-muted">${esc(page.title)}</span>` : ''}</li>`).join('')}</ol></details>`
        : '';

      return `
        <div class="attrib-panel">
          <div class="attrib-source">${esc(sourceLabel)}</div>
          ${attribLine('Campaign', campaign ? esc(campaign) : '')}
          ${attribLine('Keyword', term ? esc(term) : '')}
          ${attribLine('Landing', landing)}
          ${attribLine('Form page', current)}
          ${attribLine('Ad IDs', clickIds.length ? esc(clickIds.join(', ')) : '')}
          ${attribLine('GA client', record.attribution_ga_client_id ? esc(record.attribution_ga_client_id) : '')}
          ${attribLine('StatCounter', record.attribution_statcounter_visitor_id ? esc(record.attribution_statcounter_visitor_id) : '')}
          ${trail}
        </div>
      `;
    }

    function esc(str) {
      if (!str) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }
  </script>

  <!-- ── Delete Confirmation Modal ──────────────────────────── -->
  <div id="delete-modal" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.55); z-index:200; align-items:center; justify-content:center;">
    <div style="background:#fff; border-radius:14px; padding:36px 40px; max-width:420px; width:90%; box-shadow:0 20px 60px rgba(0,0,0,0.35); text-align:center;">
      <div style="width:52px; height:52px; background:#fee2e2; border-radius:50%; display:flex; align-items:center; justify-content:center; margin:0 auto 16px;">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#e74c3c" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4h6v2"/>
        </svg>
      </div>
      <h3 style="font-family:Inter,Arial,sans-serif; font-size:1.1rem; font-weight:700; color:#1a2a4a; margin:0 0 8px;">Remove Submission?</h3>
      <p style="font-family:Inter,Arial,sans-serif; font-size:0.88rem; color:#666; margin:0 0 24px; line-height:1.5;">This record will be permanently removed from your dashboard. This cannot be undone.</p>
      <div style="display:flex; gap:12px; justify-content:center;">
        <button id="modal-cancel" style="flex:1; padding:10px; border:2px solid #ddd; background:#fff; border-radius:8px; font-size:0.9rem; font-weight:600; cursor:pointer; color:#555; transition:all 0.15s;">Cancel</button>
        <button id="modal-confirm" style="flex:1; padding:10px; border:none; background:#e74c3c; border-radius:8px; font-size:0.9rem; font-weight:600; cursor:pointer; color:#fff; transition:background 0.15s;">Yes, Delete</button>
      </div>
    </div>
  </div>

</body>
</html>
