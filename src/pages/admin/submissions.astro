---
// Admin Dashboard — Dolphin Centrifuge Submissions
// NO-INDEX: This page is hidden from search engines
// Password protected via sessionStorage + Worker Bearer token
const contactWorkerBaseUrl = (import.meta.env.PUBLIC_CONTACT_WORKER_URL || (
  import.meta.env.DEV
    ? 'http://127.0.0.1:8787'
    : 'https://dolphin-contact-form.dolphin-centrifuge.workers.dev'
)).replace(/\/$/, '');
const isDevDashboard = import.meta.env.DEV;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Submissions Dashboard — Dolphin Centrifuge</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <style is:global>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'Inter', Arial, sans-serif;
      background: #eef3f8;
      color: #1a2a4a;
      min-height: 100vh;
    }

    /* ── Login Screen ───────────────────────────────────────── */
    #login-screen {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      background: #1a2a4a;
    }
    .login-card {
      background: #fff;
      border-radius: 16px;
      padding: 40px 48px;
      width: 100%;
      max-width: 400px;
      box-shadow: 0 20px 60px rgba(0,0,0,0.3);
      text-align: center;
    }
    .login-card h1 {
      font-size: 1.4rem;
      color: #1a2a4a;
      margin-bottom: 6px;
    }
    .login-card p {
      font-size: 0.85rem;
      color: #666;
      margin-bottom: 28px;
    }
    .login-card input {
      width: 100%;
      border: 2px solid #ddd;
      border-radius: 10px;
      padding: 12px 16px;
      font-size: 1rem;
      outline: none;
      transition: border-color 0.2s;
      margin-bottom: 14px;
    }
    .login-card input:focus { border-color: #1a2a4a; }
    .login-card button {
      width: 100%;
      background: #1a2a4a;
      color: #fff;
      border: none;
      border-radius: 10px;
      padding: 13px;
      font-size: 1rem;
      font-weight: 600;
      cursor: pointer;
      transition: background 0.2s;
    }
    .login-card button:hover { background: #e8c204; color: #1a2a4a; }
    #login-error {
      color: #c0392b;
      font-size: 0.85rem;
      margin-top: 10px;
      min-height: 20px;
    }

    /* ── Dashboard (StatCounter-style shell) ─────────────────── */
    #dashboard { display: none; }
    #dashboard.is-active { display: flex; min-height: 100vh; }

    /* Sidebar */
    .sc-sidebar {
      flex: none;
      width: 212px;
      background: #16335c;
      color: #aebfd6;
      display: flex;
      flex-direction: column;
      position: sticky;
      top: 0;
      align-self: flex-start;
      height: 100vh;
    }
    .sc-brand {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 18px 16px;
      border-bottom: 1px solid rgba(255,255,255,0.08);
    }
    .sc-brand-mark {
      width: 30px;
      height: 30px;
      border-radius: 50%;
      background: #4a90d9;
      color: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.95rem;
      font-weight: 700;
      flex: none;
    }
    .sc-brand-name {
      color: #f2f6fc;
      font-size: 1.05rem;
      font-weight: 700;
      letter-spacing: 0.01em;
    }
    .sc-nav {
      display: flex;
      flex-direction: column;
      padding: 10px 0;
      flex: 1;
    }
    .sc-nav-item {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 12px 16px;
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: #aebfd6;
      background: transparent;
      border: 0;
      border-left: 3px solid transparent;
      text-align: left;
      cursor: pointer;
      transition: background 0.15s, color 0.15s;
      width: 100%;
      font-family: inherit;
    }
    .sc-nav-item .sc-nav-ico {
      flex: none;
      width: 16px;
      height: 16px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      opacity: 0.85;
    }
    .sc-nav-item:hover { background: #1f4575; color: #fff; }
    .sc-nav-item.active {
      background: #1f4575;
      color: #fff;
      border-left-color: #4a90d9;
    }
    .sc-nav-item.active .sc-nav-ico { opacity: 1; }
    .sc-sidebar-foot {
      border-top: 1px solid rgba(255,255,255,0.08);
      padding: 12px 16px;
    }
    .sc-logout-link {
      display: flex;
      align-items: center;
      gap: 8px;
      background: transparent;
      border: 0;
      color: #aebfd6;
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      cursor: pointer;
      padding: 0;
      font-family: inherit;
    }
    .sc-logout-link:hover { color: #fff; }

    /* Content area */
    .sc-content {
      flex: 1;
      min-width: 0;
      display: flex;
      flex-direction: column;
    }
    .sc-topbar {
      height: 56px;
      background: #fff;
      border-bottom: 1px solid #dde6f0;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      padding: 0 24px;
      position: sticky;
      top: 0;
      z-index: 20;
    }
    .sc-topbar-title { color: #16335c; font-size: 18px; font-weight: 700; }
    .sc-topbar-right { display: flex; align-items: center; gap: 14px; }
    .sc-topbar-right .sc-admin-tag { font-size: 0.82rem; color: #6a7a8c; }
    #logout-btn {
      background: transparent;
      border: 1px solid #c7d4e2;
      color: #2f6db5;
      border-radius: 6px;
      padding: 6px 16px;
      font-size: 0.85rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s;
    }
    #logout-btn:hover { background: #2f6db5; color: #fff; border-color: #2f6db5; }

    .sc-body { padding: 20px 24px 40px; }

    .sc-section-title {
      color: #2f6db5;
      font-size: 24px;
      font-weight: 600;
      margin: 4px 0 14px;
    }
    .sc-toolbar {
      display: flex;
      align-items: center;
      gap: 14px;
      flex-wrap: wrap;
      margin-bottom: 14px;
    }
    .sc-toolbar input[type="search"] {
      border: 1px solid #c7d4e2;
      border-radius: 6px;
      padding: 8px 14px;
      font-size: 0.9rem;
      outline: none;
      width: 320px;
      transition: border-color 0.2s;
      font-family: inherit;
    }
    .sc-toolbar input[type="search"]:focus { border-color: #2f6db5; }
    #count-badge { font-size: 0.82rem; color: #6a7a8c; }

    /* Section panels (one visible at a time) */
    .sc-panel { display: none; }
    .sc-panel.active { display: block; }

    /* ── Table ──────────────────────────────────────────────── */
    .table-wrap {
      margin: 0 0 40px;
      max-height: calc(100vh - 200px);
      overflow: auto;
      background: #fff;
      border: 1px solid #cfd8e3;
      border-radius: 10px;
      box-shadow: 0 8px 24px rgba(26,42,74,0.08);
    }
    .visitor-directory {
      margin: 0 0 16px;
      background: transparent;
    }
    .visitor-directory h2 {
      color: #1a2a4a;
      font-size: 0.9rem;
      margin: 0 0 10px;
    }
    .visitor-directory-grid {
      display: grid;
      gap: 10px;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    }
    .visitor-directory-item {
      border: 1px solid #dce3ec;
      border-radius: 8px;
      padding: 10px;
    }
    .visitor-directory-title {
      color: #1a2a4a;
      font-size: 0.82rem;
      font-weight: 800;
      margin-bottom: 6px;
    }
    .submissions-table {
      width: max-content;
      min-width: 100%;
      border-collapse: separate;
      border-spacing: 0;
      table-layout: fixed;
      font-size: 0.84rem;
    }
    .submissions-table thead {
      background: #1a2a4a;
      color: #fff;
      text-align: left;
    }
    .submissions-table thead th {
      position: sticky;
      top: 0;
      z-index: 2;
      padding: 10px 12px;
      font-size: 0.72rem;
      font-weight: 700;
      line-height: 1.15;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      white-space: nowrap;
      background: #1a2a4a;
      border-right: 1px solid rgba(255,255,255,0.18);
      border-bottom: 1px solid #0f1b31;
    }
    .submissions-table thead th:last-child { border-right: 0; }
    .submissions-table thead th:nth-child(1),
    .submissions-table thead th:nth-child(2),
    .submissions-table thead th:nth-child(3),
    .submissions-table tbody td:nth-child(1),
    .submissions-table tbody td:nth-child(2),
    .submissions-table tbody td:nth-child(3) {
      position: sticky;
      z-index: 3;
    }
    .submissions-table thead th:nth-child(1),
    .submissions-table tbody td:nth-child(1) {
      left: 0;
      text-align: center;
    }
    .submissions-table thead th:nth-child(2),
    .submissions-table tbody td:nth-child(2) {
      left: 54px;
      white-space: nowrap;
    }
    .submissions-table thead th:nth-child(3),
    .submissions-table tbody td:nth-child(3) {
      left: 162px;
      white-space: nowrap;
    }
    .submissions-table thead th:nth-child(1),
    .submissions-table thead th:nth-child(2),
    .submissions-table thead th:nth-child(3) {
      z-index: 5;
      background: #1a2a4a;
    }
    .submissions-table tbody tr {
      transition: background 0.15s;
    }
    .submissions-table tbody tr:nth-child(even) { background: #f8fafc; }
    .submissions-table tbody tr:hover { background: #eef4fb; }
    .submissions-table tbody tr.reconnect-row { background: #fff8e1; }
    .submissions-table tbody tr.reconnect-row:hover { background: #fff3bb; }
    .submissions-table td {
      padding: 10px 12px;
      vertical-align: top;
      color: #333;
      background-clip: padding-box;
      border-right: 1px solid #dce3ec;
      border-bottom: 1px solid #dce3ec;
      line-height: 1.35;
      overflow-wrap: anywhere;
    }
    .submissions-table td:last-child { border-right: 0; }
    .submissions-table tbody td:nth-child(1),
    .submissions-table tbody td:nth-child(2),
    .submissions-table tbody td:nth-child(3) {
      background: #fff;
    }
    .submissions-table tbody tr:nth-child(even) td:nth-child(1),
    .submissions-table tbody tr:nth-child(even) td:nth-child(2),
    .submissions-table tbody tr:nth-child(even) td:nth-child(3) {
      background: #f8fafc;
    }
    .submissions-table tbody tr:hover td:nth-child(1),
    .submissions-table tbody tr:hover td:nth-child(2),
    .submissions-table tbody tr:hover td:nth-child(3) {
      background: #eef4fb;
    }
    .submissions-table tbody tr.reconnect-row td:nth-child(1),
    .submissions-table tbody tr.reconnect-row td:nth-child(2),
    .submissions-table tbody tr.reconnect-row td:nth-child(3) {
      background: #fff8e1;
    }
    .submissions-table tbody tr.reconnect-row:hover td:nth-child(1),
    .submissions-table tbody tr.reconnect-row:hover td:nth-child(2),
    .submissions-table tbody tr.reconnect-row:hover td:nth-child(3) {
      background: #fff3bb;
    }
    .submissions-table tbody td:nth-child(1) {
      color: #687386;
      font-weight: 700;
    }
    .submissions-table tbody td:nth-child(2) {
      color: #475569;
      font-size: 0.78rem;
    }
    .cell-num,
    .cell-date,
    .cell-phone,
    .cell-capacity,
    .cell-solids,
    .cell-action,
    .cell-status {
      white-space: nowrap;
    }
    .cell-num {
      color: #687386;
      font-weight: 700;
      text-align: center;
    }
    .cell-date {
      color: #475569;
      font-size: 0.78rem;
    }
    .cell-primary {
      color: #1a2a4a;
      font-weight: 700;
    }
    .cell-secondary {
      color: #64748b;
      font-size: 0.74rem;
      margin-top: 2px;
    }
    .cell-email a {
      color: #1a2a4a;
      font-weight: 600;
      text-decoration: none;
    }
    .cell-email a:hover { text-decoration: underline; }
    .empty-cell {
      color: #94a3b8;
      font-style: italic;
    }
    .badge-reconnect {
      display: inline-block;
      background: #e8c204;
      color: #1a2a4a;
      font-size: 0.7rem;
      font-weight: 700;
      padding: 2px 8px;
      border-radius: 20px;
      white-space: nowrap;
    }
    .type-badge {
      display: inline-block;
      background: #e8eef8;
      border: 1px solid #cbd8ea;
      color: #1a2a4a;
      font-size: 0.7rem;
      font-weight: 700;
      padding: 4px 8px;
      border-radius: 6px;
      white-space: nowrap;
    }
    .attrib-cell {
      min-width: 380px;
      font-size: 0.76rem;
    }
    .visitor-cell {
      min-width: 340px;
      font-size: 0.76rem;
    }
    .attrib-panel {
      display: grid;
      gap: 6px;
    }
    .attrib-source {
      display: inline-flex;
      align-items: center;
      width: fit-content;
      background: #eaf6ee;
      border: 1px solid #b7dfc2;
      border-radius: 6px;
      color: #1a2a4a;
      font-weight: 700;
      padding: 4px 8px;
    }
    .attrib-muted {
      color: #687386;
    }
    .attrib-line {
      display: grid;
      grid-template-columns: 86px minmax(0, 1fr);
      gap: 8px;
      align-items: start;
    }
    .attrib-label {
      color: #687386;
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }
    .attrib-value {
      color: #24344d;
      min-width: 0;
    }
    .attrib-path {
      color: #333;
      font-family: Consolas, 'JetBrains Mono', monospace;
      font-size: 0.72rem;
      word-break: break-word;
    }
    .attrib-details {
      border-top: 1px solid #dce3ec;
      margin-top: 2px;
      padding-top: 6px;
    }
    .attrib-details summary {
      cursor: pointer;
      color: #1a2a4a;
      font-weight: 700;
    }
    .attrib-details ol {
      margin: 6px 0 0 18px;
    }
    .attrib-details li {
      margin-bottom: 5px;
    }
    .context-ua-text {
      color: #24344d;
      font-family: Consolas, 'JetBrains Mono', monospace;
      font-size: 0.7rem;
      line-height: 1.35;
      margin-top: 6px;
      overflow-wrap: anywhere;
    }
    .visitor-label-box {
      border-top: 1px solid #dce3ec;
      display: grid;
      gap: 6px;
      margin-top: 2px;
      padding-top: 6px;
    }
    .visitor-label-box input[type="text"],
    .visitor-label-box input[type="email"],
    .visitor-label-box input[type="tel"],
    .visitor-label-box textarea {
      border: 1px solid #cfd8e3;
      border-radius: 6px;
      color: #24344d;
      font: inherit;
      padding: 5px 7px;
      width: 100%;
    }
    .visitor-label-box textarea {
      min-height: 54px;
      resize: vertical;
    }
    .visitor-identity-grid {
      display: grid;
      gap: 5px;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .visitor-identity-grid input {
      min-width: 0;
    }
    .visitor-alert-row {
      align-items: center;
      color: #475569;
      display: flex;
      gap: 6px;
    }
    .visitor-save-btn {
      background: #1a2a4a;
      border: 0;
      border-radius: 6px;
      color: #fff;
      cursor: pointer;
      font-size: 0.72rem;
      font-weight: 700;
      padding: 6px 9px;
      width: fit-content;
    }
    .visitor-save-btn:disabled {
      cursor: wait;
      opacity: 0.6;
    }
    .visitor-save-status {
      color: #64748b;
      font-size: 0.7rem;
    }
    .delete-btn {
      background: transparent;
      border: 1px solid #e74c3c;
      color: #e74c3c;
      border-radius: 6px;
      padding: 4px 10px;
      font-size: 0.78rem;
      cursor: pointer;
      transition: all 0.15s;
      white-space: nowrap;
    }
    .delete-btn:hover { background: #e74c3c; color: #fff; }

    .loading {
      text-align: center;
      padding: 60px;
      color: #888;
      font-size: 1rem;
    }
    .empty {
      text-align: center;
      padding: 60px;
      color: #999;
      font-size: 0.95rem;
    }

    /* ── Visitor activity log (StatCounter per-visit rows) ───── */
    .va-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 12px; margin: 0 0 10px; }
    .va-count { font-size: 0.8rem; font-weight: 600; color: #6a7a8c; }
    .va-legend { font-size: 0.72rem; color: #94a3b8; margin-left: auto; }
    .va-dot-id { display: inline-block; width: 10px; height: 10px; border-radius: 3px; background: #eef4fc; border: 1px solid #cbd8ea; vertical-align: -1px; }

    .va-log {
      display: flex;
      flex-direction: column;
      border: 1px solid #e3e9f0;
      border-radius: 8px;
      overflow: hidden;
      background: #fff;
    }
    .va-row { border-top: 1px solid #e3e9f0; }
    .va-row:first-child { border-top: 0; }
    .va-row.identified { background: #eef4fc; }
    /* "Connected dots" — visitors where multiple signals fuse stand out in gold */
    .va-row.va-connected { background: #fff7e6; box-shadow: inset 4px 0 0 #e0a93a; }
    .va-row.va-fullcircle { background: #fff2cc; box-shadow: inset 4px 0 0 #c9920a; }
    .va-badge-connected, .va-badge-circle {
      display: inline-block; margin-left: 6px; padding: 1px 7px; border-radius: 10px;
      font-size: 0.68rem; font-weight: 700; vertical-align: 1px; white-space: nowrap;
    }
    .va-badge-connected { background: #fde8c0; color: #8a5a00; }
    .va-badge-circle { background: #f6cf6b; color: #5c4302; }
    .va-quicktag {
      margin-left: 8px; padding: 1px 8px; border: 1px solid #cbd8ea; border-radius: 10px;
      background: #f4f8fd; color: #16335c; font-size: 0.7rem; font-weight: 600;
      cursor: pointer; vertical-align: 1px; white-space: nowrap;
    }
    .va-quicktag:hover { background: #e3eefb; border-color: #9db8dd; }

    .va-summary {
      display: flex;
      align-items: flex-start;
      gap: 14px;
      padding: 13px 16px;
      cursor: pointer;
      list-style: none;
    }
    .va-summary::-webkit-details-marker { display: none; }

    /* Blue circular expand button with a white triangle */
    .va-expand {
      flex: none;
      width: 28px;
      height: 28px;
      border-radius: 50%;
      background: #2e6fbf;
      color: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.62rem;
      line-height: 1;
      margin-top: 2px;
      transition: transform 0.15s;
    }
    .va-expand::before { content: '▶'; transform: translateX(1px); }
    .va-row[open] .va-expand { transform: rotate(90deg); }

    .va-main { flex: 1; min-width: 0; }

    /* Identity header line at the top of a row */
    .va-ident { margin-bottom: 6px; }
    .va-name { font-size: 0.95rem; font-weight: 700; color: #16335c; }
    .va-name .va-id { font-family: Consolas, monospace; font-size: 0.74rem; font-weight: 400; color: #94a3b8; }
    .va-company { color: #6a7a8c; font-weight: 600; font-size: 0.84rem; }
    .va-badge-filled {
      margin-left: 8px;
      font-size: 0.64rem;
      font-weight: 700;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      background: #eaf6ee;
      border: 1px solid #b7dfc2;
      color: #0f6e56;
      padding: 2px 7px;
      border-radius: 5px;
      vertical-align: 1px;
    }
    .va-badge-ret {
      margin-left: 6px;
      font-size: 0.64rem;
      font-weight: 700;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      background: #fdf2c9;
      border: 1px solid #e8c204;
      color: #7a5b00;
      padding: 2px 7px;
      border-radius: 5px;
      vertical-align: 1px;
    }

    /* Two-column label:value grid (StatCounter look) */
    .va-cols {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 4px 28px;
    }
    .va-pair {
      display: grid;
      grid-template-columns: 120px minmax(0, 1fr);
      gap: 8px;
      align-items: baseline;
      font-size: 0.78rem;
      line-height: 1.4;
    }
    .va-pair .va-lbl { color: #6a7a8c; }
    .va-pair .va-val { color: #24344d; overflow-wrap: anywhere; }
    .va-val a { text-decoration: none; }
    .va-val .va-isp { color: #c0392b; }
    .va-val .va-link { color: #2e6fbf; }
    .va-val .va-link:hover { text-decoration: underline; }

    .va-when { flex: none; font-size: 0.75rem; color: #6a7a8c; white-space: nowrap; text-align: right; }

    .va-detail {
      padding: 10px 16px 16px 58px;
      display: grid;
      gap: 6px;
      border-top: 1px dashed #e3e9f0;
      background: #fafcff;
    }
  </style>
</head>
<body>

  <!-- ── Login Screen ─────────────────────────────────────── -->
  <div id="login-screen">
    <div class="login-card">
      <h1>🔒 Admin Dashboard</h1>
      <p>Dolphin Centrifuge — Form Submissions</p>
      <input type="password" id="password-input" placeholder="Enter admin password" autocomplete="current-password" />
      <button id="login-btn">Sign In</button>
      <div id="login-error"></div>
      <p id="login-hint" style="margin-top:14px; font-size:0.82rem; color:#94a3b8;">Hint: ekAmrish@</p>
    </div>
  </div>

  <!-- ── Dashboard ────────────────────────────────────────── -->
  <div id="dashboard">

    <!-- Navy left sidebar -->
    <aside class="sc-sidebar">
      <div class="sc-brand">
        <span class="sc-brand-mark">D</span>
        <span class="sc-brand-name">Dolphin</span>
      </div>
      <nav class="sc-nav">
        <button type="button" class="sc-nav-item active" data-view="activity">
          <span class="sc-nav-ico">&#128202;</span>Visitor Activity
        </button>
        <button type="button" class="sc-nav-item" data-view="submissions">
          <span class="sc-nav-ico">&#128203;</span>Form Submissions
        </button>
        <button type="button" class="sc-nav-item" data-view="known">
          <span class="sc-nav-ico">&#9733;</span>Known Visitors
        </button>
      </nav>
      <div class="sc-sidebar-foot">
        <button type="button" class="sc-logout-link" id="sidebar-logout">
          <span class="sc-nav-ico">&#9099;</span>Log out
        </button>
      </div>
    </aside>

    <!-- Content area -->
    <div class="sc-content">
      <div class="sc-topbar">
        <div class="sc-topbar-title">Dolphincentrifuge.com</div>
        <div class="sc-topbar-right">
          <span class="sc-admin-tag">Admin</span>
          <button id="logout-btn">Log Out</button>
        </div>
      </div>

      <div class="sc-body">
        <div class="sc-toolbar">
          <input type="search" id="search-input" placeholder="Search by name, company, email, fluid…" />
          <span id="count-badge">Loading…</span>
        </div>

        <!-- Visitor activity / Known visitors share this panel -->
        <section class="sc-panel active" id="panel-activity">
          <h1 class="sc-section-title" id="activity-title">Visitor activity</h1>
          <div id="visitor-directory" class="visitor-directory loading">Loading visitor activity…</div>
        </section>

        <!-- Form submissions table -->
        <section class="sc-panel" id="panel-submissions">
          <h1 class="sc-section-title">Form submissions</h1>
          <div class="table-wrap">
            <div id="table-container" class="loading">Loading submissions…</div>
          </div>
        </section>
      </div>
    </div>
  </div>

  <script define:vars={{ contactWorkerBaseUrl, isDevDashboard }}>
    // ── Config ────────────────────────────────────────────────
    const WORKER_URL = contactWorkerBaseUrl;
    const SESSION_KEY = 'dc_admin_token';

    // ── Elements ──────────────────────────────────────────────
    const loginScreen    = document.getElementById('login-screen');
    const dashboard      = document.getElementById('dashboard');
    const passwordInput  = document.getElementById('password-input');
    const loginBtn       = document.getElementById('login-btn');
    const loginError     = document.getElementById('login-error');
    const searchInput    = document.getElementById('search-input');
    const countBadge     = document.getElementById('count-badge');
    const tableContainer = document.getElementById('table-container');
    const visitorDirectory = document.getElementById('visitor-directory');
    const logoutBtn      = document.getElementById('logout-btn');

    let allData = [];
    let allVisitors = [];
    const initialSearch = new URLSearchParams(window.location.search).get('q') || '';

    // ── Auto-login if session exists ──────────────────────────
    // Local dev only: lets us verify localhost without a real admin secret.
    const localDemoToken = (
      isDevDashboard
      && ['localhost', '127.0.0.1', '::1'].includes(window.location.hostname)
      && new URLSearchParams(window.location.search).get('localDemo') === '1'
    ) ? 'local-demo-token' : '';
    if (localDemoToken) sessionStorage.setItem(SESSION_KEY, localDemoToken);

    const savedToken = localDemoToken || sessionStorage.getItem(SESSION_KEY);
    if (savedToken) {
      showDashboard();
      loadSubmissions(savedToken);
    }

    // ── Login ─────────────────────────────────────────────────
    loginBtn.addEventListener('click', attemptLogin);
    passwordInput.addEventListener('keydown', e => { if (e.key === 'Enter') attemptLogin(); });

    async function attemptLogin() {
      const token = passwordInput.value.trim();
      if (!token) { loginError.textContent = 'Please enter your password.'; return; }

      loginBtn.textContent = 'Checking…';
      loginBtn.disabled = true;
      loginError.textContent = '';

      try {
        const resp = await fetch(`${WORKER_URL}/admin/submissions`, {
          headers: { 'Authorization': `Bearer ${token}` }
        });

        if (resp.status === 401) {
          loginError.textContent = 'Incorrect password.';
        } else if (resp.ok) {
          sessionStorage.setItem(SESSION_KEY, token);
          const json = await resp.json();
          allData = json.data || [];
          showDashboard();
          applyInitialSearch();
          applySearch();
          loadVisitors(token);
        } else {
          loginError.textContent = 'Server error. Please try again.';
        }
      } catch (err) {
        loginError.textContent = 'Connection error. Is the worker deployed?';
      }

      loginBtn.textContent = 'Sign In';
      loginBtn.disabled = false;
    }

    // ── Load submissions ───────────────────────────────────────
    async function loadSubmissions(token) {
      try {
        const resp = await fetch(`${WORKER_URL}/admin/submissions`, {
          headers: { 'Authorization': `Bearer ${token}` }
        });
        if (resp.status === 401) { logout(); return; }
        const json = await resp.json();
        allData = json.data || [];
        applyInitialSearch();
        applySearch();
        loadVisitors(token);
      } catch (err) {
        tableContainer.innerHTML = '<div class="empty">Failed to load data. Check your connection.</div>';
      }
    }

    async function loadVisitors(token) {
      try {
        const resp = await fetch(`${WORKER_URL}/admin/visitors`, {
          headers: { 'Authorization': `Bearer ${token}` }
        });
        if (!resp.ok) throw new Error('Visitor load failed');
        const json = await resp.json();
        allVisitors = json.data || [];
        applySearch();
      } catch (err) {
        visitorDirectory.innerHTML = '<h2>Known Visitors</h2><div class="attrib-muted">Visitor profiles are not available yet.</div>';
      }
    }

    // ── Render table ───────────────────────────────────────────
    function isReturningRecord(record) {
      return Boolean(
        record.is_reconnect
        || Number(record.attribution_is_returning || 0)
        || Number(record.visitor_profile_visit_count || record.attribution_visit_count || 0) > 1
      );
    }

    function renderTable(data) {
      const reconnectCount = data.filter(isReturningRecord).length;
      countBadge.textContent = `${data.length} entries · ${reconnectCount} returning visitor${reconnectCount !== 1 ? 's' : ''}`;

      if (data.length === 0) {
        tableContainer.innerHTML = '<div class="empty">No submissions yet.</div>';
        return;
      }

      const colgroup = `
        <colgroup>
          <col style="width:54px">
          <col style="width:108px">
          <col style="width:116px">
          <col style="width:170px">
          <col style="width:210px">
          <col style="width:230px">
          <col style="width:128px">
          <col style="width:138px">
          <col style="width:150px">
          <col style="width:110px">
          <col style="width:92px">
          <col style="width:155px">
          <col style="width:130px">
          <col style="width:250px">
          <col style="width:430px">
          <col style="width:360px">
          <col style="width:132px">
          <col style="width:96px">
        </colgroup>`;

      const thead = `
        <thead>
          <tr>
            <th>#</th>
            <th>Date</th>
            <th>Type</th>
            <th>Name</th>
            <th>Company</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Country</th>
            <th>Fluid Type</th>
            <th>Capacity</th>
            <th>Solids %</th>
            <th>Condition</th>
            <th>Contact Pref.</th>
            <th>Details</th>
            <th>Google Attribution</th>
            <th>Visitor Context</th>
            <th>Status</th>
            <th>Delete</th>
          </tr>
        </thead>`;

      const tbody = data.map(r => {
        const date = r.created_at ? r.created_at.substring(0, 10) : '—';
        const reconnectBadge = isReturningRecord(r)
          ? `<span class="badge-reconnect">⚡ RETURNING</span>`
          : '';
        const details = r.additional_details
          ? r.additional_details.substring(0, 80) + (r.additional_details.length > 80 ? '…' : '')
          : '—';
        const rowClass = isReturningRecord(r) ? 'reconnect-row' : '';
        // Country flag + foreigner cue: form country is a 2-letter ISO code.
        const cc = String(r.country || '').trim().toUpperCase();
        const ccFlag = countryFlag(cc);
        const isForeign = /^[A-Z]{2}$/.test(cc) && cc !== 'US';

        return `
          <tr class="${rowClass}" data-id="${r.id}">
            <td>${r.id}</td>
            <td style="white-space:nowrap">${date}</td>
            <td><span class="type-badge">${esc(formTypeLabel(r.form_type))}</span></td>
            <td style="white-space:nowrap">${esc(r.first_name)} ${esc(r.last_name)}</td>
            <td>${esc(r.company)}</td>
            <td><a href="mailto:${esc(r.email)}" style="color:#1a2a4a;">${esc(r.email)}</a></td>
            <td style="white-space:nowrap">${esc(r.phone)}</td>
            <td style="white-space:nowrap;${isForeign ? 'background:#FFE0B2;font-weight:600;' : ''}">${ccFlag ? ccFlag + ' ' : ''}${esc(r.country)}${r.us_state ? ' / ' + esc(r.us_state) : ''}</td>
            <td>${esc(r.fluid_type)}</td>
            <td>${esc(r.capacity)}</td>
            <td>${esc(r.solids_percentage)}</td>
            <td style="white-space:nowrap">${esc(r.centrifuge_condition)}</td>
            <td style="white-space:nowrap">${esc(r.contact_method)}</td>
            <td title="${esc(r.additional_details)}">${esc(details)}</td>
            <td class="attrib-cell">${renderAttribution(r)}</td>
            <td class="visitor-cell">${renderVisitorContext(r)}</td>
            <td>${reconnectBadge}</td>
            <td><button class="delete-btn" data-delete-id="${r.id}">Delete</button></td>
          </tr>`;
      }).join('');

      tableContainer.innerHTML = `<table class="submissions-table">${colgroup}${thead}<tbody>${tbody}</tbody></table>`;
    }

    // ── Search filter ──────────────────────────────────────────
    function visitorProfileSearchText(visitor) {
      return `${visitor.visitor_id || ''} ${visitor.label || ''} ${visitor.contact_name || ''} ${visitor.contact_company || ''} ${visitor.contact_email || ''} ${visitor.contact_phone || ''} ${visitor.identity_source || ''} ${visitor.identity_confidence || ''} ${visitor.notes || ''} ${visitor.visitor_ip || ''} ${visitor.visitor_user_agent || ''} ${visitor.visitor_country || ''} ${visitor.visitor_region || ''} ${visitor.visitor_city || ''} ${visitor.visitor_as_organization || ''} ${visitor.source || ''} ${visitor.medium || ''} ${visitor.campaign || ''} ${visitor.term || ''} ${visitor.first_landing_page || ''} ${visitor.last_page || ''}`;
    }

    function visitorDisplayName(visitor) {
      return visitor.label || visitor.contact_name || visitor.contact_company || visitor.contact_email || '';
    }

    function visitorInitials(name) {
      const parts = String(name || '').trim().split(/\s+/).filter(Boolean);
      if (!parts.length) return '';
      return (parts[0][0] + (parts[1] ? parts[1][0] : '')).toUpperCase();
    }

    function formatWhen(iso) {
      if (!iso) return '';
      const d = new Date(iso);
      if (isNaN(d.getTime())) return esc(String(iso));
      return d.toLocaleString(undefined, { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' });
    }

    function submittedVisitorIdSet() {
      const set = new Set();
      for (const r of allData) {
        if (r.attribution_visitor_id) set.add(r.attribution_visitor_id);
      }
      return set;
    }

    function visitorSourcePill(visitor) {
      const src = String(visitor.source || '').toLowerCase();
      const med = String(visitor.medium || '').toLowerCase();
      const term = visitor.term ? ' · "' + esc(visitor.term) + '"' : '';
      if (visitor.gclid || med === 'cpc' || med === 'ppc') {
        return `<span class="va-pill va-pill-ads">Google Ads${term}</span>`;
      }
      if (med === 'organic' || src.includes('google') || src.includes('bing') || src.includes('duckduckgo')) {
        return `<span class="va-pill va-pill-neu">Organic${term}</span>`;
      }
      if (!src || src === 'direct' || src === '(direct)' || src === 'none') {
        return `<span class="va-pill va-pill-neu">Direct</span>`;
      }
      const label = [visitor.source, visitor.medium].filter(Boolean).join(' / ');
      return `<span class="va-pill va-pill-neu">${esc(label || 'Other')}</span>`;
    }

    function isIdentifiedVisitor(visitor, submitted) {
      return Boolean(
        submitted.has(visitor.visitor_id)
        || visitor.contact_name
        || visitor.contact_email
        || visitor.label
      );
    }

    // Build one StatCounter-style "label: value" pair.
    function vaPair(label, valueHtml) {
      if (!valueHtml) return '';
      return `<div class="va-pair"><span class="va-lbl">${esc(label)}</span><span class="va-val">${valueHtml}</span></div>`;
    }

    function renderVisitorDirectory(visitors) {
      const submitted = submittedVisitorIdSet();
      const filteredByView = knownOnly
        ? visitors.filter(v => isIdentifiedVisitor(v, submitted))
        : visitors;
      const shown = filteredByView.slice(0, 100);
      const total = filteredByView.length;
      const identifiedCount = visitors.filter(v => isIdentifiedVisitor(v, submitted)).length;
      const countLabel = knownOnly
        ? `${total} known visitor${total !== 1 ? 's' : ''}${total > shown.length ? ' · showing 100' : ''}`
        : `${total} visitor${total !== 1 ? 's' : ''}${total > shown.length ? ' · showing 100' : ''} · ${identifiedCount} identified`;
      const heading = `
        <div class="va-head">
          <span class="va-count">${countLabel}</span>
          <span class="va-legend"><span class="va-dot-id"></span> identified / filled form · newest first</span>
        </div>`;

      if (shown.length === 0) {
        const emptyMsg = knownOnly
          ? 'No identified visitors yet. Visitors who fill a form — or that you name/label — appear here.'
          : 'No visitors match this filter yet. Tracking went live recently — new visitors appear here as they browse the site.';
        visitorDirectory.innerHTML = `${heading}<div class="attrib-muted" style="padding:14px;">${emptyMsg}</div>`;
        return;
      }

      visitorDirectory.innerHTML = `${heading}<div class="va-log">${shown.map(visitor => {
        const visitorId = visitor.visitor_id || '';
        const isFiller = submitted.has(visitorId);
        const name = visitorDisplayName(visitor);
        const isIdentified = isIdentifiedVisitor(visitor, submitted);
        const visits = Number(visitor.visit_count || 0);
        const pageviews = Number(visitor.pageview_count || 0);
        const isReturning = visits > 1;

        // "Connected dots" — count how many distinct signal types fuse on this profile.
        const srcL = String(visitor.source || '').toLowerCase();
        const hasIdentity = Boolean(visitor.contact_name || visitor.contact_email || visitor.contact_phone || visitor.label);
        const hasConversion = isFiller;
        const hasPaid = Boolean(visitor.gclid);
        const hasSource = Boolean(visitor.term) || (srcL && srcL !== 'direct' && srcL !== '(direct)' && srcL !== 'none');
        const dots = [hasIdentity, hasConversion, hasPaid, isReturning, hasSource].filter(Boolean).length;
        const fullCircle = hasIdentity && hasConversion && (hasPaid || hasSource);
        const connectClass = fullCircle ? 'va-fullcircle' : (dots >= 3 ? 'va-connected' : (isIdentified ? 'identified' : ''));
        const connectBadge = fullCircle
          ? '<span class="va-badge-circle" title="Full circle: identity + conversion + traffic source all linked">🎯 Full circle</span>'
          : (dots >= 3 ? `<span class="va-badge-connected" title="${dots} signals linked on this visitor">🔗 ${dots} dots</span>` : '');
        const quickTagBtn = visitorId
          ? `<button type="button" class="va-quicktag" data-quick-tag-id="${esc(visitorId)}" title="Quick name / tag this visitor">🏷 ${name ? 'Re-tag' : 'Name'}</button>`
          : '';

        // Identity header line
        const nameHtml = name
          ? `${esc(name)}${(visitor.contact_company && visitor.contact_company !== name) ? ' <span class="va-company">· ' + esc(visitor.contact_company) + '</span>' : ''}`
          : `Anonymous <span class="va-id">#${esc(visitorId.slice(0, 12))}</span>`;
        const filledBadge = isFiller ? '<span class="va-badge-filled">Filled Form</span>' : '';
        const retBadge = isReturning ? `<span class="va-badge-ret">Returning ×${visits}</span>` : '';

        // Column A
        const system = browserSummary(visitor.visitor_user_agent || '');
        // Column B
        const flag = countryFlag(visitor.visitor_country);
        const location = [visitor.visitor_city || '', visitor.visitor_region || '', visitor.visitor_country || ''].filter(Boolean).join(', ');
        const locationHtml = (flag ? flag + ' ' : '') + (location ? esc(location) : '');
        const ispParts = [];
        if (visitor.visitor_as_organization) ispParts.push(`<span class="va-isp">${esc(visitor.visitor_as_organization)}</span>`);
        if (visitor.visitor_ip) ispParts.push(`(${esc(visitor.visitor_ip)})`);
        const ispHtml = ispParts.join(' ');
        const sourceText = [visitor.source, visitor.medium].filter(Boolean).join(' / ') || (visitor.referrer ? displayUrl(visitor.referrer) : '');
        const lastPageRaw = visitor.last_page || visitor.first_landing_page || '';
        const lastPageHtml = lastPageRaw
          ? `<a class="va-link" href="${esc(lastPageRaw)}" target="_blank" rel="noopener">${esc(displayUrl(lastPageRaw))} ↗</a>`
          : '';

        // Detail panel (attrib lines + identity controls)
        const network = [visitor.visitor_asn ? 'AS' + visitor.visitor_asn : '', visitor.visitor_as_organization || ''].filter(Boolean).join(' ');

        return `
          <details class="va-row ${connectClass}">
            <summary class="va-summary">
              <span class="va-expand" aria-hidden="true"></span>
              <div class="va-main">
                <div class="va-ident">
                  <span class="va-name">${nameHtml}</span>${filledBadge}${retBadge}${connectBadge}${quickTagBtn}
                </div>
                <div class="va-cols">
                  ${vaPair('Page Views:', String(pageviews))}
                  ${vaPair('Location:', locationHtml)}
                  ${vaPair('Last seen:', visitor.last_seen_at ? esc(formatWhen(visitor.last_seen_at)) : '')}
                  ${vaPair('ISP / IP:', ispHtml)}
                  ${vaPair('Visits:', String(visits))}
                  ${vaPair('Source:', sourceText ? esc(sourceText) : '')}
                  ${vaPair('System:', system ? esc(system) : '')}
                  ${vaPair('Visit Page:', lastPageHtml)}
                </div>
              </div>
              <div class="va-when">${formatWhen(visitor.last_seen_at)}</div>
            </summary>
            <div class="va-detail">
              ${attribLine('Visitor ID', visitorId ? esc(visitorId) : '', 'attrib-path')}
              ${attribLine('Network', network ? esc(network) : '')}
              ${attribLine('First seen', visitor.first_seen_at ? formatWhen(visitor.first_seen_at) : '')}
              ${attribLine('Keyword', visitor.term ? esc(visitor.term) : '')}
              ${attribLine('Last page', visitor.last_page ? esc(visitor.last_page) : '', 'attrib-path')}
              ${visitorId ? renderVisitorIdentityControls(visitor, visitorId) : ''}
            </div>
          </details>`;
      }).join('')}</div>`;
    }

    function applyInitialSearch() {
      if (initialSearch && !searchInput.value) searchInput.value = initialSearch;
    }

    function applySearch() {
      const q = searchInput.value.toLowerCase();
      const filtered = allData.filter(r =>
        `${r.first_name} ${r.last_name} ${r.company} ${r.email} ${r.phone} ${r.fluid_type} ${r.country} ${r.additional_details} ${r.form_type} ${googleAttributionSearchText(r)} ${visitorContextSearchText(r)}`
          .toLowerCase().includes(q)
      );
      renderTable(filtered);
      renderVisitorDirectory(allVisitors.filter(visitor =>
        visitorProfileSearchText(visitor).toLowerCase().includes(q)
      ));
    }

    searchInput.addEventListener('input', applySearch);

    // ── Delete: event delegation on table container ─────────
    let pendingDeleteId = null;

    function getDeleteModalEls() {
      return {
        deleteModal: document.getElementById('delete-modal'),
        modalConfirm: document.getElementById('modal-confirm'),
        modalCancel: document.getElementById('modal-cancel'),
      };
    }

    tableContainer.addEventListener('click', function(e) {
      const saveVisitorBtn = e.target.closest('[data-save-visitor-id]');
      if (saveVisitorBtn) {
        saveVisitorSettings(saveVisitorBtn);
        return;
      }

      const btn = e.target.closest('[data-delete-id]');
      if (!btn) return;
      pendingDeleteId = Number(btn.dataset.deleteId);
      const { deleteModal } = getDeleteModalEls();
      if (deleteModal) deleteModal.style.display = 'flex';
    });

    visitorDirectory.addEventListener('click', function(e) {
      const quickTagBtn = e.target.closest('[data-quick-tag-id]');
      if (quickTagBtn) {
        e.preventDefault();   // don't toggle the <details> row
        e.stopPropagation();
        quickTagVisitor(quickTagBtn.dataset.quickTagId);
        return;
      }
      const saveVisitorBtn = e.target.closest('[data-save-visitor-id]');
      if (saveVisitorBtn) saveVisitorSettings(saveVisitorBtn);
    });

    async function saveVisitorSettings(button) {
      const visitorId = button.dataset.saveVisitorId;
      if (!visitorId) return;
      const token = sessionStorage.getItem(SESSION_KEY);
      const labelInput = dashboard.querySelector(`[data-visitor-label="${cssEscape(visitorId)}"]`);
      const contactNameInput = dashboard.querySelector(`[data-visitor-contact-name="${cssEscape(visitorId)}"]`);
      const contactCompanyInput = dashboard.querySelector(`[data-visitor-contact-company="${cssEscape(visitorId)}"]`);
      const contactEmailInput = dashboard.querySelector(`[data-visitor-contact-email="${cssEscape(visitorId)}"]`);
      const contactPhoneInput = dashboard.querySelector(`[data-visitor-contact-phone="${cssEscape(visitorId)}"]`);
      const notesInput = dashboard.querySelector(`[data-visitor-notes="${cssEscape(visitorId)}"]`);
      const alertInput = dashboard.querySelector(`[data-visitor-alert="${cssEscape(visitorId)}"]`);
      const emailInput = dashboard.querySelector(`[data-visitor-email="${cssEscape(visitorId)}"]`);
      const statusEl = dashboard.querySelector(`[data-visitor-status="${cssEscape(visitorId)}"]`);
      const payload = {
        label: labelInput ? labelInput.value.trim() : '',
        contact_name: contactNameInput ? contactNameInput.value.trim() : '',
        contact_company: contactCompanyInput ? contactCompanyInput.value.trim() : '',
        contact_email: contactEmailInput ? contactEmailInput.value.trim() : '',
        contact_phone: contactPhoneInput ? contactPhoneInput.value.trim() : '',
        identity_source: 'manual',
        identity_confidence: 'manual-confirmed',
        notes: notesInput ? notesInput.value.trim() : '',
        alert_enabled: alertInput ? alertInput.checked : false,
        alert_email: emailInput ? emailInput.value.trim() : 'sales@dolphincentrifuge.com',
      };

      button.disabled = true;
      if (statusEl) statusEl.textContent = 'Saving...';

      try {
        const resp = await fetch(`${WORKER_URL}/admin/visitors/${encodeURIComponent(visitorId)}`, {
          method: 'POST',
          headers: {
            'Authorization': `Bearer ${token}`,
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(payload),
        });
        if (!resp.ok) throw new Error('Save failed');

        allData = allData.map(row => {
          if (row.attribution_visitor_id !== visitorId) return row;
          return {
            ...row,
            visitor_label: payload.label,
            visitor_contact_name: payload.contact_name,
            visitor_contact_company: payload.contact_company,
            visitor_contact_email: payload.contact_email,
            visitor_contact_phone: payload.contact_phone,
            visitor_identity_source: payload.identity_source,
            visitor_identity_confidence: payload.identity_confidence,
            visitor_notes: payload.notes,
            visitor_alert_enabled: payload.alert_enabled ? 1 : 0,
            visitor_alert_email: payload.alert_email,
          };
        });
        allVisitors = allVisitors.map(visitor => {
          if (visitor.visitor_id !== visitorId) return visitor;
          return {
            ...visitor,
            label: payload.label,
            contact_name: payload.contact_name,
            contact_company: payload.contact_company,
            contact_email: payload.contact_email,
            contact_phone: payload.contact_phone,
            identity_source: payload.identity_source,
            identity_confidence: payload.identity_confidence,
            notes: payload.notes,
            alert_enabled: payload.alert_enabled ? 1 : 0,
            alert_email: payload.alert_email,
          };
        });
        applySearch();
      } catch (err) {
        if (statusEl) statusEl.textContent = 'Save failed';
        button.disabled = false;
      }
    }

    // Quick name/tag straight from a visitor row (StatCounter-style), reusing the
    // same /admin/visitors save endpoint. Merges with existing fields so a fast
    // tag never wipes previously-saved contact details.
    async function quickTagVisitor(visitorId) {
      if (!visitorId) return;
      const existing = allVisitors.find(v => v.visitor_id === visitorId) || {};
      const current = existing.label || existing.contact_name || '';
      const entered = window.prompt('Quick name / tag for this visitor (phone match, form, your read, IP — your call):', current);
      if (entered === null) return; // cancelled
      const tag = entered.trim();
      const token = sessionStorage.getItem(SESSION_KEY);
      const payload = {
        label: tag,
        contact_name: existing.contact_name || '',
        contact_company: existing.contact_company || '',
        contact_email: existing.contact_email || '',
        contact_phone: existing.contact_phone || '',
        identity_source: 'manual',
        identity_confidence: 'manual-quick',
        notes: existing.notes || '',
        alert_enabled: existing.alert_enabled ? true : false,
        alert_email: existing.alert_email || 'sales@dolphincentrifuge.com',
      };
      try {
        const resp = await fetch(`${WORKER_URL}/admin/visitors/${encodeURIComponent(visitorId)}`, {
          method: 'POST',
          headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        if (!resp.ok) throw new Error('Save failed');
        allVisitors = allVisitors.map(v => v.visitor_id === visitorId
          ? { ...v, label: tag, identity_source: 'manual', identity_confidence: 'manual-quick' } : v);
        allData = allData.map(row => row.attribution_visitor_id === visitorId
          ? { ...row, visitor_label: tag, visitor_identity_source: 'manual' } : row);
        applySearch();
      } catch (err) {
        alert('Could not save the tag. Please try again.');
      }
    }

    document.addEventListener('DOMContentLoaded', function() {
      const { deleteModal, modalConfirm, modalCancel } = getDeleteModalEls();
      if (!deleteModal || !modalConfirm || !modalCancel) return;

      modalCancel.addEventListener('click', function() {
      deleteModal.style.display = 'none';
      pendingDeleteId = null;
    });

    modalConfirm.addEventListener('click', async function() {
      if (!pendingDeleteId) return;
      const id    = pendingDeleteId;
      const token = sessionStorage.getItem(SESSION_KEY);
      deleteModal.style.display = 'none';
      pendingDeleteId = null;

      modalConfirm.textContent = 'Deleting…';
      modalConfirm.disabled = true;

      try {
        const resp = await fetch(`${WORKER_URL}/admin/submissions/${id}`, {
          method: 'DELETE',
          headers: { 'Authorization': `Bearer ${token}` }
        });
        if (resp.ok) {
          allData = allData.filter(r => r.id !== id);
          renderTable(allData);
        } else {
          alert('Delete failed — server returned an error.');
        }
      } catch (err) {
        alert('Connection error. Please try again.');
      } finally {
        modalConfirm.textContent = 'Yes, Delete';
        modalConfirm.disabled = false;
      }
    });

    // Close modal on backdrop click
    deleteModal.addEventListener('click', function(e) {
      if (e.target === deleteModal) {
        deleteModal.style.display = 'none';
        pendingDeleteId = null;
      }
    });

    // ── Helpers ────────────────────────────────────────────────
    });

    function showDashboard() {
      loginScreen.style.display = 'none';
      dashboard.style.display = 'flex';
      dashboard.classList.add('is-active');
    }

    function logout() {
      sessionStorage.removeItem(SESSION_KEY);
      dashboard.classList.remove('is-active');
      loginScreen.style.display = 'flex';
      dashboard.style.display = 'none';
      passwordInput.value = '';
    }

    logoutBtn.addEventListener('click', logout);
    const sidebarLogout = document.getElementById('sidebar-logout');
    if (sidebarLogout) sidebarLogout.addEventListener('click', logout);

    // ── Sidebar navigation (StatCounter-style view switching) ──
    // "Known Visitors" reuses the activity panel but pre-filters to
    // identified visitors (form-fillers or named/labeled profiles).
    let knownOnly = false;
    const navItems = Array.from(document.querySelectorAll('.sc-nav-item'));
    const panelActivity = document.getElementById('panel-activity');
    const panelSubmissions = document.getElementById('panel-submissions');
    const activityTitle = document.getElementById('activity-title');

    function setView(view) {
      navItems.forEach(btn => btn.classList.toggle('active', btn.dataset.view === view));
      const showActivity = (view === 'activity' || view === 'known');
      panelActivity.classList.toggle('active', showActivity);
      panelSubmissions.classList.toggle('active', view === 'submissions');
      knownOnly = (view === 'known');
      if (activityTitle) {
        activityTitle.textContent = knownOnly ? 'Known visitors' : 'Visitor activity';
      }
      if (showActivity) applySearch();
    }

    navItems.forEach(btn => {
      btn.addEventListener('click', () => setView(btn.dataset.view));
    });

    function formTypeLabel(value) {
      const type = String(value || 'contact');
      if (type === 'parts_request_form') return 'Parts RFQ';
      if (type === 'disc_parts_glossary_form') return 'Parts RFQ';
      if (type === 'centrifuge_contact_form') return 'Contact';
      if (type === 'contact') return 'Contact';
      return type.replace(/_/g, ' ');
    }

    function shortPath(value) {
      if (!value) return '';
      try {
        const url = new URL(String(value), window.location.origin);
        return `${url.pathname}${url.search}`;
      } catch (e) {
        return String(value);
      }
    }

    function displayUrl(value) {
      if (!value) return '';
      try {
        const url = new URL(String(value), window.location.origin);
        if (url.origin === window.location.origin) return `${url.pathname}${url.search}`;
        return `${url.hostname}${url.pathname}${url.search}`;
      } catch (e) {
        return String(value);
      }
    }

    function parsePages(record) {
      const raw = record && record.attribution_pages_json;
      if (!raw) return [];
      try {
        const pages = JSON.parse(raw);
        if (!Array.isArray(pages)) return [];
        return pages.filter(page => page && (page.path || page.title)).slice(-8);
      } catch (e) {
        return [];
      }
    }

    function isGoogleAttribution(record) {
      const source = String(record.attribution_source || '').toLowerCase();
      return source === 'google'
        || source.includes('google.')
        || Boolean(record.attribution_gclid || record.attribution_gbraid || record.attribution_wbraid);
    }

    function googleAttributionSearchText(record) {
      if (!isGoogleAttribution(record)) return '';
      return `${record.attribution_source} ${record.attribution_medium} ${record.attribution_campaign} ${record.attribution_term} ${record.attribution_landing_page} ${record.attribution_current_page} ${record.attribution_gclid} ${record.attribution_gbraid} ${record.attribution_wbraid} ${record.attribution_ga_client_id} ${record.attribution_statcounter_visitor_id}`;
    }

    function visitorContextSearchText(record) {
      const pages = parsePages(record).map(page => `${page.path || ''} ${page.title || ''} ${page.referrer || ''}`).join(' ');
      return `${record.attribution_visitor_id || ''} ${record.visitor_label || ''} ${record.visitor_contact_name || ''} ${record.visitor_contact_company || ''} ${record.visitor_contact_email || ''} ${record.visitor_contact_phone || ''} ${record.visitor_identity_source || ''} ${record.visitor_identity_confidence || ''} ${record.visitor_notes || ''} ${record.visitor_ip || ''} ${record.visitor_user_agent || ''} ${record.visitor_accept_language || ''} ${record.visitor_country || ''} ${record.visitor_region || ''} ${record.visitor_city || ''} ${record.visitor_timezone || ''} ${record.visitor_asn || ''} ${record.visitor_as_organization || ''} ${record.visitor_cf_ray || ''} ${record.attribution_referrer || ''} ${record.attribution_landing_page || ''} ${record.attribution_current_page || ''} ${pages}`;
    }

    function attribLine(label, value, className) {
      if (!value) return '';
      const valueClass = className ? `attrib-value ${className}` : 'attrib-value';
      return `
        <div class="attrib-line">
          <span class="attrib-label">${esc(label)}</span>
          <span class="${valueClass}">${value}</span>
        </div>`;
    }

    function cssEscape(value) {
      if (window.CSS && typeof window.CSS.escape === 'function') return window.CSS.escape(String(value));
      return String(value).replace(/["\\]/g, '\\$&');
    }

    // Convert a 2-letter ISO country code to its regional-indicator emoji.
    // Returns '' if the code is missing or not exactly two A-Z letters.
    function countryFlag(cc) {
      const code = String(cc || '').trim().toUpperCase();
      if (!/^[A-Z]{2}$/.test(code)) return '';
      const base = 0x1F1E6; // regional indicator 'A'
      return String.fromCodePoint(
        base + (code.charCodeAt(0) - 65),
        base + (code.charCodeAt(1) - 65),
      );
    }

    function browserSummary(userAgent) {
      const ua = String(userAgent || '');
      let browser = 'Browser details';
      if (ua.includes('Edg/')) browser = 'Edge';
      else if (ua.includes('Chrome/')) browser = 'Chrome';
      else if (ua.includes('Firefox/')) browser = 'Firefox';
      else if (ua.includes('Safari/') && !ua.includes('Chrome/')) browser = 'Safari';

      let device = '';
      if (ua.includes('Windows')) device = 'Windows';
      else if (ua.includes('Macintosh')) device = 'macOS';
      else if (ua.includes('iPhone')) device = 'iPhone';
      else if (ua.includes('iPad')) device = 'iPad';
      else if (ua.includes('Android')) device = 'Android';
      else if (ua.includes('Linux')) device = 'Linux';

      return device ? `${browser} on ${device}` : browser;
    }

    function renderVisitorIdentityControls(record, visitorId) {
      const labelValue = record.visitor_label || record.label || '';
      const contactNameValue = record.visitor_contact_name || record.contact_name || '';
      const contactCompanyValue = record.visitor_contact_company || record.contact_company || '';
      const contactEmailValue = record.visitor_contact_email || record.contact_email || '';
      const contactPhoneValue = record.visitor_contact_phone || record.contact_phone || '';
      const notesValue = record.visitor_notes || record.notes || '';
      const alertEnabled = Number(record.visitor_alert_enabled || record.alert_enabled || 0);
      const alertEmail = record.visitor_alert_email || record.alert_email || 'sales@dolphincentrifuge.com';

      return `
        <div class="visitor-label-box" data-visitor-box="${esc(visitorId)}">
          ${attribLine('Label', labelValue ? esc(labelValue) : '<span class="attrib-muted">Unlabeled</span>')}
          <input type="text" data-visitor-label="${esc(visitorId)}" value="${esc(labelValue)}" placeholder="Name this visitor" />
          <div class="visitor-identity-grid">
            <input type="text" data-visitor-contact-name="${esc(visitorId)}" value="${esc(contactNameValue)}" placeholder="Contact name" />
            <input type="text" data-visitor-contact-company="${esc(visitorId)}" value="${esc(contactCompanyValue)}" placeholder="Company" />
            <input type="email" data-visitor-contact-email="${esc(visitorId)}" value="${esc(contactEmailValue)}" placeholder="Email" />
            <input type="tel" data-visitor-contact-phone="${esc(visitorId)}" value="${esc(contactPhoneValue)}" placeholder="Phone or caller ID" />
          </div>
          <textarea data-visitor-notes="${esc(visitorId)}" placeholder="Notes, e.g. John called at 2:10 PM from Massachusetts">${esc(notesValue)}</textarea>
          <label class="visitor-alert-row">
            <input type="checkbox" data-visitor-alert="${esc(visitorId)}" ${alertEnabled ? 'checked' : ''} />
            <span>Email me when this visitor returns</span>
          </label>
          <input type="email" data-visitor-email="${esc(visitorId)}" value="${esc(alertEmail)}" placeholder="sales@dolphincentrifuge.com" />
          <button class="visitor-save-btn" data-save-visitor-id="${esc(visitorId)}">Save Visitor</button>
          <span class="visitor-save-status" data-visitor-status="${esc(visitorId)}"></span>
        </div>
      `;
    }

    function renderVisitorContext(record) {
      const location = [
        record.visitor_city || '',
        record.visitor_region || '',
        record.visitor_country || '',
      ].filter(Boolean).join(', ');
      const network = [
        record.visitor_asn ? `AS${record.visitor_asn}` : '',
        record.visitor_as_organization || '',
      ].filter(Boolean).join(' ');
      const pages = parsePages(record);
      const pageCount = Number(record.attribution_page_count || pages.length || 0);
      const referrer = displayUrl(record.attribution_referrer || '');
      const landing = displayUrl(record.attribution_landing_page || '');
      const userAgent = record.visitor_user_agent || '';
      const cookieVisitorId = record.attribution_visitor_id || '';
      const visitCount = Number(record.visitor_profile_visit_count || record.attribution_visit_count || 0);
      const isReturning = Number(record.attribution_is_returning || 0) || visitCount > 1;
      const lastSeen = record.visitor_profile_last_seen_at || record.attribution_visitor_last_seen_at || '';
      const labelValue = record.visitor_label || '';
      const contactNameValue = record.visitor_contact_name || '';
      const contactCompanyValue = record.visitor_contact_company || '';
      const contactEmailValue = record.visitor_contact_email || '';
      const contactPhoneValue = record.visitor_contact_phone || '';
      const identitySourceValue = record.visitor_identity_source || '';
      const identityConfidenceValue = record.visitor_identity_confidence || '';
      const notesValue = record.visitor_notes || '';
      const alertEnabled = Number(record.visitor_alert_enabled || 0);
      const alertEmail = record.visitor_alert_email || 'sales@dolphincentrifuge.com';
      const hasContext = record.visitor_ip
        || userAgent
        || location
        || network
        || cookieVisitorId
        || contactNameValue
        || contactCompanyValue
        || contactEmailValue
        || contactPhoneValue
        || notesValue
        || record.visitor_accept_language
        || record.visitor_cf_ray
        || referrer
        || landing
        || pages.length;

      if (!hasContext) {
        return '<span class="attrib-muted">Not captured yet</span>';
      }

      const browserDetails = userAgent
        ? `<details class="attrib-details"><summary>${esc(browserSummary(userAgent))}</summary><div class="context-ua-text">${esc(userAgent)}</div></details>`
        : '';
      const trailLabel = pageCount > pages.length
        ? `${pages.length} shown of ${pageCount} pages`
        : `${pages.length} page${pages.length === 1 ? '' : 's'}`;
      const trail = pages.length
        ? `<details class="attrib-details"><summary>Visit trail: ${esc(trailLabel)}</summary><ol>${pages.map(page => `<li><span class="attrib-path">${esc(displayUrl(page.path || ''))}</span>${page.title ? `<br><span class="attrib-muted">${esc(page.title)}</span>` : ''}</li>`).join('')}</ol></details>`
        : '';
      const labelControls = cookieVisitorId ? renderVisitorIdentityControls(record, cookieVisitorId) : '';

      return `
        <div class="attrib-panel">
          <div class="attrib-source">Visitor context</div>
          ${attribLine('Cookie ID', cookieVisitorId ? esc(cookieVisitorId) : '', 'attrib-path')}
          ${attribLine('Contact', contactNameValue ? esc(contactNameValue) : '')}
          ${attribLine('Company', contactCompanyValue ? esc(contactCompanyValue) : '')}
          ${attribLine('Phone', contactPhoneValue ? esc(contactPhoneValue) : '')}
          ${attribLine('Email', contactEmailValue ? esc(contactEmailValue) : '')}
          ${attribLine('Identity', identitySourceValue || identityConfidenceValue ? esc([identitySourceValue, identityConfidenceValue].filter(Boolean).join(' / ')) : '')}
          ${attribLine('Notes', notesValue ? esc(notesValue) : '')}
          ${attribLine('Visit #', visitCount ? esc(String(visitCount)) : '')}
          ${attribLine('Last seen', lastSeen ? esc(lastSeen) : '')}
          ${attribLine('Returning', isReturning ? 'Yes' : '')}
          ${attribLine('IP', record.visitor_ip ? esc(record.visitor_ip) : '')}
          ${attribLine('Location', location ? esc(location) : '')}
          ${attribLine('Referrer', referrer ? esc(referrer) : '', 'attrib-path')}
          ${attribLine('Landing', landing ? esc(landing) : '', 'attrib-path')}
          ${attribLine('Language', record.visitor_accept_language ? esc(record.visitor_accept_language) : '')}
          ${attribLine('Network', network ? esc(network) : '')}
          ${attribLine('CF-Ray', record.visitor_cf_ray ? esc(record.visitor_cf_ray) : '')}
          ${browserDetails}
          ${trail}
          ${labelControls}
        </div>
      `;
    }

    function renderAttribution(record) {
      const source = record.attribution_source || '';
      const medium = record.attribution_medium || '';
      const isGoogle = isGoogleAttribution(record);
      const landing = shortPath(record.attribution_landing_page || '');
      const current = shortPath(record.attribution_current_page || '');
      const campaign = record.attribution_campaign || '';
      const term = record.attribution_term || '';
      const pages = parsePages(record);
      const pageCount = Number(record.attribution_page_count || pages.length || 0);
      const clickIds = [
        record.attribution_gclid ? 'gclid' : '',
        record.attribution_gbraid ? 'gbraid' : '',
        record.attribution_wbraid ? 'wbraid' : '',
      ].filter(Boolean);

      if (!source && !landing && !current && pages.length === 0) {
        return '<span class="attrib-muted">Not captured yet</span>';
      }

      if (!isGoogle) {
        return `
          <div class="attrib-panel">
            <div class="attrib-source">Non-Google traffic</div>
            <div class="attrib-line">
              <span class="attrib-label">Report</span>
              <span class="attrib-value attrib-muted">Not included in Google report</span>
            </div>
          </div>
        `;
      }

      const sourceLabel = `Google${medium ? ' / ' + medium : ''}`;
      const trailLabel = pageCount > pages.length
        ? `${pages.length} shown of ${pageCount} pages`
        : `${pages.length} page${pages.length === 1 ? '' : 's'}`;
      const trail = pages.length
        ? `<details class="attrib-details"><summary>${esc(trailLabel)}</summary><ol>${pages.map(page => `<li><span class="attrib-path">${esc(shortPath(page.path || ''))}</span>${page.title ? `<br><span class="attrib-muted">${esc(page.title)}</span>` : ''}</li>`).join('')}</ol></details>`
        : '';

      return `
        <div class="attrib-panel">
          <div class="attrib-source">${esc(sourceLabel)}</div>
          ${attribLine('Campaign', campaign ? esc(campaign) : '')}
          ${attribLine('Keyword', term ? esc(term) : '')}
          ${attribLine('Landing', landing ? esc(landing) : '', 'attrib-path')}
          ${attribLine('Form page', current ? esc(current) : '', 'attrib-path')}
          ${attribLine('Ad IDs', clickIds.length ? esc(clickIds.join(', ')) : '')}
          ${attribLine('GA client', record.attribution_ga_client_id ? esc(record.attribution_ga_client_id) : '')}
          ${attribLine('StatCounter', record.attribution_statcounter_visitor_id ? esc(record.attribution_statcounter_visitor_id) : '')}
          ${trail}
        </div>
      `;
    }

    function esc(str) {
      if (!str) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }
  </script>

  <!-- ── Delete Confirmation Modal ──────────────────────────── -->
  <div id="delete-modal" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.55); z-index:200; align-items:center; justify-content:center;">
    <div style="background:#fff; border-radius:14px; padding:36px 40px; max-width:420px; width:90%; box-shadow:0 20px 60px rgba(0,0,0,0.35); text-align:center;">
      <div style="width:52px; height:52px; background:#fee2e2; border-radius:50%; display:flex; align-items:center; justify-content:center; margin:0 auto 16px;">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#e74c3c" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4h6v2"/>
        </svg>
      </div>
      <h3 style="font-family:Inter,Arial,sans-serif; font-size:1.1rem; font-weight:700; color:#1a2a4a; margin:0 0 8px;">Remove Submission?</h3>
      <p style="font-family:Inter,Arial,sans-serif; font-size:0.88rem; color:#666; margin:0 0 24px; line-height:1.5;">This record will be permanently removed from your dashboard. This cannot be undone.</p>
      <div style="display:flex; gap:12px; justify-content:center;">
        <button id="modal-cancel" style="flex:1; padding:10px; border:2px solid #ddd; background:#fff; border-radius:8px; font-size:0.9rem; font-weight:600; cursor:pointer; color:#555; transition:all 0.15s;">Cancel</button>
        <button id="modal-confirm" style="flex:1; padding:10px; border:none; background:#e74c3c; border-radius:8px; font-size:0.9rem; font-weight:600; cursor:pointer; color:#fff; transition:background 0.15s;">Yes, Delete</button>
      </div>
    </div>
  </div>

</body>
