---
import ApplicationLayout from '../../layouts/ApplicationLayout.astro';

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "DMB-019 Manual-Clean Disc Stack Centrifuge",
    "description": "Dolphin DMB-019 turnkey manual-clean module featuring a remanufactured Alfa Laval MAB 205 disc stack centrifuge. Published diesel capacity at 40°C and 13 cSt is 4,400 L/h (19.37 US GPM, derived), with a 5 HP motor and 8,700 RPM bowl speed. High-performance manual centrifuge for large turbine lube oil systems and industrial fluid purification.",
    "brand": { "@type": "Brand", "name": "Alfa Laval" },
    "alternateName": "Alfa Laval MAB 205",
    "category": "Disc Stack Centrifuges",
    "model": "DMB-019",
    "offers": {
      "@type": "Offer",
      "availability": "https://schema.org/InStock",
      "priceCurrency": "USD",
      "seller": { "@type": "Organization", "name": "Dolphin Centrifuge" }
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "DMB-019 Manual-Clean Disc Stack Centrifuge - Specifications & Applications",
    "author": {
      "@type": "Person",
      "name": "Sanjay Prabhu MSME",
      "jobTitle": "Centrifuge Applications Engineer",
      "worksFor": { "@type": "Organization", "name": "Dolphin Centrifuge" }
    },
    "publisher": { "@type": "Organization", "name": "Dolphin Centrifuge" },
    "url": "https://dolphincentrifuge.com/centrifuges/dmb-019/"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What is the throughput of the DMB-019 centrifuge?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Published MAB 205 capacities are 4,400 L/h diesel fuel at 40°C and 13 cSt (19.37 US GPM, derived), 5,750 L/h gas oil at 40°C (25.32 US GPM, derived), 2,000–2,300 L/h R&O lube oil at 80–90°C (8.81–10.13 US GPM, derived), and 4,200 L/h steam turbine oil at 60–70°C (18.49 US GPM, derived). The rated reference is 6,500 L/h (28.62 US GPM, derived); its source fluid is unspecified. The base machine uses a 5 HP motor."
        }
      },
      {
        "@type": "Question",
        "name": "What turbine size is the DMB-019 suited for?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "At the published R&O lube-oil range of 2,000–2,300 L/h at 80–90°C (8.81–10.13 US GPM, derived), the DMB-019 is well suited for turbines from approximately 5,000–15,000 HP with lube oil reservoirs of 2,000–10,000 gallons. It can also serve as a bypass purifier for larger turbines when a full-flow unit is not required. Contact Dolphin Centrifuge for a sizing calculation based on your specific turbine model and oil reservoir volume."
        }
      },
      {
        "@type": "Question",
        "name": "When should I choose the DMB-019 over the DMPX-028 self-cleaning model?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "The DMB-019 is the better choice when feed solids content is low and periodic planned cleaning is acceptable - primarily for clean turbine lube oil, diesel polishing, and gas oil purification. The DMPX-028 is the better choice when solids loading is moderate to high, continuous 24/7 unattended operation is required, or when the cost of manual cleaning shutdowns exceeds the capital cost premium for self-cleaning."
        }
      },
      {
        "@type": "Question",
        "name": "How does the DMB-019 compare to the DMB-013 and DMB-028?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "At the same published diesel condition of 40°C and 13 cSt, the DMB-019 base machine is rated at 4,400 L/h (19.37 US GPM, derived), between the DMB-013 at 2,900 L/h (12.77 US GPM, derived) and DMB-028 at 6,400 L/h (28.18 US GPM, derived). Its published R&O range at 80–90°C is 2,000–2,300 L/h (8.81–10.13 US GPM, derived); the DMB-028 range under the same R&O conditions is 2,900–3,300 L/h (12.77–14.53 US GPM, derived)."
        }
      },
      {
        "@type": "Question",
        "name": "What is the motor size for the DMB-019?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "The DMB-019 uses a 5 HP motor at 8,700 RPM, making it a significant step up in power from the DMB-013. This gives it the bowl speed and centrifugal force needed for effective separation of lube oil, diesel, and gas oil across its full rated throughput range. Contact Dolphin Centrifuge for full electrical specifications."
        }
      }
    ]
  }
];
---

<ApplicationLayout
  title="DMB-019 Manual-Clean Module - Alfa Laval MAB 205"
  pageTitle="DMB-019 Lube Oil Module - Alfa Laval MAB 205 | Dolphin Centrifuge"
  disableTitleSuffix={true}
  description="Dolphin DMB-019 module with a remanufactured Alfa Laval MAB 205: published diesel capacity at 40°C and 13 cSt is 4,400 L/h (19.37 US GPM, derived), with a 5 HP motor."
  canonicalUrl="https://dolphincentrifuge.com/centrifuges/dmb-019/"
  heroImage="/images/lube-oil-centrifuge/Alfa_Laval_MAB-205_Lube_Oil_Centrifuge_Module_by_Dolphin_Centrifuge.webp"
  heroImageAlt="Alfa Laval MAB 205 turbine lube oil centrifuge, supplied by Dolphin as the DMB-019 system"
  category="products"
  categoryLabel="Dolphin Manual-Clean Disc Centrifuges"
  toc={[
    { id: "specs", label: "Specifications" },
    { id: "capacity", label: "Capacity by Application" },
    { id: "applications", label: "Key Applications" },
    { id: "faq", label: "FAQ" },
  ]}
  relatedApplications={[
    { label: "Lube Oil Centrifuge", href: "/lube-oil-centrifuge/" },
    { label: "Fuel Oil Centrifuge", href: "/fuel-oil-centrifuge/" },
    { label: "Waste Oil Centrifuge", href: "/waste-oil-centrifuge/" },
  ]}
  relatedProducts={[
    { label: "DMB-028 Manual-Clean Centrifuge", href: "/centrifuges/dmb-028/" },
    { label: "DMB-037 Manual-Clean Centrifuge", href: "/centrifuges/dmb-037/" },
    { label: "DMPX-028 Self-Cleaning Centrifuge", href: "/centrifuges/dmpx-028/" },
  ]}
  jsonLd={jsonLd}
  hideBottomCTA={true}
>
  <article class="prose-dolphin max-w-none">

    <p>The DMB-019 is a Dolphin-engineered turnkey module featuring a remanufactured <a href="/alfa-laval-mab-centrifuge/">Alfa Laval MAB 205</a> manual-clean disc stack centrifuge, rebuilt, tested, and warrantied by Dolphin, the independent specialist in Alfa Laval centrifuges.</p>

    <h2 id="specs">DMB-019 Specifications</h2>
    <div class="overflow-x-auto mb-4">
      <table>
        <thead>
          <tr>
            <th>Parameter</th>
            <th>Value</th>
          </tr>
        </thead>
        <tbody>
          <tr><td>Base machine</td><td>Alfa Laval MAB 205 (remanufactured)</td></tr>
          <tr><td>Separation type</td><td>Two-phase clarifier (liquid-liquid or liquid-solid)</td></tr>
          <tr><td>Diesel throughput at 40&deg;C and 13 cSt</td><td>4,400 L/h (19.37 US GPM, derived)</td></tr>
          <tr><td>Rated reference (source fluid unspecified)</td><td>6,500 L/h (28.62 US GPM, derived)</td></tr>
          <tr><td>Bowl speed</td><td>8,700 RPM</td></tr>
          <tr><td>Drive motor</td><td>5 HP</td></tr>
          <tr><td>Cleaning method</td><td>Manual (bowl disassembly required for solids removal)</td></tr>
          <tr><td>Bowl construction</td><td>Carbon steel standard</td></tr>
          <tr><td>Power supply</td><td>460V / 3-phase / 60 Hz standard (other voltages available)</td></tr>
        </tbody>
      </table>
    </div>
    <p class="text-sm text-gray-500 italic">Throughput figures are for typical fluids at listed conditions. Actual capacity varies with feed viscosity, temperature, density difference, and solids loading.</p>
    <p class="text-sm text-gray-500 italic">Dolphin is an independent remanufacturer and is not affiliated with or authorized by Alfa Laval.</p>

    <div class="bg-gold/10 border-l-4 border-gold rounded-r-xl p-5 my-8 not-prose">
      <p class="font-bold text-navy text-base mb-1">Need the complete datasheet?</p>
      <p class="text-sm text-text-light leading-relaxed mb-4">We'll email the complete datasheet - usually within one business day.</p>
      <a href="/contact-for-alfa-laval-centrifuges/" class="inline-block bg-gold text-navy font-semibold px-5 py-2 rounded-lg hover:bg-gold/90 transition-colors text-sm">Request the full spec sheet (PDF) -></a>
    </div>

    <h2 id="capacity">DMB-019 Capacity by Application</h2>
    <div class="overflow-x-auto">
      <table>
        <thead>
          <tr>
            <th>Application / Fluid</th>
            <th>Published throughput (L/h and derived US GPM)</th>
          </tr>
        </thead>
        <tbody>
          <tr><td>Rated reference (source fluid unspecified)</td><td>6,500 L/h (28.62 US GPM, derived)</td></tr>
          <tr><td>Gas oil at 40&deg;C</td><td>5,750 L/h (25.32 US GPM, derived)</td></tr>
          <tr><td>Diesel fuel at 40&deg;C and 13 cSt</td><td>4,400 L/h (19.37 US GPM, derived)</td></tr>
          <tr><td>R&amp;O lube oil at 80&ndash;90&deg;C</td><td>2,000&ndash;2,300 L/h (8.81&ndash;10.13 US GPM, derived)</td></tr>
          <tr><td>Detergent lube oil at 80&ndash;90&deg;C</td><td>1,600&ndash;2,000 L/h (7.04&ndash;8.81 US GPM, derived)</td></tr>
          <tr><td>Trunk-piston detergent lube oil at 80&ndash;90&deg;C</td><td>1,200&ndash;1,400 L/h (5.28&ndash;6.16 US GPM, derived)</td></tr>
          <tr><td>Engine lubricating oil at 80&ndash;90&deg;C</td><td>2,300 L/h (10.13 US GPM, derived)</td></tr>
          <tr><td>Steam turbine oil at 60&ndash;70&deg;C</td><td>4,200 L/h (18.49 US GPM, derived)</td></tr>
        </tbody>
      </table>
    </div>
    <p class="text-sm text-gray-500 italic">US GPM values are derived from the published L/h figures using 1 US GPM = 227.124707 L/h and rounded to two decimal places. See the <a href="/technical-data/#methodology">authoritative technical-data registry and methodology</a> for source basis and machine-readable records.</p>

    <!-- Mid-Page CTA -->
    <div class="not-prose my-10 rounded-xl border-l-4 border-gold bg-gold/10 p-6 flex flex-col md:flex-row md:items-center gap-4">
      <div class="flex-1">
        <p class="text-navy font-bold text-lg mb-1">Sizing a turbine lube oil purifier?</p>
        <p class="text-gray-700 text-sm">Our applications engineers calculate the correct DMB model from your turbine HP rating, oil reservoir volume, and target turnover rate - at no charge.</p>
      </div>
      <a href="/contact-for-alfa-laval-centrifuges/" class="shrink-0 inline-block bg-gold text-navy font-bold px-6 py-3 rounded-lg hover:bg-gold/90 transition-colors text-center">
        Request a Quote &rarr;
      </a>
    </div>

    <h2 id="applications">Key Applications</h2>
    <div class="grid md:grid-cols-2 gap-6 mb-10 not-prose">
      <div class="bg-white rounded-xl p-6 border border-gray-200">
        <h3 class="font-bold text-navy mb-2">Large Turbine Lube Oil Systems</h3>
        <p class="text-sm text-gray-600">Turbine generators in the 5,000–15,000 HP range with large lube oil reservoirs. Published MAB 205 throughput is 2,000–2,300 L/h (8.81–10.13 US GPM, derived) on R&amp;O lube oil at 80–90&deg;C and 4,200 L/h (18.49 US GPM, derived) on steam turbine oil at 60–70&deg;C.</p>
        <a href="/lube-oil-centrifuge/" class="text-sm font-semibold text-navy hover:text-gold transition-colors">Lube Oil Centrifuge Details &rarr;</a>
      </div>
      <div class="bg-white rounded-xl p-6 border border-gray-200">
        <h3 class="font-bold text-navy mb-2">High-Volume Diesel &amp; Gas Oil Polishing</h3>
        <p class="text-sm text-gray-600">Large standby generators, prime power installations, and diesel fuel storage facilities with large tank volumes. Published throughput is 4,400 L/h (19.37 US GPM, derived) on diesel at 40&deg;C and 13 cSt and 5,750 L/h (25.32 US GPM, derived) on gas oil at 40&deg;C.</p>
        <a href="/diesel-centrifuge/" class="text-sm font-semibold text-navy hover:text-gold transition-colors">Diesel Centrifuge Details &rarr;</a>
      </div>
      <div class="bg-white rounded-xl p-6 border border-gray-200">
        <h3 class="font-bold text-navy mb-2">Large Industrial Hydraulic Systems</h3>
        <p class="text-sm text-gray-600">Heavy industrial presses, rolling mills, die casting machines, and other large hydraulic equipment requiring continuous oil purification. Hydraulic-oil throughput is application-specific and must be confirmed from viscosity, temperature, and separation duty.</p>
      </div>
      <div class="bg-white rounded-xl p-6 border border-gray-200">
        <h3 class="font-bold text-navy mb-2">Process Oil &amp; Compressor Lube</h3>
        <p class="text-sm text-gray-600">Large reciprocating and screw compressors, process industry lubrication systems, and industrial gearboxes requiring continuous oil polishing at higher flow rates than smaller DMB models can provide.</p>
      </div>
    </div>

    <!-- FAQ -->
    <h2 id="faq">Frequently Asked Questions</h2>

    <details class="border-l-4 border-gold/40 pl-4 mb-4 not-prose">
      <summary class="font-semibold text-navy cursor-pointer py-2">What is the throughput of the DMB-019?</summary>
      <p class="mt-2 text-gray-700 text-sm leading-relaxed">
        Published MAB 205 capacities are 4,400 L/h diesel at 40&deg;C and 13 cSt (19.37 US GPM, derived), 5,750 L/h gas oil at 40&deg;C (25.32 US GPM, derived), 2,000&ndash;2,300 L/h R&amp;O lube oil at 80&ndash;90&deg;C (8.81&ndash;10.13 US GPM, derived), and 4,200 L/h steam turbine oil at 60&ndash;70&deg;C (18.49 US GPM, derived). The 6,500 L/h (28.62 US GPM, derived) rated reference has no source fluid specified. The base machine uses a 5 HP motor.
      </p>
    </details>

    <details class="border-l-4 border-gold/40 pl-4 mb-4 not-prose">
      <summary class="font-semibold text-navy cursor-pointer py-2">What turbine size is the DMB-019 suited for?</summary>
      <p class="mt-2 text-gray-700 text-sm leading-relaxed">
        At the published R&amp;O lube-oil range of 2,000&ndash;2,300 L/h at 80&ndash;90&deg;C (8.81&ndash;10.13 US GPM, derived), the DMB-019 suits turbines from approximately 5,000–15,000 HP with lube oil reservoirs of 2,000–10,000 gallons. <a href="/contact-for-alfa-laval-centrifuges/">Contact Dolphin Centrifuge</a> for a sizing calculation based on your specific turbine and oil reservoir.
      </p>
    </details>

    <details class="border-l-4 border-gold/40 pl-4 mb-4 not-prose">
      <summary class="font-semibold text-navy cursor-pointer py-2">When should I choose DMB-019 over the DMPX-028?</summary>
      <p class="mt-2 text-gray-700 text-sm leading-relaxed">
        Choose the DMB-019 when solids content is low and periodic planned cleaning is acceptable - primarily for clean turbine lube oil and diesel polishing. The <a href="/centrifuges/dmpx-028/">DMPX-028</a> is better when solids loading is moderate to high, continuous unattended operation is required, or manual cleaning labor costs outweigh the self-cleaning price premium.
      </p>
    </details>

    <details class="border-l-4 border-gold/40 pl-4 mb-4 not-prose">
      <summary class="font-semibold text-navy cursor-pointer py-2">How does the DMB-019 compare to the DMB-013 and DMB-028?</summary>
      <p class="mt-2 text-gray-700 text-sm leading-relaxed">
        At the same published diesel condition of 40&deg;C and 13 cSt, the DMB-019 base machine is rated at 4,400 L/h (19.37 US GPM, derived), between the <a href="/centrifuges/dmb-013/">DMB-013</a> at 2,900 L/h (12.77 US GPM, derived) and the <a href="/centrifuges/dmb-028/">DMB-028</a> at 6,400 L/h (28.18 US GPM, derived). Its published R&amp;O range at 80&ndash;90&deg;C is 2,000&ndash;2,300 L/h (8.81&ndash;10.13 US GPM, derived). See the full comparison at the <a href="/disc-stack-centrifuge/">disc stack centrifuge overview</a>.
      </p>
    </details>

    <details class="border-l-4 border-gold/40 pl-4 mb-4 not-prose">
      <summary class="font-semibold text-navy cursor-pointer py-2">What is the motor size for the DMB-019?</summary>
      <p class="mt-2 text-gray-700 text-sm leading-relaxed">
        The DMB-019 uses a 5 HP motor at 8,700 RPM, delivering the centrifugal force needed for effective separation of <a href="/lube-oil-centrifuge/">lube oil</a>, diesel, and gas oil across its full rated throughput range. <a href="/contact-for-alfa-laval-centrifuges/">Contact us</a> for full electrical specifications and available power configurations.
      </p>
    </details>

    <h2>Related Resources</h2>
    <ul>
      <li><a href="/centrifuges/dmb-013/">DMB-013 Manual-Clean Centrifuge</a></li>
      <li><a href="/centrifuges/dmb-028/">DMB-028 Manual-Clean Centrifuge</a></li>
      <li><a href="/centrifuges/dmpx-028/">DMPX-028 Self-Cleaning Centrifuge</a></li>
      <li><a href="/disc-stack-centrifuge/">Disc Stack Centrifuge Overview</a></li>
      <li><a href="/contact-for-alfa-laval-centrifuges/">Contact Us for DMB-019 Pricing</a></li>
    </ul>

  </article>

  <!-- Bottom CTA Bar -->
  <div class="not-prose mt-12 rounded-xl bg-navy px-8 py-8 flex flex-col md:flex-row md:items-center gap-6">
    <div class="flex-1">
      <p class="text-white font-bold text-xl mb-1">Ready to order the DMB-019?</p>
      <p class="text-white/80 text-sm">Call <a href="tel:+12485222573" class="text-gold font-semibold">(248) 522-2573</a> or email <a href="mailto:sales@dolphincentrifuge.com" class="text-gold font-semibold">sales@dolphincentrifuge.com</a> - 40+ years in centrifugal separation, Warren MI.</p>
    </div>
    <div class="flex flex-col sm:flex-row gap-3 shrink-0">
      <a href="/contact-for-alfa-laval-centrifuges/" class="inline-block bg-gold text-navy font-bold px-6 py-3 rounded-lg hover:bg-gold/90 transition-colors text-center">Get a Quote</a>
      <a href="/industrial-centrifuge-sample-testing/" class="inline-block border border-white text-white font-bold px-6 py-3 rounded-lg hover:bg-white/10 transition-colors text-center">Sample Testing</a>
    </div>
  </div>

</ApplicationLayout>
