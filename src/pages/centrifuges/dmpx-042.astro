---
import ApplicationLayout from '../../layouts/ApplicationLayout.astro';
import InstallationRequirements from '../../components/InstallationRequirements.astro';

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "DMPX-042 Self-Cleaning Module - Alfa Laval MOPX 209",
    "description": "The Dolphin DMPX-042 is a Dolphin-engineered turnkey module featuring a remanufactured Alfa Laval MOPX 209 or MOPX 210 centrifuge, also supplied on the equivalent WHPX 410, WHPX 409, WHPX 510, and MAPX 210 base machines, a large self-cleaning three-phase disc stack module processing 32–47 GPM of diesel for crude oil, HFO, waste oil, WVO, and transformer oil applications.",
    "brand": { "@type": "Brand", "name": "Alfa Laval" },
    "alternateName": [
      "Alfa Laval MOPX 209",
      "Alfa Laval MOPX 210",
      "Alfa Laval WHPX 410",
      "Alfa Laval WHPX 510",
      "Alfa Laval MAPX 210"
    ],
    "category": "Disc Stack Centrifuges",
    "model": "DMPX-042",
    "offers": {
      "@type": "Offer",
      "availability": "https://schema.org/InStock",
      "priceCurrency": "USD",
      "seller": { "@type": "Organization", "name": "Dolphin Centrifuge" }
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "DMPX-042 Self-Cleaning Module (Alfa Laval MOPX 209) - Specifications & Applications",
    "author": {
      "@type": "Person",
      "name": "Sanjay Prabhu MSME",
      "jobTitle": "Centrifuge Applications Engineer",
      "worksFor": { "@type": "Organization", "name": "Dolphin Centrifuge" }
    },
    "publisher": { "@type": "Organization", "name": "Dolphin Centrifuge" },
    "url": "https://dolphincentrifuge.com/centrifuges/dmpx-042/"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What is the throughput of the DMPX-042 centrifuge?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "The DMPX-042 processes 32–47 GPM of diesel fuel at actual operating conditions, with a rated capacity of 69 GPM. Lube oil (R&O) throughput is 15–24 GPM, steam turbine oil is 34–46 GPM, and HFO 380 cSt is processed at 14–18 GPM."
        }
      },
      {
        "@type": "Question",
        "name": "What industries use the DMPX-042?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "The DMPX-042 is used in oil field operations for crude oil tank-bottom dewatering, large-scale biodiesel production, HFO purification at power plants and industrial boiler facilities, transformer oil purification, and high-volume industrial waste oil reclamation at manufacturing plants and fleet operations."
        }
      },
      {
        "@type": "Question",
        "name": "Is the DMPX-042 available in explosion-proof configuration?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. The DMPX-042 is available in Class I Division 1 and Class I Division 2 explosion-proof configurations for use in hazardous locations including oil fields, refineries, chemical plants, and offshore platforms. Contact Dolphin Centrifuge for hazardous-area requirements."
        }
      },
      {
        "@type": "Question",
        "name": "How large is the sludge bowl on the DMPX-042?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "The DMPX-042 features a 1.64–1.66-gallon sludge bowl - significantly larger than the DMPX-028's 1.03-gallon bowl. This larger capacity means less frequent automatic ejection cycles even when processing streams with high solids loading, such as crude oil tank bottoms or heavily contaminated waste oil."
        }
      },
      {
        "@type": "Question",
        "name": "How does the DMPX-042 compare to the DMPX-028 and DMPX-070?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "The DMPX-042 sits between the DMPX-028 (20–26 GPM diesel) and the DMPX-070 (59–72 GPM diesel). At 32–47 GPM diesel and 14–18 GPM on HFO 380 cSt, the DMPX-042 is the right choice for large industrial and power generation applications that don't yet require the flagship DMPX-070's maximum throughput."
        }
      }
    ]
  }
];
---

<ApplicationLayout
  title="DMPX-042 Self-Cleaning Module - Alfa Laval MOPX 209"
  pageTitle="DMPX-042 Self-Cleaning Module - Alfa Laval MOPX 209 | Dolphin Centrifuge"
  disableTitleSuffix={true}
  description="Dolphin DMPX-042 module featuring a remanufactured Alfa Laval MOPX 209: 32-47 GPM diesel, 1.64-gal bowl, 10-15 HP. Crude oil, HFO 380, waste oil, and WVO."
  canonicalUrl="https://dolphincentrifuge.com/centrifuges/dmpx-042/"
  heroImage="/images/centrifuges-dmpx-042/Alfa-Laval-MOPX-209-Centrifuge-Skid-by-Dolphin.webp"
  heroImageAlt="Alfa Laval MOPX 209 based Dolphin DMPX-042 disc stack centrifuge system"
  category="products"
  categoryLabel="Dolphin Disc Centrifuges"
  toc={[
    { id: "technical-specifications", label: "Technical Specifications" },
    { id: "capacity-by-fluid-type", label: "Capacity by Fluid Type" },
    { id: "key-applications", label: "Key Applications" },
    { id: "dmpx-series-comparison", label: "DMPX Series Comparison" },
    { id: "frequently-asked-questions", label: "Frequently Asked Questions" },
  ]}
  relatedApplications={[
    { label: "Waste Oil Centrifuge", href: "/waste-oil-centrifuge/" },
    { label: "Fuel Oil Centrifuge", href: "/fuel-oil-centrifuge/" },
    { label: "Lube Oil Centrifuge", href: "/lube-oil-centrifuge/" },
    { label: "Crude Oil Centrifuge", href: "/crude-oil-centrifuge/" },
    { label: "WVO Centrifuge", href: "/wvo-centrifuge-separator/" },
    { label: "Cutting Oil Centrifuge", href: "/cutting-oil-centrifuge/" },
  ]}
  relatedProducts={[
    { label: "DMPX-010 (~7 GPM)", href: "/centrifuges/dmpx-010/" },
    { label: "DMPX-028 (~20–26 GPM)", href: "/centrifuges/dmpx-028/" },
    { label: "DMPX-070 (~59–72 GPM)", href: "/centrifuges/dmpx-070/" },
    { label: "DMB-037 Manual-Clean", href: "/centrifuges/dmb-037/" },
  ]}
  jsonLd={jsonLd}
  hideBottomCTA={true}
>

  <article class="prose-dolphin max-w-none">

    <p>
      The DMPX-042 is a Dolphin-engineered turnkey module featuring a remanufactured Alfa Laval MOPX 209 or MOPX 210 centrifuge - rebuilt, tested, and warrantied by Dolphin Centrifuge, the independent specialist in Alfa Laval centrifuges for over 40 years. The same large self-cleaning module is also supplied on the equivalent Alfa Laval WHPX 410/510 and MAPX 210 base machines. Dolphin is an independent remanufacturer and is not affiliated with or authorized by Alfa Laval.
    </p>

    <!-- Product Image -->
    <figure class="text-center my-8">
      <img
        src="/images/centrifuges-dmpx-042/Alfa-Laval-MOPX-209-Centrifuge-Skid-by-Dolphin.webp"
        alt="Alfa Laval MOPX 209 self-cleaning disc stack centrifuge skid, supplied by Dolphin as the DMPX-042 system"
        width="1200"
        height="900"
        loading="lazy"
        class="rounded-lg shadow-lg img-cap-600 mx-auto"
      />
      <figcaption class="text-sm text-gray-500 mt-2">
        DMPX-042 - Large Self-Cleaning 3-Phase Disc Stack Centrifuge (Alfa Laval MOPX 209 base machine shown)
      </figcaption>
    </figure>

    <!-- Technical Specifications -->
    <h2 id="technical-specifications">Technical Specifications</h2>
    <div class="overflow-x-auto">
      <table>
        <thead>
          <tr>
            <th>Parameter</th>
            <th>DMPX-042 Value</th>
          </tr>
        </thead>
        <tbody>
          <tr><td>Base machine</td><td>Alfa Laval MOPX 209 / MOPX 210 (remanufactured); WHPX 410/510 and MAPX 210 equivalents also supplied</td></tr>
          <tr><td>Diesel Throughput (Actual)</td><td>~32–47 GPM</td></tr>
          <tr><td>Diesel Throughput (Rated)</td><td>69 GPM (actual varies by duty)</td></tr>
          <tr><td>Bowl Sludge Capacity</td><td>1.64–1.66 gallons</td></tr>
          <tr><td>Bowl Speed</td><td>5,180–7,125 RPM</td></tr>
          <tr><td>G-Force</td><td>7,000–8,000</td></tr>
          <tr><td>Motor Power</td><td>10–15 HP</td></tr>
          <tr><td>Voltages</td><td>230 / 460 V, 3-Phase</td></tr>
          <tr><td>Separation Type</td><td>Three-phase (oil / water / solids)</td></tr>
          <tr><td>Desludging</td><td>Automatic self-cleaning (hydraulic ejection)</td></tr>
          <tr><td>Process</td><td>Continuous, unattended operation</td></tr>
          <tr><td>Lube Oil (R&amp;O) Throughput</td><td>15–24 GPM</td></tr>
          <tr><td>Steam Turbine Oil Throughput</td><td>34–46 GPM</td></tr>
          <tr><td>DMPX Series Position</td><td>Large industrial (42 bowl equiv.)</td></tr>
        </tbody>
      </table>
    </div>

    <div class="bg-gold/10 border-l-4 border-gold rounded-r-xl p-5 my-8 not-prose">
      <p class="font-bold text-navy text-base mb-1">Need the complete datasheet?</p>
      <p class="text-sm text-text-light leading-relaxed mb-4">We'll email the complete datasheet - usually within one business day.</p>
      <a href="/contact-for-alfa-laval-centrifuges/" class="inline-block bg-gold text-navy font-semibold px-5 py-2 rounded-lg hover:bg-gold/90 transition-colors text-sm">Request the full spec sheet (PDF) -></a>
    </div>

    <!-- Capacity by Fluid Type -->
    <h2 id="capacity-by-fluid-type">Capacity by Fluid Type</h2>
    <div class="overflow-x-auto">
      <table>
        <thead>
          <tr>
            <th>Fluid Type</th>
            <th>Approx. Throughput (GPM)</th>
          </tr>
        </thead>
        <tbody>
          <tr><td>Diesel / Light Fuel Oil</td><td>32–47</td></tr>
          <tr><td>HFO 30 cSt</td><td>32–44</td></tr>
          <tr><td>HFO 60 cSt</td><td>24–33</td></tr>
          <tr><td>HFO 100 cSt</td><td>23–32</td></tr>
          <tr><td>HFO 180 cSt</td><td>16–22</td></tr>
          <tr><td>HFO 380 cSt</td><td>14–18</td></tr>
          <tr><td>Lube Oil (R&amp;O) / Steam Turbine</td><td>15–24 / 34–46 GPM</td></tr>
        </tbody>
      </table>
    </div>
    <p class="text-xs text-gray-500">
      * Throughput values are at typical process temperature (194&deg;F / 90&deg;C). Actual flow rates vary with temperature, contamination level, and desired separation efficiency.
    </p>

    <InstallationRequirements />

    <!-- Key Applications -->
    <h2 id="key-applications">Key Applications</h2>

    <h3>Crude Oil / Tank-Bottoms Dewatering</h3>
    <p>
      The DMPX-042 handles high-volume crude oil dewatering and tank-bottom BS&amp;W (basic sediment and water) reduction at 32–47 GPM, making it suitable for oil-field gathering stations, tank farm operations, and upstream production facilities. Three-phase separation removes water and solids simultaneously in a single pass.
    </p>

    <h3>Large-Scale HFO Purification</h3>
    <p>
      For large marine vessels, shore-power plants, and industrial boiler systems burning <a href="/fuel-oil-centrifuge/">heavy fuel oil</a>, the DMPX-042 processes HFO 380 cSt at 14–18 GPM continuously - removing water and catalyst fines that cause injector wear, fouling, and combustion inefficiency.
    </p>

    <h3>Industrial Waste Oil Processing</h3>
    <p>
      At 32–47 GPM diesel-equivalent throughput, the DMPX-042 services large <a href="/waste-oil-centrifuge/">waste oil</a> reclamation operations: fleet maintenance facilities, large industrial plants, and centralized waste oil collection centers processing thousands of gallons per day. <a href="/explosion-proof-centrifuge/">Explosion-proof</a> options available for hazardous locations.
    </p>

    <h3>Transformer Oil Purification</h3>
    <p>
      The DMPX-042 is used by utilities and industrial facilities to purify transformer oil in service, removing particulate contamination, free water, and degradation products to restore dielectric strength and extend transformer service life. Continuous processing at 15–24 GPM <a href="/lube-oil-centrifuge/">lube oil</a> throughput supports large transformer maintenance programs.
    </p>

    <h3>WVO, Yellow Grease &amp; Aluminum Drawing Oil</h3>
    <p>
      The DMPX-042 platform handles large-scale <a href="/wvo-centrifuge-separator/">waste vegetable oil</a> and <a href="/yellow-grease-purification-centrifuge/">yellow grease</a> purification for biodiesel feedstock preparation. In metalworking, the Alfa Laval MOPX 209 base machine processes aluminum <a href="/cutting-oil-centrifuge/">drawing oil</a> at 22 GPM, recovering expensive neat oil from fines-laden return streams.
    </p>

    <!-- Mid-Page CTA -->
    <div class="not-prose my-10 rounded-xl border-l-4 border-gold bg-gold/10 p-6 flex flex-col md:flex-row md:items-center gap-4">
      <div class="flex-1">
        <p class="text-navy font-bold text-lg mb-1">Need a DMPX-042 for crude oil or HFO service?</p>
        <p class="text-gray-700 text-sm">Our engineers spec explosion-proof, food-grade, and standard configurations. We'll confirm sizing and quote lead time for your application.</p>
      </div>
      <a href="/contact-for-alfa-laval-centrifuges/" class="shrink-0 inline-block bg-gold text-white font-bold px-6 py-3 rounded-lg hover:bg-gold/90 transition-colors text-center">
        Request a Quote &rarr;
      </a>
    </div>

    <!-- DMPX Series Comparison -->
    <h2 id="dmpx-series-comparison">Where the DMPX-042 Fits in the DMPX Series</h2>
    <p>
      The DMPX-042 is the second-largest model in the Dolphin DMPX range. For medium industrial applications, the
      <a href="/centrifuges/dmpx-028/">DMPX-028</a>
      (~20–26 GPM) is the step below. For compact or portable use, the
      <a href="/dmpx-014-self-cleaning-3-phase-disc-stack-centrifuge/">DMPX-014</a>
      (~13 GPM) and
      <a href="/centrifuges/dmpx-010/">DMPX-010</a>
      (~7 GPM) serve smaller-scale needs. For the highest-volume industrial and power-generation applications, the
      <a href="/centrifuges/dmpx-070/">DMPX-070</a>
      (~59–72 GPM) is the flagship model.
      All DMPX models share the same automatic self-cleaning bowl technology.
      See the full comparison at our <a href="/disc-stack-centrifuge/">disc stack centrifuge overview</a>, or <a href="/contact-for-alfa-laval-centrifuges/">contact us</a> for a sizing consultation.
    </p>

    <!-- FAQ -->
    <h2 id="frequently-asked-questions">Frequently Asked Questions</h2>

    <details class="border-l-4 border-gold/40 pl-4 mb-4 not-prose">
      <summary class="font-semibold text-navy cursor-pointer py-2">What is the throughput of the DMPX-042 centrifuge?</summary>
      <p class="mt-2 text-gray-700 text-sm leading-relaxed">
        The DMPX-042 processes 32–47 GPM of diesel fuel at actual operating conditions, with a rated capacity of 69 GPM. Lube oil (R&amp;O) throughput is 15–24 GPM, steam turbine oil is 34–46 GPM, and HFO 380 cSt is processed at 14–18 GPM.
      </p>
    </details>

    <details class="border-l-4 border-gold/40 pl-4 mb-4 not-prose">
      <summary class="font-semibold text-navy cursor-pointer py-2">What industries use the DMPX-042?</summary>
      <p class="mt-2 text-gray-700 text-sm leading-relaxed">
        The DMPX-042 is used in oil field operations for crude oil tank-bottom dewatering, large-scale <a href="/biodiesel-centrifuge/">biodiesel</a> production, HFO purification at power plants and industrial boiler facilities, transformer oil purification, and high-volume industrial <a href="/waste-oil-centrifuge/">waste oil</a> reclamation at manufacturing plants and fleet operations.
      </p>
    </details>

    <details class="border-l-4 border-gold/40 pl-4 mb-4 not-prose">
      <summary class="font-semibold text-navy cursor-pointer py-2">Is the DMPX-042 available in explosion-proof configuration?</summary>
      <p class="mt-2 text-gray-700 text-sm leading-relaxed">
        Yes. The DMPX-042 is available in Class I Division 1 and Class I Division 2 <a href="/explosion-proof-centrifuge/">explosion-proof</a> configurations for use in hazardous locations including oil fields, refineries, chemical plants, and offshore platforms. <a href="/contact-for-alfa-laval-centrifuges/">Contact us</a> to discuss hazardous-area requirements.
      </p>
    </details>

    <details class="border-l-4 border-gold/40 pl-4 mb-4 not-prose">
      <summary class="font-semibold text-navy cursor-pointer py-2">How large is the sludge bowl on the DMPX-042?</summary>
      <p class="mt-2 text-gray-700 text-sm leading-relaxed">
        The DMPX-042 features a 1.64–1.66-gallon sludge bowl - significantly larger than the <a href="/centrifuges/dmpx-028/">DMPX-028</a>'s 1.03-gallon bowl. This larger capacity reduces ejection frequency and supports continuous operation even with high-solids streams such as crude oil tank bottoms and heavily contaminated <a href="/waste-oil-centrifuge/">waste oil</a>.
      </p>
    </details>

    <details class="border-l-4 border-gold/40 pl-4 mb-4 not-prose">
      <summary class="font-semibold text-navy cursor-pointer py-2">How does the DMPX-042 compare to the DMPX-028 and DMPX-070?</summary>
      <p class="mt-2 text-gray-700 text-sm leading-relaxed">
        The DMPX-042 sits between the <a href="/centrifuges/dmpx-028/">DMPX-028</a> (20–26 GPM diesel) and the <a href="/centrifuges/dmpx-070/">DMPX-070</a> (59–72 GPM diesel). At 32–47 GPM diesel and 14–18 GPM on HFO 380 cSt, the DMPX-042 is ideal for large industrial and power generation applications. All DMPX models share the same self-cleaning bowl technology. Visit the <a href="/disc-stack-centrifuge/">disc stack centrifuge overview</a> to compare.
      </p>
    </details>

  </article>

  <!-- Bottom CTA Bar -->
  <div class="not-prose mt-12 rounded-xl bg-navy px-8 py-8 flex flex-col md:flex-row md:items-center gap-6">
    <div class="flex-1">
      <p class="text-white font-bold text-xl mb-1">Ready to specify the DMPX-042?</p>
      <p class="text-white/80 text-sm">Call <a href="tel:+12485222573" class="text-gold font-semibold">(248) 522-2573</a> or email <a href="mailto:sales@dolphincentrifuge.com" class="text-gold font-semibold">sales@dolphincentrifuge.com</a> - 40+ years in centrifugal separation, Warren MI.</p>
    </div>
    <div class="flex flex-col sm:flex-row gap-3 shrink-0">
      <a href="/contact-for-alfa-laval-centrifuges/" class="inline-block bg-gold text-white font-bold px-6 py-3 rounded-lg hover:bg-gold/90 transition-colors text-center">Get a Quote</a>
      <a href="/industrial-centrifuge-sample-testing/" class="inline-block border border-white text-white font-bold px-6 py-3 rounded-lg hover:bg-white/10 transition-colors text-center">Sample Testing</a>
    </div>
  </div>

</ApplicationLayout>
