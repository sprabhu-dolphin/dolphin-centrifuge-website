---
import ApplicationLayout from '../../layouts/ApplicationLayout.astro';
import InstallationRequirements from '../../components/InstallationRequirements.astro';

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "DMPX-010 Self-Cleaning 3-Phase Centrifuge Module",
    "description": "The Dolphin DMPX-010 is a compact commercial module class supplied with Alfa Laval MMPX 304, MMPX 404, or MAPX 204 base machines. Capacity is base-machine and fluid specific. The source-backed MAPX 204 diesel value is 1,800 L/h (7.93 US GPM derived) at 40 C and 13 cSt; no capacity is assigned to an MMPX variant without its own source record.",
    "brand": { "@type": "Brand", "name": "Alfa Laval" },
    "alternateName": ["Alfa Laval MMPX 304", "Alfa Laval MMPX 404", "Alfa Laval MAPX 204"],
    "category": "Disc Stack Centrifuges",
    "model": "DMPX-010",
    "offers": {
      "@type": "Offer",
      "availability": "https://schema.org/InStock",
      "priceCurrency": "USD",
      "seller": { "@type": "Organization", "name": "Dolphin Centrifuge" }
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "DMPX-010 Self-Cleaning Centrifuge Module - Base-Machine Specifications and Capacities",
    "author": {
      "@type": "Person",
      "name": "Sanjay Prabhu MSME",
      "jobTitle": "Centrifuge Applications Engineer",
      "worksFor": { "@type": "Organization", "name": "Dolphin Centrifuge" }
    },
    "publisher": { "@type": "Organization", "name": "Dolphin Centrifuge" },
    "url": "https://dolphincentrifuge.com/centrifuges/dmpx-010/"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What is the throughput of the DMPX-010 centrifuge?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "DMPX-010 is a commercial module class, not one universal flow rating. For the MAPX 204 base machine, the published diesel capacity is 1,800 L/h (7.93 US GPM derived) at 40 C and 13 cSt. The current source registry does not contain MMPX 304 or MMPX 404 application-capacity values, so the MAPX 204 value is not assigned to those machines."
        }
      },
      {
        "@type": "Question",
        "name": "What applications is the DMPX-010 best suited for?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "The DMPX-010 is purpose-built for compact and portable installations including small marine vessel diesel polishing, remote-site waste oil reclamation, compact hydraulic oil maintenance, and portable lube oil purification where space and weight are at a premium."
        }
      },
      {
        "@type": "Question",
        "name": "How does the DMPX-010 compare to larger Dolphin DMPX models?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "The DMPX-010 is the smallest DMPX commercial class, with an approximately 3.5–5 HP motor range and 0.16-gallon sludge space. Flow comparisons require the exact base machine and fluid; Dolphin does not use one blended capacity for each DMPX class."
        }
      },
      {
        "@type": "Question",
        "name": "What is the difference between the DMPX-010 and a manual-clean centrifuge?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "The DMPX-010 is a self-cleaning centrifuge - it ejects accumulated solids automatically using hydraulic pressure without stopping. A manual-clean centrifuge (such as the Dolphin DMB-004) requires periodic shutdown and bowl disassembly to remove solids. The DMPX-010 is ideal for continuous unattended operation where downtime for cleaning is not acceptable."
        }
      },
      {
        "@type": "Question",
        "name": "Can the DMPX-010 handle HFO heavy fuel oil?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "The current authoritative source registry contains no HFO application-capacity record for the DMPX-010 base machines. The MAPX 204 diesel, gas-oil, and lube-oil values must not be relabeled as HFO capacities. Contact Dolphin Centrifuge for application-specific HFO sizing."
        }
      }
    ]
  }
];
---

<ApplicationLayout
  title="DMPX-010 Self-Cleaning Module | Dolphin Centrifuge"
  heroTitle="DMPX-010 Self-Cleaning Module"
  disableTitleSuffix={true}
  description="Dolphin DMPX-010 self-cleaning module class with MMPX 304, MMPX 404, or MAPX 204 base machines. Exact MAPX 204 diesel capacity: 1,800 L/h (7.93 US GPM derived)."
  canonicalUrl="https://dolphincentrifuge.com/centrifuges/dmpx-010/"
  heroImage="/images/centrifuges-dmpx-010/Alfa-Laval-MAPX-204-Centrifuge-Skid-by-Dolphin.webp"
  heroImageAlt="Alfa Laval MAPX 204 centrifuge skid, supplied by Dolphin as the DMPX-010 system"
  category="products"
  categoryLabel="Dolphin Disc Centrifuges"
  toc={[
    { id: "technical-specifications", label: "Technical Specifications" },
    { id: "capacity-by-fluid-type", label: "Capacity by Fluid Type" },
    { id: "key-applications", label: "Key Applications" },
    { id: "dmpx-series-comparison", label: "DMPX Series Comparison" },
    { id: "frequently-asked-questions", label: "Frequently Asked Questions" },
  ]}
  relatedApplications={[
    { label: "Waste Oil Centrifuge", href: "/waste-oil-centrifuge/" },
    { label: "Fuel Oil Centrifuge", href: "/fuel-oil-centrifuge/" },
    { label: "Lube Oil Centrifuge", href: "/lube-oil-centrifuge/" },
  ]}
  relatedProducts={[
    { label: "DMPX-028 (MOPX 207 / WHPX 407)", href: "/centrifuges/dmpx-028/" },
    { label: "DMPX-042 (four exact base-machine variants)", href: "/centrifuges/dmpx-042/" },
    { label: "DMPX-070 (MOPX 213 / WHPX 513)", href: "/centrifuges/dmpx-070/" },
    { label: "DMB-013 Manual-Clean", href: "/centrifuges/dmb-013/" },
  ]}
  jsonLd={jsonLd}
  hideBottomCTA={true}
>

  <article class="prose-dolphin max-w-none">

    <p>
      The DMPX-010 is a Dolphin-engineered turnkey separation-module class supplied with a remanufactured Alfa Laval MMPX 304, MMPX 404, or MAPX 204 self-cleaning three-phase disc stack centrifuge. These are distinct base machines, so capacity follows the exact machine and fluid selected; DMPX-010 is not itself a universal flow rating.
    </p>
    <p>
      Dolphin is the independent specialist in Alfa Laval centrifuges, with 40+ years of MMPX, MAPX, and MAB experience behind every module.
    </p>
    <p class="text-sm text-gray-500 italic">Dolphin is an independent remanufacturer and is not affiliated with or authorized by Alfa Laval.</p>

    <!-- Product Image -->
    <figure class="text-center my-8">
      <img
        src="/images/centrifuges-dmpx-010/Alfa-Laval-MAPX-204-Centrifuge-Skid-by-Dolphin.webp"
        alt="Alfa Laval MAPX 204 centrifuge skid, supplied by Dolphin as the DMPX-010 system"
        width="1200"
        height="1398"
        loading="lazy"
        class="rounded-lg shadow-lg img-cap-600 mx-auto"
      />
      <figcaption class="text-sm text-gray-500 mt-2">
        Dolphin DMPX-010 self-cleaning disc stack centrifuge system shown with a remanufactured Alfa Laval MAPX 204
      </figcaption>
    </figure>

    <!-- Technical Specifications -->
    <h2 id="technical-specifications">Technical Specifications</h2>
    <div class="overflow-x-auto">
      <table>
        <thead>
          <tr>
            <th>Parameter</th>
            <th>DMPX-010 Value</th>
          </tr>
        </thead>
        <tbody>
          <tr><td>Base-machine options</td><td>Alfa Laval MMPX 304, MMPX 404, or MAPX 204 (remanufactured)</td></tr>
          <tr><td>Published diesel capacity</td><td>MAPX 204 only: 1,800 L/h (7.93 US GPM derived), 40&deg;C, 13 cSt</td></tr>
          <tr><td>MMPX 304 / MMPX 404 capacity status</td><td>No application-capacity value in the current authoritative source registry; MAPX 204 values are not transferred to these variants</td></tr>
          <tr><td>Bowl Sludge Capacity</td><td>0.16 gallon</td></tr>
          <tr><td>Motor Power</td><td>~3.5–5 HP</td></tr>
          <tr><td>Bowl Speed</td><td>7,200+ RPM</td></tr>
          <tr><td>G-Force</td><td>7,000+</td></tr>
          <tr><td>Separation Type</td><td>Three-phase (oil / water / solids)</td></tr>
          <tr><td>Desludging</td><td>Automatic self-cleaning (hydraulic ejection)</td></tr>
          <tr><td>Process</td><td>Continuous, unattended operation</td></tr>
          <tr><td>DMPX Series Position</td><td>Smallest / Entry (10 bowl equiv.)</td></tr>
        </tbody>
      </table>
    </div>

    <div class="bg-gold/10 border-l-4 border-gold rounded-r-xl p-5 my-8 not-prose">
      <p class="font-bold text-navy text-base mb-1">Need the complete datasheet?</p>
      <p class="text-sm text-text-light leading-relaxed mb-4">We'll email the complete datasheet - usually within one business day.</p>
      <a href="/contact-for-alfa-laval-centrifuges/" class="inline-block bg-gold text-navy font-semibold px-5 py-2 rounded-lg hover:bg-gold/90 transition-colors text-sm">Request the full spec sheet (PDF) -></a>
    </div>

    <!-- Capacity by Fluid Type -->
    <h2 id="capacity-by-fluid-type">Capacity by Fluid Type</h2>
    <div class="overflow-x-auto">
      <table>
        <thead>
          <tr>
            <th>Exact base machine</th>
            <th>Fluid and source conditions</th>
            <th>Published capacity</th>
            <th>Derived capacity</th>
          </tr>
        </thead>
        <tbody>
          <tr><td>MAPX 204</td><td>Gas oil at 40&deg;C</td><td>2,700 L/h</td><td>11.89 US GPM</td></tr>
          <tr><td>MAPX 204</td><td>Diesel, 13 cSt at 40&deg;C</td><td>1,800 L/h</td><td>7.93 US GPM</td></tr>
          <tr><td>MAPX 204</td><td>R&amp;O / engine lube oil, centrifuged at 80&ndash;90&deg;C</td><td>900 L/h</td><td>3.96 US GPM</td></tr>
          <tr><td>MAPX 204</td><td>Steam turbine lube oil, centrifuged at 60&ndash;70&deg;C</td><td>1,800 L/h</td><td>7.93 US GPM</td></tr>
        </tbody>
      </table>
    </div>
    <p class="text-xs text-gray-500">
      Source L/h values are canonical. US GPM is derived as L/h &divide; 227.124707 and rounded to two decimals. No HFO capacity is published here, and no MAPX 204 value is borrowed for MMPX 304 or MMPX 404. See the <a href="/technical-data/">technical-data methodology</a> and <a href="/technical-data/dolphin-dmpx-010.json">machine-readable DMPX-010 record</a>.
    </p>

    <InstallationRequirements />

    <!-- Key Applications -->
    <h2 id="key-applications">Key Applications</h2>

    <h3>Marine Diesel Polishing</h3>
    <p>
      The DMPX-010's compact size fits tight engine room spaces on small vessels, yachts, and workboats. It continuously removes water, microbial contamination, and particulates from <a href="/diesel-centrifuge/">diesel</a> day tanks without manual intervention.
    </p>

    <h3>Remote-Site Waste Oil Reclamation</h3>
    <p>
      For remote generators, mobile equipment fleets, or off-grid facilities, the DMPX-010 reclaims used lube oil and diesel on-site, eliminating costly waste oil disposal and reducing re-supply frequency. See our <a href="/waste-oil-centrifuge/">waste oil centrifuge</a> page for more.
    </p>

    <h3>Compact Hydraulic &amp; Lube Oil Maintenance</h3>
    <p>
      Small machine shops, mobile hydraulic systems, and light industrial operations use the DMPX-010 to clean hydraulic and R&amp;O <a href="/lube-oil-centrifuge/">lube oils</a>. The published MAPX 204 R&amp;O / engine-lube value is 900 L/h (3.96 US GPM derived) at 80&ndash;90&deg;C; other fluids and base machines require application sizing.
    </p>

    <h3>Portable Skid &amp; Trailer Applications</h3>
    <p>
      The smallest DMPX bowl and motor make it the natural choice for portable oil-cleaning skids and trailers serving multiple machines or tanks at different sites. Pairs well with a small feed pump and process heater in a self-contained unit.
    </p>

    <!-- Mid-Page CTA -->
    <div class="not-prose my-10 rounded-xl border-l-4 border-gold bg-gold/10 p-6 flex flex-col md:flex-row md:items-center gap-4">
      <div class="flex-1">
        <p class="text-navy font-bold text-lg mb-1">Need a DMPX-010 for your application?</p>
        <p class="text-gray-700 text-sm">Our applications engineers will confirm sizing, quote lead time, and recommend the right configuration for your fluid and flow rate.</p>
      </div>
      <a href="/contact-for-alfa-laval-centrifuges/" class="shrink-0 inline-block bg-gold text-navy font-bold px-6 py-3 rounded-lg hover:bg-gold/90 transition-colors text-center">
        Request a Quote &rarr;
      </a>
    </div>

    <!-- DMPX Series Comparison -->
    <h2 id="dmpx-series-comparison">How the DMPX-010 Fits the DMPX Series</h2>
    <p>
      The DMPX series spans several commercial size classes. For <strong>DMPX-010</strong>, the source-backed diesel example is the MAPX 204 at 1,800 L/h (7.93 US GPM derived). Moving up, the
      <a href="/dmpx-014-self-cleaning-3-phase-disc-stack-centrifuge/">DMPX-014</a>
      offers MOPX 205 and WHPX 405 variants with different published diesel capacities, while the
      <a href="/centrifuges/dmpx-028/">DMPX-028</a>
      has MOPX 207 and WHPX 407 variants. The
      <a href="/centrifuges/dmpx-042/">DMPX-042</a>
      and
      <a href="/centrifuges/dmpx-070/">DMPX-070</a>
      classes serve larger applications through their own exact base-machine variants.
      All DMPX models share the same automatic self-cleaning bowl technology and continuous three-phase separation capability. Visit our
      <a href="/disc-stack-centrifuge/">disc stack centrifuge overview</a>
      to compare models side by side, or <a href="/contact-for-alfa-laval-centrifuges/">contact us</a> to discuss your application.
    </p>

    <!-- FAQ -->
    <h2 id="frequently-asked-questions">Frequently Asked Questions</h2>

    <details class="border-l-4 border-gold/40 pl-4 mb-4 not-prose">
      <summary class="font-semibold text-navy cursor-pointer py-2">What is the throughput of the DMPX-010 centrifuge?</summary>
      <p class="mt-2 text-gray-700 text-sm leading-relaxed">
        DMPX-010 is a commercial module class, not one rated flow. The published MAPX 204 values are 1,800 L/h (7.93 US GPM derived) for diesel at 40&deg;C and 13 cSt, 900 L/h (3.96 US GPM) for R&amp;O / engine lube oil at 80&ndash;90&deg;C, and 1,800 L/h (7.93 US GPM) for steam turbine oil at 60&ndash;70&deg;C. The registry has no MMPX 304 or MMPX 404 capacity record.
      </p>
    </details>

    <details class="border-l-4 border-gold/40 pl-4 mb-4 not-prose">
      <summary class="font-semibold text-navy cursor-pointer py-2">What applications is the DMPX-010 best suited for?</summary>
      <p class="mt-2 text-gray-700 text-sm leading-relaxed">
        The DMPX-010 is purpose-built for compact and portable installations: small marine vessel <a href="/diesel-centrifuge/">diesel polishing</a>, remote-site <a href="/waste-oil-centrifuge/">waste oil</a> reclamation, compact hydraulic oil maintenance, and portable lube oil purification where space and weight are at a premium.
      </p>
    </details>

    <details class="border-l-4 border-gold/40 pl-4 mb-4 not-prose">
      <summary class="font-semibold text-navy cursor-pointer py-2">How does the DMPX-010 compare to larger Dolphin DMPX models?</summary>
      <p class="mt-2 text-gray-700 text-sm leading-relaxed">
        The DMPX-010 is the smallest DMPX commercial class with a 0.16-gallon sludge space and an approximately 3.5&ndash;5 HP motor range. Compare larger classes using the selected base machine and fluid, not one blended class rating: <a href="/dmpx-014-self-cleaning-3-phase-disc-stack-centrifuge/">DMPX-014</a>, <a href="/centrifuges/dmpx-028/">DMPX-028</a>, and <a href="/centrifuges/dmpx-042/">DMPX-042</a> each list their exact variants.
      </p>
    </details>

    <details class="border-l-4 border-gold/40 pl-4 mb-4 not-prose">
      <summary class="font-semibold text-navy cursor-pointer py-2">What is the difference between the DMPX-010 and a manual-clean centrifuge?</summary>
      <p class="mt-2 text-gray-700 text-sm leading-relaxed">
        The DMPX-010 is a <a href="/disc-stack-centrifuge/">self-cleaning centrifuge</a> - it ejects accumulated solids automatically without stopping. A manual-clean unit like the <a href="/centrifuges/dmb-004/">DMB-004</a> requires periodic shutdown and bowl disassembly. The DMPX-010 is ideal for continuous unattended operation where cleaning downtime is not acceptable.
      </p>
    </details>

    <details class="border-l-4 border-gold/40 pl-4 mb-4 not-prose">
      <summary class="font-semibold text-navy cursor-pointer py-2">Can the DMPX-010 handle HFO heavy fuel oil?</summary>
      <p class="mt-2 text-gray-700 text-sm leading-relaxed">
        The current authoritative source registry contains no HFO application-capacity record for the DMPX-010 base machines. MAPX 204 diesel, gas-oil, and lube-oil values cannot be relabeled as HFO capacities. <a href="/contact-for-alfa-laval-centrifuges/">Contact us</a> for fluid-specific sizing.
      </p>
    </details>

  </article>

  <!-- Bottom CTA Bar -->
  <div class="not-prose mt-12 rounded-xl bg-navy px-8 py-8 flex flex-col md:flex-row md:items-center gap-6">
    <div class="flex-1">
      <p class="text-white font-bold text-xl mb-1">Ready to specify the DMPX-010?</p>
      <p class="text-white/80 text-sm">Call <a href="tel:+12485222573" class="text-gold font-semibold">(248) 522-2573</a> or email <a href="mailto:sales@dolphincentrifuge.com" class="text-gold font-semibold">sales@dolphincentrifuge.com</a> - 40+ years in centrifugal separation, Warren MI.</p>
    </div>
    <div class="flex flex-col sm:flex-row gap-3 shrink-0">
      <a href="/contact-for-alfa-laval-centrifuges/" class="inline-block bg-gold text-navy font-bold px-6 py-3 rounded-lg hover:bg-gold/90 transition-colors text-center">Get a Quote</a>
      <a href="/industrial-centrifuge-sample-testing/" class="inline-block border border-white text-white font-bold px-6 py-3 rounded-lg hover:bg-white/10 transition-colors text-center">Sample Testing</a>
    </div>
  </div>

</ApplicationLayout>
