---
import ApplicationLayout from '../../layouts/ApplicationLayout.astro';

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "DMB-004 Manual-Clean Disc Stack Centrifuge",
    "alternateName": "Alfa Laval MAB 103",
    "description": "Dolphin DMB-004 turnkey manual-clean module featuring a remanufactured Alfa Laval MAB 103 disc stack centrifuge. Published diesel capacity at 40°C and 13 cSt is 900 L/h (3.96 US GPM, derived), with a 1 HP motor and 8,600 RPM bowl speed. Compact, cost-effective separator for turbine lube oil, diesel, and light industrial fluids.",
    "brand": { "@type": "Brand", "name": "Alfa Laval" },
    "category": "Disc Stack Centrifuges",
    "model": "DMB-004",
    "offers": {
      "@type": "Offer",
      "availability": "https://schema.org/InStock",
      "priceCurrency": "USD",
      "seller": { "@type": "Organization", "name": "Dolphin Centrifuge" }
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "DMB-004 Manual-Clean Disc Stack Centrifuge - Specifications & Applications",
    "author": {
      "@type": "Person",
      "name": "Sanjay Prabhu MSME",
      "jobTitle": "Centrifuge Applications Engineer",
      "worksFor": { "@type": "Organization", "name": "Dolphin Centrifuge" }
    },
    "publisher": { "@type": "Organization", "name": "Dolphin Centrifuge" },
    "url": "https://dolphincentrifuge.com/centrifuges/dmb-004/"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What is the throughput of the DMB-004 centrifuge?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Published MAB 103 capacities are 900 L/h diesel fuel at 40°C and 13 cSt (3.96 US GPM, derived), 1,150 L/h gas oil at 40°C (5.06 US GPM, derived), 500 L/h engine lubricating oil at 80–90°C (2.20 US GPM, derived), and 800 L/h steam turbine oil at 60–70°C (3.52 US GPM, derived). The rated reference is 1,300 L/h (5.72 US GPM, derived); its source fluid is unspecified. Actual throughput varies with fluid viscosity, temperature, and solids loading."
        }
      },
      {
        "@type": "Question",
        "name": "What is the difference between the DMB-004 and the DMPX-010?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "The DMB-004 is a manual-clean centrifuge - solids accumulate in the bowl until the machine is stopped, disassembled, and the bowl cleaned manually. The DMPX-010 is a self-cleaning separator that ejects solids automatically without stopping. The DMB-004 is lower cost and appropriate for low-solids feeds where infrequent cleaning is acceptable; the DMPX-010 is better for continuous operation with moderate to high solids loading."
        }
      },
      {
        "@type": "Question",
        "name": "What applications is the DMB-004 best suited for?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "The DMB-004 is best suited for small turbine lube oil systems (up to ~1,000 HP), diesel fuel polishing on small generator sets, hydraulic oil purification, and any low-volume application where fluid solids content is low and infrequent bowl cleaning is acceptable. Its 1 HP motor and compact footprint make it the most economical entry point in the DMB manual-clean range."
        }
      },
      {
        "@type": "Question",
        "name": "How often does the DMB-004 bowl need to be cleaned?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Cleaning frequency depends entirely on the solids content of your feed fluid. For clean turbine lube oil or polished diesel with very low particulates, cleaning intervals can range from several weeks to months. For fluids with higher solids loading, weekly or even more frequent cleaning may be required. Dolphin Centrifuge can help estimate cleaning intervals based on your fluid analysis."
        }
      },
      {
        "@type": "Question",
        "name": "What voltages are available for the DMB-004?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "The DMB-004 is available in 115V or 230V single-phase / 60 Hz as standard configurations. Other voltages and frequencies can be accommodated for international applications. Contact Dolphin Centrifuge to confirm the right electrical configuration for your installation."
        }
      }
    ]
  }
];
---

<ApplicationLayout
  title="DMB-004 Manual-Clean Module - Alfa Laval MAB 103"
  pageTitle="DMB-004 Manual-Clean Module - Alfa Laval MAB 103 | Dolphin Centrifuge"
  disableTitleSuffix={true}
  description="Dolphin DMB-004 module with a remanufactured Alfa Laval MAB 103: published diesel capacity at 40°C and 13 cSt is 900 L/h (3.96 US GPM, derived), with a 1 HP motor and 8,600 RPM bowl speed."
  canonicalUrl="https://dolphincentrifuge.com/centrifuges/dmb-004/"
  heroImage="/images/alfa-laval-mab-103-centrifuge/Alfa-Laval-MAB-103-Turbine-Lube-Oil-Centrifuge-250.webp"
  heroImageAlt="Alfa Laval MAB 103 turbine lube oil centrifuge, supplied by Dolphin as the DMB-004 manual-clean disc stack system"
  category="products"
  categoryLabel="Dolphin Manual-Clean Disc Centrifuges"
  toc={[
    { id: "specifications", label: "DMB-004 Specifications" },
    { id: "capacity-by-application", label: "Capacity by Application" },
    { id: "manual-vs-self-cleaning", label: "Manual-Clean vs. Self-Cleaning" },
    { id: "key-applications", label: "Key Applications" },
    { id: "faq", label: "Frequently Asked Questions" },
  ]}
  relatedApplications={[
    { label: "Waste Oil Centrifuge", href: "/waste-oil-centrifuge/" },
    { label: "Fuel Oil Centrifuge", href: "/fuel-oil-centrifuge/" },
    { label: "Lube Oil Centrifuge", href: "/lube-oil-centrifuge/" },
  ]}
  relatedProducts={[
    { label: "DMB-007 Manual-Clean Centrifuge", href: "/centrifuges/dmb-007/" },
    { label: "DMB-013 Manual-Clean Centrifuge", href: "/centrifuges/dmb-013/" },
    { label: "DMPX-010 Self-Cleaning Centrifuge", href: "/centrifuges/dmpx-010/" },
  ]}
  jsonLd={jsonLd}
  hideBottomCTA={true}
>
  <article class="prose-dolphin max-w-none">

    <p>
      The DMB-004 is a Dolphin-engineered turnkey module featuring a remanufactured Alfa Laval MAB 103 manual-clean disc stack centrifuge, rebuilt, tested, and warrantied by Dolphin, the independent specialist in Alfa Laval centrifuges.
    </p>

    <h2 id="specifications">DMB-004 Specifications</h2>
    <div class="overflow-x-auto mb-4">
      <table>
        <thead>
          <tr>
            <th>Parameter</th>
            <th>Value</th>
          </tr>
        </thead>
        <tbody>
          <tr><td>Base machine</td><td>Alfa Laval MAB 103 (remanufactured)</td></tr>
          <tr><td>Separation type</td><td>Two-phase clarifier (liquid-liquid or liquid-solid)</td></tr>
          <tr><td>Diesel throughput at 40&deg;C and 13 cSt</td><td>900 L/h (3.96 US GPM, derived)</td></tr>
          <tr><td>Rated reference (source fluid unspecified)</td><td>1,300 L/h (5.72 US GPM, derived)</td></tr>
          <tr><td>Bowl speed</td><td>8,600 RPM</td></tr>
          <tr><td>Drive motor</td><td>1 HP</td></tr>
          <tr><td>Cleaning method</td><td>Manual (bowl disassembly required for solids removal)</td></tr>
          <tr><td>Bowl construction</td><td>Carbon steel standard</td></tr>
          <tr><td>Power supply</td><td>115V or 230V single-phase / 60 Hz (other voltages available)</td></tr>
        </tbody>
      </table>
    </div>
    <p class="text-sm text-gray-500 italic">Throughput figures are for typical fluids at listed conditions. Actual capacity varies with feed viscosity, temperature, density difference, and solids loading.</p>
    <p class="text-sm text-gray-500 italic">Dolphin Centrifuge is an independent remanufacturer and is not affiliated with Alfa Laval.</p>

    <div class="bg-gold/10 border-l-4 border-gold rounded-r-xl p-5 my-8 not-prose">
      <p class="font-bold text-navy text-base mb-1">Need the complete datasheet?</p>
      <p class="text-sm text-text-light leading-relaxed mb-4">We'll email the complete datasheet - usually within one business day.</p>
      <a href="/contact-for-alfa-laval-centrifuges/" class="inline-block bg-gold text-navy font-semibold px-5 py-2 rounded-lg hover:bg-gold/90 transition-colors text-sm">Request the full spec sheet (PDF) -></a>
    </div>

    <h2 id="capacity-by-application">DMB-004 Capacity by Application</h2>
    <div class="overflow-x-auto">
      <table>
        <thead>
          <tr>
            <th>Application / Fluid</th>
            <th>Published throughput (L/h and derived US GPM)</th>
          </tr>
        </thead>
        <tbody>
          <tr><td>Rated reference (source fluid unspecified)</td><td>1,300 L/h (5.72 US GPM, derived)</td></tr>
          <tr><td>Gas oil at 40&deg;C</td><td>1,150 L/h (5.06 US GPM, derived)</td></tr>
          <tr><td>Diesel fuel at 40&deg;C and 13 cSt</td><td>900 L/h (3.96 US GPM, derived)</td></tr>
          <tr><td>R&amp;O lube oil at 80&ndash;90&deg;C</td><td>400&ndash;500 L/h (1.76&ndash;2.20 US GPM, derived)</td></tr>
          <tr><td>Detergent lube oil at 80&ndash;90&deg;C</td><td>300&ndash;400 L/h (1.32&ndash;1.76 US GPM, derived)</td></tr>
          <tr><td>Trunk-piston detergent lube oil at 80&ndash;90&deg;C</td><td>200&ndash;300 L/h (0.88&ndash;1.32 US GPM, derived)</td></tr>
          <tr><td>Engine lubricating oil at 80&ndash;90&deg;C</td><td>500 L/h (2.20 US GPM, derived)</td></tr>
          <tr><td>Steam turbine oil at 60&ndash;70&deg;C</td><td>800 L/h (3.52 US GPM, derived)</td></tr>
        </tbody>
      </table>
    </div>
    <p class="text-sm text-gray-500 italic">US GPM values are derived from the published L/h figures using 1 US GPM = 227.124707 L/h and rounded to two decimal places. See the <a href="/technical-data/#methodology">authoritative technical-data registry and methodology</a> for source basis and machine-readable records.</p>

    <h2 id="manual-vs-self-cleaning">Manual-Clean vs. Self-Cleaning: Choosing the Right Approach</h2>
    <p>
      The DMB-004 is a manual-clean centrifuge: accumulated solids are retained in the bowl until the machine is stopped, the bowl disassembled, and the solids manually removed. This requires periodic planned cleaning shutdowns - typically every few days to weeks depending on the solids loading of the feed.
    </p>
    <p>
      For applications with low solids content - clean <a href="/diesel-centrifuge/">diesel polishing</a>, turbine <a href="/lube-oil-centrifuge/">lube oil</a> with minimal particulate - manual cleaning is infrequent and the DMB-004 delivers excellent value. The simpler design means lower initial cost, lower operating complexity, and straightforward maintenance.
    </p>
    <p>
      If your feed has significant solids loading, or if uninterrupted 24/7 operation is critical, consider Dolphin's self-cleaning <a href="/centrifuges/dmpx-010/">DMPX-010</a> instead. The DMPX-010 ejects solids automatically without stopping and operates continuously without cleaning shutdowns.
    </p>

    <!-- Mid-Page CTA -->
    <div class="not-prose my-10 rounded-xl border-l-4 border-gold bg-gold/10 p-6 flex flex-col md:flex-row md:items-center gap-4">
      <div class="flex-1">
        <p class="text-navy font-bold text-lg mb-1">Need help selecting between DMB-004 and DMPX-010?</p>
        <p class="text-gray-700 text-sm">Our applications engineers will evaluate your solids loading, throughput, and uptime requirements to recommend the right model - at no charge.</p>
      </div>
      <a href="/contact-for-alfa-laval-centrifuges/" class="shrink-0 inline-block bg-gold text-navy font-bold px-6 py-3 rounded-lg hover:bg-gold/90 transition-colors text-center">
        Request a Quote &rarr;
      </a>
    </div>

    <h2 id="key-applications">Key Applications</h2>
    <div class="grid md:grid-cols-2 gap-6 mb-10 not-prose">
      <div class="bg-white rounded-xl p-6 border border-gray-200">
        <h3 class="font-bold text-navy mb-2">Small Turbine Lube Oil Systems</h3>
        <p class="text-sm text-gray-600">Steam turbines and gas turbines up to ~1,000 HP with lube oil reservoirs of 300–1,000 gallons. Published throughput is 800 L/h (3.52 US GPM, derived) on steam turbine oil at 60–70&deg;C and 500 L/h (2.20 US GPM, derived) on engine lubricating oil at 80–90&deg;C.</p>
      </div>
      <div class="bg-white rounded-xl p-6 border border-gray-200">
        <h3 class="font-bold text-navy mb-2">Diesel Fuel Polishing</h3>
        <p class="text-sm text-gray-600">Generator sets, small standby power systems, and diesel storage tanks requiring continuous fuel polishing. Published diesel throughput at 40&deg;C and 13 cSt is 900 L/h (3.96 US GPM, derived).</p>
        <a href="/diesel-centrifuge/" class="text-sm font-semibold text-navy hover:text-gold transition-colors">Diesel Centrifuge Details &rarr;</a>
      </div>
      <div class="bg-white rounded-xl p-6 border border-gray-200">
        <h3 class="font-bold text-navy mb-2">Hydraulic Oil Purification</h3>
        <p class="text-sm text-gray-600">Small hydraulic systems on CNC equipment, presses, and industrial machinery. Hydraulic-oil throughput is application-specific and must be confirmed from viscosity, temperature, and separation duty.</p>
        <a href="/hydraulic-oil-centrifuge/" class="text-sm font-semibold text-navy hover:text-gold transition-colors">Hydraulic Oil Centrifuge Details &rarr;</a>
      </div>
      <div class="bg-white rounded-xl p-6 border border-gray-200">
        <h3 class="font-bold text-navy mb-2">Low-Volume Industrial Oil Polishing</h3>
        <p class="text-sm text-gray-600">Quench oil, heat treatment oil, metalworking oil, and similar industrial fluids requiring periodic polishing to remove water and solids accumulation. The DMB-004 handles these low-throughput applications cost-effectively where <a href="/disc-stack-centrifuge/">self-cleaning operation</a> is not required.</p>
      </div>
    </div>

    <!-- FAQ -->
    <h2 id="faq">Frequently Asked Questions</h2>

    <details class="border-l-4 border-gold/40 pl-4 mb-4 not-prose">
      <summary class="font-semibold text-navy cursor-pointer py-2">What is the throughput of the DMB-004?</summary>
      <p class="mt-2 text-gray-700 text-sm leading-relaxed">
        Published MAB 103 capacities are 900 L/h diesel at 40&deg;C and 13 cSt (3.96 US GPM, derived), 1,150 L/h gas oil at 40&deg;C (5.06 US GPM, derived), 500 L/h engine lubricating oil at 80&ndash;90&deg;C (2.20 US GPM, derived), and 800 L/h steam turbine oil at 60&ndash;70&deg;C (3.52 US GPM, derived). The 1,300 L/h (5.72 US GPM, derived) rated reference has no source fluid specified.
      </p>
    </details>

    <details class="border-l-4 border-gold/40 pl-4 mb-4 not-prose">
      <summary class="font-semibold text-navy cursor-pointer py-2">What is the difference between DMB-004 and DMPX-010?</summary>
      <p class="mt-2 text-gray-700 text-sm leading-relaxed">
        The DMB-004 is manual-clean - solids accumulate until the bowl is manually disassembled and cleaned. The <a href="/centrifuges/dmpx-010/">DMPX-010</a> is self-cleaning with automatic solids ejection. The DMB-004 costs less and is appropriate for low-solids feeds; the DMPX-010 is better for continuous operation with moderate to high solids.
      </p>
    </details>

    <details class="border-l-4 border-gold/40 pl-4 mb-4 not-prose">
      <summary class="font-semibold text-navy cursor-pointer py-2">What applications is the DMB-004 best suited for?</summary>
      <p class="mt-2 text-gray-700 text-sm leading-relaxed">
        Small turbine <a href="/lube-oil-centrifuge/">lube oil systems</a> (up to ~1,000 HP), diesel polishing on small generators, hydraulic oil purification, and low-volume oil polishing where solids content is low and periodic cleaning is acceptable.
      </p>
    </details>

    <details class="border-l-4 border-gold/40 pl-4 mb-4 not-prose">
      <summary class="font-semibold text-navy cursor-pointer py-2">How often does the DMB-004 bowl need to be cleaned?</summary>
      <p class="mt-2 text-gray-700 text-sm leading-relaxed">
        Cleaning frequency depends on your feed fluid's solids content. For clean turbine lube oil or polished diesel, intervals can range from several weeks to months. For higher-solids feeds, weekly cleaning may be required. <a href="/contact-for-alfa-laval-centrifuges/">Contact us</a> to estimate cleaning intervals for your application.
      </p>
    </details>

    <details class="border-l-4 border-gold/40 pl-4 mb-4 not-prose">
      <summary class="font-semibold text-navy cursor-pointer py-2">What voltages are available for the DMB-004?</summary>
      <p class="mt-2 text-gray-700 text-sm leading-relaxed">
        Standard configurations are 115V or 230V single-phase / 60 Hz. Other voltages and frequencies are available for international installations. The <a href="/centrifuges/dmb-007/">DMB-007</a> and larger DMB models typically use 460V / 3-phase. <a href="/contact-for-alfa-laval-centrifuges/">Contact Dolphin Centrifuge</a> to confirm the right electrical configuration for your site.
      </p>
    </details>

    <h2>Related Resources</h2>
    <ul>
      <li><a href="/centrifuges/dmb-007/">DMB-007 Manual-Clean Centrifuge</a></li>
      <li><a href="/centrifuges/dmpx-010/">DMPX-010 Self-Cleaning Centrifuge</a></li>
      <li><a href="/disc-stack-centrifuge/">Disc Stack Centrifuge Overview</a></li>
      <li><a href="/lube-oil-centrifuge/">Lube Oil Centrifuge Applications</a></li>
      <li><a href="/contact-for-alfa-laval-centrifuges/">Contact Us for DMB-004 Pricing</a></li>
    </ul>

  </article>

  <!-- Bottom CTA Bar -->
  <div class="not-prose mt-12 rounded-xl bg-navy px-8 py-8 flex flex-col md:flex-row md:items-center gap-6">
    <div class="flex-1">
      <p class="text-white font-bold text-xl mb-1">Ready to order the DMB-004?</p>
      <p class="text-white/80 text-sm">Call <a href="tel:+12485222573" class="text-gold font-semibold">(248) 522-2573</a> or email <a href="mailto:sales@dolphincentrifuge.com" class="text-gold font-semibold">sales@dolphincentrifuge.com</a> - 40+ years in centrifugal separation, Warren MI.</p>
    </div>
    <div class="flex flex-col sm:flex-row gap-3 shrink-0">
      <a href="/contact-for-alfa-laval-centrifuges/" class="inline-block bg-gold text-navy font-bold px-6 py-3 rounded-lg hover:bg-gold/90 transition-colors text-center">Get a Quote</a>
      <a href="/industrial-centrifuge-sample-testing/" class="inline-block border border-white text-white font-bold px-6 py-3 rounded-lg hover:bg-white/10 transition-colors text-center">Sample Testing</a>
    </div>
  </div>

</ApplicationLayout>
