          <tr><td>WHPX 407</td><td>HFO 180 cSt at 50&deg;C; centrifuged at 90&ndash;98&deg;C</td><td>2,800 L/h</td><td>12.33 US GPM</td></tr>
          <tr><td>WHPX 407</td><td>HFO 380 cSt at 50&deg;C; centrifuged at 98&deg;C</td><td>2,300 L/h</td><td>10.13 US GPM</td></tr>
          <tr><td>WHPX 407</td><td>HFO 460 cSt at 50&deg;C; centrifuged at 98&deg;C</td><td>2,000 L/h</td><td>8.81 US GPM</td></tr>
