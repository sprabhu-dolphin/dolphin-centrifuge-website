const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "DMPX-028 Self-Cleaning Module - Alfa Laval MOPX 207",
    "description": "The Dolphin DMPX-028 is a commercial module class supplied with an Alfa Laval MOPX 207 or WHPX 407 base machine. Published diesel capacity is 5,000 L/h (22.01 US GPM derived) for MOPX 207 and 6,000 L/h (26.42 US GPM derived) for WHPX 407, both at 40 C and 13 cSt. HFO capacities belong only to the WHPX 407 source curve.",
    "brand": { "@type": "Brand", "name": "Alfa Laval" },
    "alternateName": "Alfa Laval MOPX 207",
    "category": "Disc Stack Centrifuges",
    "model": "DMPX-028",
    "offers": {
      "@type": "Offer",
      "availability": "https://schema.org/InStock",
      "priceCurrency": "USD",
      "seller": { "@type": "Organization", "name": "Dolphin Centrifuge" }
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "DMPX-028 Self-Cleaning Module (Alfa Laval MOPX 207) - Specifications & Applications",
    "author": {
      "@type": "Person",
      "name": "Sanjay Prabhu MSME",
      "jobTitle": "Centrifuge Applications Engineer",
      "worksFor": { "@type": "Organization", "name": "Dolphin Centrifuge" }
    },
    "publisher": { "@type": "Organization", "name": "Dolphin Centrifuge" },
    "url": "https://dolphincentrifuge.com/centrifuges/dmpx-028/"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What is the throughput of the DMPX-028 centrifuge?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "DMPX-028 is not one universal flow rating. The MOPX 207 published diesel capacity is 5,000 L/h (22.01 US GPM derived); the WHPX 407 value is 6,000 L/h (26.42 US GPM derived). Both are at 40 C and 13 cSt. The WHPX 407 also has a separate 9,000 L/h (39.63 US GPM) rated-reference value whose fluid is not identified."
        }
      },
      {
        "@type": "Question",
        "name": "What applications is the DMPX-028 used for?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "The DMPX-028 is widely used for biodiesel production finishing, industrial waste oil reclamation, HFO purification on medium-sized marine vessels and power generators, hydraulic and lube oil maintenance, and light crude oil dewatering. Its 1.03-gallon sludge bowl supports continuous operation in moderately contaminated streams."
        }
      },
      {
        "@type": "Question",
        "name": "How does the DMPX-028 compare to the DMPX-014?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Capacity comparisons must use exact base machines. Published diesel values are 5,000 L/h for MOPX 207 and 6,000 L/h for WHPX 407 in the DMPX-028 class, versus 3,300 L/h for MOPX 205 and 3,700 L/h for WHPX 405 in the DMPX-014 class. All are at 40 C and 13 cSt."
        }
      },
      {
        "@type": "Question",
        "name": "Can the DMPX-028 process HFO 380 cSt heavy fuel oil?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Only the WHPX 407 variant has a source-backed HFO curve. Its published HFO 380 cSt capacity is 2,300 L/h (10.13 US GPM derived), with viscosity specified at 50 C and centrifugation at 98 C. That value must not be assigned to the MOPX 207 variant."
        }
      },
      {
        "@type": "Question",
        "name": "What is the sludge bowl capacity of the DMPX-028?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "The DMPX-028 features a 1.03-gallon sludge bowl that automatically ejects accumulated solids via hydraulic pressure without stopping the centrifuge. This allows continuous 24/7 operation even with moderately contaminated oil streams. For heavily contaminated feeds with very high solids loading, the DMPX-042 with its 1.64-gallon bowl is recommended."
        }
      }
    ]
  }
];
