---
import ApplicationLayout from '../layouts/ApplicationLayout.astro';
import FAQ from '../components/FAQ.astro';
import FormVerification from '../components/FormVerification.astro';
import { models } from '../data/centrifugeSpecs';
import { stockList } from '../data/stockList.mjs';
import { USED_QUOTE_ATTRIBUTION_NAME, USED_QUOTE_FORM_ID } from '../lib/usedQuote.mjs';

const pageUrl = 'https://dolphincentrifuge.com/food-and-dairy-centrifuges/';
const pageTitle = 'Food & Dairy Centrifuges | Remanufactured Alfa Laval Clara, BRPX, BTPX';
const pageDescription =
  'Which remanufactured Alfa Laval stainless steel disc stack centrifuges fit food, dairy, beverage, plant protein and fermentation duties: Clara 20, BRPX, BTPX and related models, with capacities tied to their fluid, stock status and a quote form.';

// Same Worker endpoint and fallback as the contact page and used-Alfa-Laval quote form.
const contactWorkerBaseUrl = (import.meta.env.PUBLIC_CONTACT_WORKER_URL || (
  import.meta.env.DEV
    ? 'http://127.0.0.1:8787'
    : 'https://dolphin-contact-form.dolphin-centrifuge.workers.dev'
)).replace(/\/$/, '');

/* Every capacity, speed, G-force and material below is read from the single spec source
   (src/data/centrifugeSpecs.ts), never retyped. Stock status is read from src/data/stockList.mjs. */
const fmt = (n: number) => n.toLocaleString('en-US');

function spec(designation: string) {
  const m = models.find((model) => model.designation === designation);
  if (!m) throw new Error(`food and dairy page: no spec record for ${designation}`);
  return m;
}

function capacityText(designation: string, fluidMatch: RegExp, fluidWords?: string): string {
  const cap = spec(designation).capacities.find((c) => fluidMatch.test(c.fluid));
  if (!cap || typeof cap.value !== 'number') {
    throw new Error(`food and dairy page: ${designation} has no capacity matching ${fluidMatch}`);
  }
  const conditions = cap.conditions ? ` (${cap.conditions})` : '';
  return `${cap.value} GPM on ${fluidWords ?? cap.fluid}${conditions}`;
}

function stockText(designation: string): string {
  const key = (s: string) => s.replace(/-/g, ' ').toLowerCase();
  const units = stockList.units.filter((u) => key(u.model) === key(designation) && u.status === 'in stock');
  if (units.length === 0) return 'Built to order';
  const qty = units.reduce((n, u) => n + u.quantity, 0);
  const conditions = [...new Set(units.map((u) => u.condition))].join(', ');
  return `In stock: ${qty} listed (${conditions})`;
}

const clara = spec('Clara 20');
const claraHigh = clara.capacities.find((c) => /high-flow/i.test(c.fluid));
const claraLow = clara.capacities.find((c) => /low-flow/i.test(c.fluid));
if (!claraHigh?.label || !claraLow?.label) throw new Error('food and dairy page: Clara 20 flow labels missing');

const machineRows = [
  {
    name: 'Alfa Laval Clara 20 (LAPX-404 platform)',
    href: '/alfa-laval-clara-20-food-grade-centrifuge/',
    duty: `Liquid food product, high-flow configuration: ${claraHigh.label} maximum. Low-flow configuration: ${claraLow.label} maximum`,
    speed: `${fmt(clara.bowlSpeedRpm as number)} RPM, ${fmt(clara.gForce as number)} g`,
    wetted: clara.wettedParts ?? '',
    stock: stockText('Clara 20'),
  },
  {
    name: 'Alfa Laval BRPX 313',
    href: '/beer-wine-centrifuge/',
    duty: capacityText('BRPX 313', /^Beer$/i, 'beer'),
    speed: `${fmt(spec('BRPX 313').gForce as number)} Gs`,
    wetted: spec('BRPX 313').wettedParts ?? '',
    stock: stockText('BRPX 313'),
  },
  {
    name: 'Alfa Laval BRPX 309',
    href: '/beer-wine-centrifuge/',
    duty: capacityText('BRPX 309', /beer, wine/i, 'beer, wine and cider clarification'),
    speed: 'Not published',
    wetted: spec('BRPX 309').wettedParts ?? '',
    stock: stockText('BRPX 309'),
  },
  {
    name: 'Alfa Laval BRPX 213',
    href: '/alfa-laval-industrial-centrifuges/',
    duty: 'Sized per application (no capacity published)',
    speed: `${fmt(spec('BRPX 213').gForce as number)} Gs`,
    wetted: spec('BRPX 213').wettedParts ?? '',
    stock: stockText('BRPX 213'),
  },
  {
    name: 'Alfa Laval BTPX 205',
    href: '/alfa-laval-btpx-205-biotech-centrifuge/',
    duty: capacityText('BTPX 205', /cell broth/i, 'pharma cell broth'),
    speed: `${fmt(spec('BTPX 205').bowlSpeedRpm as number)} RPM, ${fmt(spec('BTPX 205').gForce as number)} Gs`,
    wetted: spec('BTPX 205').wettedParts ?? '',
    stock: stockText('BTPX 205'),
  },
  {
    name: 'Alfa Laval LAPX-404',
    href: '/alfa-laval-lapx-404-disc-centrifuge/',
    duty: capacityText('LAPX-404', /chicken/i, 'chicken broth and chicken fat separation'),
    speed: `${fmt(spec('LAPX-404').bowlSpeedRpm as number)} RPM, ${fmt(spec('LAPX-404').gForce as number)} Gs`,
    wetted: spec('LAPX-404').wettedParts ?? '',
    stock: stockText('LAPX-404'),
  },
  {
    name: 'Alfa Laval AFPX 207',
    href: '/stainless-steel-centrifuge/',
    duty: capacityText('AFPX 207', /rendering/i, 'animal fat rendering'),
    speed: `${fmt(spec('AFPX 207').bowlSpeedRpm as number)} RPM`,
    wetted: spec('AFPX 207').wettedParts ?? '',
    stock: stockText('AFPX 207'),
  },
];

const stockedFoodUnits = ['BRPX 213', 'BRPX 417', 'BTPX 205', 'VNPX 207', 'VNPX 407', 'VNPX 410'].map((designation) => {
  const units = stockList.units.filter((u) => u.model === designation && u.status === 'in stock');
  return { designation, qty: units.reduce((n, u) => n + u.quantity, 0) };
}).filter((row) => row.qty > 0);
const stockedText = stockedFoodUnits.map((row) => `${row.designation} (${row.qty})`).join(', ');

const faqItems = [
  {
    question: 'Which Alfa Laval centrifuge fits a food or dairy plant?',
    answer:
      'It depends on the product. For beer, wine and cider clarification the BRPX 313 and BRPX 309 have published capacities. For juice, beverage and edible oil polishing at pilot scale the Clara 20 is the compact stainless module. For fermentation broth and cell harvesting the BTPX 205 is the machine. For milk, whey and cream, Dolphin has not published a rating for any model, so we size from your product, temperature, solids and flow. See the table above for each capacity and the fluid it applies to.',
  },
  {
    question: 'Can I use a remanufactured centrifuge on food or dairy product?',
    answer:
      'Only after it is reviewed for your product. Most machines Dolphin sells are rebuilt machines that may have had prior industrial use, and Dolphin cannot guarantee or certify the previous use, sanitary history or prior process exposure of any specific centrifuge. We do not represent a remanufactured centrifuge as suitable for food, beverage or other human-consumption use unless that suitability is reviewed and confirmed in writing for the specific machine and application. Tell us the product and the requirement in your inquiry.',
  },
  {
    question: 'Do you publish a sanitary certification or clean-in-place rating?',
    answer:
      'No. We do not publish a sanitary certification or a clean-in-place rating for these machines. If your plant has either requirement, state it in the inquiry and we will confirm in writing what a given machine supports.',
  },
  {
    question: 'Is the machine in stock or built to order?',
    answer:
      `Only units on the dated stock list are in stock. As of ${stockList.asOf} that includes ${stockedText} among the stainless steel disc stack machines, each remanufactured to order before shipment. The Clara 20, BRPX 313, BRPX 309 and LAPX-404 are built to order. Lead time is 4 to 8 weeks for small machines and 12 to 20 weeks for large ones, confirmed in your quote. See the <a href="/alfa-laval-centrifuges-in-stock/">Alfa Laval centrifuges in stock</a> list.`,
  },
  {
    question: 'Can you test my product before I buy?',
    answer:
      'Yes. Sample testing is a chargeable service: send a sample and we run it on a lab-scale disc stack centrifuge and report the separation. See <a href="/industrial-centrifuge-sample-testing/">industrial centrifuge sample testing</a>.',
  },
  {
    question: 'Is Dolphin Centrifuge affiliated with Alfa Laval?',
    answer:
      'No. Dolphin Centrifuge is an independent remanufacturer and is not affiliated with Alfa Laval. Dolphin builds the skid, controls and piping around a remanufactured Alfa Laval centrifuge in Warren, Michigan.',
  },
];

const stripTags = (html: string) => html.replace(/<[^>]+>/g, '').replace(/&amp;/g, '&');

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: stripTags(item.answer) },
  })),
};

const webPageJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${pageUrl}#webpage`,
  url: pageUrl,
  name: pageTitle,
  description: pageDescription,
  inLanguage: 'en-US',
  datePublished: '2026-10-13',
  dateModified: '2026-10-13',
  isPartOf: { '@type': 'WebSite', name: 'Dolphin Centrifuge', url: 'https://dolphincentrifuge.com' },
  about: [
    { '@type': 'Brand', name: 'Alfa Laval' },
    { '@type': 'Thing', name: 'Remanufactured stainless steel disc stack centrifuges for food, dairy and beverage processing' },
  ],
  author: {
    '@type': 'Person',
    name: 'Sanjay Prabhu',
    honorificSuffix: 'M.S.M.E.',
    jobTitle: 'Centrifuge Applications Engineer',
    url: 'https://dolphincentrifuge.com/about-dolphin-centrifuge/',
    worksFor: { '@type': 'Organization', name: 'Dolphin Centrifuge', url: 'https://dolphincentrifuge.com' },
  },
  publisher: { '@type': 'Organization', name: 'Dolphin Centrifuge', url: 'https://dolphincentrifuge.com' },
};

const jsonLd = [webPageJsonLd, faqJsonLd];

const toc = [
  { id: 'duties', label: 'Which Models Fit Which Duties' },
  { id: 'capacities', label: 'Capacities, Construction and Stock' },
  { id: 'dairy', label: 'Milk, Whey and Cream' },
  { id: 'beverage', label: 'Beer, Wine, Juice and Edible Oil' },
  { id: 'protein', label: 'Plant Protein and Soy' },
  { id: 'fermentation', label: 'Biotech and Fermentation Broth' },
  { id: 'wastewater', label: 'Food Plant Wastewater' },
  { id: 'stainless', label: 'Stainless Steel Construction' },
  { id: 'remanufacturing', label: 'What Remanufacturing Includes' },
  { id: 'sample-testing', label: 'Sample Testing' },
  { id: 'faq', label: 'Food and Dairy Centrifuge FAQ' },
  { id: 'quote', label: 'Get a Quote' },
];

const relatedApplications = [
  { label: 'Beer, Wine, Cider and Juice', href: '/beer-wine-centrifuge/' },
  { label: 'Stainless Steel Beverage Centrifuge Guide', href: '/food-grade-centrifuge/' },
  { label: 'Food Industry Wastewater', href: '/food-industry-wastewater-centrifuge/' },
  { label: 'Fish Processing Centrifuge', href: '/fish-processing-centrifuge/' },
  { label: 'All Centrifuge Applications', href: '/disc-stack-centrifuge-applications/' },
];

const relatedProducts = [
  { label: 'Alfa Laval Clara 20 Module', href: '/alfa-laval-clara-20-food-grade-centrifuge/', description: 'Compact stainless disc stack module' },
  { label: 'Alfa Laval BTPX 205', href: '/alfa-laval-btpx-205-biotech-centrifuge/', description: 'Cell harvesting and broth clarification' },
  { label: 'Stainless Steel Centrifuges', href: '/stainless-steel-centrifuge/', description: 'BRPX, AFPX and related models' },
  { label: 'Alfa Laval Centrifuges in Stock', href: '/alfa-laval-centrifuges-in-stock/', description: 'Dated stock list' },
];

const linkClass = 'text-navy font-medium underline decoration-gold underline-offset-2 hover:text-gold-dark';
const inputClass = 'w-full border-2 border-gray-200 rounded-xl px-4 py-2.5 text-sm text-text focus:outline-none focus:border-navy transition-colors';
const labelClass = 'block text-xs font-bold text-navy uppercase tracking-wide mb-1.5';
---

<ApplicationLayout
  title="Food and Dairy Centrifuges"
  heroTitle="Food and Dairy Centrifuges: Remanufactured Alfa Laval Disc Stack Machines"
  pageTitle={pageTitle}
  description={pageDescription}
  heroImage="/images/food-grade-centrifuge/stainless-steel-centrifuge-new-hero-2000.webp"
  heroImageAlt="Alfa Laval stainless steel disc stack centrifuge remanufactured by Dolphin Centrifuge for food and beverage processing"
  category="applications"
  categoryHref="/disc-stack-centrifuge-applications/"
  categoryLabel="Applications"
  canonicalUrl={pageUrl}
  jsonLd={jsonLd}
  toc={toc}
  relatedApplications={relatedApplications}
  relatedProducts={relatedProducts}
  hideBottomCTA={true}
  disableTitleSuffix={true}
  robots="index, follow"
>

  <p>
    Dolphin Centrifuge remanufactures stainless steel Alfa Laval disc stack centrifuges for food, beverage, plant protein and fermentation duties, and builds the skid, controls and piping around them in Warren, Michigan. Dolphin Centrifuge keeps 150+ Alfa Laval centrifuges in stock in Warren, Michigan. Dolphin is an independent remanufacturer and is not affiliated with Alfa Laval.
  </p>

  <p>
    This page says which models fit which duties, what each one is rated for and on what fluid, what is in stock, and where we have no published rating. Where we have no number, we say so instead of guessing.
  </p>

  <h2 id="duties">Which Alfa Laval Models Fit Which Food and Dairy Duties</h2>

  <div class="not-prose overflow-x-auto border border-gray-100 rounded-xl mb-4">
    <table class="w-full text-sm border-collapse">
      <thead>
        <tr class="bg-navy text-white">
          <th class="py-3 px-3 text-left font-semibold text-xs uppercase tracking-wider text-white">Duty</th>
          <th class="py-3 px-3 text-left font-semibold text-xs uppercase tracking-wider text-white">Alfa Laval models</th>
          <th class="py-3 px-3 text-left font-semibold text-xs uppercase tracking-wider text-white">Basis</th>
        </tr>
      </thead>
      <tbody>
        <tr class="border-b border-gray-200">
          <td class="py-3 px-3 font-semibold text-navy">Milk, whey, cream</td>
          <td class="py-3 px-3 text-sm">No model rated by Dolphin</td>
          <td class="py-3 px-3 text-sm">Sized per application. See <a href="#dairy" class={linkClass}>milk, whey and cream</a>.</td>
        </tr>
        <tr class="border-b border-gray-200 bg-light-bg">
          <td class="py-3 px-3 font-semibold text-navy">Beer, wine and cider clarification</td>
          <td class="py-3 px-3 text-sm">BRPX 313, BRPX 309</td>
          <td class="py-3 px-3 text-sm">Published capacities in the table below</td>
        </tr>
        <tr class="border-b border-gray-200">
          <td class="py-3 px-3 font-semibold text-navy">Juice, tea, coffee extract and edible oil polishing</td>
          <td class="py-3 px-3 text-sm">Clara 20</td>
          <td class="py-3 px-3 text-sm">Application list on the <a href="/alfa-laval-clara-20-food-grade-centrifuge/" class={linkClass}>Clara 20 page</a></td>
        </tr>
        <tr class="border-b border-gray-200 bg-light-bg">
          <td class="py-3 px-3 font-semibold text-navy">Plant protein and soy</td>
          <td class="py-3 px-3 text-sm">Self-cleaning stainless disc stack, sized per application</td>
          <td class="py-3 px-3 text-sm">Dolphin has supplied centrifuges for soy protein recovery</td>
        </tr>
        <tr class="border-b border-gray-200">
          <td class="py-3 px-3 font-semibold text-navy">Fermentation broth and cell harvesting</td>
          <td class="py-3 px-3 text-sm">BTPX 205</td>
          <td class="py-3 px-3 text-sm">Published capacity in the table below</td>
        </tr>
        <tr class="border-b border-gray-200 bg-light-bg">
          <td class="py-3 px-3 font-semibold text-navy">Poultry broth, fat and rendering</td>
          <td class="py-3 px-3 text-sm">LAPX-404, AFPX 207</td>
          <td class="py-3 px-3 text-sm">Published capacities in the table below</td>
        </tr>
        <tr class="border-b border-gray-200">
          <td class="py-3 px-3 font-semibold text-navy">Food plant wastewater</td>
          <td class="py-3 px-3 text-sm">NX decanters and DMPX disc stack modules</td>
          <td class="py-3 px-3 text-sm"><a href="/food-industry-wastewater-centrifuge/" class={linkClass}>Food industry wastewater centrifuge</a></td>
        </tr>
      </tbody>
    </table>
  </div>

  <h2 id="capacities">Capacities, Construction and Stock</h2>

  <div class="not-prose overflow-x-auto border border-gray-100 rounded-xl mb-4">
    <table class="w-full text-sm border-collapse">
      <thead>
        <tr class="bg-navy text-white">
          <th class="py-3 px-3 text-left font-semibold text-xs uppercase tracking-wider text-white">Machine</th>
          <th class="py-3 px-3 text-left font-semibold text-xs uppercase tracking-wider text-white">Capacity and fluid</th>
          <th class="py-3 px-3 text-left font-semibold text-xs uppercase tracking-wider text-white">Bowl speed or G-force</th>
          <th class="py-3 px-3 text-left font-semibold text-xs uppercase tracking-wider text-white">Wetted parts</th>
          <th class="py-3 px-3 text-left font-semibold text-xs uppercase tracking-wider text-white">Stock</th>
        </tr>
      </thead>
      <tbody>
        {machineRows.map((row, i) => (
          <tr class={`border-b border-gray-200 ${i % 2 === 1 ? 'bg-light-bg' : ''}`}>
            <td class="py-3 px-3 font-semibold text-navy"><a href={row.href}>{row.name}</a></td>
            <td class="py-3 px-3 text-sm">{row.duty}</td>
            <td class="py-3 px-3 font-mono text-sm">{row.speed}</td>
            <td class="py-3 px-3 text-sm">{row.wetted}</td>
            <td class="py-3 px-3 text-sm">{row.stock}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <p class="text-sm text-text-light italic">
    Capacities come from the Dolphin spec data and are tied to the fluid shown. A different product, viscosity, temperature or solids load changes the number, so final sizing comes from your product. Stock status is from the dated stock list (as of {stockList.asOf}). Lead time is 4 to 8 weeks for small machines and 12 to 20 weeks for large ones.
  </p>

  <h2 id="dairy">Milk, Whey and Cream</h2>

  <p>
    Separating milk fat from milk is the classic disc stack job. The old cream separators were the first commercial disc stack centrifuges, and milk standardization, which separates the fat and returns a set amount to the milk, is still a common Alfa Laval disc stack application.
  </p>

  <p>
    Dolphin has not published a dairy duty or capacity for any model, and the spec data holds no cream or whey rating. That is why there is no dairy number on this page. Send the product, the temperature, the solids and the flow, and an engineer will tell you which stainless machine fits, or tell you if none does. Suitability of a remanufactured machine for dairy product is reviewed in writing for the specific machine and application, as described under <a href="#stainless" class={linkClass}>stainless steel construction</a>.
  </p>

  <h2 id="beverage">Beer, Wine, Juice and Edible Oil</h2>

  <p>
    For beer, the BRPX 313 is rated at {capacityText('BRPX 313', /^Beer$/i, 'beer')}, and the BRPX 309 at {capacityText('BRPX 309', /beer, wine/i, 'beer, wine and cider clarification')}. They separate yeast, trub, lees, pulp and fine sediment. The VNPX 407 and VNPX 410 are the stainless machines we pair with wine and juice. See <a href="/beer-wine-centrifuge/" class={linkClass}>beer, wine, cider and juice centrifuges</a>.
  </p>

  <p>
    The Clara 20 is the compact module for juice, wine, beer, tea and coffee extract clarification and for final polishing of vegetable and animal oils. It is a reconditioned Clara 20 separator on the LAPX-404 platform with new controls, a stainless steel skid and new process piping. Its published capacities are {claraHigh.label} maximum in the high-flow configuration and {claraLow.label} maximum in the low-flow configuration, rated on liquid food product. The new controls are a PLC with touchscreen and a VFD, with an automatic feed valve and a flow meter with totalizer. See the <a href="/alfa-laval-clara-20-food-grade-centrifuge/" class={linkClass}>Clara 20 module page</a>.
  </p>

  <p>
    Soybean oil is a two-step job: a decanter takes the bulk soy solids out of the expeller oil, and a high-speed disc centrifuge downstream polishes out the fine particles, with the oil heated to about 130 F to cut its viscosity. See <a href="/disc-stack-centrifuge-applications/#soybean-oil" class={linkClass}>soybean oil</a>.
  </p>

  <h2 id="protein">Plant Protein and Soy</h2>

  <p>
    In soy protein production, the protein is dissolved in water, the residual solids are removed, and the protein is precipitated out of the water and dried. Filter presses do the separation in many plants. Dolphin has supplied stainless disc stack centrifuges for this duty. A self-cleaning machine harvests the precipitated protein continuously and ejects the concentrated precipitate periodically. We publish no soy protein capacity for any model, so these machines are sized from your slurry. See <a href="/disc-stack-centrifuge-applications/#soy-protein-separation" class={linkClass}>soy protein separation</a>.
  </p>

  <p>
    Other plant-based beverages follow the same pattern: almond and oat milk are clarified from the organic mass with decanters and disc stack centrifuges.
  </p>

  <h2 id="fermentation">Biotech and Fermentation Broth with the BTPX 205</h2>

  <p>
    The BTPX 205 is a self-cleaning disc stack machine that runs as a clarifier or a purifier. It harvests organic cells, clarifies fermentation broth and cell debris, and recovers inclusion bodies, with solids content from 0.1% to 10% by volume and particles from 0.5 to 500 microns. A partial discharge feature purges only the solids, which reduces fluid loss. It is rated at {capacityText('BTPX 205', /cell broth/i, 'pharma cell broth')} and develops {fmt(spec('BTPX 205').gForce as number)} Gs at {fmt(spec('BTPX 205').bowlSpeedRpm as number)} RPM. On the stock list as of {stockList.asOf}: {stockText('BTPX 205').replace('In stock: ', '')}, as complete modules on stainless steel skids. See the <a href="/alfa-laval-btpx-205-biotech-centrifuge/" class={linkClass}>BTPX 205 page</a>.
  </p>

  <h2 id="wastewater">Food Plant Wastewater</h2>

  <p>
    Food and dairy plants also have a wastewater stream with suspended solids, fats, oils and grease. Decanters and self-cleaning disc stack modules treat it, and the capacity depends on the sludge percentage. The full treatment, with duties and capacities, is on <a href="/food-industry-wastewater-centrifuge/" class={linkClass}>food industry wastewater centrifuge modules</a>.
  </p>

  <h2 id="stainless">Stainless Steel Construction</h2>

  <ul>
    <li><strong>Wetted parts:</strong> the spec data lists stainless steel wetted parts for the Clara 20, BRPX 213, BTPX 205 and LAPX-404, and 316L stainless steel for the BRPX 313, BRPX 309 and AFPX 207. The Clara 20 page lists its wetted parts as s.s. 1.4462 (UNS S31803) and 1.4401 (UNS 31600).</li>
    <li><strong>Skids and piping:</strong> the Clara 20 module has a custom-fabricated stainless steel skid with all-new process piping. Exposed fasteners on our remanufactured machines are upgraded to stainless steel.</li>
    <li><strong>Machines on the stock list:</strong> the stainless steel disc stack units listed in stock as of {stockList.asOf} include {stockedText}, each with SS316 wetted parts per the stock list.</li>
  </ul>

  <div class="not-prose my-6 rounded-lg border border-amber-400 bg-amber-50 p-5">
    <p class="font-bold text-amber-900 mb-2">Suitability for food and dairy product</p>
    <p class="text-sm text-amber-900 mb-3">Most centrifuges offered by Dolphin Centrifuge are used, rebuilt or remanufactured machines. Because they may have had prior industrial use, Dolphin cannot guarantee or certify the previous use, sanitary history or prior process exposure of any specific centrifuge.</p>
    <p class="text-sm text-amber-900">We do not represent any used or remanufactured centrifuge as suitable for food, beverage, pharmaceutical, cosmetic or human-consumption applications unless that suitability is reviewed and confirmed in writing for the specific machine and application. We do not publish a sanitary certification or a clean-in-place rating for these machines.</p>
  </div>

  <h2 id="remanufacturing">What Remanufacturing Includes</h2>

  <p>
    Every remanufactured Alfa Laval centrifuge from Dolphin receives the same standard, written out on the <a href="/centrifuge-reconditioning-standard/" class={linkClass}>reconditioning standard</a> page.
  </p>

  <ul>
    <li>Bowl and critical rotating components visually inspected for excessive wear</li>
    <li>Every seal, gasket, friction pad, bearing and fastener replaced, regardless of condition</li>
    <li>Frame parts sandblasted to bare metal and finished with two coats of durable epoxy</li>
    <li>Rotating assembly vibration-checked and dynamically balanced as needed</li>
    <li>A full test run at rated speed before shipment, on a surrogate fluid (hydraulic oil or water)</li>
    <li>Operational data (running amps, performance) recorded on every unit, with a signed Test or FAT report available on request (additional charges may apply)</li>
  </ul>

  <p class="text-sm text-text-light">
    Terms: 12-month mechanical warranty and ongoing technical support for the original purchaser, as specified in the formal proposal.
  </p>

  <h2 id="sample-testing">Sample Testing</h2>

  <p>
    Send a sample of your product. We run it on a lab-scale disc stack centrifuge, about 1 gallon, and report the separation, so you can confirm performance before any commitment. Larger samples are possible on request, and Dolphin can batch process a sample of up to 10 gallons through a small industrial disc stack centrifuge. Sample testing is a chargeable service. See <a href="/industrial-centrifuge-sample-testing/" class={linkClass}>industrial centrifuge sample testing</a>.
  </p>

  <FAQ items={faqItems} heading="Food and Dairy Centrifuge FAQ" />

  <section id="quote" class="not-prose scroll-mt-24 my-8">
    <div class="bg-white rounded-2xl border-2 border-navy/15 shadow-sm p-5 md:p-7">
      <h2 class="text-xl md:text-2xl font-bold text-navy font-heading mb-1">Get a quote for a food or dairy centrifuge</h2>
      <p class="text-sm text-text-light mb-5">Tell us the product, the flow and the temperature. An engineer replies within one business day.</p>

      <form
        id={USED_QUOTE_FORM_ID}
        data-dolphin-attribution-name={USED_QUOTE_ATTRIBUTION_NAME}
        data-endpoint={contactWorkerBaseUrl}
        class="space-y-4"
        novalidate
      >
        <div style="display:none" aria-hidden="true">
          <label>Leave this empty: <input type="text" name="bot-field" tabindex="-1" autocomplete="off" maxlength="254" /></label>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="uq-name" class={labelClass}>Name</label>
            <input id="uq-name" name="name" type="text" required autocomplete="name" maxlength="254" class={inputClass} />
          </div>
          <div>
            <label for="uq-company" class={labelClass}>Company</label>
            <input id="uq-company" name="company" type="text" required autocomplete="organization" maxlength="254" class={inputClass} />
          </div>
          <div>
            <label for="uq-email" class={labelClass}>Email</label>
            <input id="uq-email" name="email" type="email" required autocomplete="email" maxlength="254" placeholder="you@company.com" class={inputClass} />
          </div>
          <div>
            <label for="uq-phone" class={labelClass}>Phone</label>
            <input id="uq-phone" name="phone" type="tel" required autocomplete="tel" maxlength="254" class={inputClass} />
          </div>
          <div>
            <label for="uq-fluid" class={labelClass}>Product to process</label>
            <input id="uq-fluid" name="fluid" type="text" required autocomplete="off" maxlength="254" placeholder="e.g. whey, beer, juice, soy protein slurry" class={inputClass} />
          </div>
          <div>
            <label for="uq-flow" class={labelClass}>Flow rate <span class="font-normal normal-case text-text-muted">(optional)</span></label>
            <input id="uq-flow" name="flowRate" type="text" autocomplete="off" maxlength="254" placeholder="e.g. 20 GPM or 10,000 gal/day" class={inputClass} />
          </div>
          <div>
            <label for="uq-country" class={labelClass}>Country <span class="font-normal normal-case text-text-muted">(optional)</span></label>
            <input id="uq-country" name="country" type="text" autocomplete="country-name" maxlength="100" class={inputClass} />
          </div>
          <div>
            <label for="uq-contact" class={labelClass}>Preferred contact <span class="font-normal normal-case text-text-muted">(optional)</span></label>
            <select id="uq-contact" name="preferredContact" class={inputClass}>
              <option value="">No preference</option>
              <option value="email">Email</option>
              <option value="phone_dolphin_calls">Phone - Dolphin Centrifuge calls you</option>
              <option value="phone_you_call">Phone - You call us: (248) 522-2573</option>
            </select>
          </div>
          <div class="sm:col-span-2">
            <label for="uq-model" class={labelClass}>Model of interest <span class="font-normal normal-case text-text-muted">(optional)</span></label>
            <input id="uq-model" name="modelInterest" type="text" autocomplete="off" maxlength="200" placeholder="e.g. Clara 20, BRPX 313 or BTPX 205" class={inputClass} />
          </div>
          <div class="sm:col-span-2">
            <label for="uq-details" class={labelClass}>Other details <span class="font-normal normal-case text-text-muted">(optional)</span></label>
            <textarea id="uq-details" name="details" rows="3" maxlength="2000" placeholder="Solids, temperature, hours per day, sanitary requirements, timeline" class={inputClass}></textarea>
          </div>
        </div>

        <FormVerification action="contact" />

        <p data-quote-error hidden role="alert" class="bg-red-50 border border-red-200 rounded-xl p-3 text-sm font-semibold text-red-700"></p>
        <p data-quote-success hidden role="status" class="bg-green-50 border border-green-200 rounded-xl p-3 text-sm font-semibold text-green-800"></p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <button type="submit" class="w-full bg-navy text-white font-bold py-3.5 px-6 rounded-xl hover:bg-gold hover:text-navy transition-all duration-200 disabled:opacity-50 disabled:cursor-not-allowed">
            Send Quote Request
          </button>
          <a href="tel:+12485222573" class="w-full inline-flex items-center justify-center gap-2 border-2 border-navy text-navy font-bold py-3 px-6 rounded-xl hover:bg-navy hover:text-white transition-colors">
            Call (248) 522-2573
          </a>
        </div>
        <p class="text-xs text-text-muted">A quote request asks for engineering follow-up. It is not an order.</p>
      </form>
    </div>
  </section>

</ApplicationLayout>

