  { label: 'NX-314 Decanter', href: '/alfa-laval-nx-314-decanter-centrifuge/', description: 'Compact wastewater decanter' },
  { label: 'DMPX-042 Self-Cleaning Module', href: '/centrifuges/dmpx-042/', description: 'Three-phase disc stack class' },
