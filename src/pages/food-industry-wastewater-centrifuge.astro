  { label: 'Dewatering Centrifuge', href: '/dewatering-centrifuge/' },
  { label: 'Food Grade Centrifuge', href: '/food-grade-centrifuge/' },
  { label: 'Yellow Grease Purification', href: '/yellow-grease-purification-centrifuge/' },
  { label: 'Silicon Wafer Wastewater Case', href: '/industrial-wastewater-centrifuge-silicon-wafer-facility/' },
