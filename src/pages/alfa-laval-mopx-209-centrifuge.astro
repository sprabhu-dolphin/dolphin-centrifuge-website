          <tr><td><strong>HFO 30 / 40 cSt at 50 &deg;C</strong></td><td>7,800 L/h (34.34 US GPM derived), centrifuged at 70&ndash;98 / 80&ndash;98 &deg;C</td></tr>
          <tr><td><strong>HFO 60 cSt at 50 &deg;C</strong></td><td>5,900 L/h (25.98 US GPM derived), centrifuged at 80&ndash;98 &deg;C</td></tr>
          <tr><td><strong>HFO 100 cSt at 50 &deg;C</strong></td><td>5,600 L/h (24.66 US GPM derived), centrifuged at 90&ndash;98 &deg;C</td></tr>
          <tr><td><strong>HFO 180 cSt at 50 &deg;C</strong></td><td>3,900 L/h (17.17 US GPM derived), centrifuged at 90&ndash;98 &deg;C</td></tr>
