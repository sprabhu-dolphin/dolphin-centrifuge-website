    { "@type": "PropertyValue", "name": "OEM application capacity - Diesel fuel", "value": "7,900 L/h (34.78 US GPM derived), 40 C, 13 cSt at 40 C" },
    { "@type": "PropertyValue", "name": "OEM application capacity - R&O / engine lube oil", "value": "4,100 L/h (18.05 US GPM derived), 80-90 C" },
    { "@type": "PropertyValue", "name": "OEM application capacity - Steam turbine lube oil", "value": "7,700 L/h (33.90 US GPM derived), 60-70 C" },
