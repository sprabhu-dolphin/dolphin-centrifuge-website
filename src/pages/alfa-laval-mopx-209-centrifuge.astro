---
import ApplicationLayout from '../layouts/ApplicationLayout.astro';
import FAQ from '../components/FAQ.astro';

const faqItems = [
  {
    question: "What is the Dolphin equivalent of the Alfa Laval MOPX 209 centrifuge?",
    answer: "The Alfa Laval MOPX 209 is one exact base-machine option for the Dolphin DMPX-042 centrifuge system. Other DMPX-042 variants use MOPX 210, WHPX 409, or WHPX 510 base machines. The DMPX-042 adds a complete system frame, PLC controls, electric heaters, feed pump, and piping; capacity must be quoted for the exact base machine and fluid, not as one blended DMPX-042 rating."
  },
  {
    question: "What is the flow rate of the Alfa Laval MOPX 209 centrifuge?",
    answer: "The OEM application table for the exact Alfa Laval MOPX 209 lists 11,800 L/h (51.95 US GPM derived) for gas oil at 40 C; 7,900 L/h (34.78 US GPM derived) for diesel at 40 C and 13 cSt; 4,100 L/h (18.05 US GPM derived) for R&O / engine lube oil at 80–90 C; and 7,700 L/h (33.90 US GPM derived) for steam-turbine lube oil at 60–70 C. Each value is fluid- and condition-specific."
  },
  {
    question: "What applications is the Alfa Laval MOPX 209 / DMPX-042 best suited for?",
    answer: "The MOPX 209 / DMPX-042 is a mid-to-large self-cleaning centrifuge option for diesel and gas-oil purification, waste-oil recovery, cutting-oil clarification, lube-oil purification, and qualified crude-oil duties. The exact base machine, fluid properties, temperature, contamination, and separation target must be selected before stating a design flow."
  },
  {
    question: "What is the motor horsepower of the Alfa Laval MOPX 209?",
    answer: "The Alfa Laval MOPX 209 centrifuge uses a 15 HP main drive motor. The complete Dolphin DMPX-042 system module typically includes a 15 HP centrifuge motor plus additional pump motor (1–3 HP) and optional electric heaters (up to 60 kW)."
  },
  {
    question: "Is the Alfa Laval MOPX 209 centrifuge available explosion-proof?",
    answer: "Yes. The Dolphin DMPX-042 (built around the MOPX 209 bowl) is available in Class I Division 2 explosion-proof configuration for hazardous area installations. Contact Dolphin Centrifuge at <a href='tel:+12485222573' class='text-navy font-semibold hover:text-gold'>(248) 522-2573</a> for explosion-proof options."
  }
];

const productJsonLd = {
