  "brand": { "@type": "Brand", "name": "Alfa Laval" },
  "manufacturer": { "@type": "Organization", "name": "Alfa Laval" },
  "model": "WHPX 513",
  "alternateName": ["Alfa Laval WHPX-513", "Alfa Laval WHPX 513 TGD 24-60"],
  "isRelatedTo": {
    "@type": "Product",
    "name": "Dolphin DMPX-070 Centrifuge Module",
    "description": "Dolphin module featuring a remanufactured Alfa Laval WHPX 513 centrifuge.",
    "url": "https://dolphincentrifuge.com/centrifuges/dmpx-070/",
  },
  "category": "Disc Stack Centrifuges",
  "url": "https://dolphincentrifuge.com/alfa-laval-whpx-513/",
  "image": "https://dolphincentrifuge.com/images/alfa-laval-whpx-513/Stainless_Steel_WHPX-513_Centrifuge_Module_for_WVO_Purification.webp",
  "subjectOf": {
    "@type": "DigitalDocument",
    "name": "WHPX 513 machine-readable technical record",
    "url": "https://dolphincentrifuge.com/technical-data/alfa-laval-whpx-513.json"
  },
  "offers": {
    "@type": "Offer",
    "seller": { "@type": "Organization", "name": "Dolphin Centrifuge", "url": "https://dolphincentrifuge.com" },
  },
  "additionalProperty": [
    { "@type": "PropertyValue", "name": "Model Type", "value": "Alfa Laval WHPX 513 TGD 24-60" },
    { "@type": "PropertyValue", "name": "Marine diesel application capacity", "value": "16,400 L/h (72.21 US GPM) at 13 cSt and 40 C" },
    { "@type": "PropertyValue", "name": "Rated reference capacity", "value": "24,500 L/h (107.87 US GPM); source fluid not specified" },
    { "@type": "PropertyValue", "name": "Sludge Space", "value": "3.87 Gallons" },
    { "@type": "PropertyValue", "name": "Motor HP", "value": "15 HP" },
    { "@type": "PropertyValue", "name": "Voltages", "value": "230 / 460 V" },
  ],
};

const jsonLd = [productJsonLd];

const toc = [
  { id: 'overview', label: 'Overview' },
  { id: 'application', label: 'Application' },
  { id: 'whpx-513-specifications', label: 'WHPX 513 Specifications' },
  { id: 'whpx-513-capacity-data', label: 'WHPX 513 Capacity Data' },
  { id: 'fopx-613', label: 'FOPX 613 Partial-Discharge Centrifuge' },
  { id: 'fopx-613-specifications', label: 'FOPX 613 Specifications' },
  { id: 'mopx-213', label: 'MOPX 213 Total-Discharge Centrifuge' },
  { id: 'mopx-213-specifications', label: 'MOPX 213 Specifications' },
  { id: 'WHPX-513-Gallery', label: 'WHPX 513 Centrifuge Modules Gallery' },
];

const relatedApplications = [
  { label: 'Diesel Fuel Centrifuge', href: '/alfa-laval-diesel-centrifuge/' },
  { label: 'Fuel Oil Centrifuge', href: '/fuel-oil-centrifuge/' },
  { label: 'Waste Oil Centrifuge', href: '/waste-oil-centrifuge/' },
  { label: 'Lube Oil Centrifuge', href: '/lube-oil-centrifuge/' },
  { label: 'Machine Coolant Centrifuge', href: '/machine-coolant-centrifuge/' },
