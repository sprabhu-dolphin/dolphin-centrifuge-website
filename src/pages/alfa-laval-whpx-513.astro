  <h3 id="fopx-613-specifications">Specifications</h3>

  <div class="not-prose overflow-x-auto border border-gray-100 rounded-xl">
    <SpecTable
      model="alfa-laval-fopx-613"
      variant="plain"
      rows={[
        { label: 'Model Type', field: 'modelType' },
        { label: 'Rated Capacity', capacity: 0 },
        { label: 'Sludge Space', field: 'sludgeVolumeGal' },
