  title={title}
  heroTitle="Alfa Laval MOPX 207 Self-Cleaning Centrifuge"
  pageTitle={pageTitle}
  description={description}
  disableTitleSuffix={true}
  heroImage="/images/alfa-laval-mopx-207-centrifuge/DMPX-028-Disc-Stack-Centrifuge-EKPC-Power-Plant.webp"
