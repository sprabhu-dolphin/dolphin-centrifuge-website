---
import ApplicationLayout from '../layouts/ApplicationLayout.astro';
import FormVerification from '../components/FormVerification.astro';
import {
  USED_OFFER_JSON_PATH,
  USED_OPENING_ANSWER,
  USED_PAGE_URL,
  USED_PRICE_TEXT,
  usedApplications,
  usedOffer,
} from '../data/usedAlfaLavalOffer.mjs';
import { USED_QUOTE_ATTRIBUTION_NAME, USED_QUOTE_FORM_ID } from '../lib/usedQuote.mjs';

// Same Worker endpoint and fallback as the contact page form.
const contactWorkerBaseUrl = (import.meta.env.PUBLIC_CONTACT_WORKER_URL || (
  import.meta.env.DEV
    ? 'http://127.0.0.1:8787'
    : 'https://dolphin-contact-form.dolphin-centrifuge.workers.dev'
)).replace(/\/$/, '');

// Owner-approved copy only (2026-09-28). Do not add customer-facing sentences.
const faqItems = [
  {
    question: 'Where can I buy a used Alfa Laval centrifuge?',
    answer: USED_OPENING_ANSWER,
  },
  {
    question: "Are Dolphin's used Alfa Laval centrifuges sold as-is?",
    answer: 'No. Every machine is fully rebuilt before it ships: bowl and rotating parts inspected and repaired where possible, every seal, gasket, friction pad, bearing and fastener replaced, new motor, and a full wet test on a surrogate fluid. FAT is available on request.',
  },
  {
    question: 'What warranty comes with a used Alfa Laval centrifuge from Dolphin?',
    answer: 'A 6-month mechanical warranty with all skids, plus lifetime technical support.',
  },
  {
    question: 'How much does a used Alfa Laval centrifuge cost?',
    answer: USED_PRICE_TEXT,
  },
  {
    question: 'Can I buy just the centrifuge without a skid?',
    answer: 'No. We sell complete plug-and-play modules only.',
  },
  {
    question: 'Can I inspect the machine or test my fluid before buying?',
    answer: 'Yes. You can visit our Warren, Michigan shop by appointment to see machines in stock. We also offer paid sample testing: we run your fluid through a lab-scale disc stack centrifuge and send you the results.',
  },
  {
    question: 'Is Dolphin an authorized Alfa Laval dealer?',
    answer: 'No. Dolphin Centrifuge is an independent remanufacturer of Alfa Laval centrifuges and is not affiliated with Alfa Laval. Established in 1982 as an Alfa Laval aftermarket parts manufacturer, we ship worldwide.',
  },
];

const description = 'Reconditioned Alfa Laval centrifuge modules for used oil and waste oil. Fully rebuilt, wet-tested, 6-month warranty, from the mid-$50s. Warren, MI.';

const webPageJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${USED_PAGE_URL}#webpage`,
  name: 'Used Alfa Laval Centrifuges for Sale',
  description,
  url: USED_PAGE_URL,
  dateModified: '2026-09-28',
  inLanguage: 'en-US',
  about: [
    { '@type': 'Brand', name: 'Alfa Laval' },
    { '@type': 'Thing', name: 'Remanufactured Alfa Laval centrifuges' },
  ],
  author: { '@type': 'Person', name: 'Sanjay Prabhu' },
  publisher: { '@type': 'Organization', name: 'Dolphin Centrifuge', url: 'https://dolphincentrifuge.com' },
  subjectOf: {
    '@type': 'DigitalDocument',
    name: 'Used Alfa Laval centrifuge offer, machine-readable record',
    url: `https://dolphincentrifuge.com${USED_OFFER_JSON_PATH}`,
    encodingFormat: 'application/json',
  },
};

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};

const badges = [
  'Every Unit Test-Run',
  'Full Rebuild',
  'Fully Automatic Domestic Control System',
  '6-Month Mechanical Warranty',
];

const keyFacts = [
  'Established 1982, Warren, MI',
  'Fully rebuilt, never sold as-is',
  'Wet-tested, FAT on request',
  '6-month mechanical warranty + lifetime technical support',
  '150+ centrifuges in stock',
  'Complete plug-and-play modules only',
  'From the mid-$50s',
];

const toc = [
  { id: 'answer', label: 'Where to buy a used Alfa Laval centrifuge' },
  { id: 'quote', label: 'Get a quote' },
  { id: 'key-facts', label: 'Key facts' },
  { id: 'reconditioned', label: 'What reconditioned means' },
  { id: 'as-is', label: 'Why not buy as-is?' },
  { id: 'models', label: 'Models' },
  { id: 'applications', label: 'Applications' },
  { id: 'how-to-choose', label: 'How to choose by fluid and flow rate' },
  { id: 'price', label: 'Price guidance' },
  { id: 'faq', label: 'FAQ' },
];

const linkClass = 'text-navy font-medium underline decoration-gold underline-offset-2 hover:text-gold-dark';
const inputClass = 'w-full border-2 border-gray-200 rounded-xl px-4 py-2.5 text-sm text-text focus:outline-none focus:border-navy transition-colors';
const labelClass = 'block text-xs font-bold text-navy uppercase tracking-wide mb-1.5';
---

<ApplicationLayout
  robots="noindex,follow"
  title="Used Alfa Laval Centrifuges for Sale"
  heroTitle="Used Alfa Laval Centrifuges for Sale"
  heroDescription="Reconditioned Alfa Laval disc stack and decanter centrifuges, fully rebuilt with warranty in Warren, Michigan, backed by lifetime technical support and a large in-house Alfa Laval parts inventory."
  description={description}
  heroImage="/images/used-oil-centrifuge/Used_Oil_Centrifuge_Hero_1440.webp"
  heroImageAlt="Remanufactured Alfa Laval centrifuge module"
  heroCtaLabel="Get a Quote"
  heroCtaHref="#quote"
  category="products"
  categoryLabel="Products"
  categoryHref="/alfa-laval-centrifuges/"
  canonicalUrl={USED_PAGE_URL}
  alternateJsonUrl={USED_OFFER_JSON_PATH}
  jsonLd={[webPageJsonLd, faqJsonLd]}
  toc={toc}
  hideBottomCTA={true}
>

  <ul class="not-prose flex flex-wrap gap-2 mb-8" aria-label="Highlights">
    {badges.map((badge) => (
      <li class="inline-flex items-center rounded-full bg-navy/5 border border-navy/15 px-3 py-1 text-xs font-bold text-navy uppercase tracking-wide">{badge}</li>
    ))}
  </ul>

  <h2 id="answer">Where to buy a used Alfa Laval centrifuge</h2>
  <p>{USED_OPENING_ANSWER}</p>

  <section id="quote" class="not-prose scroll-mt-24 my-8">
    <div class="bg-white rounded-2xl border-2 border-navy/15 shadow-sm p-5 md:p-7">
      <h2 class="text-xl md:text-2xl font-bold text-navy font-heading mb-1">Get a quote on an Alfa Laval centrifuge</h2>
      <p class="text-sm text-text-light mb-5">Tell us the fluid and the flow. An engineer replies within one business day.</p>

      <form
        id={USED_QUOTE_FORM_ID}
        data-dolphin-attribution-name={USED_QUOTE_ATTRIBUTION_NAME}
        data-endpoint={contactWorkerBaseUrl}
        class="space-y-4"
        novalidate
      >
        <div style="display:none" aria-hidden="true">
          <label>Leave this empty: <input type="text" name="bot-field" tabindex="-1" autocomplete="off" maxlength="254" /></label>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="uq-name" class={labelClass}>Name</label>
            <input id="uq-name" name="name" type="text" required autocomplete="name" maxlength="254" class={inputClass} />
          </div>
          <div>
            <label for="uq-company" class={labelClass}>Company</label>
            <input id="uq-company" name="company" type="text" required autocomplete="organization" maxlength="254" class={inputClass} />
          </div>
          <div>
            <label for="uq-email" class={labelClass}>Email</label>
            <input id="uq-email" name="email" type="email" required autocomplete="email" maxlength="254" placeholder="you@company.com" class={inputClass} />
          </div>
          <div>
            <label for="uq-phone" class={labelClass}>Phone</label>
            <input id="uq-phone" name="phone" type="tel" required autocomplete="tel" maxlength="254" class={inputClass} />
          </div>
          <div>
            <label for="uq-fluid" class={labelClass}>Fluid to process</label>
            <input id="uq-fluid" name="fluid" type="text" required autocomplete="off" maxlength="254" placeholder="e.g. waste oil, diesel, used cooking oil" class={inputClass} />
          </div>
          <div>
            <label for="uq-flow" class={labelClass}>Flow rate <span class="font-normal normal-case text-text-muted">(optional)</span></label>
            <input id="uq-flow" name="flowRate" type="text" autocomplete="off" maxlength="254" placeholder="e.g. 20 GPM or 10,000 gal/day" class={inputClass} />
          </div>
        </div>

        <FormVerification action="contact" />

        <p data-quote-error hidden role="alert" class="bg-red-50 border border-red-200 rounded-xl p-3 text-sm font-semibold text-red-700"></p>
        <p data-quote-success hidden role="status" class="bg-green-50 border border-green-200 rounded-xl p-3 text-sm font-semibold text-green-800"></p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <button type="submit" class="w-full bg-navy text-white font-bold py-3.5 px-6 rounded-xl hover:bg-gold hover:text-navy transition-all duration-200 disabled:opacity-50 disabled:cursor-not-allowed">
            Send Quote Request
          </button>
          <a href="tel:+12485222573" class="w-full inline-flex items-center justify-center gap-2 border-2 border-navy text-navy font-bold py-3 px-6 rounded-xl hover:bg-navy hover:text-white transition-colors">
            Call (248) 522-2573
          </a>
        </div>
        <p class="text-xs text-text-muted">A quote request asks for engineering follow-up. It is not an order.</p>
      </form>
    </div>
  </section>

  <h2 id="key-facts">Key facts</h2>
  <div class="not-prose my-6 overflow-x-auto border border-gray-100 rounded-xl bg-white">
    <table class="w-full text-sm">
      <caption class="sr-only">Key facts about buying a used Alfa Laval centrifuge from Dolphin Centrifuge</caption>
      <tbody class="divide-y divide-gray-100">
        {keyFacts.map((fact) => (
          <tr><td colspan="2" class="px-4 py-2.5 text-text">{fact}</td></tr>
        ))}
        <tr><th scope="row" class="text-left align-top font-semibold text-navy px-4 py-2.5 w-40">Contact</th><td class="px-4 py-2.5 text-text"><a href="tel:+12485222573" class={linkClass}>(248) 522-2573</a> or <a href="mailto:sales@dolphincentrifuge.com" class={linkClass}>sales@dolphincentrifuge.com</a>. Reply within one business day.</td></tr>
      </tbody>
    </table>
  </div>

  <figure>
    <img
      src="/images/about-dolphin-centrifuge/Dolphin_Centrifuge_Warren_MI_Shop_800.webp"
      alt="Dolphin Centrifuge shop in Warren, Michigan"
      width="800"
      height="314"
      loading="lazy"
      class="img-cap-800"
    />
  </figure>

  <h2 id="reconditioned">What reconditioned means</h2>
  <ol>
    {usedOffer.condition.standard.map((item) => (
      item.startsWith('FAT ')
        ? <li><strong>FAT</strong>{item.slice(3)}</li>
        : <li>{item}</li>
    ))}
  </ol>
  <p><a href="/centrifuge-reconditioning-standard/">Read the full reconditioning standard</a></p>

  <h2 id="as-is">Why not buy as-is?</h2>
  <p>
    As-is equipment may be suspect due to worn or missing bowl parts, which often cost more than the used machine itself. These are high-speed centrifuges, and running one at operating speed can be unsafe if the bearings are questionable or the bowl is out of balance.
  </p>

  <figure>
    <img
      src="/images/used-oil-centrifuge/Alfa-Laval-MOPX207-Used-Oil-Skid.webp"
      alt="Alfa Laval MOPX 207 centrifuge on a used oil skid"
      width="400"
      height="412"
      loading="lazy"
      class="img-cap-400"
    />
  </figure>

  <h2 id="models">Models</h2>
  <p>
    We specialize in heavy-duty Alfa Laval WHPX, MOPX and MAPX series centrifuges. These are gear-drive machines, and in our customers' experience they are more durable than the newer belt-drive models. We have 150+ Alfa Laval centrifuges in stock in Warren, Michigan, which we fully rebuild and custom fit onto a new skid based on each customer's application.
  </p>
  <p>
    All these centrifuges are well suited to removing water and sludge from oil simultaneously, in a single pass-through process, at extremely high G-force.
  </p>

  <h2 id="applications">Applications</h2>
  <p>Typical duties. Each page covers the process in detail.</p>
  <ul>
    {usedApplications.map((application) => (
      <li><a href={application.path}>{application.label}</a></li>
    ))}
  </ul>

  <h2 id="how-to-choose">How to choose by fluid and flow rate</h2>
  <p>Tell us your fluid, flow rate and solids content. We'll recommend the right machine and size it to your process.</p>

  <h2 id="price">Price guidance</h2>
  <p>{USED_PRICE_TEXT}</p>

  <h2 id="faq">Used Alfa Laval centrifuges: frequently asked questions</h2>
  <div class="space-y-3 not-prose">
    {faqItems.map((item) => (
      <details class="border-l-4 border-gold/40 bg-white rounded-r-xl shadow-sm p-5">
        <summary class="font-semibold text-navy cursor-pointer list-none flex items-center gap-2">
          <span class="text-gold font-bold">+</span> {item.question}
        </summary>
        <p class="text-text-light mt-3 text-sm leading-relaxed">{item.answer}</p>
      </details>
    ))}
  </div>

</ApplicationLayout>

<script>
  import { initUsedQuoteForm } from '../scripts/usedQuoteForm';
  initUsedQuoteForm();
</script>
