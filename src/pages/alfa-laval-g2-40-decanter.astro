---
import ApplicationLayout from '../layouts/ApplicationLayout.astro';
import SpecTable from '../components/SpecTable.astro';

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "Alfa Laval G2-40 Decanter | High-Performance Centrifuge",
  "description": "Alfa Laval G2-40 decanter centrifuge finds multiple uses for sludge thickening and wastewater applications. It is ideal for high sludge mining applications.",
  "url": "https://dolphincentrifuge.com/alfa-laval-g2-40-decanter/",
  "author": {
    "@type": "Person",
    "name": "Sanjay Prabhu MSME",
    "jobTitle": "Centrifuge Applications Engineer",
    "worksFor": { "@type": "Organization", "name": "Dolphin Centrifuge" }
  },
  "publisher": { "@type": "Organization", "name": "Dolphin Centrifuge", "url": "https://dolphincentrifuge.com" }
};

const productJsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "Alfa Laval G2-40 Decanter Centrifuge",
  "description": "Alfa Laval G2-40 decanter centrifuge finds multiple uses for sludge thickening and wastewater applications. It is ideal for high sludge mining applications.",
  "brand": { "@type": "Brand", "name": "Alfa Laval" },
  "model": "G2-40",
  "alternateName": [
    "Alfa Laval G2-40",
    "Alfa Laval G2 Decanter Centrifuge"
  ],
  "category": "Decanter Centrifuges",
  "itemCondition": "https://schema.org/RefurbishedCondition",
  "image": "https://dolphincentrifuge.com/images/alfa-laval-g2-40-decanter/alfa-laval-g2-40-decanter-2000.webp",
  "url": "https://dolphincentrifuge.com/alfa-laval-g2-40-decanter/",
  "additionalProperty": [
    { "@type": "PropertyValue", "name": "Rated Capacity", "value": "160 GPM on Water Sludge Thickening" },
    { "@type": "PropertyValue", "name": "Bowl Speed", "value": "4,000 RPM" },
    { "@type": "PropertyValue", "name": "GearBox Ratio", "value": "1: 52 (3.5 kN-M) DD Gearbox" },
    { "@type": "PropertyValue", "name": "Auger Differential Speed", "value": "1 ~ 140 RPM" }
  ],
  "offers": {
    "@type": "Offer",
    "availability": "https://schema.org/InStock",
    "itemCondition": "https://schema.org/RefurbishedCondition",
    "url": "https://dolphincentrifuge.com/alfa-laval-g2-40-decanter/",
    "seller": {
      "@type": "Organization",
      "name": "Dolphin Centrifuge",
      "telephone": "(248) 522-2573",
      "email": "sales@dolphincentrifuge.com",
      "url": "https://dolphincentrifuge.com"
    }
  }
};

const faqItems = [
  {
    question: "What is the Alfa Laval G2-40 decanter centrifuge?",
    answer: "The Alfa Laval G2-40 is a horizontal two-phase decanter centrifuge. It runs a bowl speed of 4,000 RPM, uses a 1:52 (3.5 kN-M) direct drive gearbox with an auger differential of 1 to 140 RPM, and is rated at 160 GPM on water sludge thickening."
  },
  {
    question: "Can Dolphin Centrifuge supply, rebuild, or service an Alfa Laval G2-40?",
    answer: "Yes. Dolphin Centrifuge is the independent specialist in Alfa Laval centrifuges: remanufactured machines, turnkey systems, parts, and service. G2 decanter work is done in Dolphin's Warren, Michigan shop by an engineer-led team headed by Sanjay Prabhu, M.S.M.E., and covers bowl and conveyor rebuilds, gearbox service, hard-surfacing, balancing, and field startup. Dolphin is an independent remanufacturer and is not affiliated with or authorized by Alfa Laval."
  },
  {
    question: "What applications is the Alfa Laval G2-40 used for?",
    answer: "The G2-40 handles two-phase separation duties such as municipal wastewater and sludge thickening, industrial sludge dewatering, crude oil tank bottoms, waste oil de-sludging, paint sludge, pyrolysis sludge, liquid humus fertilizer, and hemp or ethanol extraction solids."
  },
  {
    question: "How does the G2-40 compare with the Alfa Laval NX decanters Dolphin supplies?",
    answer: "The G2-40 is the high-throughput two-phase machine in Dolphin's Alfa Laval decanter lineup. The NX 314 is the compact 314 mm decanter, the NX 418 is the 418 mm industrial decanter, and the CHNX 418 is the nitrogen-purged version for hazardous duty. Dolphin remanufactures and supplies all of them, so the selection comes down to flow rate, solids loading, and area classification rather than availability."
  }
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": { "@type": "Answer", "text": item.answer }
  }))
};

const jsonLd = [articleJsonLd, productJsonLd, faqJsonLd];

const toc = [
  { id: 'g2-40-decanter', label: 'Alfa Laval G2-40 Two-Phase Decanter Centrifuge' },
  { id: 'applications', label: 'Applications' },
  { id: 'cross-section-diagram', label: 'Cross Section Diagram' },
  { id: 'specifications', label: 'Specifications' },
  { id: 'faq', label: 'Frequently Asked Questions' },
];

const relatedApplications = [
  { label: 'Decanter Centrifuge Applications', href: '/decanter-centrifuge-applications/' },
  { label: 'Dewatering Centrifuge', href: '/dewatering-centrifuge/' },
  { label: 'Three-Phase Decanter', href: '/three-phase-decanter/' },
  { label: 'Decanter vs Disc Stack', href: '/difference-between-decanter-centrifuge-disc-centrifuge/' },
];

const relatedProducts = [
  { label: 'Alfa Laval CHNX 418 Decanter', href: '/alfa-laval-chnx-418-decanter/', description: 'Nitrogen-purged hazardous duty decanter' },
  { label: 'Alfa Laval NX-314 Decanter', href: '/alfa-laval-nx-314-decanter-centrifuge/', description: '314 mm compact decanter' },
  { label: 'Alfa Laval NX 418 Decanter', href: '/alfa-laval-nx-418-decanter-centrifuge/', description: '418 mm industrial decanter' },
];
---

<ApplicationLayout
  hideBottomCTA={true}
  title="Alfa Laval G2-40 Decanter | High Performance Centrifuge"
  heroTitle="Alfa Laval G2-40 Decanter"
  pageTitle="Alfa Laval G2-40 Decanter | High-Performance Centrifuge"
  disableTitleSuffix={true}
  description="Alfa Laval G2-40 decanter centrifuge finds multiple uses for sludge thickening and wastewater applications. It is ideal for high sludge mining applications."
  heroImage="/images/alfa-laval-g2-40-decanter/alfa-laval-g2-40-decanter-2000.webp"
  heroImageAlt="Alfa Laval G2-40 Decanter Centrifuge"
  category="products"
  categoryLabel="Products"
  categoryHref="/decanter-centrifuge/"
  canonicalUrl="https://dolphincentrifuge.com/alfa-laval-g2-40-decanter/"
  jsonLd={jsonLd}
  toc={toc}
  relatedApplications={relatedApplications}
  relatedProducts={relatedProducts}
>

  <!-- Alfa Laval G2-40 Two-Phase Decanter Centrifuge -->
  <h2 id="g2-40-decanter">Alfa Laval G2-40 Two-Phase Decanter Centrifuge</h2>

  <p>The <a href="https://www.alfalaval.us/products/separation/centrifugal-separators/decanters/sg2/">Alfa Laval G2-40</a> <a href="/decanter-centrifuge/">Decanter Centrifuge</a> is a horizontal de-sludging centrifuge built for the two-phase separation of <strong>wastewater</strong>, <strong>crude oil tank bottoms</strong>, municipal <strong>sludge-thickening</strong>, industrial sludge dewatering, <strong>paint sludge handling</strong>, etc.</p>

  <p>With a 25 HP Motor, the G2-40 decanter has a <strong>bowl RPM of 4,000</strong> and can process <strong>160 GPM of water with light sludge</strong>.</p>

  <p>Dolphin Centrifuge is the independent specialist in <a href="/alfa-laval-centrifuges/">Alfa Laval</a> centrifuges: remanufactured machines, turnkey systems, parts, and service, built on 40+ years of Alfa Laval experience and led by Sanjay Prabhu, M.S.M.E. Apart from Alfa Laval itself, Dolphin is the reliable source for quality Alfa Laval decanters, including the G2 series alongside the <a href="/alfa-laval-nx-314-decanter-centrifuge/">NX 314</a>, <a href="/alfa-laval-nx-418-decanter-centrifuge/">NX 418</a>, and <a href="/alfa-laval-chnx-418-decanter/">CHNX 418</a>. Every machine is stripped, rebuilt, balanced, and tested in Dolphin's Warren, Michigan shop. Dolphin is an independent remanufacturer and is not affiliated with or authorized by Alfa Laval.</p>

  <!-- Applications -->
  <h3 id="applications">Applications</h3>

  <p>The Alfa Laval G2-40 Decanter is used for the following applications.</p>

  <ul>
    <li><a href="/stainless-steel-centrifuge/">Hemp Solvent Extraction</a></li>
    <li><a href="/ethanol-extraction-centrifuges-technical-comparison/">Ethanol Extraction Centrifuge</a></li>
    <li><a href="/waste-oil-centrifuge/">Waste Oil De-sludging</a></li>
    <li><a href="/crude-oil-centrifuge/">Crude Oil Tank Bottom Sludge</a></li>
    <li><a href="/wastewater-centrifuge/">Municipal Wastewater</a></li>
    <li><a href="/pyrolysis-oil-centrifuge/">Pyrolysis Sludge Separation</a></li>
    <li><a href="/liquid-humus-centrifuge/">Liquid Humus Fertilizer</a></li>
    <li><a href="/wastewater-centrifuge/">Sludge Thickening &amp; Dewatering</a></li>
  </ul>

  <figure>
    <img
      src="/images/alfa-laval-g2-40-decanter/Alfa-Laval-Decanter-Rotating-Assembly-800.webp"
      alt="Alfa Laval G2 Decanter Rotating Assembly"
      width="800"
      height="352"
      loading="lazy"
      class="img-cap-800"
    />
    <figcaption><strong>Alfa Laval G2 Decanter</strong></figcaption>
  </figure>

  <!-- Cross Section Diagram -->
  <h3 id="cross-section-diagram">Cross Section Diagram</h3>

  <figure>
    <img
      src="/images/alfa-laval-g2-40-decanter/Decanter-Cross-Section-600.webp"
      alt="Alfa Laval G2-40 Decanter Centrifuge Cross Section"
      width="600"
      height="264"
      loading="lazy"
      class="img-cap-600"
    />
    <figcaption><strong>Alfa Laval G2-40 Decanter Centrifuge Cross Section</strong></figcaption>
  </figure>

  <!-- Specifications -->
  <h3 id="specifications">Specifications</h3>

  <div class="overflow-x-auto mb-8">
    <SpecTable
      model="alfa-laval-g2-40"
      variant="striped-card"
      rows={[
        { label: 'Model Type', field: 'modelType' },
        { label: 'Rated Capacity', capacity: 0 },
        { label: 'Auger Differential Speed', field: 'augerDifferentialRpm' },
        { label: 'Drive Motor Power', field: 'motorHp' },
        { label: 'GearBox Ratio', field: 'gearboxRatio' },
        { label: 'Bowl Speed', field: 'bowlSpeedRpm' },
        { label: 'Conveyor Protection', field: 'conveyorProtection' },
      ]}
    />
  </div>

  <!-- PDF Datasheet - after specs table -->
  <div class="not-prose my-6 p-4 border border-gray-200 rounded-lg flex items-center gap-4">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 shrink-0 text-red-600" viewBox="0 0 24 24" fill="currentColor">
      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6zm-1 1.5L18.5 9H13V3.5zM8.5 15.5h-.75v1.25H7v-4h1.5c.83 0 1.5.67 1.5 1.5s-.67 1.25-1.5 1.25zm3.75 1.25h-1.5v-4H12c1.1 0 2 .9 2 2s-.9 2-2 2zm4.5-2.75h-1v.75h1v.75h-1v1.25h-.75v-4H17v.75h-1v.5h1v-.25z"/>
    </svg>
    <div class="flex-1">
      <p class="text-sm font-semibold text-navy mb-1">Alfa Laval G2 Decanter - Product Datasheet</p>
      <a
        href="/images/alfa-laval-g2-40-decanter/Alfa-Laval-G2-Decanter.pdf"
        class="text-sm text-gold-darker hover:underline font-medium"
        target="_blank"
        rel="noopener noreferrer"
        download
      >Download PDF</a>
    </div>
  </div>

  <!-- FAQ -->
  <h3 id="faq">Frequently Asked Questions</h3>

  {faqItems.map((item) => (
    <details class="border-l-4 border-gold/40 pl-4 mb-3 group">
      <summary class="cursor-pointer font-semibold text-navy py-2 list-none flex justify-between items-center">
        {item.question}
        <span class="text-gold ml-2 group-open:rotate-180 transition-transform">&#9660;</span>
      </summary>
      <p class="text-text-light mt-2 pb-2">{item.answer}</p>
    </details>
  ))}

</ApplicationLayout>
