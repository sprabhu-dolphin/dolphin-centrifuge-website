---
/**
 * statcounter-custom-tag-test.astro
 *
 * Standalone noindex page for controlled StatCounter staging verification.
 * Does NOT use BaseLayout — avoids double-loading the @statcounter/astro plugin.
 *
 * Usage:
 *   https://<pages-deploy>.pages.dev/statcounter-custom-tag-test?sc_test=<marker>
 *
 * StatCounter loads only when sc_test is a valid marker:
 *   - letters, numbers, underscore, hyphen
 *   - 4–30 characters
 *
 * Custom tags pushed before the counter script:
 *   site_mode  : staging
 *   platform   : astro
 *   test_id    : <sc_test marker>
 *   tracker    : custom_tag
 *   launch     : wp_to_astro
 */

const SC_PROJECT  = 9162316;
const SC_SECURITY = 'aef6b239';

// Serialise constants for the inline script
const scProject  = SC_PROJECT;
const scSecurity = SC_SECURITY;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>StatCounter Custom-Tag Staging Test | Dolphin Centrifuge</title>

    <style>
      /* ── Reset & tokens ─────────────────────────────────────── */
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      :root {
        --navy:   #003366;
        --teal:   #006b8f;
        --green:  #00875a;
        --amber:  #d97706;
        --red:    #dc2626;
        --bg:     #f0f4f8;
        --surface:#ffffff;
        --text:   #1e293b;
        --muted:  #64748b;
        --border: #cbd5e1;
        --radius: 10px;
        --shadow: 0 4px 20px rgba(0,0,0,.08);
        --font:   system-ui, -apple-system, 'Segoe UI', sans-serif;
      }

      body {
        font-family: var(--font);
        background: var(--bg);
        color: var(--text);
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem 1rem;
      }

      /* ── Card ───────────────────────────────────────────────── */
      .card {
        background: var(--surface);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        max-width: 680px;
        width: 100%;
        overflow: hidden;
      }

      .card-header {
        background: linear-gradient(135deg, var(--navy) 0%, var(--teal) 100%);
        padding: 2rem 2rem 1.5rem;
        color: #fff;
      }

      .card-header h1 {
        font-size: 1.25rem;
        font-weight: 700;
        line-height: 1.3;
        margin-bottom: .5rem;
      }

      .card-header p {
        font-size: .85rem;
        opacity: .85;
      }

      .card-body {
        padding: 1.75rem 2rem;
      }

      /* ── Badge-style status block ───────────────────────────── */
      .status-block {
        border-radius: var(--radius);
        padding: 1.1rem 1.25rem;
        margin-bottom: 1.25rem;
        font-size: .9rem;
        border: 1px solid transparent;
      }

      .status-block.ok {
        background: #f0fdf4;
        border-color: #86efac;
        color: #166534;
      }

      .status-block.warn {
        background: #fffbeb;
        border-color: #fcd34d;
        color: #92400e;
      }

      .status-block.error {
        background: #fef2f2;
        border-color: #fca5a5;
        color: #991b1b;
      }

      .status-block strong { display: block; margin-bottom: .35rem; font-size: .95rem; }

      /* ── Detail table ───────────────────────────────────────── */
      .detail-table {
        width: 100%;
        border-collapse: collapse;
        font-size: .875rem;
        margin-bottom: 1.25rem;
      }

      .detail-table th,
      .detail-table td {
        text-align: left;
        padding: .55rem .75rem;
        border-bottom: 1px solid var(--border);
      }

      .detail-table th {
        color: var(--muted);
        font-weight: 600;
        width: 38%;
      }

      .detail-table td code {
        background: #f1f5f9;
        border-radius: 4px;
        padding: .15rem .45rem;
        font-size: .82rem;
        font-family: 'SFMono-Regular', Consolas, monospace;
      }

      /* ── Tag list ───────────────────────────────────────────── */
      .tag-list {
        list-style: none;
        background: #f8fafc;
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 1rem 1.25rem;
        margin-bottom: 1.25rem;
      }

      .tag-list li {
        font-size: .875rem;
        padding: .3rem 0;
        display: flex;
        gap: .5rem;
        border-bottom: 1px dashed #e2e8f0;
      }

      .tag-list li:last-child { border-bottom: none; }

      .tag-list .tag-key {
        color: var(--teal);
        font-weight: 600;
        min-width: 9rem;
        font-family: 'SFMono-Regular', Consolas, monospace;
        font-size: .82rem;
      }

      /* ── Footer note ────────────────────────────────────────── */
      .footer-note {
        font-size: .78rem;
        color: var(--muted);
        padding-top: .75rem;
        border-top: 1px solid var(--border);
      }
    </style>
  </head>

  <body>
    <div class="card">
      <div class="card-header">
        <h1>StatCounter Custom-Tag Staging Test</h1>
        <p>Dolphin Centrifuge · Cloudflare Pages staging verification</p>
      </div>

      <div class="card-body">

        <!-- ── Status block (populated by inline script) ── -->
        <div id="sc-status" class="status-block warn">
          <strong>⏳ Evaluating…</strong>
          Checking for a valid <code>?sc_test</code> parameter.
        </div>

        <!-- ── Detail table ── -->
        <table class="detail-table">
          <tbody>
            <tr>
              <th>sc_project</th>
              <td><code id="td-project">—</code></td>
            </tr>
            <tr>
              <th>sc_security</th>
              <td><code id="td-security">—</code></td>
            </tr>
            <tr>
              <th>sc_test marker</th>
              <td><code id="td-marker">—</code></td>
            </tr>
            <tr>
              <th>Hostname</th>
              <td><code id="td-host">—</code></td>
            </tr>
            <tr>
              <th>StatCounter status</th>
              <td id="td-sc-status">—</td>
            </tr>
          </tbody>
        </table>

        <!-- ── Custom tags list ── -->
        <ul class="tag-list" id="tag-list-wrap" style="display:none">
          <li><span class="tag-key">site_mode</span><span>staging</span></li>
          <li><span class="tag-key">platform</span><span>astro</span></li>
          <li><span class="tag-key">test_id</span><span id="tag-test-id">—</span></li>
          <li><span class="tag-key">tracker</span><span>custom_tag</span></li>
          <li><span class="tag-key">launch</span><span>wp_to_astro</span></li>
        </ul>

        <p class="footer-note">
          This page is <strong>noindex, nofollow</strong>. It exists solely to verify
          StatCounter custom-tag delivery on the Cloudflare Pages staging environment
          before production go-live.
        </p>
      </div>
    </div>

    <!--
      ── Inline StatCounter loader ──────────────────────────────────────────
      Runs after DOM is parsed. Validates the sc_test marker, then conditionally:
        1. Pushes custom tags via _statcounter array
        2. Loads counter.js from statcounter.com
      No tracking occurs if the marker is absent or invalid.
    -->
    <script is:inline define:vars={{ scProject, scSecurity }}>
    (function () {
      var VALID_MARKER = /^[A-Za-z0-9_-]{4,30}$/;

      // ── DOM refs ──────────────────────────────────────────────
      var elStatus   = document.getElementById('sc-status');
      var elProject  = document.getElementById('td-project');
      var elSecurity = document.getElementById('td-security');
      var elMarker   = document.getElementById('td-marker');
      var elHost     = document.getElementById('td-host');
      var elScStatus = document.getElementById('td-sc-status');
      var elTagList  = document.getElementById('tag-list-wrap');
      var elTagTestId = document.getElementById('tag-test-id');

      // ── Populate static fields ────────────────────────────────
      elProject.textContent  = String(scProject);
      elSecurity.textContent = scSecurity;
      elHost.textContent     = window.location.hostname;

      // ── Validate marker ───────────────────────────────────────
      var testId    = new URLSearchParams(window.location.search).get('sc_test');
      var isValid   = VALID_MARKER.test(testId || '');
      var isPagesHost = window.location.hostname.endsWith('.pages.dev');

      elMarker.textContent = testId || '(none)';

      if (!isValid) {
        elStatus.className = 'status-block error';
        elStatus.innerHTML =
          '<strong>❌ StatCounter NOT loaded</strong>' +
          'A valid <code>?sc_test=&lt;marker&gt;</code> is required.<br>' +
          'Marker rules: letters, numbers, underscore, hyphen · 4–30 characters.';
        elScStatus.textContent = 'Suppressed — invalid or missing marker';
        return;
      }

      // ── Push custom tags ──────────────────────────────────────
      window._statcounter = window._statcounter || [];
      window._statcounter.push({
        tags: {
          site_mode: 'staging',
          platform:  'astro',
          test_id:   testId,
          tracker:   'custom_tag',
          launch:    'wp_to_astro'
        }
      });

      // ── Configure StatCounter globals ─────────────────────────
      window.sc_project  = scProject;
      window.sc_security = scSecurity;
      window.sc_invisible = 1;
      window.sc_https    = 1;

      // ── Load counter.js ───────────────────────────────────────
      var s = document.createElement('script');
      s.async = true;
      s.src   = 'https://www.statcounter.com/counter/counter.js';
      document.head.appendChild(s);

      // ── Update UI ─────────────────────────────────────────────
      elStatus.className = 'status-block ok';
      elStatus.innerHTML =
        '<strong>✅ StatCounter loaded with custom tags</strong>' +
        'counter.js injected · custom tags pushed · marker: <code>' + testId + '</code>';

      elScStatus.textContent = 'Active — counter.js injected';
      elTagTestId.textContent = testId;
      elTagList.style.display = 'block';

      // ── Console breadcrumb ────────────────────────────────────
      console.info('[SC-staging-test] StatCounter custom-tag test fired.', {
        sc_project:  scProject,
        sc_security: scSecurity,
        sc_test:     testId,
        hostname:    window.location.hostname,
        tags:        window._statcounter
      });
    })();
    </script>

    <!-- StatCounter noscript fallback (invisible pixel) -->
    <noscript>
      <div class="statcounter">
        <a title="web counter"
           href="https://statcounter.com/"
           target="_blank">
          <img class="statcounter"
               src="https://c.statcounter.com/9162316/0/aef6b239/1/"
               alt="web counter"
               referrerpolicy="no-referrer-when-downgrade" />
        </a>
      </div>
    </noscript>
  </body>
</html>
